<Project Sdk="Microsoft.NET.Sdk">
    <ImportGroup>
        <Import Project="../CommonVersion.props" />
    </ImportGroup>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>LLServer</RootNamespace>
        <Nullable>enable</Nullable>
        <EnableFlHookCompat Condition="'$(EnableFlHookCompat)' == ''">false</EnableFlHookCompat>
        <EnableClusterIntegration Condition="'$(EnableClusterIntegration)' == ''">false</EnableClusterIntegration>
    </PropertyGroup>

    <PropertyGroup Condition="'$(EnableFlHookCompat)' == 'true'">
        <DefineConstants>$(DefineConstants);LANCER_NEXUS_FLHOOKCOMPAT</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(EnableClusterIntegration)' == 'true'">
        <DefineConstants>$(DefineConstants);LANCER_NEXUS_CLUSTER</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\LibreLancer.Base\LibreLancer.Base.csproj" />
        <ProjectReference Include="..\Librelancer.Database\LibreLancer.Database.csproj" />
        <ProjectReference Include="..\LibreLancer.Entities\LibreLancer.Entities.csproj" />
        <ProjectReference Include="..\LibreLancer\LibreLancer.csproj" />
        <ProjectReference Include="..\Nexus.Assets\Nexus.Assets.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(EnableFlHookCompat)' == 'true'">
        <ProjectReference Include="../../../FLHookCompat/src/LancerNexus.FlhookCompat.Contracts/LancerNexus.FlhookCompat.Contracts.csproj" />
        <ProjectReference Include="../../../FLHookCompat/src/LancerNexus.FlhookCompat.Hosting/LancerNexus.FlhookCompat.Hosting.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(EnableClusterIntegration)' == 'true'">
        <ProjectReference Include="../../../Cluster/src/LancerNexus.Cluster/LancerNexus.Cluster.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Properties" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    </ItemGroup>
</Project>
