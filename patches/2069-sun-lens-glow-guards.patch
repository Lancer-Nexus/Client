@@ -68,13 +68,14 @@
             var fadeSeconds = lensGlowTargetAlpha > lensGlowAlpha
                 ? Sun.LensGlowFadeInSeconds
                 : Sun.LensGlowFadeOutSeconds;
-            if (fadeSeconds <= 0)
+            if (!float.IsFinite(fadeSeconds) || fadeSeconds <= 0)
             {
                 lensGlowAlpha = lensGlowTargetAlpha;
             }
             else
             {
-                var step = (float)(Math.Max(0, elapsed) / fadeSeconds);
