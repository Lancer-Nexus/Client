--- a/src/LibreLancer/Shaders/includes/NormalMap.hlsl
+++ b/src/LibreLancer/Shaders/includes/NormalMap.hlsl
@@ -12,14 +12,17 @@
     return NormalMapNormalize(float3(xy * clamp(strength, 0.0, 16.0), z), float3(0.0, 0.0, 1.0));
 }
 
-float3x3 MakeNormalMapBasis(float3 normal, float3 tangent, float handedness)
+float3x3 MakeNormalMapBasis(float3 normal, float3 tangent, float handedness, float2 uvScale)
 {
     float3 n = NormalMapNormalize(normal, float3(0.0, 0.0, 1.0));
     float3 axis = abs(n.z) < 0.999 ? float3(0.0, 0.0, 1.0) : float3(0.0, 1.0, 0.0);
     float3 fallback = normalize(cross(axis, n));
     float3 t = NormalMapNormalize(tangent - n * dot(n, tangent), fallback);
     float3 b = cross(n, t) * (handedness < 0.0 ? -1.0 : 1.0);
-    return float3x3(t, b, n);
+    // MaterialAnim scales the sampled UVs. Scale the tangent axes by the same
+    // signed factors so animated tiling also changes normal-map slope and
+    // mirrored UV animation keeps its handedness.
+    return float3x3(t * uvScale.x, b * uvScale.y, n);
 }
 
 float3 TransformNormalMap(float3 tangentNormal, float3x3 basis)
