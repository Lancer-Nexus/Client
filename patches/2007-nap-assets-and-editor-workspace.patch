+
+    private void DrawRouteTable(TradeCommodity commodity)
+    {
+        var visibleRoutes = commodity.Routes
+            .Where(RouteMatchesFilter)
+            .Take(Math.Max(25, maxRoutesShown))
+            .ToList();
