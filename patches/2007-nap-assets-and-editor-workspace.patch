+
+    private void DrawMapSplitter(float width, float minHeight, float maxHeight)
+    {
+        var splitterHeight = 8 * ImGuiHelper.Scale;
+        ImGui.InvisibleButton("##maproutesplitter", new Vector2(width, splitterHeight));
