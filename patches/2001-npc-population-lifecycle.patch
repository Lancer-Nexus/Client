+                {
+                    TransferId = transferId,
+                    AccountId = accountId,
+                    CharacterId = characterId,
+                    SourceInstanceId = sourceInstanceId,
+                    TargetInstanceId = targetInstanceId,
+                    TargetSystemId = targetSystemId,
+                    LeaseVersion = leaseVersion,
+                    TicketHash = ticketHash
