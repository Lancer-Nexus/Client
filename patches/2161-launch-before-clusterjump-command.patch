From: Lancer Nexus
Subject: [PATCH] Launch from base before operator cluster jump

diff --git a/src/LibreLancer/Server/Player.cs b/src/LibreLancer/Server/Player.cs
--- a/src/LibreLancer/Server/Player.cs
+++ b/src/LibreLancer/Server/Player.cs
@@ -2778,7 +2778,7 @@
             }, msnPreload);
         }
 
-        public void LaunchFromBase()
+        public void LaunchFromBase(Action? afterLaunch = null)
         {
             if (Character?.Ship == null)
             {
@@ -2877,6 +2877,7 @@
                     }
 
                     HandleSpaceEntry();
+                    afterLaunch?.Invoke();
                 });
             }, msnPreload);
         }
diff --git a/src/LibreLancer/Server/ConsoleCommands/ClusterJumpCommand.cs b/src/LibreLancer/Server/ConsoleCommands/ClusterJumpCommand.cs
--- a/src/LibreLancer/Server/ConsoleCommands/ClusterJumpCommand.cs
+++ b/src/LibreLancer/Server/ConsoleCommands/ClusterJumpCommand.cs
@@ -54,6 +54,19 @@
             return;
         }
 
+        if (player.Base is not null)
+        {
+            player.RpcClient.OnConsoleMessage($"Launching and requesting cluster jump to {targetSystem.Nickname}.");
+            player.LaunchFromBase(() => player.JumpTo(targetSystem.Nickname, arrivalGate, []));
+            return;
+        }
+
+        if (player.Space is null)
+        {
+            player.RpcClient.OnConsoleMessage("Cluster jump requires a player ship in space.");
+            return;
+        }
+
         player.JumpTo(targetSystem.Nickname, arrivalGate, []);
         player.RpcClient.OnConsoleMessage($"Cluster jump to {targetSystem.Nickname} requested via {sourceGate.Nickname}.");
     }
