diff --git a/src/LibreLancer.Tests/RendererSettingsValidationTests.cs b/src/LibreLancer.Tests/RendererSettingsValidationTests.cs
new file mode 100644
--- /dev/null
+++ b/src/LibreLancer.Tests/RendererSettingsValidationTests.cs
@@ -0,0 +1,28 @@
+using LibreLancer;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public class RendererSettingsValidationTests
+{
+    [Theory]
+    [InlineData(0.05f)]
+    [InlineData(2f)]
+    [InlineData(20f)]
+    public void SoftParticleDistanceKeepsSupportedValues(float value)
+    {
+        Assert.Equal(value, GameSettings.NormalizeSoftParticleDistance(value));
+    }
+
+    [Theory]
+    [InlineData(-1f)]
+    [InlineData(0f)]
+    [InlineData(20.01f)]
+    [InlineData(float.NaN)]
+    [InlineData(float.PositiveInfinity)]
+    [InlineData(float.NegativeInfinity)]
+    public void SoftParticleDistanceFallsBackForUnsupportedValues(float value)
+    {
+        Assert.Equal(2f, GameSettings.NormalizeSoftParticleDistance(value));
+    }
+}
