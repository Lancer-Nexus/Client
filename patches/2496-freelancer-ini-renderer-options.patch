+        private static readonly Dictionary<string, FieldInfo> FreelancerRendererFields =
+            typeof(GameSettings).GetFields(BindingFlags.Instance | BindingFlags.Public)
+                .SelectMany(field => field.GetCustomAttributes<EntryAttribute>()
+                    .Where(attribute => IsFreelancerRendererOption(attribute.Name))
+                    .Select(attribute => (attribute.Name, Field: field)))
+                .ToDictionary(item => item.Name, item => item.Field, StringComparer.OrdinalIgnoreCase);
+
+        private static bool IsFreelancerRendererOption(string name) =>
+            name.StartsWith("render_", StringComparison.OrdinalIgnoreCase) ||
+            name.StartsWith("surface_", StringComparison.OrdinalIgnoreCase) ||
+            name.StartsWith("pbr_", StringComparison.OrdinalIgnoreCase) ||
+            name is "anisotropy" or "antialias" or "lod_multiplier" or "per_pixel_lighting" or
+                "dynamic_lighting" or "dynamic_light_budget" or "transient_effect_light_budget";
+
+        public void ApplyFreelancerRendererOptions(Section section, ISet<string>? explicitLocalSettings = null)
+        {
+            if (!TryParse(section, out var parsed) || parsed == null)
+                return;
+
+            foreach (var entry in section)
+            {
+                if (explicitLocalSettings?.Contains(entry.Name) == true)
+                    continue;
+
+                if (string.Equals(entry.Name, "surface_profile", StringComparison.OrdinalIgnoreCase))
+                {
+                    SurfaceProfile = parsed.SurfaceProfile;
+                    continue;
+                }
+
+                if (FreelancerRendererFields.TryGetValue(entry.Name, out var field))
+                    field.SetValue(this, field.GetValue(parsed));
+            }
+        }
+
         float IRendererSettings.LodMultiplier => LodMultiplier;
         bool IRendererSettings.PerPixelLighting => PerPixelLighting;
         bool IRendererSettings.DynamicLighting => DynamicLighting;
