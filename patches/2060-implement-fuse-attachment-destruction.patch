+        private void DestroyHpAttachment(GameWorld world, FuseDestroyHpAttachment action)
+        {
+            var equipment = Parent.AllEquipment.Where(x => x.Attachment != null).ToArray();
+            if (equipment.Length == 0 || string.IsNullOrWhiteSpace(action.Hardpoint)) return;
+            var hardpointName = action.Hardpoint.Equals("random", StringComparison.OrdinalIgnoreCase)
+                ? SelectRandomHardpoint(equipment.Select(x => x.Attachment!.Name).Distinct(StringComparer.OrdinalIgnoreCase).ToArray(), Random.Shared.NextSingle())
+                : equipment.FirstOrDefault(x => x.Attachment!.Name.Equals(action.Hardpoint, StringComparison.OrdinalIgnoreCase))?.Attachment?.Name;
+            var item = equipment.FirstOrDefault(x => x.Attachment!.Name.Equals(hardpointName, StringComparison.OrdinalIgnoreCase));
+            if (item?.Attachment is not { } hardpoint) return;
+
+            if (action.Fate == FusePartFate.loot && item.Equipment.LootAppearance is { } lootAppearance)
+            {
+                var transform = hardpoint.Transform * Parent.WorldTransform;
+                world.Server?.SpawnLoot(lootAppearance, item.Equipment, 1, transform,
+                    initialImpulse: Random.Shared.NextUnitVector() * (40 + Random.Shared.NextSingle() * 60));
+            }
+
+            if (Parent.RemoveEquipment(hardpoint.Name, world))
+                world.Server?.OnEquipmentDestroyed(Parent, item, action.Fate == FusePartFate.debris);
+        }
+
+        internal static string? SelectRandomHardpoint(IReadOnlyList<string> hardpoints, float randomValue)
+        {
+            if (hardpoints.Count == 0) return null;
+            var normalized = MathHelper.Clamp(randomValue, 0, 1);
+            return hardpoints[Math.Min(hardpoints.Count - 1, (int)(normalized * hardpoints.Count))];
+        }
