+    public async Task<CharacterRosterEntryV1[]> ListCharactersAsync(string accessToken, Guid accountId,
+        Guid sessionId, CancellationToken cancellationToken = default)
+    {
+        if (string.IsNullOrWhiteSpace(accessToken) || accountId == Guid.Empty || sessionId == Guid.Empty)
+            throw new ArgumentException("Gateway access token, account and session are required.");
+        var request = new CharacterRosterRequestV1
+        {
+            CorrelationId = Guid.NewGuid(), AccountId = accountId, SessionId = sessionId
+        };
+        using var message = new HttpRequestMessage(HttpMethod.Post, new Uri(gateway, "/api/v1/characters/list"));
+        message.Headers.Authorization = new AuthenticationHeaderValue("Bearer", accessToken);
+        message.Content = JsonContent.Create(request);
+        using var response = await http.SendAsync(message, cancellationToken);
+        if (response.StatusCode == HttpStatusCode.Unauthorized)
+            throw new UnauthorizedAccessException("Gateway character roster rejected the active session.");
+        if (!response.IsSuccessStatusCode)
+            throw new HttpRequestException($"Gateway character roster failed with HTTP {(int)response.StatusCode}.");
+        var roster = await response.Content.ReadFromJsonAsync<CharacterRosterResultV1>(
+            cancellationToken: cancellationToken)
+            ?? throw new InvalidDataException("Gateway character roster response is empty.");
+        if (!roster.IsValid() || roster.CorrelationId != request.CorrelationId || !roster.Accepted)
+            throw new InvalidDataException("Gateway character roster response is invalid or rejected.");
+        return roster.Characters;
+    }
