@@ -177,10 +177,28 @@
             if (sunColor.R <= 0 && sunColor.G <= 0 && sunColor.B <= 0)
                 return ambient;
 
-            // Blend a bounded sun-colored contribution into the authored ambient.
+            // Tint the authored ambient while preserving its Rec. 709 luminance.
             var sunTintedAmbient = ambient * sunColor;
-            return ambient * (1f - sunTintBlend) + sunTintedAmbient * sunTintBlend;
+            var tintedAmbient = ambient * (1f - sunTintBlend) + sunTintedAmbient * sunTintBlend;
+            var ambientLuminance = GetLuminance(ambient);
+            var tintedLuminance = GetLuminance(tintedAmbient);
+            if (!float.IsFinite(ambientLuminance) || ambientLuminance <= 0 ||
+                !float.IsFinite(tintedLuminance) || tintedLuminance <= 0)
+                return ambient;
+
+            var luminanceScale = ambientLuminance / tintedLuminance;
+            var maximumChannel = Math.Max(tintedAmbient.R,
+                Math.Max(tintedAmbient.G, tintedAmbient.B));
+            // Freelancer ambient colors are normalized. Keep the new tint in that range
+            // because the current forward path has no HDR lighting buffer.
+            if (maximumChannel * luminanceScale > 1f)
+                luminanceScale = 1f / maximumChannel;
+
+            return tintedAmbient * luminanceScale;
         }
+
+        private static float GetLuminance(Color3f color) =>
+            color.R * 0.2126f + color.G * 0.7152f + color.B * 0.0722f;
 
