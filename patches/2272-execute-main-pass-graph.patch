+
+/// <summary>Schedules the executable SystemRenderer pass callbacks by resource and explicit dependencies.</summary>
+public sealed class SystemRenderPassGraph
+{
+    private sealed class Node
+    {
+        public string Name { get; }
+        public SystemRenderPass? Pass { get; }
+        public SystemRenderResource RequiredReads { get; }
+        public Action Execute { get; }
+        public string[] After { get; }
+        public int Priority { get; }
+
+        public Node(string name, SystemRenderPass? pass, SystemRenderResource requiredReads,
+            Action execute, string[] after, int priority)
+        {
+            Name = name;
+            Pass = pass;
+            RequiredReads = requiredReads;
+            Execute = execute;
+            After = after;
+            Priority = priority;
+        }
+    }
+
+    private const int ResourceBitCount = 32;
+    private const int InitialNodeCapacity = 16;
+    private readonly List<Node> nodes = new(InitialNodeCapacity);
+    private bool[,] edges = new bool[InitialNodeCapacity, InitialNodeCapacity];
+    private int[] indegree = new int[InitialNodeCapacity];
+    private readonly List<int>[] readers = new List<int>[ResourceBitCount];
+    private readonly List<int>[] writers = new List<int>[ResourceBitCount];
+    private bool[] executed = new bool[InitialNodeCapacity];
+
+    public SystemRenderPassGraph()
+    {
+        for (var i = 0; i < readers.Length; i++)
+        {
+            readers[i] = new List<int>(InitialNodeCapacity);
+            writers[i] = new List<int>(InitialNodeCapacity);
+        }
+    }
+
+    public int Count => nodes.Count;
+
+    public void Reset() => nodes.Clear();
+
+    public void AddPass(SystemRenderPass pass, Action execute,
+        SystemRenderResource requiredReads = SystemRenderResource.None, params string[] after)
+    {
+        var descriptor = SystemRenderPasses.Get(pass);
+        Add(new Node(descriptor.Name, pass, requiredReads, execute, after,
+            checked(descriptor.ExecutionOrder * 2)));
+    }
+
+    public void AddAction(string name, Action execute, int priority, params string[] after) =>
+        Add(new Node(name, null, SystemRenderResource.None, execute, after, priority));
+
+    private void Add(Node node)
+    {
+        if (node.Execute == null)
+            throw new ArgumentNullException(nameof(node.Execute));
+        foreach (var existing in nodes)
+            if (string.Equals(existing.Name, node.Name, StringComparison.Ordinal))
+                throw new InvalidOperationException($"Render graph node '{node.Name}' was added more than once.");
+        nodes.Add(node);
+    }
+
+    public void Execute(SystemRenderResource externalResources = SystemRenderResource.None)
+    {
+        var count = nodes.Count;
+        EnsureCapacity(count);
+        Array.Clear(edges);
+        Array.Clear(indegree);
+        Array.Clear(executed);
+        for (var i = 0; i < ResourceBitCount; i++)
+        {
+            readers[i].Clear();
+            writers[i].Clear();
+        }
+
+        void AddEdge(int from, int to)
+        {
+            if (from == to || edges[from, to])
+                return;
+            edges[from, to] = true;
+            indegree[to]++;
+        }
+
+        for (var i = 0; i < count; i++)
+        {
+            foreach (var dependency in nodes[i].After)
+            {
+                var found = -1;
+                for (var j = 0; j < count; j++)
+                    if (string.Equals(nodes[j].Name, dependency, StringComparison.Ordinal))
+                    {
+                        found = j;
+                        break;
+                    }
+                if (found < 0)
+                    throw new InvalidOperationException(
+                        $"Render graph node '{nodes[i].Name}' depends on missing node '{dependency}'.");
+                AddEdge(found, i);
+            }
+        }
+
+        for (var i = 0; i < count; i++)
+        {
+            var node = nodes[i];
+            var reads = node.RequiredReads;
+            var optionalReads = SystemRenderResource.None;
+            var writes = SystemRenderResource.None;
+            if (node.Pass is { } pass)
+            {
+                var descriptor = SystemRenderPasses.Get(pass);
+                reads |= descriptor.Reads;
+                optionalReads = descriptor.OptionalReads;
+                writes = descriptor.Writes;
+            }
+
+            for (var bit = 0; bit < ResourceBitCount; bit++)
+            {
+                var resource = (SystemRenderResource)(1u << bit);
+                if ((reads & resource) != 0)
+                    readers[bit].Add(i);
+                if ((writes & resource) != 0)
+                    writers[bit].Add(i);
+            }
+        }
+
+        for (var bit = 0; bit < ResourceBitCount; bit++)
+        {
+            var resource = (SystemRenderResource)(1u << bit);
+            var resourceReaders = readers[bit];
+            var resourceWriters = writers[bit];
+
+            for (var writerIndex = 1; writerIndex < resourceWriters.Count; writerIndex++)
+                AddEdge(resourceWriters[writerIndex - 1], resourceWriters[writerIndex]);
+
+            foreach (var reader in resourceReaders)
+            {
+                var previousWriter = -1;
+                var nextWriter = -1;
+                foreach (var writer in resourceWriters)
+                {
+                    if (writer < reader)
+                        previousWriter = writer;
+                    else if (writer > reader)
+                    {
+                        nextWriter = writer;
+                        break;
+                    }
+                }
+
+                if (previousWriter >= 0)
+                {
+                    AddEdge(previousWriter, reader);
+                    if (nextWriter >= 0)
+                        AddEdge(reader, nextWriter);
+                    continue;
+                }
+
+                if ((externalResources & resource) != 0)
+                {
+                    if (nextWriter >= 0)
+                        AddEdge(reader, nextWriter);
+                    continue;
+                }
+                if (nextWriter >= 0)
+                {
+                    AddEdge(nextWriter, reader);
+                    continue;
+                }
+
+                var node = nodes[reader];
+                var optionalReads = node.Pass is { } pass
+                    ? SystemRenderPasses.Get(pass).OptionalReads
+                    : SystemRenderResource.None;
+                if ((node.RequiredReads & resource) == 0 && (optionalReads & resource) != 0)
+                    continue;
+                throw new InvalidOperationException(
+                    $"Render graph node '{node.Name}' reads resource '{resource}' without a producer.");
+            }
+        }
+
+        for (var step = 0; step < count; step++)
+        {
+            var next = -1;
+            for (var i = 0; i < count; i++)
+            {
+                if (executed[i] || indegree[i] != 0)
+                    continue;
+                if (next < 0 || nodes[i].Priority < nodes[next].Priority ||
+                    (nodes[i].Priority == nodes[next].Priority && i < next))
+                    next = i;
+            }
+            if (next < 0)
+                throw new InvalidOperationException("Render graph contains a dependency cycle.");
+            nodes[next].Execute();
+            executed[next] = true;
+            for (var i = 0; i < count; i++)
+                if (edges[next, i]) indegree[i]--;
+        }
+    }
+
+    private void EnsureCapacity(int required)
+    {
+        if (required <= indegree.Length)
+            return;
+
+        var capacity = Math.Max(required, checked(indegree.Length * 2));
+        edges = new bool[capacity, capacity];
+        Array.Resize(ref indegree, capacity);
+        Array.Resize(ref executed, capacity);
+        foreach (var resourceReaders in readers)
+            resourceReaders.Capacity = Math.Max(resourceReaders.Capacity, capacity);
+        foreach (var resourceWriters in writers)
+            resourceWriters.Capacity = Math.Max(resourceWriters.Capacity, capacity);
+    }
+
+    public static string Name(SystemRenderPass pass) => SystemRenderPasses.Get(pass).Name;
 }
 
