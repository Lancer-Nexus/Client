+/// <summary>Checks the pass order and resource dependencies of one real frame.</summary>
+public sealed class SystemRenderPassExecution
+{
+    private static readonly SystemRenderPass[] RequiredPasses =
+    [SystemRenderPass.FrameClear, SystemRenderPass.Opaque, SystemRenderPass.Transparent];
+    private SystemRenderResource available;
+    private SystemRenderResource requiredBeforeTransparent;
+    private SystemRenderPass? activePass;
+    private int lastOrder = -1;
+    private uint completedMask;
+
+    private bool IsCompleted(SystemRenderPass pass) =>
+        (completedMask & (1u << (int)pass)) != 0;
+
+    public void Reset()
+    {
+        available = SystemRenderResource.None;
+        requiredBeforeTransparent = SystemRenderResource.None;
+        activePass = null;
+        lastOrder = -1;
+        completedMask = 0;
+    }
+
+    public void RequireBeforeTransparent(SystemRenderResource resources) =>
+        requiredBeforeTransparent |= resources;
+
+    public void Begin(SystemRenderPass pass)
+    {
+        if (activePass != null)
+            throw new InvalidOperationException(
+                $"Render pass '{SystemRenderPasses.Get(activePass.Value).Name}' is still active.");
+
+        var order = GetOrder(pass);
+        var descriptor = SystemRenderPasses.Get(pass);
+        if (order < lastOrder || IsCompleted(pass))
+            throw new InvalidOperationException(
+                $"Render pass '{descriptor.Name}' is out of order or was executed more than once.");
+
+        var prerequisite = pass switch
+        {
+            SystemRenderPass.SsaoDepthPrepass or SystemRenderPass.ParticleDepthPrepass or
+                SystemRenderPass.DepthPrepass or SystemRenderPass.ShadowMap or
+                SystemRenderPass.Opaque => SystemRenderPass.FrameClear,
+            SystemRenderPass.StarsAndNebula or SystemRenderPass.Transparent => SystemRenderPass.Opaque,
+            _ => (SystemRenderPass?)null
+        };
+        if (prerequisite is { } requiredPass && !IsCompleted(requiredPass))
+            throw new InvalidOperationException(
+                $"Render pass '{descriptor.Name}' requires '{SystemRenderPasses.Get(requiredPass).Name}' first.");
+
+        var required = descriptor.Reads & ~descriptor.OptionalReads;
+        if (pass == SystemRenderPass.Transparent)
+            required |= requiredBeforeTransparent;
+        var missing = required & ~available;
+        if (missing != SystemRenderResource.None)
+            throw new InvalidOperationException(
+                $"Render pass '{descriptor.Name}' reads unavailable frame resources {missing}.");
+
+        lastOrder = order;
+        activePass = pass;
+    }
+
+    public void End(SystemRenderPass pass)
+    {
+        if (activePass != pass)
+            throw new InvalidOperationException(
+                $"Render pass '{SystemRenderPasses.Get(pass).Name}' ended without a matching begin.");
+        available |= SystemRenderPasses.Get(pass).Writes;
+        completedMask |= 1u << (int)pass;
+        activePass = null;
+    }
+
+    public void CompleteFrame()
+    {
+        if (activePass != null)
+            throw new InvalidOperationException(
+                $"Render frame ended while pass '{SystemRenderPasses.Get(activePass.Value).Name}' was active.");
+        foreach (var required in RequiredPasses)
+        {
+            if (!IsCompleted(required))
+                throw new InvalidOperationException(
+                    $"Render frame ended before required pass '{SystemRenderPasses.Get(required).Name}'.");
+        }
+    }
+
+    private static int GetOrder(SystemRenderPass pass) => pass switch
+    {
+        SystemRenderPass.FrameClear => 0,
+        SystemRenderPass.SsaoDepthPrepass or SystemRenderPass.ParticleDepthPrepass => 1,
+        SystemRenderPass.DepthPrepass => 2,
+        SystemRenderPass.ShadowMap => 3,
+        SystemRenderPass.Opaque => 4,
+        SystemRenderPass.StarsAndNebula => 5,
+        SystemRenderPass.Transparent => 6,
+        _ => throw new InvalidOperationException(
+            $"Pass '{SystemRenderPasses.Get(pass).Name}' is not part of the SystemRenderer frame sequence.")
+    };
+}
 
