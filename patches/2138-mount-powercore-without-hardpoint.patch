--- a/src/LibreLancer/GameStates/SpaceGameplay.cs
+++ b/src/LibreLancer/GameStates/SpaceGameplay.cs
@@ -191,2 +191,3 @@ namespace LibreLancer
-            foreach (var equipment in session.Items.Where(x => !string.IsNullOrEmpty(x.Hardpoint)))
