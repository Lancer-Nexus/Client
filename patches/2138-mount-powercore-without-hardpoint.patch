+                         !string.IsNullOrEmpty(x.Hardpoint) || x.Equipment is PowerEquipment))
             {
diff --git a/patches/series b/patches/series
--- a/patches/series
+++ b/patches/series
@@ -140,0 +141 @@ client 2137-preserve-target-transfer-session.patch
+client 2138-mount-powercore-without-hardpoint.patch
