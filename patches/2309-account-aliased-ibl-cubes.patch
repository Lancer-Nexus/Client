@@ -0,0 +1,46 @@
+using System.Collections.Generic;
+using LibreLancer.Graphics;
+
+namespace LibreLancer.Resources;
+
+internal sealed class TextureMemoryLedger
+{
+    private readonly Dictionary<Texture, int> references = new(ReferenceEqualityComparer.Instance);
+
+    public long EstimatedBytes { get; private set; }
+
+    public void AddReference(Texture texture)
+    {
+        if (references.TryGetValue(texture, out var count))
+        {
+            references[texture] = checked(count + 1);
+            return;
+        }
+
+        references.Add(texture, 1);
+        EstimatedBytes = checked(EstimatedBytes + texture.EstimatedTextureMemory);
+    }
+
+    /// <summary>Removes one dictionary alias and returns true when it was the final alias.</summary>
+    public bool RemoveReference(Texture texture)
+    {
+        if (!references.TryGetValue(texture, out var count))
+            throw new KeyNotFoundException("Texture has no memory-ledger reference");
+
+        if (count > 1)
+        {
+            references[texture] = count - 1;
+            return false;
+        }
+
+        references.Remove(texture);
+        EstimatedBytes -= texture.EstimatedTextureMemory;
+        return true;
+    }
+
+    public void Clear()
+    {
+        references.Clear();
+        EstimatedBytes = 0;
+    }
+}
