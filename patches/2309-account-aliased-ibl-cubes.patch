+using LibreLancer.Graphics;
+using LibreLancer.Resources;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public class TextureMemoryLedgerTests
+{
+    private sealed class HeadlessGame() : Game(64, 64, false, GameConfiguration.HeadlessTest()) { }
+
+    [Fact]
+    public void AliasesCountTextureBytesOnceUntilLastAliasIsRemoved()
+    {
+        var context = new HeadlessGame().RenderContext;
+        using var texture = new TextureCube(context, 16, mipMap: true, format: SurfaceFormat.Bgra8);
+        var ledger = new TextureMemoryLedger();
+
+        ledger.AddReference(texture);
+        var oneAliasBytes = texture.EstimatedTextureMemory;
+        Assert.Equal(oneAliasBytes, ledger.EstimatedBytes);
+
+        ledger.AddReference(texture);
+        Assert.Equal(oneAliasBytes, ledger.EstimatedBytes);
+        Assert.False(ledger.RemoveReference(texture));
+        Assert.Equal(oneAliasBytes, ledger.EstimatedBytes);
+
+        Assert.True(ledger.RemoveReference(texture));
+        Assert.Equal(0, ledger.EstimatedBytes);
+    }
+
+    [Fact]
+    public void DistinctTexturesAreSummedIndependently()
+    {
+        var context = new HeadlessGame().RenderContext;
+        using var first = new TextureCube(context, 16, mipMap: false, format: SurfaceFormat.Bgra8);
+        using var second = new TextureCube(context, 32, mipMap: false, format: SurfaceFormat.Bgra8);
+        var ledger = new TextureMemoryLedger();
+
+        ledger.AddReference(first);
+        ledger.AddReference(second);
+
+        Assert.Equal((long)first.EstimatedTextureMemory + second.EstimatedTextureMemory,
+            ledger.EstimatedBytes);
+    }
+}
