+using System;
+using System.Numerics;
+using LibreLancer.Render.Cameras;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public class DirectionalShadowCameraTests
+{
+    [Fact]
+    public void SubTexelCameraMotionDoesNotSlideShadowProjection()
+    {
+        var source = new LookAtCamera();
+        source.Update(1280, 720, Vector3.Zero, new Vector3(0, 0, -1));
+        var shadow = new DirectionalShadowCamera();
+        var lightDirection = Vector3.Normalize(new Vector3(0.4f, -0.7f, 0.2f));
+
+        Assert.True(shadow.Fit(source, lightDirection, 1000, 1024, 0, 100));
+        var initial = Vector4.Transform(new Vector4(17, 4, -25, 1), shadow.ViewProjection);
+
+        var cameraMotion = new Vector3(0.05f, 0, 0);
+        source.Update(1280, 720, cameraMotion, cameraMotion + new Vector3(0, 0, -1));
+        Assert.True(shadow.Fit(source, lightDirection, 1000, 1024, 0, 100));
+        var moved = Vector4.Transform(new Vector4(17, 4, -25, 1), shadow.ViewProjection);
+
+        Assert.Equal(initial.X, moved.X, 6);
+        Assert.Equal(initial.Y, moved.Y, 6);
+    }
+
+    [Fact]
+    public void FittedCameraContainsDistanceLimitedSourceFrustumCorners()
+    {
+        var source = new LookAtCamera();
+        source.Update(1280, 720, new Vector3(120, -30, 50), new Vector3(120, -30, 49));
+        var shadow = new DirectionalShadowCamera();
+        var lightDirection = Vector3.Normalize(new Vector3(-0.6f, -0.3f, 0.8f));
+        const float maxDistance = 1500f;
+
+        Assert.True(shadow.Fit(source, lightDirection, maxDistance, 1024, 10, 100));
+        Assert.True(Matrix4x4.Invert(source.ViewProjection, out var inverseViewProjection));
+
+        for (var y = -1; y <= 1; y += 2)
+        for (var x = -1; x <= 1; x += 2)
+        {
+            Assert.True(TryUnproject(new Vector3(x, y, 0), inverseViewProjection, out var near));
+            Assert.True(TryUnproject(new Vector3(x, y, 1), inverseViewProjection, out var far));
+            var ray = Vector3.Normalize(far - source.Position);
+            var nearDistance = Math.Max(0, Vector3.Dot(near - source.Position, ray));
+            var farDistance = Math.Min(maxDistance, Vector3.Distance(far, source.Position));
+            var start = source.Position + ray * nearDistance;
+            var end = source.Position + ray * farDistance;
+
+            Assert.True(shadow.FrustumCheck(new BoundingSphere(start, 0.1f)));
+            Assert.True(shadow.FrustumCheck(new BoundingSphere(end, 0.1f)));
+        }
+    }
+
+    private static bool TryUnproject(Vector3 clip, Matrix4x4 inverse, out Vector3 world)
+    {
+        var result = Vector4.Transform(new Vector4(clip, 1), inverse);
+        if (Math.Abs(result.W) < 1e-7f)
+        {
+            world = default;
+            return false;
+        }
+        world = new Vector3(result.X, result.Y, result.Z) / result.W;
+        return true;
+    }
+}
