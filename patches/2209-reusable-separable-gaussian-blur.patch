diff --git a/src/LibreLancer.Base/Graphics/SeparableGaussianBlurPass.cs b/src/LibreLancer.Base/Graphics/SeparableGaussianBlurPass.cs
new file mode 100644
index 0000000..6d5f6fe
--- /dev/null
+++ b/src/LibreLancer.Base/Graphics/SeparableGaussianBlurPass.cs
@@ -0,0 +1,127 @@
+using System;
+using System.Numerics;
+
+namespace LibreLancer.Graphics;
+
+/// <summary>
+/// Reusable horizontal/vertical Gaussian blur for post-processing textures.
+/// The caller owns input extraction, output composition, and resolution policy.
+/// </summary>
+internal sealed class SeparableGaussianBlurPass : IDisposable
+{
+    private readonly RenderContext context;
+    private RenderTarget2D? horizontal;
+    private RenderTarget2D? blurred;
+    private int width;
+    private int height;
+    private SurfaceFormat format;
+    private bool failed;
+
+    public long EstimatedMemoryBytes =>
+        (horizontal?.EstimatedMemoryBytes ?? 0) + (blurred?.EstimatedMemoryBytes ?? 0);
+
+    public SeparableGaussianBlurPass(RenderContext context) => this.context = context;
+
+    public Texture2D? Process(Texture2D source, float radius, SurfaceFormat targetFormat)
+    {
+        radius = float.IsFinite(radius) ? Math.Clamp(radius, 0.25f, 4f) : 1f;
+        if (failed || source.Width <= 0 || source.Height <= 0)
+            return null;
+
+        if (width != source.Width || height != source.Height || format != targetFormat ||
+            horizontal == null || blurred == null)
+        {
+            DisposeTargets();
+            width = source.Width;
+            height = source.Height;
+            format = targetFormat;
+            try
+            {
+                horizontal = new RenderTarget2D(context, width, height, null, false, format);
+                blurred = new RenderTarget2D(context, width, height, null, false, format);
+            }
+            catch (Exception ex) when (ex is InvalidOperationException or NotSupportedException)
+            {
+                DisposeTargets();
+                failed = true;
+                FLLog.Warning("Graphics", $"Gaussian blur targets are unavailable; continuing without blur. {ex.Message}");
+                return null;
+            }
+        }
+
+        try
+        {
+            Draw(source, horizontal!, new Vector4(1f / source.Width, 0f, radius, 0f));
+            Draw(horizontal!.Texture, blurred!, new Vector4(0f, 1f / height, radius, 0f));
+        }
+        catch (Exception ex) when (ex is InvalidOperationException or NotSupportedException)
+        {
+            DisposeTargets();
+            failed = true;
+            FLLog.Warning("Graphics", $"Gaussian blur failed; continuing without blur. {ex.Message}");
+            return null;
+        }
+
+        return blurred!.Texture;
+    }
+
+    private void Draw(Texture2D source, RenderTarget2D target, Vector4 parameters)
+    {
+        var previousTarget = context.RenderTarget;
+        var previousTexture = context.Textures[0];
+        var previousSampler = context.Samplers[0];
+        var previousShader = context.Shader;
+        var previousBlend = context.BlendMode;
+        var previousDepth = context.DepthEnabled;
+        var previousDepthWrite = context.DepthWrite;
+        var previousColorWrite = context.ColorWrite;
+        var previousCull = context.Cull;
+        var previousStencil = context.Stencil;
+        var previousStencilEnabled = context.StencilEnabled;
+        var viewportPushed = false;
+        var scissorPushed = false;
+        try
+        {
+            context.RenderTarget = target;
+            context.PushViewport(0, 0, width, height);
+            viewportPushed = true;
+            scissorPushed = context.PushScissor(new Rectangle(0, 0, width, height), false);
+            context.DepthEnabled = false;
+            context.DepthWrite = false;
+            context.ColorWrite = true;
+            context.Cull = false;
+            context.StencilEnabled = false;
+            context.BlendMode = BlendMode.Opaque;
+            context.Textures[0] = source;
+            context.Samplers[0] = new SamplerState(TextureFiltering.Linear, WrapMode.ClampToEdge, WrapMode.ClampToEdge);
+            context.BloomBlurShader.SetUniformBlock(3, ref parameters);
+            context.Shader = context.BloomBlurShader;
+            context.FullScreenTriangle.Draw(PrimitiveTypes.TriangleList, 1);
+        }
+        finally
+        {
+            context.Textures[0] = previousTexture;
+            context.Samplers[0] = previousSampler;
+            context.Shader = previousShader;
+            context.BlendMode = previousBlend;
+            context.DepthEnabled = previousDepth;
+            context.DepthWrite = previousDepthWrite;
+            context.ColorWrite = previousColorWrite;
+            context.Cull = previousCull;
+            context.Stencil = previousStencil;
+            context.StencilEnabled = previousStencilEnabled;
+            if (scissorPushed) context.PopScissor();
+            if (viewportPushed) context.PopViewport();
+            context.RenderTarget = previousTarget;
+        }
+    }
+
+    private void DisposeTargets()
+    {
+        horizontal?.Dispose();
+        blurred?.Dispose();
+        horizontal = blurred = null;
+    }
+
+    public void Dispose() => DisposeTargets();
+}
