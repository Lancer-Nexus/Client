+    private static (IntPtr Buffer, IntPtr TransferBuffer) CreateVertexBuffer(IntPtr device,
+        byte[] vertices, int strideBytes)
+    {
+        if (strideBytes <= 0 || vertices.Length < strideBytes * 3 || vertices.Length % strideBytes != 0)
+            throw new ArgumentException("The SDL_GPU byte vertex buffer must contain complete vertices.", nameof(vertices));
+        return CreateUploadedBuffer(device, vertices, SDL3.SDL_GPUBufferUsageFlags.SDL_GPU_BUFFERUSAGE_VERTEX,
+            "vertex");
+    }
+
+    private static (IntPtr Buffer, IntPtr TransferBuffer) CreateStorageBuffer(IntPtr device, byte[] data)
+    {
+        if (data.Length == 0 || data.Length % 64 != 0)
+            throw new ArgumentException("The SDL_GPU bone storage buffer must contain complete 64-byte matrices.", nameof(data));
+        return CreateUploadedBuffer(device, data, SDL3.SDL_GPUBufferUsageFlags.SDL_GPU_BUFFERUSAGE_GRAPHICS_STORAGE_READ,
+            "bone storage");
+    }
+
+    private static unsafe (IntPtr Buffer, IntPtr TransferBuffer) CreateUploadedBuffer(IntPtr device,
+        byte[] bytes, SDL3.SDL_GPUBufferUsageFlags usage, string label)
+    {
+        var byteSize = checked((uint)bytes.Length);
+        var buffer = SDL3.SDL_CreateGPUBuffer(device, new SDL3.SDL_GPUBufferCreateInfo
+        {
+            usage = usage,
+            size = byteSize
+        });
+        if (buffer == IntPtr.Zero) throw Failure($"Creating the SDL_GPU {label} buffer failed");
+        var transfer = SDL3.SDL_CreateGPUTransferBuffer(device, new SDL3.SDL_GPUTransferBufferCreateInfo
+        {
+            usage = SDL3.SDL_GPUTransferBufferUsage.SDL_GPU_TRANSFERBUFFERUSAGE_UPLOAD,
+            size = byteSize
+        });
+        if (transfer == IntPtr.Zero)
+        {
+            SDL3.SDL_ReleaseGPUBuffer(device, buffer);
+            throw Failure($"Creating the SDL_GPU {label} upload buffer failed");
+        }
+        var mapped = SDL3.SDL_MapGPUTransferBuffer(device, transfer, false);
+        if (mapped == IntPtr.Zero)
+        {
+            SDL3.SDL_ReleaseGPUBuffer(device, buffer);
+            SDL3.SDL_ReleaseGPUTransferBuffer(device, transfer);
+            throw Failure($"Mapping the SDL_GPU {label} upload buffer failed");
+        }
+        fixed (byte* source = bytes)
+            Buffer.MemoryCopy(source, (void*)mapped, byteSize, byteSize);
+        SDL3.SDL_UnmapGPUTransferBuffer(device, transfer);
+
+        var commandBuffer = SDL3.SDL_AcquireGPUCommandBuffer(device);
+        if (commandBuffer == IntPtr.Zero)
+        {
+            SDL3.SDL_ReleaseGPUBuffer(device, buffer);
+            SDL3.SDL_ReleaseGPUTransferBuffer(device, transfer);
+            throw Failure($"Acquiring a command buffer for the SDL_GPU {label} upload failed");
+        }
+        var copyPass = SDL3.SDL_BeginGPUCopyPass(commandBuffer);
+        if (copyPass == IntPtr.Zero)
+        {
+            SDL3.SDL_CancelGPUCommandBuffer(commandBuffer);
+            SDL3.SDL_ReleaseGPUBuffer(device, buffer);
+            SDL3.SDL_ReleaseGPUTransferBuffer(device, transfer);
+            throw Failure($"Beginning the SDL_GPU {label} upload pass failed");
+        }
+        var sourceLocation = new SDL3.SDL_GPUTransferBufferLocation { transfer_buffer = transfer, offset = 0 };
+        var destination = new SDL3.SDL_GPUBufferRegion { buffer = buffer, offset = 0, size = byteSize };
+        SDL3.SDL_UploadToGPUBuffer(copyPass, sourceLocation, destination, false);
+        SDL3.SDL_EndGPUCopyPass(copyPass);
+        if (!SDL3.SDL_SubmitGPUCommandBuffer(commandBuffer))
+        {
+            SDL3.SDL_ReleaseGPUBuffer(device, buffer);
+            SDL3.SDL_ReleaseGPUTransferBuffer(device, transfer);
+            throw Failure($"Submitting the SDL_GPU {label} upload failed");
+        }
+        return (buffer, transfer);
+    }
