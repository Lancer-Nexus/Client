+        {
+            var pointIndex = mesh.PointIndices[i];
+            if ((uint)pointIndex >= mesh.Points.Length || (uint)pointIndex >= mesh.PointBoneFirst.Length ||
+                (uint)pointIndex >= mesh.PointBoneCount.Length || (uint)i >= mesh.UV0Indices.Length ||
+                (uint)pointIndex >= mesh.VertexNormals.Length || (uint)mesh.UV0Indices[i] >= mesh.UV0.Length)
+                throw new InvalidDataException($"DFM vertex data is incomplete at vertex {i}: {path}");
+            var first = mesh.PointBoneFirst[pointIndex];
+            var count = mesh.PointBoneCount[pointIndex];
+            if (count is < 0 or > 4 || first < 0 || first + count > mesh.BoneIdChain.Length ||
+                first + count > mesh.BoneWeightChain.Length)
+                throw new InvalidDataException($"DFM bone weights are invalid at vertex {i}: {path}");
+            ids.Clear();
+            weights.Clear();
+            weights[0] = 1.0f;
+            for (var j = 0; j < count; j++)
+            {
+                var id = mesh.BoneIdChain[first + j];
+                if ((uint)id > byte.MaxValue) throw new InvalidDataException($"DFM bone index {id} exceeds UBYTE4.");
+                ids[j] = (byte)id;
+                weights[j] = mesh.BoneWeightChain[first + j];
+            }
+            if (count == 0) weights[0] = 1.0f;
+            var uv1 = mesh.UV1Indices != null && mesh.UV1 != null &&
