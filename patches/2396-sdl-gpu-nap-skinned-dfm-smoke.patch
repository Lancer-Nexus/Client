+        var normalStrength = surface?.NormalStrength ?? 1.0f;
+        var tangentVertices = DfmTangentBuilder.Build(sourceVertices, selectedGroup,
+            surface?.NormalUvChannel ?? 0);
+        if (tangentVertices.Length < 3) throw new InvalidDataException($"DFM selected face group is empty: {path}");
+        foreach (var vertex in tangentVertices)
+        {
+            if (vertex.Vertex.BoneId1 >= boneMatrices.Length || vertex.Vertex.BoneId2 >= boneMatrices.Length ||
+                vertex.Vertex.BoneId3 >= boneMatrices.Length || vertex.Vertex.BoneId4 >= boneMatrices.Length)
+                throw new InvalidDataException($"DFM vertex references a missing skinning matrix: {path}");
+        }
+
+        Vector3 SkinPosition(DfmVertex v)
+        {
+            var p = new Vector4(v.Position, 1.0f);
+            var result = Vector4.Transform(p, boneMatrices[v.BoneId1]) * v.BoneWeights.X +
+                         Vector4.Transform(p, boneMatrices[v.BoneId2]) * v.BoneWeights.Y +
+                         Vector4.Transform(p, boneMatrices[v.BoneId3]) * v.BoneWeights.Z +
+                         Vector4.Transform(p, boneMatrices[v.BoneId4]) * v.BoneWeights.W;
+            return new Vector3(result.X, result.Y, result.Z);
+        }
+
+        var maxSkinDelta = 0.0f;
+        foreach (var vertex in tangentVertices)
+            maxSkinDelta = MathF.Max(maxSkinDelta, Vector3.Distance(vertex.Vertex.Position, SkinPosition(vertex.Vertex)));
+
+        var min = new Vector3(float.PositiveInfinity);
+        var max = new Vector3(float.NegativeInfinity);
+        foreach (var vertex in tangentVertices)
+        {
+            var position = SkinPosition(vertex.Vertex);
+            min = Vector3.Min(min, position);
+            max = Vector3.Max(max, position);
+        }
+        var center = (min + max) * 0.5f;
+        var extent = max - min;
