+        var world = Matrix4x4.CreateScale(scale) * Matrix4x4.CreateTranslation(-center * scale);
+        if (!Matrix4x4.Invert(world, out var inverseWorld)) throw new InvalidDataException($"DFM world matrix is singular: {path}");
+        var normalMatrix = Matrix4x4.Transpose(inverseWorld);
+        var coverage = new float[6];
+        var coverageArea = -1.0f;
+        for (var i = 0; i + 2 < tangentVertices.Length; i += 3)
+        {
+            var a = Vector3.Transform(SkinPosition(tangentVertices[i].Vertex), world);
+            var b = Vector3.Transform(SkinPosition(tangentVertices[i + 1].Vertex), world);
+            var c = Vector3.Transform(SkinPosition(tangentVertices[i + 2].Vertex), world);
+            var area = MathF.Abs((b.X - a.X) * (c.Y - a.Y) - (b.Y - a.Y) * (c.X - a.X));
+            if (area <= coverageArea) continue;
+            coverageArea = area;
+            coverage[0] = a.X;
+            coverage[1] = a.Y;
+            coverage[2] = b.X;
+            coverage[3] = b.Y;
+            coverage[4] = c.X;
+            coverage[5] = c.Y;
+        }
+        if (coverageArea <= 0) throw new InvalidDataException($"DFM has no non-degenerate projected triangle: {path}");
+
+        byte[]? ReadSurface(SurfaceTextureReference? reference) => reference == null || surfaceVfs == null
+            ? null
+            : SurfaceTextureReader.Read(surfaceVfs, reference).Data;
+        var diffuseImage = diffuseTexture.GetImageResource()!;
+        var diffuseColor = selectedMaterial.Dc;
+        return new DfmDraw(MemoryMarshal.AsBytes(tangentVertices.AsSpan()).ToArray(),
+            (uint)tangentVertices.Length, MemoryMarshal.AsBytes(boneMatrices.AsSpan()).ToArray(),
+            world, normalMatrix, coverage,
+            $"{path} DFM LOD0 material={selectedMaterial.Name} diffuse={selectedMaterial.DtName}, " +
+            $"dc=({diffuseColor.R:F3},{diffuseColor.G:F3},{diffuseColor.B:F3},{diffuseColor.A:F3}), " +
+            $"faceGroupCorners={tangentVertices.Length}, bones={boneMatrices.Length}, maxSkinDelta={maxSkinDelta:F6}" +
+            (surface?.Normal == null ? "" : $", surface={surface.Normal.File}:{surface.Normal.Node}"),
+            [diffuseColor.R, diffuseColor.G, diffuseColor.B, diffuseColor.A], diffuseImage.Data,
+            ReadSurface(surfaceEnabled ? surface?.Normal : null),
+            ReadSurface(surfaceEnabled ? surface?.RoughnessMap : null),
+            ReadSurface(surfaceEnabled ? surface?.MetallicMap : null), normalStrength,
+            surface?.Roughness ?? selectedMaterial.RFactor ?? 0.55f,
+            surface?.Metallic ?? selectedMaterial.MFactor ?? 0.0f);
+    }
 
