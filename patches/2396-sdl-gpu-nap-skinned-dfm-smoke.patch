+        if (boneMatrices.Length is 0 or > 200)
+            throw new InvalidDataException($"DFM has {boneMatrices.Length} bone matrices; production skinned materials support 1-200: {path}");
+
+        Material? selectedMaterial = null;
+        FaceGroup? selectedGroup = null;
+        TextureData? diffuseTexture = null;
+        SurfaceMaterialBinding? surface = null;
+        foreach (var group in mesh.FaceGroups.OrderByDescending(x => x.FaceIndices?.Length ?? x.TriangleStripIndices?.Length ?? 0))
+        {
+            if (string.IsNullOrWhiteSpace(group.MaterialName)) continue;
+            var material = dfm.MaterialLibrary?.Materials.Values.FirstOrDefault(x =>
+                string.Equals(x.Name, group.MaterialName, StringComparison.OrdinalIgnoreCase));
+            if (material?.DtName == null) continue;
+            var texture = dfm.TextureLibrary?.Textures.GetValueOrDefault(material.DtName);
+            if (texture?.GetImageResource() is not { Type: ImageType.DDS }) continue;
+            var candidateSurface = surfaceMaps != null ? SurfaceMaterialResolver.Resolve(material, surfaceMaps) : null;
+            // Prefer a real NAP Surface assignment over the largest unmapped group.
+            // DFM bodies often contain several similarly sized material groups.
+            if (selectedGroup != null && (surface != null || candidateSurface == null)) continue;
+            selectedGroup = group;
+            selectedMaterial = material;
+            diffuseTexture = texture;
+            surface = candidateSurface;
+            if (surface != null) break; // Groups are descending by size, so this is the largest mapped group.
+        }
+        if (selectedGroup == null || selectedMaterial == null || diffuseTexture == null)
+            throw new InvalidDataException($"DFM has no LOD0 material with embedded DDS diffuse: {path}");
