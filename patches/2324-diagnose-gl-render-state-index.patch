diff --git a/src/LibreLancer.Tests/GLTextureSlotCapacityTests.cs b/src/LibreLancer.Tests/GLTextureSlotCapacityTests.cs
new file mode 100644
index 000000000..b8c8fbc50
--- /dev/null
+++ b/src/LibreLancer.Tests/GLTextureSlotCapacityTests.cs
@@ -0,0 +1,25 @@
+using System.Reflection;
+using LibreLancer.Graphics;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public class GLTextureSlotCapacityTests
+{
+    [Fact]
+    public void OpenGlBindingCacheIncludesEverySharedTextureSlot()
+    {
+        const int PbrDetailTextureUnit = 8;
+        Assert.True(TextureSlots.Capacity > PbrDetailTextureUnit);
+
+        var bindType = typeof(TextureSlots).Assembly.GetType(
+            "LibreLancer.Graphics.Backends.OpenGL.GLBind");
+        Assert.NotNull(bindType);
+        var textureCache = bindType.GetField("textures",
+            BindingFlags.NonPublic | BindingFlags.Static);
+        Assert.NotNull(textureCache);
+
+        var slots = Assert.IsType<int[]>(textureCache.GetValue(null));
+        Assert.Equal(TextureSlots.Capacity, slots.Length);
+    }
+}


