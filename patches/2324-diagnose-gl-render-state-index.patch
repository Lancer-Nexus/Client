+        if ((uint)lastTextureApply >= (uint)textures.Length)
+            throw new InvalidOperationException($"OpenGL texture state high-water mark {lastTextureApply} exceeds slot capacity {textures.Length}");
         for (int i = 0; i <= lastTextureApply; i++)
         {
