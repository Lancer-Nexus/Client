From: Lancer Nexus
Subject: [PATCH] Fix OpenGL texture cache capacity for PBR slot 8





diff --git a/src/LibreLancer.Base/Graphics/Backends/OpenGL/GLBind.cs b/src/LibreLancer.Base/Graphics/Backends/OpenGL/GLBind.cs
--- a/src/LibreLancer.Base/Graphics/Backends/OpenGL/GLBind.cs
+++ b/src/LibreLancer.Base/Graphics/Backends/OpenGL/GLBind.cs
@@ -26,7 +26,14 @@ internal static class GLBind
         active_unit = -1;
     }
 
-    private static int[] textures = [-1, -1, -1, -1, -1, -1, -1, -1];
+    private static int[] textures = CreateTextureSlots();
     private static int active_unit = -1;
 
+    private static int[] CreateTextureSlots()
+    {
+        var slots = new int[LibreLancer.Graphics.TextureSlots.Capacity];
+        for (int i = 0; i < slots.Length; i++) slots[i] = -1;
+        return slots;
+    }
+
 
     public static void BindTexture(int unit, int target, uint texture)




