+        private static double[] Percentiles(double[] samples, int count)
+        {
+            var ordered = new double[count];
+            Array.Copy(samples, ordered, count);
+            Array.Sort(ordered);
+            static double At(double[] values, double percentile) =>
+                values[(int)Math.Ceiling((values.Length - 1) * percentile)];
