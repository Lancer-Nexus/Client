diff --git a/src/LibreLancer.Tests/TransientLightTests.cs b/src/LibreLancer.Tests/TransientLightTests.cs
new file mode 100644
--- /dev/null
+++ b/src/LibreLancer.Tests/TransientLightTests.cs
@@ -0,0 +1,73 @@
+using System.Numerics;
+using LibreLancer.Data.GameData;
+using LibreLancer.Render;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public sealed class TransientLightTests
+{
+    [Fact]
+    public void DirectPreviewLightingUsesPersistentSourcesWithoutFrameSetup()
+    {
+        var lighting = new SystemLighting();
+        var source = CreateLight(1);
+        lighting.Lights.Add(source);
+
+        Assert.Same(lighting.Lights, lighting.FrameLights);
+    }
+
+    [Fact]
+    public void FrameLightBudgetKeepsNearestLights()
+    {
+        var lighting = new SystemLighting();
+        lighting.BeginFrame(Vector3.Zero);
+
+        for (var i = 1; i <= SystemLighting.MaxFrameLights; i++)
+            Assert.True(lighting.AddFrameLight(CreateLight(i)));
+
+        Assert.True(lighting.AddFrameLight(CreateLight(0.5f)));
+
+        Assert.Equal(SystemLighting.MaxFrameLights, lighting.FrameLights.Count);
+        Assert.Contains(lighting.FrameLights, x => x.Light.Position.X == 0.5f);
+        Assert.DoesNotContain(lighting.FrameLights, x => x.Light.Position.X == SystemLighting.MaxFrameLights);
+    }
+
+    [Fact]
+    public void DynamicLightingSettingDisablesFrameLights()
+    {
+        var lighting = new SystemLighting { DynamicLightsEnabled = false };
+        lighting.BeginFrame(Vector3.Zero);
+
+        Assert.False(lighting.AddFrameLight(CreateLight(1)));
+        Assert.Empty(lighting.FrameLights);
+    }
+
+    [Fact]
+    public void ObjectLightingSelectsNearestEightMatchingLights()
+    {
+        var lighting = new SystemLighting();
+        lighting.BeginFrame(Vector3.Zero);
+        for (var i = 1; i <= 10; i++)
+            lighting.AddFrameLight(CreateLight(i));
+
+        var selected = RenderHelpers.ApplyLights(lighting, 0, Vector3.Zero, 0, null).Lights.SourceEnabled;
+
+        for (var i = 0; i < 8; i++)
+            Assert.True(selected[i]);
+        Assert.False(selected[8]);
+        Assert.False(selected[9]);
+    }
+
+    private static DynamicLight CreateLight(float distance) => new()
+    {
+        Light = new RenderLight
+        {
+            Kind = LightKind.Point,
+            Position = new Vector3(distance, 0, 0),
+            Range = 100,
+            Attenuation = Vector3.One,
+            Color = Color3f.White
+        }
+    };
+}
