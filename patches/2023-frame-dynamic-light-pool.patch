 {
 	public class SystemLighting
 	{
+        public const int MaxFrameLights = 32;
+
         public int ID = Environment.TickCount;
 		public Color4 Ambient = Color4.Black;
 		public List<DynamicLight> Lights = [];
+		private readonly List<DynamicLight> frameLights = new(64);
+		private bool frameStarted;
+		public List<DynamicLight> FrameLights => frameStarted ? frameLights : Lights;
 		public bool DynamicLightsEnabled = true;
 		public FogModes FogMode = FogModes.None;
 		public float FogDensity = 0f;
 		public Color4 FogColor = Color4.Black;
 		public Vector2 FogRange = Vector2.Zero;
 		public int NumberOfTilesX;
+
+        private int transientStart;
+        private Vector3 frameCameraPosition;
+
+        public void BeginFrame(Vector3 cameraPosition)
+        {
+            frameCameraPosition = cameraPosition;
+            frameLights.Clear();
+            var persistentCount = Math.Min(Lights.Count, BitArray128.Capacity);
+            for (var i = 0; i < persistentCount; i++)
+                frameLights.Add(Lights[i]);
+            transientStart = frameLights.Count;
+            frameStarted = true;
+        }
+
+        public bool AddFrameLight(DynamicLight light)
+        {
+            if (!DynamicLightsEnabled || !light.Active)
+                return false;
+
+            if (!frameStarted)
+                BeginFrame(frameCameraPosition);
+
+            if (frameLights.Count >= BitArray128.Capacity)
+                return false;
+
+            var transientCount = frameLights.Count - transientStart;
+            if (transientCount < MaxFrameLights)
+            {
+                frameLights.Add(light);
+                return true;
+            }
+
+            var lightPosition = light.Light.Position;
+            var distance = Vector3.DistanceSquared(frameCameraPosition, lightPosition);
+            var farthestIndex = transientStart;
+            var farthestDistance = Vector3.DistanceSquared(frameCameraPosition,
+                frameLights[farthestIndex].Light.Position);
+            for (var i = transientStart + 1; i < frameLights.Count; i++)
+            {
+                var candidateDistance = Vector3.DistanceSquared(frameCameraPosition, frameLights[i].Light.Position);
+                if (candidateDistance > farthestDistance)
+                {
+                    farthestIndex = i;
+                    farthestDistance = candidateDistance;
+                }
+            }
+
+            if (distance >= farthestDistance)
+                return false;
+
+            frameLights[farthestIndex] = light;
+            return true;
+        }
 	}
 }
