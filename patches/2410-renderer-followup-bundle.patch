@@ -56,17 +56,31 @@
 
     public void RemoveAt(int segment, int index)
     {
+        ref var b = ref segments[segment];
+        if (index < 0 || index >= b.Count)
+            throw new ArgumentOutOfRangeException("index");
         if (index == 0) {
             Dequeue(segment);
             return;
         }
-        ref var b = ref segments[segment];
-        if (index < 0 || index >= b.Count)
-            throw new ArgumentOutOfRangeException("index");
-        for (int i = index; i < b.Count - 1; i++)
-            this[segment, i] = this[segment, i + 1];
-        this[segment, b.Count - 1] = default;
-        b.Head = b.Head - 1 < 0 ? (b.Capacity - 1) : b.Head - 1;
+
+        var suffixCount = b.Count - index - 1;
+        if (index < suffixCount)
+        {
+            // Preserve queue order while shifting the shorter prefix toward the removed slot.
+            for (int i = index; i > 0; i--)
+                this[segment, i] = this[segment, i - 1];
+            this[segment, 0] = default;
+            b.Tail = (b.Tail + 1) % b.Capacity;
+        }
+        else
+        {
+            // Preserve queue order while shifting the shorter suffix toward the removed slot.
+            for (int i = index; i < b.Count - 1; i++)
+                this[segment, i] = this[segment, i + 1];
+            this[segment, b.Count - 1] = default;
+            b.Head = b.Head - 1 < 0 ? (b.Capacity - 1) : b.Head - 1;
+        }
         b.Count--;
     }
 
