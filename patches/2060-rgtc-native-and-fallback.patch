new file mode 100644
--- /dev/null
+++ b/src/LibreLancer.Base/Graphics/Rgtc.cs
@@ -0,0 +1,76 @@
+using System;
+using System.Buffers.Binary;
+
+namespace LibreLancer.Graphics;
+
+/// <summary>CPU expansion for BC4/BC5 textures on devices without RGTC support.</summary>
+public static class Rgtc
+{
+    public static byte[] Decompress(SurfaceFormat format, int width, int height, ReadOnlySpan<byte> input)
+    {
+        if (format is not (SurfaceFormat.Rgtc1 or SurfaceFormat.Rgtc2))
+            throw new ArgumentOutOfRangeException(nameof(format));
+        if (width < 1 || height < 1)
+            throw new ArgumentOutOfRangeException(nameof(width));
+        var channels = format == SurfaceFormat.Rgtc1 ? 1 : 2;
+        var blockBytes = channels * 8;
+        var blocksX = (width + 3) / 4;
+        var blocksY = (height + 3) / 4;
+        if (input.Length != blocksX * blocksY * blockBytes)
+            throw new ArgumentException("BC4/BC5 block payload length does not match dimensions", nameof(input));
+
+        // The OpenGL fallback uploads BGRA bytes. Put BC5's first block in R
+        // and second block in G so shader channel semantics match native RGTC.
+        var output = new byte[checked(width * height * 4)];
+        Span<byte> red = stackalloc byte[16];
+        Span<byte> green = stackalloc byte[16];
+        var sourceOffset = 0;
+        for (var by = 0; by < blocksY; by++)
+        for (var bx = 0; bx < blocksX; bx++)
+        {
+            DecodeChannel(input.Slice(sourceOffset, 8), red);
+            sourceOffset += 8;
+            if (channels == 2)
+            {
+                DecodeChannel(input.Slice(sourceOffset, 8), green);
+                sourceOffset += 8;
+            }
+            for (var y = 0; y < 4; y++)
+            for (var x = 0; x < 4; x++)
+            {
+                var px = bx * 4 + x;
+                var py = by * 4 + y;
+                if (px >= width || py >= height) continue;
+                var pixel = (py * width + px) * 4;
+                output[pixel] = 0; // B
+                output[pixel + 1] = channels == 2 ? green[y * 4 + x] : (byte)0; // G
+                output[pixel + 2] = red[y * 4 + x]; // R
+                output[pixel + 3] = 255; // A
+            }
+        }
+        return output;
+    }
+
+    private static void DecodeChannel(ReadOnlySpan<byte> block, Span<byte> output)
+    {
+        Span<byte> palette = stackalloc byte[8];
+        palette[0] = block[0];
+        palette[1] = block[1];
+        if (palette[0] > palette[1])
+        {
+            for (var i = 1; i <= 6; i++)
+                palette[i + 1] = (byte)(((7 - i) * palette[0] + i * palette[1]) / 7);
+        }
+        else
+        {
+            for (var i = 1; i <= 4; i++)
+                palette[i + 1] = (byte)(((5 - i) * palette[0] + i * palette[1]) / 5);
+            palette[6] = 0;
+            palette[7] = 255;
+        }
+
+        ulong indices = 0;
+        for (var i = 0; i < 6; i++) indices |= (ulong)block[i + 2] << (8 * i);
+        for (var i = 0; i < 16; i++) output[i] = palette[(int)((indices >> (3 * i)) & 7)];
+    }
+}
