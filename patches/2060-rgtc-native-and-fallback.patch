@@ -0,0 +1,57 @@
+using System;
+using LibreLancer.Graphics;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public class RgtcTests
+{
+    static void SetSelector(byte[] block,int blockOffset,int selector)
+    {
+        ulong indices=0;
+        for(var i=0;i<16;i++)indices|=(ulong)selector<<(3*i);
+        for(var i=0;i<6;i++)block[blockOffset+2+i]=(byte)(indices>>(8*i));
+    }
+
+    [Fact]
+    public void ExpandsBc4ToRedAndClipsPartialBlocks()
+    {
+        var block=new byte[8];
+        block[0]=10; block[1]=200;
+        SetSelector(block,0,1); // selector 1 -> endpoint 200
+        var rgba=Rgtc.Decompress(SurfaceFormat.Rgtc1,3,2,block);
+        Assert.Equal(3*2*4,rgba.Length);
+        for(var pixel=0;pixel<6;pixel++)
+        {
+            Assert.Equal(0,rgba[pixel*4]);
+            Assert.Equal(0,rgba[pixel*4+1]);
+            Assert.Equal(200,rgba[pixel*4+2]);
+            Assert.Equal(255,rgba[pixel*4+3]);
+        }
+    }
+
+    [Fact]
+    public void ExpandsBc5ChannelsIntoRedAndGreen()
+    {
+        var blocks=new byte[16];
+        blocks[0]=10; blocks[1]=200;
+        blocks[8]=250; blocks[9]=20;
+        SetSelector(blocks,0,1); // R selector 1 -> endpoint 200
+        Array.Fill(blocks,(byte)0xff,10,6); // G selector 7 -> final interpolated palette entry
+        var rgba=Rgtc.Decompress(SurfaceFormat.Rgtc2,4,4,blocks);
+        for(var pixel=0;pixel<16;pixel++)
+        {
+            Assert.Equal(0,rgba[pixel*4]);
+            Assert.Equal(52,rgba[pixel*4+1]);
+            Assert.Equal(200,rgba[pixel*4+2]);
+            Assert.Equal(255,rgba[pixel*4+3]);
+        }
+    }
+
+    [Fact]
+    public void RejectsUnsupportedFormatsAndTruncatedBlocks()
+    {
+        Assert.Throws<ArgumentOutOfRangeException>(()=>Rgtc.Decompress(SurfaceFormat.Dxt5,4,4,new byte[16]));
+        Assert.Throws<ArgumentException>(()=>Rgtc.Decompress(SurfaceFormat.Rgtc2,4,4,new byte[8]));
+    }
+}
