From: Lancer Nexus
Subject: [PATCH] Return safely to menu when player ship has no powercore

diff --git a/src/LibreLancer/GameStates/SpaceGameplay.cs b/src/LibreLancer/GameStates/SpaceGameplay.cs
--- a/src/LibreLancer/GameStates/SpaceGameplay.cs
+++ b/src/LibreLancer/GameStates/SpaceGameplay.cs
@@ -205,7 +205,8 @@ namespace LibreLancer
                 var receivedEquipment = string.Join(", ", session.Items.Select(x =>
                     $"{x.Equipment?.Nickname ?? "<unresolved>"}@{x.Hardpoint ?? "<none>"}:{x.Equipment?.GetType().Name ?? "<unresolved>"}"));
                 FLLog.Error("Client", $"No powercore component after mounting player equipment. Ship: {session.PlayerShip.Nickname}; received equipment: {receivedEquipment}");
-                throw new Exception("Player launched without a powercore equipped!");
+                session.QuitToMenu();
+                return;
             }
 
             _chaseCamera = new ChaseCamera(Game.RenderContext.CurrentViewport, Game.GameData.Items.Ini.Cameras);
diff --git a/patches/series b/patches/series
--- a/patches/series
+++ b/patches/series
@@ -167,1 +167,2 @@ client 2165-add-quote-bound-dynamic-market-trades.patch
 client 2166-block-launch-without-powercore.patch
+client 2167-return-to-menu-without-powercore.patch
