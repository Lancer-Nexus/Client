diff --git a/src/LibreLancer.Tests/DynamicAsteroidParticleEffectTests.cs b/src/LibreLancer.Tests/DynamicAsteroidParticleEffectTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..b60d5dc72e6cc7bb7fd4255389852f64095bd2e5
--- /dev/null
+++ b/src/LibreLancer.Tests/DynamicAsteroidParticleEffectTests.cs
@@ -0,0 +1,38 @@
+using LibreLancer.Data.Ini;
+using LibreLancer.Data.Schema.Solar;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public class DynamicAsteroidParticleEffectTests
+{
+    [Theory]
+    [InlineData("gf_blsmallasteroid")]
+    [InlineData("gf_dynamiclavaast")]
+    public void ParsesDynamicAsteroidParticleEffect(string nickname)
+    {
+        var section = new Section("DynamicAsteroid");
+        Add(section, "nickname", "test_dynamic_asteroid");
+        Add(section, "particle_effect", nickname);
+
+        Assert.True(DynamicAsteroid.TryParse(section, out var asteroid));
+        Assert.Equal(nickname, asteroid!.ParticleEffect);
+    }
+
+    [Fact]
+    public void ParticleEffectRemainsOptional()
+    {
+        var section = new Section("DynamicAsteroid");
+        Add(section, "nickname", "test_dynamic_asteroid");
+
+        Assert.True(DynamicAsteroid.TryParse(section, out var asteroid));
+        Assert.Null(asteroid!.ParticleEffect);
+    }
+
+    private static void Add(Section section, string key, string value)
+    {
+        var entry = new Entry(section, key);
+        entry.Add(value);
+        section.Add(entry);
+    }
+}
