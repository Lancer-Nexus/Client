+        private readonly record struct SurfaceMaterialRow(string Owner, string MaterialName, uint Crc);
+
+        private IEnumerable<SurfaceMaterialRow> EnumerateSurfaceMaterialRows()
+        {
+            var seen = new HashSet<(string Owner, uint Crc)>();
+            if (vmsModel != null)
+            {
+                foreach (var part in vmsModel.AllParts)
+                {
+                    if (part.Mesh?.Levels == null) continue;
+                    var owner = part.Name ?? part.Path ?? "Model";
+                    foreach (var level in part.Mesh.Levels)
+                    {
+                        if (level == null) continue;
+                        foreach (var drawcall in level.Drawcalls)
+                        {
+                            if (!seen.Add((owner, drawcall.MaterialCrc))) continue;
+                            var name = res.FindMaterial(drawcall.MaterialCrc)?.Name ?? "";
+                            yield return new SurfaceMaterialRow(owner, name, drawcall.MaterialCrc);
+                        }
+                    }
+                }
+            }
+            else if (drawable is DF.DfmFile dfm)
+            {
+                foreach (var (levelNumber, level) in dfm.Levels.OrderBy(x => x.Key))
+                {
+                    foreach (var group in level.FaceGroups)
+                    {
+                        if (string.IsNullOrWhiteSpace(group.MaterialName)) continue;
+                        var name = group.MaterialName;
+                        var crc = CrcTool.FLModelCrc(name);
+                        var owner = $"LOD {levelNumber}";
+                        if (seen.Add((owner, crc)))
+                            yield return new SurfaceMaterialRow(owner, name, crc);
+                    }
+                }
+            }
+        }
+
