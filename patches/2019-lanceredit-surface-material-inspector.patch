+            ImGui.TextDisabled($"Loaded catalog: {res.SurfaceMaps.Libraries.Count} libraries, " +
+                               $"{res.SurfaceMaps.NormalMaps.Count} normal-map mappings, " +
+                               $"{res.SurfaceMaps.CubeMaps.Count} cubemaps");
+            if (res.SurfaceMaps.Diagnostics.Count > 0 && ImGui.TreeNode($"Catalog diagnostics ({res.SurfaceMaps.Diagnostics.Count})"))
+            {
+                foreach (var diagnostic in res.SurfaceMaps.Diagnostics)
+                    ImGui.TextWrapped(diagnostic);
+                ImGui.TreePop();
+            }
+
+            var rows = EnumerateSurfaceMaterialRows().ToArray();
+            if (rows.Length == 0)
+            {
+                ImGui.TextDisabled("No material assignments are available for this model.");
+                return;
+            }
+
+            for (int i = 0; i < rows.Length; i++)
+            {
+                var row = rows[i];
+                var material = res.FindMaterial(row.Crc);
+                var displayName = material?.Name ??
+                                  (string.IsNullOrWhiteSpace(row.MaterialName) ? "Unknown material" : row.MaterialName);
+                ImGui.PushID(i);
+                if (ImGui.TreeNode($"{row.Owner}: {displayName} (0x{row.Crc:X8})"))
