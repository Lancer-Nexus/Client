+    private static int EstimateTextureMemory(int size, int levels, SurfaceFormat format, bool nativeCompression)
+    {
+        long bytesPerFace = 0;
+        for (var level = 0; level < levels; level++)
+        {
+            var dimension = Math.Max(size >> level, 1);
+            if (nativeCompression)
+            {
+                var blockBytes = format == SurfaceFormat.Dxt1 ? 8 : 16;
+                bytesPerFace += (long)((dimension + 3) / 4) * ((dimension + 3) / 4) * blockBytes;
+            }
+            else
+            {
+                var bytesPerPixel = glFormatBytes(format);
+                bytesPerFace += (long)dimension * dimension * bytesPerPixel;
+            }
+        }
+
+        return (int)Math.Min(bytesPerFace * 6, int.MaxValue);
+
+        static int glFormatBytes(SurfaceFormat value) => value switch
+        {
+            SurfaceFormat.Vector4 => 16,
+            SurfaceFormat.HdrBlendable or SurfaceFormat.HalfVector4 or SurfaceFormat.Vector2 or SurfaceFormat.Rgba64 => 8,
+            SurfaceFormat.HalfVector2 or SurfaceFormat.Single or SurfaceFormat.Rg32 or SurfaceFormat.NormalizedByte4 or
+                SurfaceFormat.Rgba1010102 or SurfaceFormat.Bgra8 or SurfaceFormat.Depth => 4,
+            SurfaceFormat.HalfSingle or SurfaceFormat.NormalizedByte2 or SurfaceFormat.Bgr565 or SurfaceFormat.Bgra4444 or
+                SurfaceFormat.Bgra5551 => 2,
+            SurfaceFormat.R8 => 1,
+            SurfaceFormat.Dxt1 or SurfaceFormat.Dxt3 or SurfaceFormat.Dxt5 => 4,
+            _ => throw new NotSupportedException($"Cannot estimate cubemap memory for {value}")
+        };
+    }
