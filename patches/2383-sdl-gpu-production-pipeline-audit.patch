+    public static unsafe int AuditProductionGraphicsPipelines()
+    {
+        if (!SDL3.Supported)
+        {
+            Console.Error.WriteLine("SDL_GPU production pipeline audit requires SDL3.");
+            return 2;
+        }
+
+        if (!SDL3.SDL_Init(SDL3.SDL_InitFlags.SDL_INIT_VIDEO))
+        {
+            Console.Error.WriteLine($"SDL video initialization failed: {SDL3.SDL_GetError()}");
+            return 1;
+        }
+
+        IntPtr window = IntPtr.Zero;
+        IntPtr device = IntPtr.Zero;
+        try
+        {
+            window = SDL3.SDL_CreateWindow("Lancer Nexus SDL_GPU pipeline audit", 64, 64,
+                SDL3.SDL_WindowFlags.SDL_WINDOW_HIDDEN);
+            if (window == IntPtr.Zero)
+                throw Failure("Audit window creation failed");
+
+            var shaderFormats = SDL3.SDL_GPUShaderFormat.SDL_GPU_SHADERFORMAT_SPIRV |
+                                SDL3.SDL_GPUShaderFormat.SDL_GPU_SHADERFORMAT_DXIL |
+                                SDL3.SDL_GPUShaderFormat.SDL_GPU_SHADERFORMAT_MSL;
+            device = SDL3.SDL_CreateGPUDevice(shaderFormats, false, null!);
+            if (device == IntPtr.Zero)
+                throw Failure("SDL_GPU device creation failed");
+            if ((SDL3.SDL_GetGPUShaderFormats(device) & SDL3.SDL_GPUShaderFormat.SDL_GPU_SHADERFORMAT_SPIRV) == 0)
+                throw new InvalidOperationException("The selected SDL_GPU driver does not support production SPIR-V shaders.");
+
+            Console.WriteLine($"SDL_GPU production pipeline audit driver: {SDL3.SDL_GetGPUDeviceDriver(device)}");
+            var assembly = Assembly.Load("LibreLancer");
+            var shaderCatalog = assembly.GetType("LibreLancer.Shaders.AllShaders", throwOnError: true)!;
+            var bundles = shaderCatalog.GetFields(BindingFlags.Public | BindingFlags.Static)
+                .Where(field => field.FieldType == typeof(ShaderBundle))
+                .OrderBy(field => field.Name, StringComparer.Ordinal)
+                .ToArray();
+            if (bundles.Length == 0)
+                throw new InvalidDataException("The built-in shader catalog contains no shader bundles.");
+
+            var totalVariants = 0;
+            foreach (var field in bundles)
+            {
+                var resourceName = field.Name + ".bin";
+                using var stream = assembly.GetManifestResourceStream(resourceName)
+                                   ?? throw new FileNotFoundException($"Missing embedded production shader bundle {resourceName}.");
+                var bundle = BytecodesBundle.FromStream(stream);
+                var pipelinesCreated = 0;
+                for (var index = 0; index < bundle.ShaderCount; index++)
+                {
+                    var shaderBytes = bundle.GetShader(index);
+                    if (shaderBytes.Length == 5 && shaderBytes.SequenceEqual("NULL\0"u8))
+                        continue;
+
+                    var features = bundle.GetFeatures(index);
+                    IntPtr vertexShader = IntPtr.Zero;
+                    IntPtr fragmentShader = IntPtr.Zero;
+                    IntPtr pipeline = IntPtr.Zero;
+                    try
+                    {
+                        var program = SDL3GpuShaderProgramReader.Parse(shaderBytes);
+                        var attributes = ReflectVertexAttributes(program.Vertex.Code, out var vertexStride);
+                        vertexShader = CreateSpirvShader(device, program.Vertex,
+                            SDL3.SDL_GPUShaderStage.SDL_GPU_SHADERSTAGE_VERTEX);
+                        fragmentShader = CreateSpirvShader(device, program.Fragment,
+                            SDL3.SDL_GPUShaderStage.SDL_GPU_SHADERSTAGE_FRAGMENT);
+                        pipeline = CreateProductionAuditPipeline(device, vertexShader, fragmentShader,
+                            attributes, vertexStride);
+                        pipelinesCreated++;
+                        totalVariants++;
+                    }
+                    catch (Exception exception)
+                    {
+                        throw new InvalidOperationException(
+                            $"SDL_GPU rejected production pipeline {field.Name}, feature mask 0x{features:X8}.", exception);
+                    }
+                    finally
+                    {
+                        if (pipeline != IntPtr.Zero)
+                            SDL3.SDL_ReleaseGPUGraphicsPipeline(device, pipeline);
+                        if (fragmentShader != IntPtr.Zero)
+                            SDL3.SDL_ReleaseGPUShader(device, fragmentShader);
+                        if (vertexShader != IntPtr.Zero)
+                            SDL3.SDL_ReleaseGPUShader(device, vertexShader);
+                    }
+                }
+
+                Console.WriteLine($"{field.Name}: {pipelinesCreated} production pipelines created.");
+            }
+
+            Console.WriteLine($"SDL_GPU production pipeline audit passed: {bundles.Length} bundles, " +
+                              $"{totalVariants} pipelines created and released.");
+            return totalVariants == 0 ? 1 : 0;
+        }
+        catch (Exception exception)
+        {
+            Console.Error.WriteLine($"SDL_GPU production pipeline audit failed: {exception}");
+            return 1;
+        }
+        finally
+        {
+            if (device != IntPtr.Zero)
+            {
+                SDL3.SDL_WaitForGPUIdle(device);
+                SDL3.SDL_DestroyGPUDevice(device);
+            }
+            if (window != IntPtr.Zero)
+                SDL3.SDL_DestroyWindow(window);
+            SDL3.SDL_Quit();
+        }
+    }
