+    private static SDL3.SDL_GPUVertexAttribute[] ReflectVertexAttributes(ReadOnlySpan<byte> spirv, out uint stride)
+    {
+        if (spirv.Length < 20 || (spirv.Length & 3) != 0)
+            throw new InvalidDataException("Production vertex shader has invalid SPIR-V size.");
+
+        var locations = new Dictionary<uint, uint>();
+        var pointers = new Dictionary<uint, (uint StorageClass, uint Pointee)>();
+        var scalarTypes = new Dictionary<uint, (bool IsFloat, bool IsSigned, uint Width)>();
+        var vectorTypes = new Dictionary<uint, (uint ComponentType, uint ComponentCount)>();
+        var variables = new List<(uint ResultType, uint ResultId, uint StorageClass)>();
+        var words = new uint[spirv.Length / sizeof(uint)];
+        for (var i = 0; i < words.Length; i++)
+            words[i] = BinaryPrimitives.ReadUInt32LittleEndian(spirv.Slice(i * sizeof(uint), sizeof(uint)));
+
+        for (var offset = 5; offset < words.Length;)
+        {
+            var wordCount = checked((int)(words[offset] >> 16));
+            var opcode = (ushort)words[offset];
+            if (wordCount == 0 || wordCount > words.Length - offset)
+                throw new InvalidDataException("Production vertex shader contains a malformed SPIR-V instruction.");
+
+            switch (opcode)
+            {
+                case 21 when wordCount >= 4: // OpTypeInt
+                    scalarTypes[words[offset + 1]] = (false, words[offset + 3] != 0, words[offset + 2]);
+                    break;
+                case 22 when wordCount >= 3: // OpTypeFloat
+                    scalarTypes[words[offset + 1]] = (true, false, words[offset + 2]);
+                    break;
+                case 23 when wordCount >= 4: // OpTypeVector
+                    vectorTypes[words[offset + 1]] = (words[offset + 2], words[offset + 3]);
+                    break;
+                case 32 when wordCount >= 4: // OpTypePointer
+                    pointers[words[offset + 1]] = (words[offset + 2], words[offset + 3]);
+                    break;
+                case 59 when wordCount >= 4: // OpVariable
+                    variables.Add((words[offset + 1], words[offset + 2], words[offset + 3]));
+                    break;
+                case 71 when wordCount >= 4 && (ushort)words[offset + 2] == 30: // OpDecorate Location
+                    locations[words[offset + 1]] = words[offset + 3];
+                    break;
+            }
+            offset += wordCount;
+        }
+
+        var reflected = new List<(uint Location, SDL3.SDL_GPUVertexElementFormat Format, uint Size)>();
+        foreach (var variable in variables)
+        {
+            if (variable.StorageClass != 1 || !locations.TryGetValue(variable.ResultId, out var location))
+                continue;
+            if (!pointers.TryGetValue(variable.ResultType, out var pointer) || pointer.StorageClass != 1)
+                throw new InvalidDataException($"Vertex input at location {location} has an unsupported pointer type.");
+
+            var componentType = pointer.Pointee;
+            uint componentCount = 1;
+            if (vectorTypes.TryGetValue(componentType, out var vector))
+            {
+                componentType = vector.ComponentType;
+                componentCount = vector.ComponentCount;
+            }
+            if (componentCount is < 1 or > 4 || !scalarTypes.TryGetValue(componentType, out var scalar) || scalar.Width != 32)
+                throw new InvalidDataException($"Vertex input at location {location} has an unsupported scalar/vector type.");
+
+            var format = (scalar.IsFloat, scalar.IsSigned, componentCount) switch
+            {
+                (true, _, 1) => SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_FLOAT,
+                (true, _, 2) => SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_FLOAT2,
+                (true, _, 3) => SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3,
+                (true, _, 4) => SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_FLOAT4,
+                (false, true, 1) => SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_INT,
+                (false, true, 2) => SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_INT2,
+                (false, true, 3) => SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_INT3,
+                (false, true, 4) => SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_INT4,
+                (false, false, 1) => SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_UINT,
+                (false, false, 2) => SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_UINT2,
+                (false, false, 3) => SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_UINT3,
+                (false, false, 4) => SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_UINT4,
+                _ => throw new InvalidDataException($"Vertex input at location {location} has an unsupported format.")
+            };
+            reflected.Add((location, format, componentCount * sizeof(uint)));
+        }
+
+        reflected.Sort((a, b) => a.Location.CompareTo(b.Location));
+        stride = 0;
+        var result = new SDL3.SDL_GPUVertexAttribute[reflected.Count];
+        for (var i = 0; i < reflected.Count; i++)
+        {
+            var attribute = reflected[i];
+            result[i] = new SDL3.SDL_GPUVertexAttribute
+            {
+                location = attribute.Location,
+                buffer_slot = 0,
+                format = attribute.Format,
+                offset = stride
+            };
+            stride = checked(stride + attribute.Size);
+        }
+        return result;
+    }
+
+    private static unsafe IntPtr CreateProductionAuditPipeline(IntPtr device, IntPtr vertexShader,
+        IntPtr fragmentShader, SDL3.SDL_GPUVertexAttribute[] attributes, uint vertexStride)
+    {
+        var colorTarget = new SDL3.SDL_GPUColorTargetDescription
+        {
+            format = SDL3.SDL_GPUTextureFormat.SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM,
+            blend_state = new SDL3.SDL_GPUColorTargetBlendState
+            {
+                color_write_mask = SDL3.SDL_GPUColorComponentFlags.SDL_GPU_COLORCOMPONENT_R |
+                                   SDL3.SDL_GPUColorComponentFlags.SDL_GPU_COLORCOMPONENT_G |
+                                   SDL3.SDL_GPUColorComponentFlags.SDL_GPU_COLORCOMPONENT_B |
+                                   SDL3.SDL_GPUColorComponentFlags.SDL_GPU_COLORCOMPONENT_A,
+                enable_color_write_mask = true
+            }
+        };
+        var buffer = new SDL3.SDL_GPUVertexBufferDescription
+        {
+            slot = 0,
+            pitch = vertexStride,
+            input_rate = SDL3.SDL_GPUVertexInputRate.SDL_GPU_VERTEXINPUTRATE_VERTEX
+        };
+        fixed (SDL3.SDL_GPUVertexAttribute* attributePointer = attributes)
+        {
+            var info = new SDL3.SDL_GPUGraphicsPipelineCreateInfo
+            {
+                vertex_shader = vertexShader,
+                fragment_shader = fragmentShader,
+                vertex_input_state = new SDL3.SDL_GPUVertexInputState
+                {
+                    vertex_buffer_descriptions = attributes.Length == 0 ? null : &buffer,
+                    num_vertex_buffers = attributes.Length == 0 ? 0u : 1u,
+                    vertex_attributes = attributePointer,
+                    num_vertex_attributes = (uint)attributes.Length
+                },
+                primitive_type = SDL3.SDL_GPUPrimitiveType.SDL_GPU_PRIMITIVETYPE_TRIANGLELIST,
+                rasterizer_state = new SDL3.SDL_GPURasterizerState
+                {
+                    fill_mode = SDL3.SDL_GPUFillMode.SDL_GPU_FILLMODE_FILL,
+                    cull_mode = SDL3.SDL_GPUCullMode.SDL_GPU_CULLMODE_NONE,
+                    front_face = SDL3.SDL_GPUFrontFace.SDL_GPU_FRONTFACE_COUNTER_CLOCKWISE,
+                    enable_depth_clip = true
+                },
+                multisample_state = new SDL3.SDL_GPUMultisampleState
+                {
+                    sample_count = SDL3.SDL_GPUSampleCount.SDL_GPU_SAMPLECOUNT_1
+                },
+                target_info = new SDL3.SDL_GPUGraphicsPipelineTargetInfo
+                {
+                    color_target_descriptions = &colorTarget,
+                    num_color_targets = 1
+                }
+            };
+            var pipeline = SDL3.SDL_CreateGPUGraphicsPipeline(device, info);
+            if (pipeline == IntPtr.Zero)
+                throw Failure("Creating an SDL_GPU production graphics pipeline failed");
+            return pipeline;
         }
     }
 
