+
+        private bool TryGetCullRadius(out float radius, int depth)
+        {
+            radius = 0;
+            if (depth > 16 || !IsFinite(Position))
+                return false;
+
+            if (!HasLiveChildEffects() && float.IsFinite(Effect.Radius) && Effect.Radius >= 0)
+            {
+                radius = Effect.Radius;
+                return true;
+            }
+
+            for (var appearanceIndex = 0; appearanceIndex < Effect.Appearances.Count; appearanceIndex++)
+            {
+                var appearanceNode = Effect.Appearances[appearanceIndex];
+                if (!appearanceNode.Enabled)
+                    continue;
+
+                var appearance = appearanceNode.Appearance;
+                var count = Buffer.GetCount(appearanceIndex);
+                if (appearance is FxParticleAppearance particleAppearance)
+                {
+                    if (particleAppearance.LifeEffect == null)
+                        continue;
+
+                    for (var particleIndex = 0; particleIndex < count; particleIndex++)
+                    {
+                        ref var particle = ref Buffer[appearanceIndex, particleIndex];
+                        if (!TryGetChildEffect(appearanceIndex, particle.Id, out var child))
+                            continue;
+                        if (!child.TryGetCullRadius(out var childRadius, depth + 1))
+                            return false;
+
+                        var childDistance = Vector3.Distance(Position, child.Position);
+                        if (!float.IsFinite(childDistance))
+                            return false;
+                        radius = Math.Max(radius, childDistance + childRadius);
+                    }
+
+                    continue;
+                }
+
+                // These appearances do not emit geometry in the current runtime.
+                if (appearance is FxMeshAppearance || appearance.GetType() == typeof(FxAppearance))
+                    continue;
+
+                if (!TryGetParticleExtent(appearance, out var extent))
+                    return false;
+
+                var nodeTransform = NodeTransforms[appearanceNode.NodeIdx];
+                var nodeOrigin = Vector3.Transform(Vector3.Zero, nodeTransform);
+                var nodeOffset = Vector3.Distance(Position, nodeOrigin);
+                if (!IsFinite(nodeOrigin) || !float.IsFinite(nodeOffset))
+                    return false;
+
+                for (var particleIndex = 0; particleIndex < count; particleIndex++)
+                {
+                    ref var particle = ref Buffer[appearanceIndex, particleIndex];
+                    var particleDistance = particle.Position.Length();
+                    var particleExtent = extent;
+                    if (appearance is FxBasicAppearance { MotionBlur: true })
+                    {
+                        var velocity = Vector3.TransformNormal(particle.Velocity, nodeTransform).Length();
+                        if (!float.IsFinite(velocity))
+                            return false;
+                        particleExtent += velocity * 0.03f;
+                    }
+
+                    if (!float.IsFinite(particleDistance) || !float.IsFinite(particleExtent))
+                        return false;
+                    radius = Math.Max(radius, nodeOffset + particleDistance + particleExtent);
+                }
+            }
+
+            return float.IsFinite(radius) && radius >= 0;
+        }
+
+        private static bool TryGetParticleExtent(FxAppearance appearance, out float extent)
+        {
+            switch (appearance)
+            {
+                case FLBeamAppearance beam:
+                    extent = beam.Width.GetMax(true) * 0.5f;
+                    break;
+                case FxRectAppearance rect:
+                {
+                    var scale = rect.Scale.GetMax(true);
+                    var length = rect.Length.GetMax(true) * scale;
+                    var width = rect.Width.GetMax(true) * scale;
+                    extent = length + MathF.Sqrt(length * length + width * width);
+                    break;
+                }
+                case FxOrientedAppearance oriented:
+                {
+                    var width = oriented.Width?.GetMax(true) ?? 1f;
+                    var height = oriented.Height?.GetMax(true) ?? 1f;
+                    extent = MathF.Sqrt(width * width + height * height);
+                    break;
+                }
+                case FxPerpAppearance perpendicular:
+                    extent = perpendicular.Size.GetMax(true);
+                    break;
+                case FxBasicAppearance basic:
+                {
+                    var size = basic.Size.GetMax(true);
+                    var aspect = basic.HToVAspect?.GetMax(true) ?? 1f;
+                    extent = MathF.Sqrt(size * size * aspect * aspect + size * size);
+                    break;
+                }
+                default:
+                    extent = 0;
+                    return false;
+            }
+
+            return float.IsFinite(extent) && extent >= 0;
+        }
+
+        private static bool IsFinite(Vector3 value) =>
+            float.IsFinite(value.X) && float.IsFinite(value.Y) && float.IsFinite(value.Z);
 
