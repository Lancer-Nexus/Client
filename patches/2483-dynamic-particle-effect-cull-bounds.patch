+        private bool HasLiveChildEffects()
+        {
+            for (var i = 0; i < Effect.Appearances.Count; i++)
+            {
+                if (Effect.Appearances[i].Appearance is FxParticleAppearance { LifeEffect: not null } &&
+                    Buffer.GetCount(i) > 0)
+                    return true;
+            }
+
+            return false;
