@@ -0,0 +1,87 @@
+using System;
+using System.Buffers.Binary;
+using System.IO;
+using LibreLancer.Graphics;
+using LibreLancer.ImageLib;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public class DdsHdrCubeTests
+{
+    private sealed class HeadlessGame : Game
+    {
+        public HeadlessGame() : base(64, 64, false, GameConfiguration.HeadlessTest()) { }
+    }
+
+    [Fact]
+    public void LoadsDx10Rgba16fCubemapAndConsumesAllMipFaces()
+    {
+        var context = new HeadlessGame().RenderContext;
+        var bytes = CreateCube();
+        using var stream = new MemoryStream(bytes);
+
+        var cube = Assert.IsType<TextureCube>(DDS.FromStream(context, stream));
+
+        Assert.Equal(4, cube.Size);
+        Assert.Equal(SurfaceFormat.HalfVector4, cube.Format);
+        Assert.Equal(bytes.Length, stream.Position);
+    }
+
+    [Fact]
+    public void RejectsTruncatedDx10Rgba16fCubePayload()
+    {
+        var context = new HeadlessGame().RenderContext;
+        var bytes = CreateCube();
+        using var stream = new MemoryStream(bytes, 0, bytes.Length - 1, writable: false);
+
+        Assert.Throws<EndOfStreamException>(() => DDS.FromStream(context, stream));
+    }
+
+    [Theory]
+    [InlineData(11, 1)] // Not RGBA16F.
+    [InlineData(10, 2)] // Texture arrays are not supported yet.
+    public void RejectsUnsupportedDx10CubeFormats(uint dxgiFormat, uint arraySize)
+    {
+        var context = new HeadlessGame().RenderContext;
+        using var stream = new MemoryStream(CreateCube(dxgiFormat: dxgiFormat, arraySize: arraySize));
+
+        Assert.Throws<NotSupportedException>(() => DDS.FromStream(context, stream));
+    }
+
+    private static byte[] CreateCube(uint dxgiFormat = 10, uint arraySize = 1)
+    {
+        const int width = 4;
+        const int height = 4;
+        const int mipCount = 2;
+        const int headerBytes = 148;
+        var faceBytes = 0;
+        var mipSize = width;
+        for (var level = 0; level < mipCount; level++)
+        {
+            faceBytes += mipSize * mipSize * 8;
+            mipSize = Math.Max(1, mipSize / 2);
+        }
+        var result = new byte[headerBytes + faceBytes * 6];
+        "DDS "u8.CopyTo(result);
+        Write(4, 124); // DDS_HEADER size
+        Write(8, 0x1u | 0x2u | 0x4u | 0x1000u | 0x20000u); // caps, dimensions, pixel format, mip count
+        Write(12, (uint)height);
+        Write(16, (uint)width);
+        Write(20, (uint)(width * height * 8));
+        Write(28, (uint)mipCount);
+        Write(76, 32); // DDS_PIXELFORMAT size
+        Write(80, 0x4); // FOURCC
+        Write(84, 0x30315844); // DX10
+        Write(108, 0x1000u | 0x8u | 0x400000u); // texture, complex, mipmap
+        Write(128, dxgiFormat);
+        Write(132, 3); // D3D10_RESOURCE_DIMENSION_TEXTURE2D
+        Write(136, 0x4); // D3D11_RESOURCE_MISC_TEXTURECUBE
+        Write(140, arraySize);
+        for (var i = headerBytes; i < result.Length; i += 2)
+            BinaryPrimitives.WriteUInt16LittleEndian(result.AsSpan(i, 2), 0x3C00); // Half-float 1.0
+        return result;
+
+        void Write(int offset, uint value) => BinaryPrimitives.WriteUInt32LittleEndian(result.AsSpan(offset, 4), value);
+    }
+}
