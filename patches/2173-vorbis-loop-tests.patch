@@ -0,0 +1,40 @@
+using System;
+using System.IO;
+using LibreLancer.Media;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public class AudioDecoderLoopTests
+{
+    [Theory]
+    [InlineData("AudioTestAssets/vorbis-bell.ogg", "vorbis")]
+    [InlineData("TestAssets/Audio/synthetic-flac.flac", "flac")]
+    public void DecoderCanReplayFromStartAfterTrackEnd(string relativePath, string expectedCodec)
+    {
+        var path = Path.Combine(AppContext.BaseDirectory, relativePath.Replace('/', Path.DirectorySeparatorChar));
+        using var decoder = new AudioDecoder(File.OpenRead(path));
+        Assert.True(decoder.GetString(AudioProperty.Codec, out var codec));
+        Assert.Equal(expectedCodec, codec);
+
+        var firstPlay = ReadToEnd(decoder);
+        Assert.NotEmpty(firstPlay);
+
+        decoder.Seek(0, SeekOrigin.Begin);
+        var secondPlay = ReadToEnd(decoder);
+        Assert.Equal(firstPlay, secondPlay);
+    }
+
+    private static byte[] ReadToEnd(AudioDecoder decoder)
+    {
+        var buffer = new byte[8192];
+        using var pcm = new MemoryStream();
+        while (true)
+        {
+            var read = decoder.Read(buffer, 0, buffer.Length);
+            if (read == 0)
+                return pcm.ToArray();
+            pcm.Write(buffer, 0, read);
+        }
+    }
+}
