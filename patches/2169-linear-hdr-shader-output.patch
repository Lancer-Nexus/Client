diff --git a/src/LibreLancer/Shaders/includes/OutputColor.hlsl b/src/LibreLancer/Shaders/includes/OutputColor.hlsl
new file mode 100644
index 0000000..079ddc1
--- /dev/null
+++ b/src/LibreLancer/Shaders/includes/OutputColor.hlsl
@@ -0,0 +1,26 @@
+cbuffer RenderColorSpace : register(b6, UNIFORM_SPACE)
+{
+    float4 RenderColorSpaceParameters;
+};
+
+float3 SRGBToLinearOutput(float3 srgb)
+{
+    float3 value = max(srgb, 0.0);
+    float3 low = value / 12.92;
+    float3 high = pow((value + 0.055) / 1.055, 2.4);
+    return lerp(low, high, step(0.04045, value));
+}
+
+float4 ToSceneOutput(float4 displayColor)
+{
+    if (RenderColorSpaceParameters.x > 0.5)
+        displayColor.rgb = SRGBToLinearOutput(displayColor.rgb);
+    return displayColor;
+}
+
+float4 ToDisplayOutput(float4 linearColor)
+{
+    if (RenderColorSpaceParameters.x < 0.5)
+        linearColor.rgb = pow(max(linearColor.rgb, 0.0), 1.0 / 2.2);
+    return linearColor;
+}
