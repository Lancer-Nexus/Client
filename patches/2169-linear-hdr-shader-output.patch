+    internal bool HdrOutputActive => requestedRenderTarget is AntialiasTarget { HdrOutputEnabled: true };
+
+    private void UpdateRenderColorSpace(Shader? shader)
+    {
+        if (shader == null || !shader.HasUniformBlock(RenderColorSpaceUniformBlock))
+            return;
+
+        var hdrOutput = HdrOutputActive;
+        var tag = RenderColorSpaceTagBase | (hdrOutput ? 1UL : 0UL);
+        if (shader.UniformBlockTag(RenderColorSpaceUniformBlock) == tag)
+            return;
+
+        var parameters = new Vector4(hdrOutput ? 1f : 0f, 0f, 0f, 0f);
+        shader.SetUniformBlock(RenderColorSpaceUniformBlock, ref parameters);
+        shader.UniformBlockTag(RenderColorSpaceUniformBlock) = tag;
+    }
