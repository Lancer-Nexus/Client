diff --git a/src/LibreLancer.Tests/SurfaceMapWorkspaceTests.cs b/src/LibreLancer.Tests/SurfaceMapWorkspaceTests.cs
new file mode 100644
index 000000000..0ac546442
--- /dev/null
+++ b/src/LibreLancer.Tests/SurfaceMapWorkspaceTests.cs
@@ -0,0 +1,34 @@
+using System;
+using System.IO;
+using LancerEdit;
+using LibreLancer.Data.Schema;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public class SurfaceMapWorkspaceTests
+{
+    [Fact]
+    public void ExplicitZeroPbrUvChannelSurvivesWorkspaceSaveAndReload()
+    {
+        var directory = Path.Combine(Path.GetTempPath(), "LancerSurfaceWorkspace-" + Guid.NewGuid().ToString("N"));
+        var file = Path.Combine(directory, "SurfaceMaps.ini");
+        try
+        {
+            var workspace = new SurfaceMapWorkspace("fx/SurfaceMaps.ini", file);
+            workspace.Set(new SurfaceNormalMap("hull.tga", "ships", "nm_hull", 1,
+                "rt_hull", null, "mt_hull", null, 1, 0));
+
+            var serialized = File.ReadAllText(file);
+            Assert.Contains("pbr_uv = 0", serialized);
+
+            var reloaded = new SurfaceMapWorkspace("fx/SurfaceMaps.ini", file);
+            Assert.Equal(1, reloaded.NormalMaps["hull.tga"].UvChannel);
+            Assert.Equal(0, reloaded.NormalMaps["hull.tga"].PbrUvChannel);
+        }
+        finally
+        {
+            if (Directory.Exists(directory)) Directory.Delete(directory, recursive: true);
+        }
+    }
+}
