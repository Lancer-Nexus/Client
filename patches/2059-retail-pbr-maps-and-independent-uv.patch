+    "surface_archive": "packages/data/surface.nap",
+    "surface_archive_verify_entries": 42,
+    "loose_DATA_directory": false
+  },
+  "scene": {
+    "model": "ships/liberty/li_elite/li_elite.cmp",
+    "basic_material_drawcalls": 19,
+    "selected_surface_binding_count": 5,
+    "camera": "fixed LookAtCamera at (0,0,7), looking at origin",
+    "lighting": "two identical directional lights facing the front hull and black ambient",
+    "normal_maps_enabled": false,
+    "pbr_environment_maps_enabled": false,
+    "surface_pbr_maps_enabled": true,
+    "material_scalar_roughness": 1.0,
+    "material_scalar_metallic": 1.0,
+    "normal_map_uv_channel": 0,
+    "pbr_map_uv_channel": 0,
+    "map_references": {
+      "roughness": {
+        "file": "EXE\\..\\data/fx\\normalmaps_ships.txm",
+        "node": "rt_li_elite_hull",
+        "format": "ATI1/BC4 R channel"
+      },
+      "metallic": {
+        "file": "EXE\\..\\data/fx\\normalmaps_ships.txm",
+        "node": "mt_li_elite_hull",
+        "format": "ATI1/BC4 R channel"
+      }
+    },
+    "control": "PBR remains active with the same scalar factors; map references are removed for scalar-only, then roughness, metallic, or both references are restored independently."
+  },
+  "linear_channel_evidence": {
+    "shader": "PBR.frag.hlsl getRoughness/getMetallic sample .r and multiply the scalar factor; the diffuse albedo alone uses SRGBtoLinear.",
+    "OpenGL_format": "ATI1 DDS maps load as SurfaceFormat.Rgtc1 and GL_COMPRESSED_RED_RGTC1_EXT, a linear single-channel format."
+  },
+  "comparison": {
+    "image_size": "512x512",
+    "metrics": {
+      "roughness_only_vs_scalar_only": {
+        "changed_pixels": 7188,
+        "changed_channels": 21443,
+        "rmse": 9.12853
+      },
+      "metallic_only_vs_scalar_only": {
+        "changed_pixels": 7090,
+        "changed_channels": 21062,
+        "rmse": 3.93823
+      },
+      "both_maps_vs_scalar_only": {
+        "changed_pixels": 7090,
+        "changed_channels": 21004,
+        "rmse": 7.612834
+      }
+    },
+    "gpu_cache_after_runs": {
+      "resident_bytes": 349520,
+      "entries": 2,
+      "active_leases": 0
+    },
+    "images": {
+      "li-elite-retail-pbr-scalar-only.png": {
+        "sha256": "b3bcf49173fcabf94ae050a89eda0dd3aa801b469df3edb291571f46286ed97e",
+        "size": 34046
+      },
+      "li-elite-retail-pbr-roughness.png": {
+        "sha256": "940f188e930117fc3b1bacec8b3db78988bafddfa7075d59d6d37f8e4222c8ad",
+        "size": 35652
+      },
+      "li-elite-retail-pbr-metallic.png": {
+        "sha256": "46e6cdf334961ea2124d9c00498e05f2f533f9016478a2478346a722f6d0a3a6",
+        "size": 35031
+      },
+      "li-elite-retail-pbr-both.png": {
+        "sha256": "7a596e54b066f7d2dd0a5eb038becb4ecd0fcd56f7e8dbdc2deddb824c688fb5",
+        "size": 35841
+      },
+      "li-elite-retail-pbr-maps-ab.png": {
+        "sha256": "6087a331e2ebbebf0b73bdaf0d6007b8d34f32f07d6e67034325826689d9f0dc",
+        "size": 84757
+      }
+    }
+  },
+  "interpretation": "Both real NAP BC4 maps are loaded into the production LI_ELITE retail mesh PBR path. Independent removal of each map changes rendered pixels while keeping the PBR shader and scalar factors fixed. This proves the shader consumes each R channel and the OpenGL upload is linear. This run used UV0 for both maps (uv=0 and pbr_uv=0); the independent pbr_uv selector is now implemented and covered by parser/resolver tests, but its UV1 GPU effect and the independent UV animation case remain unverified."
