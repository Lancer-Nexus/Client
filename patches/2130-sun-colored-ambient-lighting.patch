+        private static Color3f ApplySunAmbient(SystemLighting source, int lightGroup,
+            Vector3 center, float radius, Color3f ambient)
+        {
+            const float sunTintBlend = 0.25f;
+            var colorSum = Color3f.Black;
+            var weightSum = 0f;
+            foreach (var dynamicLight in source.SunAmbientLights)
+            {
+                if (!dynamicLight.Active || dynamicLight.LightGroup != lightGroup)
+                    continue;
+
+                var light = dynamicLight.Light;
+                var weight = GetSunAmbientWeight(light, center, radius);
+                if (weight <= 0 || !float.IsFinite(light.Color.R) || !float.IsFinite(light.Color.G) ||
+                    !float.IsFinite(light.Color.B))
+                    continue;
+
+                colorSum += new Color3f(Math.Max(0, light.Color.R), Math.Max(0, light.Color.G),
+                    Math.Max(0, light.Color.B)) * weight;
+                weightSum += weight;
+            }
+
+            if (weightSum <= 0 || !float.IsFinite(weightSum))
+                return ambient;
+
+            var sunColor = colorSum * (1f / weightSum);
+            if (sunColor.R <= 0 && sunColor.G <= 0 && sunColor.B <= 0)
+                return ambient;
+
+            // Blend a bounded sun-colored contribution into the authored ambient.
+            var sunTintedAmbient = ambient * sunColor;
+            return ambient * (1f - sunTintBlend) + sunTintedAmbient * sunTintBlend;
+        }
+
+        private static float GetSunAmbientWeight(RenderLight light, Vector3 center, float radius)
+        {
+            if (light.Kind == LightKind.Directional)
+                return 1f;
+
+            if (!float.IsFinite(light.Range) || light.Range <= 0)
+                return 0;
+            var distance = Math.Max(0, Vector3.Distance(light.Position, center) - Math.Max(0, radius));
+            if (!float.IsFinite(distance) || distance > light.Range)
+                return 0;
+
+            float denominator;
+            if (light.Kind == LightKind.PointAttenCurve)
+            {
+                var normalizedDistance = distance / Math.Max(light.Range, 1);
+                denominator = light.Attenuation.X * normalizedDistance * normalizedDistance +
+                              light.Attenuation.Y * normalizedDistance + light.Attenuation.Z;
+            }
+            else
+            {
+                denominator = light.Attenuation.X + light.Attenuation.Y * distance +
+                              light.Attenuation.Z * distance * distance;
+            }
+
+            if (!float.IsFinite(denominator) || denominator <= 0)
+                return 0;
+            var weight = 1f / denominator;
+            return float.IsFinite(weight) ? weight : 0;
+        }
