+using LibreLancer.World.Equipments;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public class EngineKillSParamTests
+{
+    [Fact]
+    public void EngineKillSParamTracksRemainingShipVelocity()
+    {
+        Assert.Equal(0.5f, Engine.CalculateSParam(true, 0, 100, 200));
+    }
+
+    [Fact]
+    public void EngineKillSParamClampsToValidRange()
+    {
+        Assert.Equal(1f, Engine.CalculateSParam(true, 0, 300, 200));
+        Assert.Equal(0f, Engine.CalculateSParam(true, 0, 0, 200));
+        Assert.Equal(0f, Engine.CalculateSParam(true, 0, 100, 0));
+    }
+
+    [Fact]
+    public void NormalEngineSParamRemainsUnchanged()
+    {
+        Assert.Equal(0.72f, Engine.CalculateSParam(false, 0.72f, 100, 200));
+    }
+}
