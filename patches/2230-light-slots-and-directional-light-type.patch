+        private static void PackLight(ref PackedLight packed, RenderLight src, bool shadow)
+        {
+            packed = default;
+            packed.Position = src.Position;
+            packed.Attentuation = src.Attenuation;
+            packed.Direction = src.Direction;
+            packed.Shadow = shadow ? 1f : 0f;
+            packed.Diffuse = src.Color;
+            packed.Ambient = src.Ambient;
+            packed.Range = src.Range;
+
+            if (src.Kind == LightKind.Spotlight)
+            {
+                packed.Spotlight = 1;
+                packed.Theta = MathF.Cos(MathHelper.DegreesToRadians(src.Theta) * 0.5f);
+                packed.Phi = MathF.Cos(MathHelper.DegreesToRadians(src.Phi) * 0.5f);
+                packed.Falloff = src.Falloff;
+            }
+
+            if (src.Kind is LightKind.Point or LightKind.Spotlight)
+                packed.Type = 1;
+            else if (src.Kind == LightKind.PointAttenCurve)
+                packed.Type = 2;
