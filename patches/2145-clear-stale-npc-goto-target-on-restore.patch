+    [Fact]
+    public void UnresolvedAmbientNpcGotoTarget_IsClearedWithoutChangingMissionOrDirectiveStates()
+    {
+        var state = new AutopilotTransferState
+        {
+            Behavior = AutopilotBehaviors.Goto,
+            TargetNickname = "stale_target",
+            MaxThrottle = 1,
+            GotoRadius = 25,
+            PitchController = new PIDControllerTransferState(0, 0, 0, 0, 0),
+            YawController = new PIDControllerTransferState(0, 0, 0, 0, 0),
+            Avoidance = new AutopilotAvoidanceTransferState()
+        };
+
+        var restored = NPCManager.NormalizeUnresolvedNpcGotoTarget(state, "none", hasMissionRuntime: false);
+
+        Assert.NotSame(state, restored);
+        Assert.Equal(AutopilotBehaviors.None, restored.Behavior);
+        Assert.Null(restored.GetTargetReference());
+        Assert.Same(state.PitchController, restored.PitchController);
+        Assert.Same(state.YawController, restored.YawController);
+        restored.Validate();
+        Assert.Same(state, NPCManager.NormalizeUnresolvedNpcGotoTarget(state, "none", hasMissionRuntime: true));
+        Assert.Same(state, NPCManager.NormalizeUnresolvedNpcGotoTarget(state, "AiAttackState", hasMissionRuntime: false));
+        Assert.Equal("spacepop_1", NPCManager.ResolveNpcDisplayName(" ", "spacepop_1"));
+        Assert.Equal("Trader", NPCManager.ResolveNpcDisplayName("Trader", "spacepop_1"));
+    }
+
