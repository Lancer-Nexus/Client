+        internal static float CalculateFrameLightPriority(RenderLight light, Vector3 cameraPosition)
+        {
+            if (light.Kind == LightKind.Directional)
+                return CalculateLightPriority(light, cameraPosition, 0);
+
+            var range = light.Range;
+            if (!float.IsFinite(range) || range <= 0)
+                return 0;
+
+            var distanceSquared = Vector3.DistanceSquared(light.Position, cameraPosition);
+            if (!float.IsFinite(distanceSquared))
+                return 0;
+
+            if (distanceSquared <= range * range)
+                return CalculateLightPriority(light, cameraPosition, 0);
+
+            // Frame selection must retain a light if the camera is outside its
+            // radius: visible objects near the emitter may still be illuminated.
+            // Per-object lighting applies the actual radius and attenuation later.
+            var color = light.Color;
+            var ambient = light.Ambient;
+            var intensity = Math.Max(0, color.R) * 0.2126f +
+                            Math.Max(0, color.G) * 0.7152f +
+                            Math.Max(0, color.B) * 0.0722f +
+                            Math.Max(0, ambient.R) * 0.2126f +
+                            Math.Max(0, ambient.G) * 0.7152f +
+                            Math.Max(0, ambient.B) * 0.0722f;
+            if (!float.IsFinite(intensity) || intensity <= 0)
+                return 0;
+
+            var distance = MathF.Sqrt(distanceSquared);
+            var projectedRange = range / (distance + range);
+            var priority = intensity * projectedRange * projectedRange;
+            return float.IsFinite(priority) ? priority : 0;
+        }
+
