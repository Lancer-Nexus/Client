+using System;
+
+namespace LibreLancer.Graphics;
+
+/// <summary>GPU phases currently exposed by the system renderer.</summary>
+public enum SystemRenderPass
+{
+    FrameClear,
+    DepthPrepass,
+    Opaque,
+    StarsAndNebula,
+    Transparent,
+    AntialiasResolve
+}
+
+[Flags]
+public enum SystemRenderResource
+{
+    None = 0,
+    SceneColor = 1 << 0,
+    SceneDepth = 1 << 1,
+    PresentationColor = 1 << 2,
+    SmaaEdges = 1 << 3,
+    SmaaWeights = 1 << 4,
+    SmaaStencil = 1 << 5,
+    SmaaLookupTextures = 1 << 6,
+    SmaaDepth = 1 << 7,
+    SceneStencil = 1 << 8
+}
+
+public enum SystemRenderTargetRole
+{
+    Scene,
+    Presentation,
+    SmaaEdges,
+    SmaaBlendWeights
+}
+
+public enum SystemRenderAttachmentFormat
+{
+    ActiveTarget,
+    CallerDefined,
+    Bgra8,
+    OpenGlMsaaColor,
+    OpenGlRgba8,
+    OpenGlRgbaImplementationDefined,
+    Depth24,
+    Depth24Stencil8
+}
+
+public enum SystemRenderLoadOperation { None, Load, Clear, DontCare }
+public enum SystemRenderStoreOperation { None, Store, ResolveColor }
+public enum SystemRenderSampleCount { Single, ModeSelected }
+
+/// <summary>Describes one attachment's format and content lifetime in a pass.</summary>
+public readonly record struct SystemRenderAttachmentContract(
+    SystemRenderResource Resource,
+    SystemRenderAttachmentFormat Format,
+    SystemRenderLoadOperation Load,
+    SystemRenderStoreOperation Store,
+    bool Optional = false,
+    SystemRenderSampleCount Samples = SystemRenderSampleCount.Single);
+
+/// <summary>
+/// Metadata for the current forward renderer path. This is not an executing
+/// render graph; target bindings remain owned by the existing renderer.
+/// </summary>
+public readonly record struct SystemRenderPassDescriptor(
+    SystemRenderPass Pass,
+    string Name,
+    SystemRenderResource Reads,
+    SystemRenderResource Writes,
+    SystemRenderTargetRole Target,
+    SystemRenderAttachmentContract? Color,
+    SystemRenderAttachmentContract? Depth,
+    SystemRenderAttachmentContract? Stencil,
+    bool Conditional = false);
+
+public enum SystemRenderSubpass
+{
+    SmaaEdgeDetection,
+    SmaaBlendWeights,
+    SmaaNeighborhoodBlend,
+    MsaaColorResolve
+}
+
+public readonly record struct SystemRenderSubpassDescriptor(
+    SystemRenderSubpass Pass,
+    string Name,
+    SystemRenderTargetRole Target,
+    SystemRenderResource Reads,
+    SystemRenderResource Writes,
+    SystemRenderAttachmentContract? Color,
+    SystemRenderAttachmentContract? Depth,
+    SystemRenderAttachmentContract? Stencil,
+    bool Conditional = true,
+    SystemRenderAttachmentContract? SourceColor = null,
+    SystemRenderAttachmentContract? SourceDepth = null);
+
+public static class SystemRenderPasses
+{
