+            throw new ArgumentOutOfRangeException(nameof(index));
+        return Descriptors[index];
+    }
+
+    public static SystemRenderSubpassDescriptor GetSubpass(SystemRenderSubpass pass)
+    {
+        var index = (int)pass;
+        if ((uint)index >= (uint)Subpasses.Length)
+            throw new ArgumentOutOfRangeException(nameof(pass));
+        return Subpasses[index];
+    }
+
+    public static SystemRenderSubpassDescriptor GetSubpass(int index)
+    {
+        if ((uint)index >= (uint)Subpasses.Length)
+            throw new ArgumentOutOfRangeException(nameof(index));
+        return Subpasses[index];
+    }
+}
