+            new(SystemRenderResource.SceneDepth, SystemRenderAttachmentFormat.ActiveTarget,
+                SystemRenderLoadOperation.Load, SystemRenderStoreOperation.Store, Optional: true), null),
+        new(SystemRenderPass.AntialiasResolve, "AA resolve",
+            SystemRenderResource.SceneColor | SystemRenderResource.PresentationColor,
+            SystemRenderResource.PresentationColor, SystemRenderTargetRole.Presentation,
+            new(SystemRenderResource.PresentationColor, SystemRenderAttachmentFormat.CallerDefined,
+                SystemRenderLoadOperation.Load, SystemRenderStoreOperation.Store), null, null,
+            Conditional: true)
