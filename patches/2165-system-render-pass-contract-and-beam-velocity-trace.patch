+                SystemRenderLoadOperation.Load, SystemRenderStoreOperation.None,
+                Samples: SystemRenderSampleCount.ModeSelected))
+    ];
+
+    static SystemRenderPasses()
+    {
+        foreach (var descriptor in Descriptors)
+            ValidateAttachments(descriptor.Name, descriptor.Reads, descriptor.Writes,
+                descriptor.Color, descriptor.Depth, descriptor.Stencil);
+        foreach (var descriptor in Subpasses)
+            ValidateAttachments(descriptor.Name, descriptor.Reads, descriptor.Writes,
+                descriptor.Color, descriptor.Depth, descriptor.Stencil,
+                descriptor.SourceColor, descriptor.SourceDepth);
+
+        ValidateSequence("SystemRenderer", Descriptors,
+            SystemRenderResource.PresentationColor);
+        ValidateSequence("SMAA", [Subpasses[0], Subpasses[1], Subpasses[2]],
+            SystemRenderResource.SceneColor | SystemRenderResource.PresentationColor |
+            SystemRenderResource.SmaaLookupTextures);
+        ValidateSequence("MSAA", [Subpasses[3]],
+            SystemRenderResource.SceneColor | SystemRenderResource.PresentationColor);
+    }
+
+    private static void ValidateSequence(
+        string sequenceName,
+        SystemRenderPassDescriptor[] passes,
+        SystemRenderResource externalResources)
+    {
+        var available = externalResources;
+        foreach (var descriptor in passes)
+        {
+            var missing = descriptor.Reads & ~available;
+            if (missing != SystemRenderResource.None)
+                throw new InvalidOperationException(
+                    $"Render sequence '{sequenceName}' reads uninitialized resources " +
+                    $"{missing} in pass '{descriptor.Name}'.");
+            available |= descriptor.Writes;
+        }
+    }
+
+    private static void ValidateSequence(
+        string sequenceName,
+        SystemRenderSubpassDescriptor[] passes,
+        SystemRenderResource externalResources)
+    {
+        var available = externalResources;
+        foreach (var descriptor in passes)
+        {
+            var missing = descriptor.Reads & ~available;
+            if (missing != SystemRenderResource.None)
+                throw new InvalidOperationException(
+                    $"Render sequence '{sequenceName}' reads uninitialized resources " +
+                    $"{missing} in subpass '{descriptor.Name}'.");
+            available |= descriptor.Writes;
+        }
+    }
+
+    private static void ValidateAttachments(
+        string name,
+        SystemRenderResource reads,
+        SystemRenderResource writes,
+        SystemRenderAttachmentContract? color,
+        SystemRenderAttachmentContract? depth,
+        SystemRenderAttachmentContract? stencil,
+        SystemRenderAttachmentContract? sourceColor = null,
+        SystemRenderAttachmentContract? sourceDepth = null)
+    {
+        ValidateAttachment(name, "color", color, reads, writes, isSource: false);
+        ValidateAttachment(name, "depth", depth, reads, writes, isSource: false);
+        ValidateAttachment(name, "stencil", stencil, reads, writes, isSource: false);
+        ValidateAttachment(name, "source color", sourceColor, reads, writes, isSource: true);
+        ValidateAttachment(name, "source depth", sourceDepth, reads, writes, isSource: true);
+    }
+
+    private static void ValidateAttachment(
+        string name,
+        string attachmentName,
+        SystemRenderAttachmentContract? attachment,
+        SystemRenderResource reads,
+        SystemRenderResource writes,
+        bool isSource)
+    {
+        if (attachment is not { } contract)
+            return;
+
+        if (contract.Load == SystemRenderLoadOperation.Load &&
+            (reads & contract.Resource) != contract.Resource)
+            throw new InvalidOperationException(
+                $"Render pass '{name}' loads {attachmentName} without declaring its resource as read.");
+
+        if (!isSource &&
+            (contract.Load is SystemRenderLoadOperation.Clear or SystemRenderLoadOperation.DontCare) &&
+            (contract.Store is SystemRenderStoreOperation.Store or SystemRenderStoreOperation.ResolveColor) &&
+            (writes & contract.Resource) != contract.Resource)
+            throw new InvalidOperationException(
+                $"Render pass '{name}' stores {attachmentName} without declaring its resource as written.");
+    }
+
+    public static int Count => Descriptors.Length;
+    public static int SubpassCount => Subpasses.Length;
