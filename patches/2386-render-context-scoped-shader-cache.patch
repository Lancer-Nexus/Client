+    [Fact]
+    public void BuiltinShaderBundlesAreRecreatedForANewRenderContext()
+    {
+        var firstContext = new HeadlessGame().RenderContext;
+        Shader firstAsteroidBandShader;
+        try
+        {
+            AllShaders.Compile(firstContext);
+            firstAsteroidBandShader = AllShaders.AsteroidBand.Get(0);
+            firstContext.DisposeShaders();
+            Assert.True(firstAsteroidBandShader.IsDisposed);
+
+            var secondContext = new HeadlessGame().RenderContext;
+            try
+            {
+                AllShaders.Compile(secondContext);
+                var secondAsteroidBandShader = AllShaders.AsteroidBand.Get(0);
+
+                Assert.NotSame(firstAsteroidBandShader, secondAsteroidBandShader);
+                Assert.False(secondAsteroidBandShader.IsDisposed);
+            }
+            finally
+            {
+                secondContext.DisposeShaders();
+            }
+        }
+        finally
+        {
+            firstContext.DisposeShaders();
+        }
     }
 
