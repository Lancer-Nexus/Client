+using LibreLancer.Graphics;
 using LibreLancer.Render;
 using Xunit;
 
@@ -5,6 +6,37 @@
 
 public class GpuPassProfileTests
 {
+    [Fact]
+    public void MissingTimerQueryIsIgnored()
+    {
+        Assert.False(GpuPassProfile.TryGetQueryResult(null, out var nanoseconds, out var frameNumber));
+        Assert.Equal(0UL, nanoseconds);
+        Assert.Equal(0L, frameNumber);
+    }
+
+    [Fact]
+    public void TimerQueryResultIsForwarded()
+    {
+        var query = new FakeGpuTimerQuery(12_500_000, 42);
+
+        Assert.True(GpuPassProfile.TryGetQueryResult(query, out var nanoseconds, out var frameNumber));
+        Assert.Equal(12_500_000UL, nanoseconds);
+        Assert.Equal(42L, frameNumber);
+    }
+
+    private sealed class FakeGpuTimerQuery(ulong elapsed, long submittedFrame) : IGpuTimerQuery
+    {
+        public bool Begin(long frameNumber) => false;
+        public void End() { }
+        public bool TryGetResult(out ulong nanoseconds, out long frameNumber)
+        {
+            nanoseconds = elapsed;
+            frameNumber = submittedFrame;
+            return true;
+        }
+        public void Dispose() { }
+    }
+
