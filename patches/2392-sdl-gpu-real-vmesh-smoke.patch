+                    for (var i = 0; i < 3; i++)
+                    {
+                        var vertex = meshRef.StartVertex + mesh.StartVertex + data.Indices[indexStart + i];
+                        if (vertex >= data.VertexCount)
+                        {
+                            valid = false;
+                            break;
+                        }
+                    }
+                    if (!valid)
+                        continue;
+                    selectedModel = model;
+                    selectedRef = meshRef;
+                    selectedData = data;
+                    selectedMesh = mesh;
+                    selectedIndexStart = indexStart;
+                    largestTriangle = mesh.NumRefVertices;
+                }
+            }
