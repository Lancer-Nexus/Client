diff --git a/src/LibreLancer.Base/Graphics/PostProcessExecutionPlan.cs b/src/LibreLancer.Base/Graphics/PostProcessExecutionPlan.cs
new file mode 100644
--- /dev/null
+++ b/src/LibreLancer.Base/Graphics/PostProcessExecutionPlan.cs
@@ -0,0 +1,167 @@
+using System;
+using System.Collections.Generic;
+
+namespace LibreLancer.Graphics;
+
+[Flags]
+internal enum PostProcessResource
+{
+    None = 0,
+    CurrentColor = 1 << 0,
+    SceneDepth = 1 << 1,
+    BloomBase = 1 << 2,
+    BloomMedium = 1 << 3,
+    BloomWide = 1 << 4,
+    PresentationColor = 1 << 5
+}
+
+internal readonly record struct PostProcessStage(
+    string Name,
+    IPostProcessPass Pass,
+    PostProcessResource Reads,
+    PostProcessResource Writes,
+    PostProcessResource OptionalReads = PostProcessResource.None,
+    PostProcessResource OptionalWrites = PostProcessResource.None);
+
+/// <summary>
+/// Compiles post-process resources with the SystemRenderer frame-graph
+/// scheduler. Target allocation and backend-specific bindings remain owned by
+/// AntialiasTarget.
+/// </summary>
+internal sealed class PostProcessExecutionPlan
+{
+    private const PostProcessResource AllResources =
+        PostProcessResource.CurrentColor | PostProcessResource.SceneDepth |
+        PostProcessResource.BloomBase | PostProcessResource.BloomMedium |
+        PostProcessResource.BloomWide | PostProcessResource.PresentationColor;
+
+    private sealed class RuntimeContext
+    {
+        public PostProcessContext Value;
+    }
+
+    private readonly PostProcessStage[] stages;
+    private readonly SystemRenderPassSchedule schedule;
+    private readonly RuntimeContext runtimeContext;
+
+    private PostProcessExecutionPlan(PostProcessStage[] stages,
+        SystemRenderPassSchedule schedule, RuntimeContext runtimeContext)
+    {
+        this.stages = stages;
+        this.schedule = schedule;
+        this.runtimeContext = runtimeContext;
+    }
+
+    public static PostProcessExecutionPlan Compile(
+        IReadOnlyList<PostProcessStage> stages,
+        PostProcessResource initiallyAvailable)
+    {
+        ArgumentNullException.ThrowIfNull(stages);
+        if ((initiallyAvailable & ~AllResources) != PostProcessResource.None)
+            throw new ArgumentOutOfRangeException(nameof(initiallyAvailable));
+
+        var graph = new SystemRenderPassGraph();
+        var runtimeContext = new RuntimeContext();
+        for (var i = 0; i < stages.Count; i++)
+        {
+            var stage = stages[i];
+            if (string.IsNullOrWhiteSpace(stage.Name))
+                throw new ArgumentException($"Post-process stage {i} has no name.", nameof(stages));
+            ArgumentNullException.ThrowIfNull(stage.Pass);
+            if (((stage.Reads | stage.Writes | stage.OptionalReads | stage.OptionalWrites) & ~AllResources) !=
+                PostProcessResource.None)
+                throw new ArgumentException($"Post-process stage '{stage.Name}' declares an unknown resource.", nameof(stages));
+
+            var capturedStage = stage;
+            graph.AddResourceAction(stage.Name,
+                () => ExecuteStage(runtimeContext, capturedStage),
+                ToFrameResources(stage.Reads), ToFrameResources(stage.Writes),
+                ToFrameResources(stage.OptionalReads), ToFrameResources(stage.OptionalWrites), i);
+        }
+
+        var schedule = graph.CompileSchedule(ToFrameResources(initiallyAvailable));
+        var executionOrder = new PostProcessStage[stages.Count];
+        for (var i = 0; i < executionOrder.Length; i++)
+            executionOrder[i] = stages[schedule.GetNodeIndex(i)];
+        return new PostProcessExecutionPlan(executionOrder, schedule, runtimeContext);
+    }
+
+    private static SystemRenderResource ToFrameResources(PostProcessResource resources)
+    {
+        var mapped = SystemRenderResource.None;
+        if ((resources & PostProcessResource.CurrentColor) != 0)
+            mapped |= SystemRenderResource.SceneColor;
+        if ((resources & PostProcessResource.SceneDepth) != 0)
+            mapped |= SystemRenderResource.SampleableSceneDepth;
+        if ((resources & PostProcessResource.BloomBase) != 0)
+            mapped |= SystemRenderResource.BloomBlurredColor;
+        if ((resources & PostProcessResource.BloomMedium) != 0)
+            mapped |= SystemRenderResource.BloomMediumBlurredColor;
+        if ((resources & PostProcessResource.BloomWide) != 0)
+            mapped |= SystemRenderResource.BloomWideBlurredColor;
+        if ((resources & PostProcessResource.PresentationColor) != 0)
+            mapped |= SystemRenderResource.PresentationColor;
+        return mapped;
+    }
+
+    private static void ExecuteStage(RuntimeContext runtime, PostProcessStage stage)
+    {
+        var context = runtime.Value;
+        var available = context.AvailableResources;
+        var missing = stage.Reads & ~stage.OptionalReads & ~available;
+        if (missing != PostProcessResource.None)
+            throw new InvalidOperationException(
+                $"Post-process stage '{stage.Name}' is missing runtime resources: {missing}.");
+
+        stage.Pass.Execute(ref context);
+
+        // Optional outputs count only when the pass produced their runtime object.
+        var runtimeOutputs = GetRuntimeOutputs(context);
+        var requiredWrites = stage.Writes & ~stage.OptionalWrites;
+        var optionalWrites = stage.Writes & stage.OptionalWrites & runtimeOutputs;
+        context.AvailableResources = available | requiredWrites | optionalWrites;
+        runtime.Value = context;
+    }
+
+    public long EstimatedMemoryBytes
+    {
+        get
+        {
+            long total = 0;
+            foreach (var stage in stages)
+                total = checked(total + stage.Pass.EstimatedMemoryBytes);
+            return total;
+        }
+    }
+
+    public void Execute(ref PostProcessContext context)
+    {
+        runtimeContext.Value = context;
+        try
+        {
+            schedule.Execute();
+            context = runtimeContext.Value;
+        }
+        finally
+        {
+            runtimeContext.Value = default;
+        }
+    }
+
+    private static PostProcessResource GetRuntimeOutputs(in PostProcessContext context)
+    {
+        var available = PostProcessResource.None;
+        if (context.Source != null) available |= PostProcessResource.CurrentColor;
+        if (context.SceneDepth != null) available |= PostProcessResource.SceneDepth;
+        if (context.BloomTexture != null) available |= PostProcessResource.BloomBase;
+        if (context.BloomMediumTexture != null) available |= PostProcessResource.BloomMedium;
+        if (context.BloomWideTexture != null) available |= PostProcessResource.BloomWide;
+        return available;
+    }
+
+    public void Dispose()
+    {
+        for (var i = stages.Length - 1; i >= 0; i--)
+            stages[i].Pass.Dispose();
+    }
+}
