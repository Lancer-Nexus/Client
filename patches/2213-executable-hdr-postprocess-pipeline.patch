diff --git a/src/LibreLancer.Base/Graphics/PostProcessPipeline.cs b/src/LibreLancer.Base/Graphics/PostProcessPipeline.cs
new file mode 100644
index 0000000..7b92d25
--- /dev/null
+++ b/src/LibreLancer.Base/Graphics/PostProcessPipeline.cs
@@ -0,0 +1,84 @@
+using System;
+
+namespace LibreLancer.Graphics;
+
+/// <summary>Per-frame inputs and outputs shared by executable post-process passes.</summary>
+internal struct PostProcessContext
+{
+    public RenderContext Graphics;
+    public Texture2D Source;
+    public RenderTarget? Target;
+    public int Width;
+    public int Height;
+    public Point Offset;
+    public bool BloomEnabled;
+    public float BloomThreshold;
+    public float BloomStrength;
+    public float BloomRadius;
+    public float BloomResolutionScale;
+    public Texture2D? BloomTexture;
+    public Action<SystemRenderSubpass, bool>? GpuSubpassMarker;
+}
+
+/// <summary>A resource-owning stage in the HDR post-process sequence.</summary>
+internal interface IPostProcessPass : IDisposable
+{
+    long EstimatedMemoryBytes { get; }
+    void Execute(ref PostProcessContext context);
+}
+
+/// <summary>Runs post-process stages in dependency order after AA resolve.</summary>
+internal sealed class PostProcessPipeline : IDisposable
+{
+    private readonly IPostProcessPass[] passes;
+
+    public long EstimatedMemoryBytes
+    {
+        get
+        {
+            long total = 0;
+            foreach (var pass in passes)
+                total += pass.EstimatedMemoryBytes;
+            return total;
+        }
+    }
+
+    public PostProcessPipeline(RenderContext graphics)
+    {
+        passes = [new BloomPass(graphics), new ToneMapPostProcessPass()];
+    }
+
+    public void Execute(ref PostProcessContext context)
+    {
+        foreach (var pass in passes)
+            pass.Execute(ref context);
+    }
+
+    public void Dispose()
+    {
+        foreach (var pass in passes)
+            pass.Dispose();
+    }
+}
+
+internal sealed class ToneMapPostProcessPass : IPostProcessPass
+{
+    public long EstimatedMemoryBytes => 0;
+
+    public void Execute(ref PostProcessContext context)
+    {
+        context.GpuSubpassMarker?.Invoke(SystemRenderSubpass.ToneMap, true);
+        try
+        {
+            TonemapPass.Draw(context.Graphics, context.Source, context.Target,
+                context.Width, context.Height, context.Offset, context.BloomTexture,
+                context.BloomTexture != null ? context.BloomStrength : 0f);
+        }
+        finally
+        {
+            context.GpuSubpassMarker?.Invoke(SystemRenderSubpass.ToneMap, false);
+        }
+    }
+
+    public void Dispose() { }
+}
