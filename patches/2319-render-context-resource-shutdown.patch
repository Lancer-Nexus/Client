+using System;
+using LibreLancer.Graphics;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public class RenderContextLifecycleTests
+{
+    private sealed class HeadlessGame() : Game(64, 64, false, GameConfiguration.HeadlessTest()) { }
+
+    [Fact]
+    public void DisposeDrainsGpuWorkAndReleasesContextOwnedResourcesOnce()
+    {
+        var context = new HeadlessGame().RenderContext;
+        var areaTexture = context.SMAAAreaTex;
+        var searchTexture = context.SMAASearchTex;
+        var textTexture = context.Renderer2D.Dot;
+        var fullscreenBuffer = context.FullScreenTriangle;
+        var retired = false;
+        context.RetireAfterFrame(() => retired = true);
+
+        context.Dispose();
+        context.Dispose();
+
+        Assert.True(retired);
+        Assert.True(areaTexture.IsDisposed);
+        Assert.True(searchTexture.IsDisposed);
+        Assert.True(textTexture.IsDisposed);
+        Assert.True(fullscreenBuffer.IsDisposed);
+        Assert.Equal(0, context.OwnedShaderCount);
+        Assert.Throws<ObjectDisposedException>(() => new Shader(context, ReadOnlySpan<byte>.Empty));
+    }
+}
