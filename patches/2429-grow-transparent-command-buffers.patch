+++ b/src/LibreLancer.Tests/RenderCommandBufferCapacityTests.cs
@@ -0,0 +1,64 @@
+using System;
+using System.Numerics;
+using LibreLancer;
+using LibreLancer.Graphics;
+using LibreLancer.Graphics.Vertices;
+using LibreLancer.Render;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public class RenderCommandBufferCapacityTests
+{
+    private sealed class HeadlessGame : Game
+    {
+        public HeadlessGame() : base(64, 64, false, GameConfiguration.HeadlessTest()) { }
+    }
+
+    private sealed class TransparentMaterial : RenderMaterial
+    {
+        public TransparentMaterial() : base(null) { }
+        public override bool IsTransparent => true;
+        public override void Use(RenderContext context, IVertexType vertexType, ref Lighting lights, int userData) =>
+            throw new InvalidOperationException("Transparent material should not draw during command insertion");
+    }
+
+    [Theory]
+    [InlineData(0, 1, 16)]
+    [InlineData(16384, 16385, 32768)]
+    [InlineData(32768, 65537, 131072)]
+    public void CapacityGrowsGeometrically(int current, int required, int expected)
+    {
+        Assert.Equal(expected, CommandBuffer.GetExpandedCapacity(current, required));
+    }
+
+    [Fact]
+    public void CapacityDoesNotShrinkWhenCurrentAllocationIsEnough()
+    {
+        Assert.Equal(32768, CommandBuffer.GetExpandedCapacity(32768, 16385));
+    }
+
+    [Fact]
+    public void AddingCommandsPastOriginalLimitGrowsCommandAndSortBuffers()
+    {
+        var context = new HeadlessGame().RenderContext;
+        try
+        {
+            using var commands = new CommandBuffer(context);
+            var material = new TransparentMaterial();
+            for (var i = 0; i < 16385; i++)
+            {
+                commands.AddCommandFade(material, default, Lighting.Empty, null!,
+                    PrimitiveTypes.TriangleList, -1, 0, 3, 0, Vector2.Zero);
+            }
+
+            Assert.Equal(16385, commands.TransparentCommandCount);
+            Assert.Equal(32768, commands.TransparentCommandCapacity);
+            Assert.Equal(commands.TransparentCommandCapacity, commands.TransparentSortCapacity);
+        }
+        finally
+        {
+            context.DisposeShaders();
+        }
+    }
+}
