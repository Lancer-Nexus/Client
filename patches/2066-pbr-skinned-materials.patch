diff --git a/src/LibreLancer.Tests/DfmSkinnedPbrShaderTests.cs b/src/LibreLancer.Tests/DfmSkinnedPbrShaderTests.cs
new file mode 100644
index 000000000..012d82803
--- /dev/null
+++ b/src/LibreLancer.Tests/DfmSkinnedPbrShaderTests.cs
@@ -0,0 +1,63 @@
+using System;
+using System.Reflection;
+using LibreLancer.Graphics;
+using LibreLancer.Render.Materials;
+using LibreLancer.Shaders;
+using LibreLancer.Utf.Dfm;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+[CollectionDefinition(Name, DisableParallelization = true)]
+public sealed class DfmSkinnedPbrShaderCollection
+{
+    public const string Name = "DFM skinned PBR shader bundle";
+}
+
+[Collection(DfmSkinnedPbrShaderCollection.Name)]
+public sealed class DfmSkinnedPbrShaderTests
+{
+    private sealed class HeadlessGame : Game
+    {
+        public HeadlessGame() : base(64, 64, false, GameConfiguration.HeadlessTest()) { }
+    }
+
+    [Fact]
+    public void DfmVerticesSelectSkinnedPbrBundleAndTangentNormalMapVariant()
+    {
+        var game = new HeadlessGame();
+        var context = game.RenderContext;
+        var previousPbr = AllShaders.PBR;
+        var previousSkinnedPbr = AllShaders.PBR_Skinned;
+        try
+        {
+            AllShaders.PBR = ShaderBundle.FromResource<FreelancerGame>(context, "PBR.bin");
+            AllShaders.PBR_Skinned = ShaderBundle.FromResource<FreelancerGame>(context, "PBR_Skinned.bin");
+
+            var material = new BasicMaterial("DcDt", null!);
+            using var bones = new StorageBuffer(context, 64, 64);
+            material.Bones = bones;
+
+            Assert.Same(AllShaders.PBR_Skinned.Get(1u << 4), GetPbrShader(material, new DfmVertex()));
+
+            material.NmSampler = "qa_normal";
+            Assert.Same(AllShaders.PBR_Skinned.Get(1u << 4), GetPbrShader(material, new DfmVertex()));
+            Assert.Same(AllShaders.PBR_Skinned.Get((1u << 4) | 1u), GetPbrShader(material, new DfmTangentVertex()));
+
+            material.Bones = null;
+            Assert.Same(AllShaders.PBR.Get((1u << 4) | 1u), GetPbrShader(material, new DfmTangentVertex()));
+        }
+        finally
+        {
+            context.DisposeShaders();
+            AllShaders.PBR = previousPbr;
+            AllShaders.PBR_Skinned = previousSkinnedPbr;
+        }
+    }
+
+    private static Shader GetPbrShader(BasicMaterial material, object vertexType)
+    {
+        var method = typeof(BasicMaterial).GetMethod("GetPBRShader", BindingFlags.Instance | BindingFlags.NonPublic)!;
+        return Assert.IsType<Shader>(method.Invoke(material, [vertexType, false]));
+    }
+}

