+    private async Task<string> RecoverCharacterSystemMetadataAsync(string accessToken, Guid accountId,
+        Guid sessionId, long characterId, CancellationToken cancellationToken)
+    {
+        var request = new CharacterSystemMetadataRecoveryRequestV1
+        {
+            CorrelationId = Guid.NewGuid(),
+            AccountId = accountId,
+            SessionId = sessionId,
+            CharacterId = characterId
+        };
+        using var message = new HttpRequestMessage(HttpMethod.Post,
+            new Uri(gateway, "/api/v1/characters/system/recover"));
+        message.Headers.Authorization = new AuthenticationHeaderValue("Bearer", accessToken);
+        message.Content = JsonContent.Create(request);
+        using var response = await http.SendAsync(message, cancellationToken);
+        if (response.StatusCode == HttpStatusCode.Unauthorized)
+            throw new UnauthorizedAccessException("Gateway character system recovery rejected the active session.");
+        var recovery = await response.Content.ReadFromJsonAsync<CharacterSystemMetadataRecoveryResultV1>(
+            cancellationToken: cancellationToken);
+        if (!response.IsSuccessStatusCode || recovery is null || !recovery.IsValid() ||
+            recovery.CorrelationId != request.CorrelationId ||
+            recovery.CharacterId != characterId || !recovery.Accepted || string.IsNullOrWhiteSpace(recovery.SystemId))
+            throw new InvalidDataException($"Gateway character system recovery failed: {recovery?.ReasonCode ?? "empty response"}.");
+        return recovery.SystemId;
+    }
