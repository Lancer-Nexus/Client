+using System;
+using System.IO;
+using System.Security.Cryptography;
+using System.Text.Json;
+using LibreLancer.Data;
+using LibreLancer.Data.IO;
+using Nexus.Assets;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public sealed class NexusEditorDataMountTests : IDisposable
+{
+    private readonly string root = Path.Combine(Path.GetTempPath(), "nap-editor-mount-" + Guid.NewGuid().ToString("N"));
+    private string ApplicationDirectory => Path.Combine(root, "application");
+    private string InstallDirectory => Path.Combine(root, "freelancer");
+    private string PackageDirectory => Path.Combine(ApplicationDirectory, "packages");
+
+    [Fact]
+    public void SharedEditorMountReadsActiveNapAndWritesPackagedFilesToPersistentWorkspace()
+    {
+        var source = Path.Combine(root, "source");
+        Directory.CreateDirectory(Path.Combine(source, "interface"));
+        File.WriteAllText(Path.Combine(source, "interface", "resources.xml"), "package resources");
+        Directory.CreateDirectory(Path.Combine(InstallDirectory, "DATA", "interface"));
+        File.WriteAllText(Path.Combine(InstallDirectory, "DATA", "interface", "resources.xml"), "loose resources");
+        Directory.CreateDirectory(PackageDirectory);
+        var package = Path.Combine(PackageDirectory, "core.nap");
+        NapWriter.PackDirectory(source, package);
+        var hash = Convert.ToHexString(SHA256.HashData(File.ReadAllBytes(package))).ToLowerInvariant();
+        var info = new FileInfo(package);
+        var snapshot = new
+        {
+            schemaVersion = 1,
+            packages = new[]
+            {
+                new
+                {
+                    id = "core",
+                    path = "core.nap",
+                    size = info.Length,
+                    sha256 = hash,
+                    required = true,
+                    priority = 100,
+                    mountOrder = 1,
+                    dependencies = Array.Empty<string>(),
+                    overrides = Array.Empty<string>()
+                }
+            }
+        };
+        File.WriteAllText(Path.Combine(PackageDirectory, "active.json"), JsonSerializer.Serialize(snapshot));
+
+        var fileSystem = FileSystem.FromPath(InstallDirectory);
+        var workspaceBase = Path.Combine(root, "editor-data");
+        var mount = NexusEditorDataMount.Attach(fileSystem, ApplicationDirectory, InstallDirectory, workspaceBase);
+
+        Assert.NotNull(mount);
+        Assert.Equal("package resources", fileSystem.ReadAllText("DATA/interface/resources.xml"));
+        var backingPath = fileSystem.GetBackingFileName("DATA/interface/resources.xml");
+        Assert.NotNull(backingPath);
+        Assert.StartsWith(mount.WorkspaceDirectory, backingPath, StringComparison.Ordinal);
+        Assert.StartsWith(workspaceBase, mount.WorkspaceDirectory, StringComparison.Ordinal);
+
+        File.WriteAllText(backingPath, "editor override");
+        fileSystem.Refresh();
+        Assert.Equal("editor override", fileSystem.ReadAllText("DATA/interface/resources.xml"));
+        Assert.Equal("loose resources", File.ReadAllText(Path.Combine(InstallDirectory,
+            "DATA", "interface", "resources.xml")));
+    }
+
+    [Fact]
+    public void SharedEditorMountPreservesLooseOnlyModeWithoutAnActiveSnapshot()
+    {
+        Directory.CreateDirectory(InstallDirectory);
+        var fileSystem = FileSystem.FromPath(InstallDirectory);
+        var providerCount = fileSystem.FileProviders.Count;
+
+        Assert.Null(NexusEditorDataMount.Attach(fileSystem, ApplicationDirectory, InstallDirectory,
+            Path.Combine(root, "editor-data")));
+        Assert.Equal(providerCount, fileSystem.FileProviders.Count);
+    }
+
+    void IDisposable.Dispose()
+    {
+        if (Directory.Exists(root)) Directory.Delete(root, recursive: true);
+    }
+}
