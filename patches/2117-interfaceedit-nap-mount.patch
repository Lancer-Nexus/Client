+using System;
+using System.IO;
+using System.Numerics;
+using System.Security.Cryptography;
+using System.Text;
+using LibreLancer.Data.IO;
+
+using Nexus.Assets;
+
+namespace LibreLancer.Data;
+
+/// <summary>Mounts an activated NAP snapshot and persistent writable workspace for an editor VFS.</summary>
+public sealed class NexusEditorDataMount
+{
+    private const string WorkspaceAlphabet = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_;-+=,#$@%^!~`()[]{}";
+
+    private NexusEditorDataMount(string workspaceDirectory, NexusPackageFileProvider packages)
+    {
+        WorkspaceDirectory = workspaceDirectory;
+        Packages = packages;
+    }
+
+    public string WorkspaceDirectory { get; }
+    public NexusPackageFileProvider Packages { get; }
+
+    /// <summary>
+    /// Adds active packages and their writable workspace above the VFS's existing loose-data providers.
+    /// Returns null when no active package snapshot is installed.
+    /// </summary>
+    public static NexusEditorDataMount? Attach(FileSystem fileSystem, string applicationDirectory,
+        string gameDataDirectory, string? workspaceBaseDirectory = null)
+    {
+        ArgumentNullException.ThrowIfNull(fileSystem);
+        ArgumentException.ThrowIfNullOrWhiteSpace(applicationDirectory);
+        ArgumentException.ThrowIfNullOrWhiteSpace(gameDataDirectory);
+
+        var packages = NexusPackageFileProvider.LoadActive(applicationDirectory);
+        if (packages is null) return null;
+
+        var workspaceDirectory = GetWorkspaceDirectory(gameDataDirectory, workspaceBaseDirectory);
+        var workspace = new NexusPackageWorkspaceFileProvider(workspaceDirectory, packages);
+        fileSystem.FileProviders.Add(packages);
+        fileSystem.FileProviders.Add(workspace);
+        return new NexusEditorDataMount(workspaceDirectory, packages);
+    }
+
+    /// <summary>Uses the legacy LancerEdit path and installation ID to preserve existing edits.</summary>
+    public static string GetWorkspaceDirectory(string gameDataDirectory, string? workspaceBaseDirectory = null)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(gameDataDirectory);
+        if (string.IsNullOrWhiteSpace(workspaceBaseDirectory))
+        {
+            var localData = Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData);
+            workspaceBaseDirectory = string.IsNullOrWhiteSpace(localData)
+                ? Path.Combine(AppContext.BaseDirectory, "user-data", "LancerEdit")
+                : Path.Combine(localData, "LancerEdit");
+        }
+        return Path.Combine(workspaceBaseDirectory, "NAPWorkspace", InstallationId(gameDataDirectory));
+    }
+
+    private static string InstallationId(string path)
+    {
+        var digest = SHA256.HashData(Encoding.UTF8.GetBytes(path.ToUpperInvariant()));
+        var value = new BigInteger(digest.AsSpan(0, 24), isUnsigned: true);
+        var builder = new StringBuilder();
+        while (value > 0)
+        {
+            value = BigInteger.DivRem(value, WorkspaceAlphabet.Length, out var remainder);
+            builder.Append(WorkspaceAlphabet[(int)remainder]);
+        }
+        return builder.ToString();
+    }
+}
