diff --git a/src/LibreLancer.Base/Shaders/BloomBlur.frag.hlsl b/src/LibreLancer.Base/Shaders/BloomBlur.frag.hlsl
new file mode 100644
--- /dev/null
+++ b/src/LibreLancer.Base/Shaders/BloomBlur.frag.hlsl
@@ -0,0 +1,14 @@
+Texture2D<float4> SourceTexture : register(t0, TEXTURE_SPACE);
+SamplerState SourceSampler : register(s0, TEXTURE_SPACE);
+cbuffer Parameters : register(b3, UNIFORM_SPACE) { float4 BlurParameters; }
+
+float4 main(float4 position : SV_Position, float2 uv : TEXCOORD0) : SV_Target0
+{
+    float2 stepUv = BlurParameters.xy;
+    float4 color = SourceTexture.Sample(SourceSampler, uv) * 0.2270270270;
+    color += SourceTexture.Sample(SourceSampler, uv + stepUv * 1.3846153846) * 0.3162162162;
+    color += SourceTexture.Sample(SourceSampler, uv - stepUv * 1.3846153846) * 0.3162162162;
+    color += SourceTexture.Sample(SourceSampler, uv + stepUv * 3.2307692308) * 0.0702702703;
+    color += SourceTexture.Sample(SourceSampler, uv - stepUv * 3.2307692308) * 0.0702702703;
+    return color;
+}
