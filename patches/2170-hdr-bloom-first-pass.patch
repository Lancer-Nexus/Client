diff --git a/src/LibreLancer.Base/Shaders/BloomExtract.frag.hlsl b/src/LibreLancer.Base/Shaders/BloomExtract.frag.hlsl
new file mode 100644
--- /dev/null
+++ b/src/LibreLancer.Base/Shaders/BloomExtract.frag.hlsl
@@ -0,0 +1,21 @@
+Texture2D<float4> SceneTexture : register(t0, TEXTURE_SPACE);
+SamplerState SceneSampler : register(s0, TEXTURE_SPACE);
+cbuffer Parameters : register(b3, UNIFORM_SPACE) { float4 BloomParameters; }
+
+float3 SampleScene(float2 uv) { return SceneTexture.Sample(SceneSampler, uv).rgb; }
+
+float4 main(float4 position : SV_Position, float2 uv : TEXCOORD0) : SV_Target0
+{
+    float2 texel = BloomParameters.xy;
+    float3 color = (SampleScene(uv + texel * float2(-0.5, -0.5)) +
+                    SampleScene(uv + texel * float2( 0.5, -0.5)) +
+                    SampleScene(uv + texel * float2(-0.5,  0.5)) +
+                    SampleScene(uv + texel * float2( 0.5,  0.5))) * 0.25;
+    float brightness = max(color.r, max(color.g, color.b));
+    float threshold = BloomParameters.z;
+    float soft = max(BloomParameters.w, 0.0001);
+    float softContribution = clamp(brightness - threshold + soft, 0.0, 2.0 * soft);
+    softContribution = softContribution * softContribution / (4.0 * soft);
+    float contribution = max(brightness - threshold, softContribution);
+    return float4(color * (contribution / max(brightness, 0.0001)), 1.0);
+}
