diff --git a/src/LibreLancer.Base/Graphics/BloomPass.cs b/src/LibreLancer.Base/Graphics/BloomPass.cs
new file mode 100644
--- /dev/null
+++ b/src/LibreLancer.Base/Graphics/BloomPass.cs
@@ -0,0 +1,122 @@
+using System.Numerics;
+
+namespace LibreLancer.Graphics;
+
+internal sealed class BloomPass : System.IDisposable
+{
+    private readonly RenderContext context;
+    private RenderTarget2D? extracted;
+    private RenderTarget2D? horizontal;
+    private RenderTarget2D? blurred;
+    private int width;
+    private int height;
+    private bool failed;
+    public long EstimatedMemoryBytes => (extracted?.EstimatedMemoryBytes ?? 0) +
+        (horizontal?.EstimatedMemoryBytes ?? 0) + (blurred?.EstimatedMemoryBytes ?? 0);
+
+    public BloomPass(RenderContext context) => this.context = context;
+
+    public Texture2D? Process(Texture2D source)
+    {
+        if (failed)
+            return null;
+        var targetWidth = System.Math.Max(1, source.Width / 4);
+        var targetHeight = System.Math.Max(1, source.Height / 4);
+        if (width != targetWidth || height != targetHeight)
+        {
+            DisposeTargets();
+            width = targetWidth;
+            height = targetHeight;
+            try
+            {
+                extracted = new RenderTarget2D(context, width, height, null, false, SurfaceFormat.HdrBlendable);
+                horizontal = new RenderTarget2D(context, width, height, null, false, SurfaceFormat.HdrBlendable);
+                blurred = new RenderTarget2D(context, width, height, null, false, SurfaceFormat.HdrBlendable);
+            }
+            catch (System.Exception ex) when (ex is System.InvalidOperationException or System.NotSupportedException)
+            {
+                DisposeTargets();
+                failed = true;
+                FLLog.Warning("Graphics", $"Bloom targets are unavailable; continuing without bloom. {ex.Message}");
+                return null;
+            }
+        }
+
+        try
+        {
+            Draw(context.BloomExtractShader, source, extracted!, new Vector4(
+                1f / source.Width, 1f / source.Height, 1f, 0.5f));
+            Draw(context.BloomBlurShader, extracted!.Texture, horizontal!, new Vector4(1f / width, 0, 0, 0));
+            Draw(context.BloomBlurShader, horizontal!.Texture, blurred!, new Vector4(0, 1f / height, 0, 0));
+        }
+        catch (System.Exception ex) when (ex is System.InvalidOperationException or System.NotSupportedException)
+        {
+            DisposeTargets();
+            failed = true;
+            FLLog.Warning("Graphics", $"Bloom rendering failed; continuing without bloom. {ex.Message}");
+            return null;
+        }
+        return blurred!.Texture;
+    }
+
+    private void Draw(Shader shader, Texture2D source, RenderTarget2D target, Vector4 parameters)
+    {
+        var previousTarget = context.RenderTarget;
+        var previousTexture = context.Textures[0];
+        var previousSampler = context.Samplers[0];
+        var previousShader = context.Shader;
+        var previousBlend = context.BlendMode;
+        var previousDepth = context.DepthEnabled;
+        var previousDepthWrite = context.DepthWrite;
+        var previousColorWrite = context.ColorWrite;
+        var previousCull = context.Cull;
+        var previousStencil = context.Stencil;
+        var previousStencilEnabled = context.StencilEnabled;
+        var viewportPushed = false;
+        var scissorPushed = false;
+        try
+        {
+            context.RenderTarget = target;
+            context.PushViewport(0, 0, width, height);
+            viewportPushed = true;
+            scissorPushed = context.PushScissor(new Rectangle(0, 0, width, height), false);
+            context.DepthEnabled = false;
+            context.DepthWrite = false;
+            context.ColorWrite = true;
+            context.Cull = false;
+            context.StencilEnabled = false;
+            context.BlendMode = BlendMode.Opaque;
+            context.Textures[0] = source;
+            context.Samplers[0] = new SamplerState(TextureFiltering.Linear, WrapMode.ClampToEdge, WrapMode.ClampToEdge);
+            shader.SetUniformBlock(3, ref parameters);
+            context.Shader = shader;
+            context.FullScreenTriangle.Draw(PrimitiveTypes.TriangleList, 1);
+        }
+        finally
+        {
+            context.Textures[0] = previousTexture;
+            context.Samplers[0] = previousSampler;
+            context.Shader = previousShader;
+            context.BlendMode = previousBlend;
+            context.DepthEnabled = previousDepth;
+            context.DepthWrite = previousDepthWrite;
+            context.ColorWrite = previousColorWrite;
+            context.Cull = previousCull;
+            context.Stencil = previousStencil;
+            context.StencilEnabled = previousStencilEnabled;
+            if (scissorPushed) context.PopScissor();
+            if (viewportPushed) context.PopViewport();
+            context.RenderTarget = previousTarget;
+        }
+    }
+
+    private void DisposeTargets()
+    {
+        extracted?.Dispose();
+        horizontal?.Dispose();
+        blurred?.Dispose();
+        extracted = horizontal = blurred = null;
+    }
+
+    public void Dispose() => DisposeTargets();
+}
