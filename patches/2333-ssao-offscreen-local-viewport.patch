From: Lancer Nexus
Subject: [PATCH] Render SSAO intermediate targets at local origin

HDR and multisample post-processing render through an offscreen target whose
coordinates begin at (0,0). Preserve the caller viewport offset only when SSAO
writes directly to the drawable. Cover both coordinate-space choices with
focused regression tests and record NAP-only HDR runtime evidence.

--- a/src/LibreLancer.Base/Graphics/ScreenSpaceAmbientOcclusionPass.cs
+++ b/src/LibreLancer.Base/Graphics/ScreenSpaceAmbientOcclusionPass.cs
@@ -43,6 +43,9 @@
             height = context.Height;
         }
         var target = hasFollowingPass ? intermediate : context.Target;
+        // Intermediate targets use local coordinates; only the final drawable pass
+        // should inherit the letterbox or split-screen offset from the caller.
+        var offset = ResolveTargetOffset(context.Offset, hasFollowingPass);
 
         var oldTarget = graphics.RenderTarget;
         var oldTexture0 = graphics.Textures[0];
@@ -60,9 +63,9 @@
         try
         {
             graphics.RenderTarget = target;
-            graphics.PushViewport(context.Offset.X, context.Offset.Y, context.Width, context.Height);
+            graphics.PushViewport(offset.X, offset.Y, context.Width, context.Height);
             viewport = true;
-            scissor = graphics.PushScissor(new Rectangle(context.Offset.X, context.Offset.Y, context.Width, context.Height), false);
+            scissor = graphics.PushScissor(new Rectangle(offset.X, offset.Y, context.Width, context.Height), false);
             graphics.DepthEnabled = false;
             graphics.DepthWrite = false;
             graphics.ColorWrite = true;
@@ -110,5 +113,8 @@
         }
     }
 
+    internal static Point ResolveTargetOffset(Point callerOffset, bool rendersToIntermediate) =>
+        rendersToIntermediate ? Point.Zero : callerOffset;
+
     public void Dispose() => intermediate?.Dispose();
 }
--- /dev/null
+++ b/src/LibreLancer.Tests/ScreenSpaceAmbientOcclusionOffsetTests.cs
@@ -0,0 +1,20 @@
+using LibreLancer.Graphics;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public class ScreenSpaceAmbientOcclusionOffsetTests
+{
+    [Fact]
+    public void IntermediateTargetUsesLocalOrigin()
+    {
+        Assert.Equal(Point.Zero, ScreenSpaceAmbientOcclusionPass.ResolveTargetOffset(new Point(0, 101), true));
+    }
+
+    [Fact]
+    public void DrawableTargetRetainsCallerOffset()
+    {
+        var offset = new Point(0, 101);
+        Assert.Equal(offset, ScreenSpaceAmbientOcclusionPass.ResolveTargetOffset(offset, false));
+    }
+}
