+using System;
 using LibreLancer.Graphics;
 using Xunit;
 
@@ -19,3 +20,30 @@
         Assert.Equal(2, executions);
     }
 }
+
+public class SystemRenderPassExecutionTests
+{
+    [Fact]
+    public void EndRejectsMissingRequiredColorAttachmentWrite()
+    {
+        var execution = new SystemRenderPassExecution();
+        execution.Begin(SystemRenderPass.FrameClear);
+
+        var error = Assert.Throws<InvalidOperationException>(() =>
+            execution.End(SystemRenderPass.FrameClear,
+                SystemRenderResource.SceneDepth | SystemRenderResource.SceneStencil));
+
+        Assert.Contains("SceneColor", error.Message);
+    }
+
+    [Fact]
+    public void EndAllowsMissingOptionalDepthAndStencilWrites()
+    {
+        var execution = new SystemRenderPassExecution();
+        execution.Begin(SystemRenderPass.FrameClear);
+
+        execution.End(SystemRenderPass.FrameClear, SystemRenderResource.SceneColor);
+
+        Assert.Equal(SystemRenderResource.SceneColor, execution.AvailableResources);
+    }
+}
