+					case RenderCmdType.Material: materials++; break;
+					case RenderCmdType.MaterialFade: fades++; break;
+					case RenderCmdType.MaterialOverride: overrides++; break;
+					case RenderCmdType.Billboard: billboards++; break;
+					default:
+						throw new InvalidOperationException($"Unknown transparent render command type: {command.CmdType}");
+				}
+			}
+			return new TransparentCommandCounts(materials, fades, overrides, billboards);
