+    private static bool TryParseStartupArguments(string[] args, out string[] remainingArgs,
+        out bool startNewGame, out string? loadSavePath, out string? error)
+    {
+        var remaining = new System.Collections.Generic.List<string>();
+        startNewGame = false;
+        loadSavePath = null;
+        error = null;
+        for (var i = 0; i < args.Length; i++)
+        {
+            var arg = args[i];
+            if (arg == "--new-game")
+            {
+                if (startNewGame || loadSavePath is not null)
+                {
+                    error = "Choose only one of --new-game or --load-save.";
+                    remainingArgs = Array.Empty<string>();
+                    return false;
+                }
+                startNewGame = true;
+            }
+            else if (arg == "--load-save" || arg.StartsWith("--load-save=", StringComparison.Ordinal))
+            {
+                if (startNewGame || loadSavePath is not null)
+                {
+                    error = "Choose only one of --new-game or --load-save.";
+                    remainingArgs = Array.Empty<string>();
+                    return false;
+                }
+                var path = arg == "--load-save" ? (++i < args.Length ? args[i] : null) : arg[12..];
+                if (string.IsNullOrWhiteSpace(path) || !File.Exists(path))
+                {
+                    error = "--load-save requires an existing savegame path.";
+                    remainingArgs = Array.Empty<string>();
+                    return false;
+                }
+                loadSavePath = Path.GetFullPath(path);
+            }
+            else
+            {
+                remaining.Add(arg);
+            }
+        }
+        remainingArgs = remaining.ToArray();
+        return true;
+    }
+
