diff --git a/src/LibreLancer/Server/GatewayCharacterLeaseClient.cs b/src/LibreLancer/Server/GatewayCharacterLeaseClient.cs
new file mode 100644
index 000000000..164b70e23
--- /dev/null
+++ b/src/LibreLancer/Server/GatewayCharacterLeaseClient.cs
@@ -0,0 +1,168 @@
+using System;
+using System.IO;
+using System.Net.Http;
+using System.Net.Http.Headers;
+using System.Net.Http.Json;
+using System.Security.Cryptography;
+using System.Text;
+using System.Threading;
+using System.Threading.Tasks;
+using LancerNexus.Protocol;
+
+namespace LibreLancer.Server;
+
+public sealed record GatewayCharacterLease(long CharacterId, string LeaseToken, long LeaseVersion,
+    DateTimeOffset ValidUntilUtc);
+
+public sealed class GatewayCharacterLeaseClient
+{
+    private readonly Uri gateway;
+    private readonly string instanceKey;
+    private readonly HttpClient http;
+
+    public GatewayCharacterLeaseClient(Uri gateway, string instanceKey, HttpClient http)
+    {
+        if (!gateway.IsAbsoluteUri || gateway.Scheme != Uri.UriSchemeHttps ||
+            gateway.AbsolutePath != "/" || !string.IsNullOrEmpty(gateway.UserInfo) || !string.IsNullOrEmpty(gateway.Query) ||
+            !string.IsNullOrEmpty(gateway.Fragment))
+            throw new ArgumentException("Gateway URL must be an HTTPS origin.", nameof(gateway));
+        if (string.IsNullOrWhiteSpace(instanceKey) || instanceKey.Length < 32)
+            throw new ArgumentException("Gateway instance key is invalid.", nameof(instanceKey));
+        this.gateway = new Uri(gateway.AbsoluteUri.TrimEnd('/') + "/", UriKind.Absolute);
+        this.instanceKey = instanceKey;
+        this.http = http ?? throw new ArgumentNullException(nameof(http));
+    }
+
+    public async Task<GatewayCharacterLease> ResolveAndAcquireAsync(Guid accountId, Guid sessionId,
+        string displayName, CancellationToken cancellationToken = default)
+    {
+        var resolveRequest = new CharacterIdentityResolveRequestV1
+        {
+            CorrelationId = Guid.NewGuid(), AccountId = accountId, SessionId = sessionId,
+            DisplayName = displayName
+        };
+        if (!resolveRequest.IsValid())
+            throw new ArgumentException("Character identity request is invalid.", nameof(displayName));
+
+        using var resolveMessage = new HttpRequestMessage(HttpMethod.Post,
+            new Uri(gateway, "api/v1/game/characters/resolve-identity"));
+        resolveMessage.Headers.Authorization = new AuthenticationHeaderValue("Bearer", instanceKey);
+        resolveMessage.Content = JsonContent.Create(resolveRequest);
+        using var resolveResponse = await http.SendAsync(resolveMessage, cancellationToken).ConfigureAwait(false);
+        if (!resolveResponse.IsSuccessStatusCode)
+            throw new HttpRequestException($"Gateway character identity resolution failed with HTTP {(int)resolveResponse.StatusCode}.");
+        var identity = await resolveResponse.Content.ReadFromJsonAsync<CharacterIdentityResolveResultV1>(
+            cancellationToken: cancellationToken).ConfigureAwait(false);
+        if (identity is null || !identity.IsValid() || identity.CorrelationId != resolveRequest.CorrelationId ||
+            !identity.Accepted || identity.CharacterId is not > 0 || string.IsNullOrWhiteSpace(identity.LeaseTicket))
+            throw new InvalidDataException("Gateway character identity response is invalid.");
+
+        var leaseTokenPayload = Encoding.UTF8.GetBytes(
+            $"character-lease-v1:{accountId:D}:{sessionId:D}:{identity.CharacterId.Value}");
+        var instanceKeyBytes = Encoding.UTF8.GetBytes(instanceKey);
+        var leaseTokenBytes = HMACSHA256.HashData(instanceKeyBytes, leaseTokenPayload);
+        var leaseToken = Convert.ToBase64String(leaseTokenBytes).TrimEnd('=').Replace('+', '-').Replace('/', '_');
+        CryptographicOperations.ZeroMemory(leaseTokenBytes);
+        CryptographicOperations.ZeroMemory(leaseTokenPayload);
+        CryptographicOperations.ZeroMemory(instanceKeyBytes);
+        var acquireRequest = new CharacterLeaseAcquireRequestV1
