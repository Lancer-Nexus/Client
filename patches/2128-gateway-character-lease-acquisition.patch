+        private void StartGatewayLeaseRenewal()
+        {
+            if (GatewayCharacterId <= 0 || string.IsNullOrWhiteSpace(GatewayLeaseToken) || GatewayLeaseVersion <= 0)
+                return;
+            if (GatewayLeaseValidUntilUtc <= DateTimeOffset.UtcNow)
+            {
+                if (!TransferInProgress) Client.Disconnect(DisconnectReason.LoginError);
+                return;
+            }
+            var cancellation = new CancellationTokenSource();
+            var previous = Interlocked.Exchange(ref gatewayLeaseRenewalCancellation, cancellation);
+            previous?.Cancel();
+            gatewayLeaseRenewalTask = Task.Run(async () =>
+            {
+                while (!cancellation.IsCancellationRequested)
+                {
+                    var remaining = GatewayLeaseValidUntilUtc - DateTimeOffset.UtcNow;
+                    if (remaining <= TimeSpan.Zero)
+                    {
+                        if (!TransferInProgress) Client.Disconnect(DisconnectReason.LoginError);
+                        return;
+                    }
+                    var delay = remaining <= TimeSpan.FromSeconds(10)
+                        ? TimeSpan.Zero
+                        : TimeSpan.FromTicks(Math.Max(TimeSpan.FromSeconds(5).Ticks, remaining.Ticks / 3));
+                    try { await Task.Delay(delay, cancellation.Token).ConfigureAwait(false); }
+                    catch (OperationCanceledException) { return; }
+                    try
+                    {
+                        var renewed = await Game.RenewCharacterLeaseAsync(GatewayCharacterId, GatewayLeaseToken!,
+                            GatewayLeaseVersion, cancellation.Token).ConfigureAwait(false);
+                        if (renewed.LeaseVersion != GatewayLeaseVersion || renewed.ValidUntilUtc <= DateTimeOffset.UtcNow)
+                            throw new InvalidDataException("Gateway returned an invalid lease renewal.");
+                        GatewayLeaseValidUntilUtc = renewed.ValidUntilUtc;
+                    }
+                    catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { return; }
+                    catch (Exception error)
+                    {
+                        FLLog.Warning("Gateway", $"Character lease renewal failed ({error.GetType().Name}).");
+                        var stillValid = GatewayLeaseValidUntilUtc - DateTimeOffset.UtcNow;
+                        if (stillValid <= TimeSpan.FromSeconds(10))
+                        {
+                            if (!TransferInProgress) Client.Disconnect(DisconnectReason.LoginError);
+                            return;
+                        }
+                        try { await Task.Delay(TimeSpan.FromSeconds(Math.Min(15, stillValid.TotalSeconds / 2)),
+                            cancellation.Token).ConfigureAwait(false); }
+                        catch (OperationCanceledException) { return; }
+                    }
+                }
+            }, cancellation.Token);
+        }
