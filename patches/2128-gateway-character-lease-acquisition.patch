diff --git a/src/LibreLancer.Tests/GatewayCharacterLeaseClientTests.cs b/src/LibreLancer.Tests/GatewayCharacterLeaseClientTests.cs
new file mode 100644
index 000000000..11508ffd7
--- /dev/null
+++ b/src/LibreLancer.Tests/GatewayCharacterLeaseClientTests.cs
@@ -0,0 +1,123 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Net;
+using System.Net.Http;
+using System.Net.Http.Json;
+using System.Threading;
+using System.Threading.Tasks;
+using LancerNexus.Protocol;
+using LibreLancer.Server;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public sealed class GatewayCharacterLeaseClientTests
+{
+    [Fact]
+    public async Task ResolvesStableIdThenAcquiresItsSignedLease()
+    {
+        var handler = new Handler();
+        using var http = new HttpClient(handler);
+        var account = Guid.NewGuid();
+        var session = Guid.NewGuid();
+        var client = new GatewayCharacterLeaseClient(new Uri("https://gateway.test"), new string('k', 32), http);
+
+        var lease = await client.ResolveAndAcquireAsync(account, session, "Pilot One");
+
+        Assert.Equal(918, lease.CharacterId);
+        Assert.Equal(1, lease.LeaseVersion);
+        Assert.Equal("lj1.signed", handler.AcquireRequest!.JoinTicket);
+        Assert.Equal(918, handler.AcquireRequest.CharacterId);
+        Assert.Equal(43, handler.AcquireRequest.LeaseToken.Length);
+        Assert.Equal(new[]
+        {
+            "/api/v1/game/characters/resolve-identity",
+            "/api/v1/game/acquire-character-lease"
+        }, handler.Paths);
+        Assert.All(handler.Authorizations, value => Assert.Equal("Bearer " + new string('k', 32), value));
+    }
+
+    [Fact]
+    public async Task RenewsTheSameLeaseFenceAndToken()
+    {
+        var handler = new Handler();
+        using var http = new HttpClient(handler);
+        var client = new GatewayCharacterLeaseClient(new Uri("https://gateway.test"), new string('k', 32), http);
+        var acquired = await client.ResolveAndAcquireAsync(Guid.NewGuid(), Guid.NewGuid(), "Pilot One");
+
+        var renewed = await client.RenewAsync(acquired.CharacterId, acquired.LeaseToken, acquired.LeaseVersion);
+
+        Assert.Equal(acquired.CharacterId, renewed.CharacterId);
+        Assert.Equal(acquired.LeaseToken, renewed.LeaseToken);
+        Assert.Equal(acquired.LeaseVersion, renewed.LeaseVersion);
+        Assert.Equal("/api/v1/game/renew-character-lease", handler.Paths[^1]);
+        Assert.Equal(acquired.LeaseToken, handler.RenewRequest!.LeaseToken);
+        Assert.Equal(acquired.LeaseVersion, handler.RenewRequest.LeaseVersion);
+    }
+
+    [Fact]
+    public async Task RejectsMismatchedIdentityCorrelationBeforeAcquiringLease()
+    {
+        var handler = new Handler(mismatchCorrelation: true);
+        using var http = new HttpClient(handler);
+        var client = new GatewayCharacterLeaseClient(new Uri("https://gateway.test"), "instance-key-value-0123456789abcdef", http);
+
+        await Assert.ThrowsAsync<InvalidDataException>(() =>
+            client.ResolveAndAcquireAsync(Guid.NewGuid(), Guid.NewGuid(), "Pilot One"));
+        Assert.Single(handler.Paths);
+    }
+
+    private sealed class Handler(bool mismatchCorrelation = false) : HttpMessageHandler
+    {
+        public List<string> Paths { get; } = [];
+        public List<string?> Authorizations { get; } = [];
+        public CharacterLeaseAcquireRequestV1? AcquireRequest { get; private set; }
+        public CharacterLeaseRenewRequestV1? RenewRequest { get; private set; }
+
+        protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request,
+            CancellationToken cancellationToken)
+        {
+            Paths.Add(request.RequestUri!.AbsolutePath);
+            Authorizations.Add(request.Headers.Authorization?.ToString());
+            if (request.RequestUri.AbsolutePath.EndsWith("resolve-identity", StringComparison.Ordinal))
+            {
+                var body = await request.Content!.ReadFromJsonAsync<CharacterIdentityResolveRequestV1>(
+                    cancellationToken: cancellationToken);
+                return new HttpResponseMessage(HttpStatusCode.OK)
+                {
+                    Content = JsonContent.Create(new CharacterIdentityResolveResultV1
+                    {
+                        CorrelationId = mismatchCorrelation ? Guid.NewGuid() : body!.CorrelationId,
+                        Accepted = true, ReasonCode = "resolved", CharacterId = 918, LeaseTicket = "lj1.signed"
+                    })
+                };
+            }
+
+            if (request.RequestUri.AbsolutePath.EndsWith("renew-character-lease", StringComparison.Ordinal))
+            {
+                RenewRequest = await request.Content!.ReadFromJsonAsync<CharacterLeaseRenewRequestV1>(
+                    cancellationToken: cancellationToken);
+                return new HttpResponseMessage(HttpStatusCode.OK)
+                {
+                    Content = JsonContent.Create(new CharacterLeaseRenewResultV1
+                    {
+                        CorrelationId = RenewRequest!.CorrelationId, Accepted = true, ReasonCode = "renewed",
+                        LeaseVersion = RenewRequest.LeaseVersion, ValidUntilUtc = DateTimeOffset.UtcNow.AddMinutes(15)
+                    })
+                };
+            }
+
+            AcquireRequest = await request.Content!.ReadFromJsonAsync<CharacterLeaseAcquireRequestV1>(
+                cancellationToken: cancellationToken);
+            return new HttpResponseMessage(HttpStatusCode.OK)
+            {
+                Content = JsonContent.Create(new CharacterLeaseAcquireResultV1
+                {
+                    CorrelationId = AcquireRequest!.CorrelationId, Accepted = true, ReasonCode = "acquired",
+                    LeaseVersion = 1, ValidUntilUtc = DateTimeOffset.UtcNow.AddMinutes(15)
+                })
+            };
+        }
+    }
+}
