+++ b/src/LibreLancer.Tests/DetailMapPbrRoutingTests.cs
@@ -0,0 +1,22 @@
+using System.Reflection;
+using LibreLancer.Render.Materials;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public class DetailMapPbrRoutingTests
+{
+    [Fact]
+    public void DetailMapMaterialRoutesMatNormalSamplerThroughPbrWhenLit()
+    {
+        var material = new DetailMapMaterial(null!, "diffuse", "detail")
+        {
+            NmSampler = "hull_normal"
+        };
+        var needsPbr = typeof(DetailMapMaterial).GetMethod("NeedsPbr",
+            BindingFlags.Instance | BindingFlags.NonPublic)!;
+
+        Assert.True((bool)needsPbr.Invoke(material, [true])!);
+        Assert.False((bool)needsPbr.Invoke(material, [false])!);
+    }
+}
