+++ b/src/LibreLancer.Base/Graphics/Backends/SDL3/SDL3GpuDeviceOwner.cs
@@ -0,0 +1,49 @@
+using System;
+using LibreLancer.Platforms;
+
+namespace LibreLancer.Graphics.Backends.SDL3Gpu;
+
+/// <summary>
+/// Owns an SDL_GPU device and drains its submitted work before destroying it.
+/// SDL video initialization and windows remain owned by the platform host.
+/// </summary>
+internal sealed class SDL3GpuDeviceOwner : IDisposable
+{
+    private IntPtr device;
+
+    public IntPtr Handle => device != IntPtr.Zero
+        ? device
+        : throw new ObjectDisposedException(nameof(SDL3GpuDeviceOwner));
+
+    private SDL3GpuDeviceOwner(IntPtr device) => this.device = device;
+
+    public static SDL3GpuDeviceOwner Create(SDL3.SDL_GPUShaderFormat formats,
+        bool debugMode = false, string? driver = null)
+    {
+        var created = SDL3.SDL_CreateGPUDevice(formats, debugMode, driver!);
+        if (created == IntPtr.Zero)
+            throw new InvalidOperationException($"SDL_GPU device creation failed: {SDL3.SDL_GetError()}");
+
+        return new SDL3GpuDeviceOwner(created);
+    }
+
+    public string Driver => SDL3.SDL_GetGPUDeviceDriver(Handle) ?? "unknown";
+
+    public void Dispose()
+    {
+        var owned = device;
+        if (owned == IntPtr.Zero)
+            return;
+
+        device = IntPtr.Zero;
+        try
+        {
+            if (!SDL3.SDL_WaitForGPUIdle(owned))
+                throw new InvalidOperationException($"SDL_GPU device idle wait failed: {SDL3.SDL_GetError()}");
+        }
+        finally
+        {
+            SDL3.SDL_DestroyGPUDevice(owned);
+        }
+    }
+}
