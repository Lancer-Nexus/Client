+		private void TryAcquireSurfaceNormal(IVertexType vertexType, RenderContext rstate)
+		{
+			if (activeSurfaceNormal != null)
+				throw new InvalidOperationException("Surface normal lease was not released after the preceding draw");
+			var library = Library;
+			var reference = SurfaceBinding?.Normal;
+			var tangentFormat = vertexType is VertexPositionNormalTextureTangent or DfmTangentVertex or
+				FVFVertex { Normal: true, TexCoords: 3 or 4 };
+			if (surfaceNormalLoadFailed || library == null || !library.SurfaceNormalMapsEnabled ||
+				(vertexType is VertexPositionNormalTextureTangent && !library.SurfaceGeneratedTangentsEnabled) ||
+				library.SurfaceGpuTextures is not { } gpuCache ||
+				reference == null || !tangentFormat)
+				return;
+			try
+			{
+				activeSurfaceNormal = gpuCache.TryAcquireResident(reference);
+				if (activeSurfaceNormal == null)
+				{
+					using var cpuImage = library.SurfaceImages.TryAcquireResident(reference);
+					if (cpuImage != null)
+						activeSurfaceNormal = gpuCache.TryAcquire(reference, cpuImage);
+					else
+					{
+						Interlocked.CompareExchange(ref surfaceImageLoadState, 0, 2);
+						QueueSurfaceImageLoad(library, reference);
+					}
+				}
+				if (activeSurfaceNormal == null) return;
+				activeSurfaceNormalStrength = SurfaceBinding!.NormalStrength;
+				previousSurfaceTexture = rstate.Textures[2];
+				surfaceTextureBound = true;
+			}
+			catch (Exception ex) when (ex is IOException or InvalidDataException or KeyNotFoundException or NotSupportedException)
+			{
+				surfaceNormalLoadFailed = true;
+				FLLog.Warning("Surface", $"Unable to load detail-map normal map for {DtSampler}: {ex.Message}");
+			}
+		}
+
+		private void QueueSurfaceImageLoad(ResourceManager library, SurfaceTextureReference reference)
+		{
+			if (Volatile.Read(ref surfaceImageLoadState) != 0 || Environment.TickCount64 < Volatile.Read(ref nextSurfaceImageAttempt))
+				return;
+			if (Interlocked.CompareExchange(ref surfaceImageLoadState, 1, 0) != 0) return;
+			_ = Task.Run(() => {
+				SurfaceImageLease? image = null;
+				try {
+					image = library.SurfaceImages.TryAcquire(reference);
+					if (image == null) {
+						Volatile.Write(ref nextSurfaceImageAttempt, Environment.TickCount64 + 1000);
+						Volatile.Write(ref surfaceImageLoadState, 0);
+					} else {
+						image.Dispose();
+						image = null;
+						Volatile.Write(ref surfaceImageLoadState, 2);
+					}
+				} catch (Exception ex) {
+					surfaceNormalLoadFailed = true;
+					Volatile.Write(ref surfaceImageLoadState, 3);
+					FLLog.Warning("Surface", $"Unable to preload detail-map normal map for {DtSampler}: {ex.Message}");
+				} finally {
+					image?.Dispose();
+				}
+			});
+		}
+
+		public override void AfterDraw(RenderContext rstate)
+		{
+			if (activeSurfaceNormal == null) return;
+			try {
+				if (surfaceTextureBound) rstate.Textures[2] = previousSurfaceTexture;
+			} finally {
+				surfaceTextureBound = false;
+				previousSurfaceTexture = null;
+				activeSurfaceNormal.Dispose();
+				activeSurfaceNormal = null;
+			}
+		}
 
