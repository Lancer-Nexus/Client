+using System.Numerics;
+using System.Runtime.InteropServices;
+
+namespace LibreLancer.Graphics.Vertices;
+
+/// <summary>Position, normal, two UV sets and a tangent encoded in TEXCOORD2/3.</summary>
+[StructLayout(LayoutKind.Sequential)]
+public struct VertexPositionNormalTextureTangent : IVertexType
+{
+    public Vector3 Position;
+    public Vector3 Normal;
+    public Vector2 TextureCoordinate;
+    public Vector2 TextureCoordinate2;
+    public Vector2 Tangent0;
+    public Vector2 Tangent1;
+
+    public VertexPositionNormalTextureTangent(Vector3 position, Vector3 normal, Vector2 textureCoordinate,
+        Vector4 tangent)
+    {
+        Position = position;
+        Normal = normal;
+        TextureCoordinate = textureCoordinate;
+        TextureCoordinate2 = textureCoordinate;
+        Tangent0 = new Vector2(tangent.X, tangent.Y);
+        Tangent1 = new Vector2(tangent.Z, tangent.W);
+    }
+
+    public VertexDeclaration GetVertexDeclaration() => new(
+        sizeof(float) * 14,
+        new VertexElement(VertexSlots.Position, 3, VertexElementType.Float, false, 0),
+        new VertexElement(VertexSlots.Normal, 3, VertexElementType.Float, false, sizeof(float) * 3),
+        new VertexElement(VertexSlots.Texture1, 2, VertexElementType.Float, false, sizeof(float) * 6),
+        new VertexElement(VertexSlots.Texture2, 2, VertexElementType.Float, false, sizeof(float) * 8),
+        new VertexElement(VertexSlots.Texture3, 2, VertexElementType.Float, false, sizeof(float) * 10),
+        new VertexElement(VertexSlots.Texture4, 2, VertexElementType.Float, false, sizeof(float) * 12));
+}
