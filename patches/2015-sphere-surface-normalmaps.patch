+    private static VertexPositionNormalTextureTangent[] BuildTangentVertices(
+        VertexPositionNormalTexture[] source, ushort[] triangleIndices)
+    {
+        var tangentSums = new Vector3[source.Length];
+        var bitangentSums = new Vector3[source.Length];
+        for (var i = 0; i < triangleIndices.Length; i += 3)
+        {
+            var i0 = triangleIndices[i];
+            var i1 = triangleIndices[i + 1];
+            var i2 = triangleIndices[i + 2];
+            var v0 = source[i0];
+            var v1 = source[i1];
+            var v2 = source[i2];
+            var edge1 = v1.Position - v0.Position;
+            var edge2 = v2.Position - v0.Position;
+            var uv1 = v1.TextureCoordinate - v0.TextureCoordinate;
+            var uv2 = v2.TextureCoordinate - v0.TextureCoordinate;
+            var determinant = uv1.X * uv2.Y - uv1.Y * uv2.X;
+            if (MathF.Abs(determinant) < 1e-10f)
+                continue;
+            var inverse = 1.0f / determinant;
+            var tangent = (edge1 * uv2.Y - edge2 * uv1.Y) * inverse;
+            var bitangent = (edge2 * uv1.X - edge1 * uv2.X) * inverse;
+            tangentSums[i0] += tangent;
+            tangentSums[i1] += tangent;
+            tangentSums[i2] += tangent;
+            bitangentSums[i0] += bitangent;
+            bitangentSums[i1] += bitangent;
+            bitangentSums[i2] += bitangent;
+        }
+
+        var result = new VertexPositionNormalTextureTangent[source.Length];
+        for (var i = 0; i < source.Length; i++)
+        {
+            var normal = Vector3.Normalize(source[i].Normal);
+            var tangent = tangentSums[i] - normal * Vector3.Dot(normal, tangentSums[i]);
+            if (tangent.LengthSquared() < 1e-12f)
+            {
+                var axis = MathF.Abs(normal.Z) < 0.999f ? Vector3.UnitZ : Vector3.UnitY;
+                tangent = Vector3.Cross(axis, normal);
+            }
+            tangent = Vector3.Normalize(tangent);
+            var handedness = Vector3.Dot(Vector3.Cross(normal, tangent), bitangentSums[i]) < 0 ? -1.0f : 1.0f;
+            result[i] = new VertexPositionNormalTextureTangent(source[i].Position, normal,
+                source[i].TextureCoordinate, new Vector4(tangent, handedness));
+        }
+        return result;
     }
 
