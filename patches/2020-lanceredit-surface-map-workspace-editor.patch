+namespace LancerEdit;
+
+/// <summary>Persists user Surface metadata outside the installed Freelancer or NAP files.</summary>
+public sealed class SurfaceMapWorkspace
+{
+    private readonly Dictionary<string, SurfaceNormalMap> normalMaps = new(StringComparer.OrdinalIgnoreCase);
+
+    public string VirtualPath { get; }
+    public string FilePath { get; }
+    public IReadOnlyDictionary<string, SurfaceNormalMap> NormalMaps => normalMaps;
+
+    public SurfaceMapWorkspace(string virtualPath, string filePath)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(virtualPath);
+        ArgumentException.ThrowIfNullOrWhiteSpace(filePath);
+        VirtualPath = virtualPath.Replace('\\', '/');
+        FilePath = Path.GetFullPath(filePath);
+        Load();
+    }
+
+    public void Set(SurfaceNormalMap normalMap)
+    {
+        ArgumentNullException.ThrowIfNull(normalMap);
+        if (string.IsNullOrWhiteSpace(normalMap.Texture) || string.IsNullOrWhiteSpace(normalMap.Library) ||
+            string.IsNullOrWhiteSpace(normalMap.Map) || !float.IsFinite(normalMap.Strength) ||
+            normalMap.Strength is < 0 or > 16 || normalMap.UvChannel is < 0 or > 1)
+            throw new ArgumentException("Surface normal-map mapping is incomplete or out of range.", nameof(normalMap));
+        if (normalMap.Roughness is { } roughness && (!float.IsFinite(roughness) || roughness is < 0 or > 1))
+            throw new ArgumentException("Surface roughness must be between 0 and 1.", nameof(normalMap));
+        if (normalMap.Metallic is { } metallic && (!float.IsFinite(metallic) || metallic is < 0 or > 1))
+            throw new ArgumentException("Surface metallic must be between 0 and 1.", nameof(normalMap));
+
+        var updated = normalMaps.Values.Where(x => !x.Texture.Equals(normalMap.Texture, StringComparison.OrdinalIgnoreCase))
+            .Append(normalMap).OrderBy(x => x.Texture, StringComparer.OrdinalIgnoreCase).ToArray();
+        Save(updated);
+        normalMaps[normalMap.Texture] = normalMap;
+    }
+
+    private void Load()
+    {
+        if (!File.Exists(FilePath)) return;
+        using var input = File.OpenRead(FilePath);
+        var sections = IniFile.ParseFile(VirtualPath, input)
+            .Where(x => x.Name.Equals("NormalMap", StringComparison.OrdinalIgnoreCase)).ToArray();
+        var parsed = new SurfaceMapsIni();
+        parsed.AddSections(sections);
+        foreach (var (texture, normalMap) in parsed.NormalMaps)
+            normalMaps[texture] = normalMap;
+    }
+
+    private void Save(IEnumerable<SurfaceNormalMap> entries)
+    {
+        var builder = new IniBuilder();
+        foreach (var map in entries)
+        {
+            var section = builder.Section("NormalMap")
+                .Entry("texture", map.Texture)
+                .Entry("library", map.Library)
+                .Entry("map", map.Map)
+                .Entry("strength", map.Strength)
+                .Entry("uv", map.UvChannel);
+            section.OptionalEntry("roughness_map", map.RoughnessMap)
+                .OptionalEntry("metallic_map", map.MetallicMap);
+            if (map.Roughness is { } roughness) section.Entry("roughness", roughness);
+            if (map.Metallic is { } metallic) section.Entry("metallic", metallic);
+        }
+
+        var directory = Path.GetDirectoryName(FilePath)!;
+        Directory.CreateDirectory(directory);
+        var temporary = FilePath + ".tmp";
+        try
+        {
+            IniWriter.WriteIniFile(temporary, builder.Sections);
+            File.Move(temporary, FilePath, true);
+        }
+        finally
+        {
+            if (File.Exists(temporary)) File.Delete(temporary);
+        }
+    }
+}
+
+/// <summary>Maps one virtual Surface INI path to a private LancerEdit workspace file.</summary>
+internal sealed class SurfaceMapWorkspaceFileProvider : IFileProvider
+{
+    private readonly string virtualPath;
+    private readonly string filePath;
+
+    public SurfaceMapWorkspaceFileProvider(string virtualPath, string filePath)
+    {
+        this.virtualPath = Normalize(virtualPath);
+        this.filePath = Path.GetFullPath(filePath);
+    }
+
+    public Stream? Open(string filename) => Matches(filename) && File.Exists(filePath)
+        ? File.OpenRead(filePath)
+        : null;
+
+    public bool FileExists(string filename) => Matches(filename) && File.Exists(filePath);
+
+    public bool GetBackingFileName(string path, out string? fileName)
+    {
+        fileName = null;
+        if (!Matches(path)) return false;
+        Directory.CreateDirectory(Path.GetDirectoryName(filePath)!);
+        fileName = filePath;
+        return true;
+    }
+
+    public IEnumerable<string> GetFiles(string path) => Array.Empty<string>();
+    public IEnumerable<string> GetDirectories(string path) => Array.Empty<string>();
+    public void Refresh() { }
+
+    private bool Matches(string path) => Normalize(path).Equals(virtualPath, StringComparison.OrdinalIgnoreCase);
+
+    private static string Normalize(string path) => path.Replace('\\', '/').TrimStart('/').TrimEnd('/');
+}

