+
+        private void StartSurfaceMappingValidation(string texture, SurfaceMapEditState state)
+        {
+            if (!float.IsFinite(state.Strength) || state.Strength is < 0 or > 16 || state.UvChannel is < 0 or > 1 ||
+                (state.HasRoughnessFactor && (!float.IsFinite(state.RoughnessFactor) || state.RoughnessFactor is < 0 or > 1)) ||
+                (state.HasMetallicFactor && (!float.IsFinite(state.MetallicFactor) || state.MetallicFactor is < 0 or > 1)))
+            {
+                state.Status = "Strength, UV channel or PBR factor is outside its valid range.";
+                return;
+            }
+            if (!res.SurfaceMaps.Libraries.TryGetValue(state.Library, out var library))
+            {
+                state.Status = "Select a library present in the loaded Surface catalog.";
+                return;
+            }
+            if (string.IsNullOrWhiteSpace(state.NormalNode))
+            {
+                state.Status = "A normal-map UTF node is required.";
+                return;
+            }
+
+            var pending = new SurfaceNormalMap(texture, state.Library, state.NormalNode, state.Strength,
+                string.IsNullOrWhiteSpace(state.RoughnessNode) ? null : state.RoughnessNode,
+                state.HasRoughnessFactor ? state.RoughnessFactor : null,
+                string.IsNullOrWhiteSpace(state.MetallicNode) ? null : state.MetallicNode,
+                state.HasMetallicFactor ? state.MetallicFactor : null,
+                state.UvChannel);
+            var vfs = _window.OpenDataContext!.GameData.VFS;
+            var references = new List<SurfaceTextureReference>
+            {
+                new(library.Name, library.File, pending.Map)
+            };
+            if (pending.RoughnessMap is { Length: > 0 } roughness)
+                references.Add(new(library.Name, library.File, roughness));
+            if (pending.MetallicMap is { Length: > 0 } metallic)
+                references.Add(new(library.Name, library.File, metallic));
+            state.Pending = pending;
+            state.Status = "Validating referenced UTF texture nodes…";
+            state.ValidationTask = Task.Run(() =>
+            {
+                foreach (var reference in references)
+                    _ = SurfaceTextureReader.Read(vfs, reference);
+            });
+        }
+
+        private static void CompleteSurfaceMappingValidation(string texture, SurfaceMapEditState state,
+            SurfaceMapWorkspace? workspace)
+        {
+            if (state.ValidationTask is not { IsCompleted: true } task) return;
+            state.ValidationTask = null;
+            try
+            {
+                task.GetAwaiter().GetResult();
+                if (workspace == null || state.Pending == null)
+                    throw new InvalidOperationException("The Surface workspace is no longer available.");
+                workspace.Set(state.Pending);
+                state.Status = $"Validated and saved {texture}. Reload Data to apply it.";
+            }
+            catch (Exception ex)
+            {
+                state.Status = $"Validation failed: {ex.GetBaseException().Message}";
+            }
+            finally
+            {
+                state.Pending = null;
+            }
+        }
