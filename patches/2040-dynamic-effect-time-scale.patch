diff --git a/src/LibreLancer.Tests/EffectLightTimingTests.cs b/src/LibreLancer.Tests/EffectLightTimingTests.cs
new file mode 100644
--- /dev/null
+++ b/src/LibreLancer.Tests/EffectLightTimingTests.cs
@@ -0,0 +1,68 @@
+using System.Numerics;
+using LibreLancer.Data.Ini;
+using LibreLancer.Data.Schema.Effects;
+using LibreLancer.Data.Schema;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public class EffectLightTimingTests
+{
+    [Fact]
+    public void EffectTimeScaleDefaultsToOneAndParsesExplicitValue()
+    {
+        static Section MakeEffect(float? scale)
+        {
+            var section = new Section("Effect");
+            var nickname = new Entry(section, "nickname");
+            nickname.Add("explosion_test");
+            section.Add(nickname);
+            if (scale.HasValue)
+            {
+                var entry = new Entry(section, "lgt_time_scale");
+                entry.Add(scale.Value);
+                section.Add(entry);
+            }
+            return section;
+        }
+
+        Assert.True(Effect.TryParse(MakeEffect(null), out var defaults));
+        Assert.Equal(1f, defaults!.LgtTimeScale);
+        Assert.True(Effect.TryParse(MakeEffect(2.5f), out var parsed));
+        Assert.Equal(2.5f, parsed!.LgtTimeScale);
+    }
+
+    [Fact]
+    public void ScaledLightAnimationUsesElapsedTimeTimesScale()
+    {
+        var animation = new LightAnim("test",
+        [
+            new LightAnimFrame(0, Vector3.Zero, 0),
+            new LightAnimFrame(1, Vector3.One, 1)
+        ]);
+
+        var sample = animation.Sample(0.25f, 2f);
+
+        Assert.Equal(0.5f, sample.Time);
+        Assert.Equal(0.5f, sample.Intensity);
+        Assert.Equal(new Vector3(0.5f), sample.Color);
+    }
+
+    [Fact]
+    public void NonPositiveOrNonFiniteTimeScaleFallsBackToNormalSpeed()
+    {
+        Assert.Equal(0.5f, LightAnim.ScalePlaybackTime(0.5f, 0));
+        Assert.Equal(0.5f, LightAnim.ScalePlaybackTime(0.5f, float.NaN));
+        Assert.Equal(0f, LightAnim.ScalePlaybackTime(-1, 1));
+    }
+
+    [Fact]
+    public void TimeScaleChangesTransientLightPlaybackLifetime()
+    {
+        var animation = new LightAnim("test", [new LightAnimFrame(1, Vector3.One, 1)]);
+
+        Assert.False(animation.IsPlaybackComplete(0.49f, 2f));
+        Assert.True(animation.IsPlaybackComplete(0.5f, 2f));
+        Assert.False(animation.IsPlaybackComplete(0.5f, 1f));
+    }
+}
