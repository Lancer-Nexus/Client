From: Lancer Nexus
Subject: [PATCH] Reject launch when the player ship has no powercore

diff --git a/src/LibreLancer/Server/Player.cs b/src/LibreLancer/Server/Player.cs
--- a/src/LibreLancer/Server/Player.cs
+++ b/src/LibreLancer/Server/Player.cs
@@ -2963,5 +2963,12 @@ namespace LibreLancer.Server
                 return;
             }
 
+            if (!Character.Items.Any(item =>
+                    item.Equipment is LibreLancer.Data.GameData.Items.PowerEquipment))
+            {
+                rpcClient.OnConsoleMessage("You cannot launch without a powercore installed.");
+                return;
+            }
+
             ClearScan();
             var b = Game.GameData.Items.Bases.Get(Base)!;
             var sys = Game.GameData.Items.Systems.Get(b.System);
diff --git a/patches/series b/patches/series
--- a/patches/series
+++ b/patches/series
@@ -166,1 +166,2 @@ client 2164-add-gateway-market-trade-transport.patch
 client 2165-add-quote-bound-dynamic-market-trades.patch
+client 2166-block-launch-without-powercore.patch
