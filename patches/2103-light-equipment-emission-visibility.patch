+using LibreLancer.Render;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public sealed class LightEquipmentEmissionTests
+{
+    [Fact]
+    public void EmitRangeLightDoesNotDependOnBillboardVisibility()
+    {
+        Assert.True(LightEquipRenderer.ShouldEmitRangeLight(
+            forceCull: false,
+            lightOn: true,
+            showLight: true,
+            emitRange: 50f,
+            rangeIntersectsView: true));
+    }
+
+    [Theory]
+    [InlineData(true, true, true, 50f, true)]
+    [InlineData(false, false, true, 50f, true)]
+    [InlineData(false, true, false, 50f, true)]
+    [InlineData(false, true, true, 0f, true)]
+    [InlineData(false, true, true, -1f, true)]
+    [InlineData(false, true, true, 50f, false)]
+    public void EmitRangeLightHonorsItsOwnActivationAndRangeGates(
+        bool forceCull, bool lightOn, bool showLight, float emitRange, bool rangeIntersectsView)
+    {
+        Assert.False(LightEquipRenderer.ShouldEmitRangeLight(
+            forceCull, lightOn, showLight, emitRange, rangeIntersectsView));
+    }
+
+    [Theory]
+    [InlineData(float.NaN)]
+    [InlineData(float.PositiveInfinity)]
+    [InlineData(float.NegativeInfinity)]
+    public void EmitRangeLightRejectsNonFiniteRanges(float emitRange)
+    {
+        Assert.False(LightEquipRenderer.ShouldEmitRangeLight(
+            forceCull: false,
+            lightOn: true,
+            showLight: true,
+            emitRange: emitRange,
+            rangeIntersectsView: true));
+    }
+}

