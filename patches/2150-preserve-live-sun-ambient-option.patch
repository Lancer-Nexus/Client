From: Lancer Nexus Client overlay
Subject: [PATCH] Preserve live sun ambient selection when leaving options

---
--- a/uixml/options.lua
+++ b/uixml/options.lua
@@ -131,6 +131,7 @@
         e.sun_lens_glow.Selected = this.opts.RenderSunLensGlow
         e.sun_ambient.Selected = this.opts.RenderSunAmbient
         e.sun_ambient.OnClick(() => {
+            this.opts.RenderSunAmbient = e.sun_ambient.Selected
             local settings = Game.GetCurrentSettings()
             settings.RenderSunAmbient = e.sun_ambient.Selected
             Game.ApplySettings(settings)
