@@ -0,0 +1,74 @@
+using System;
+using System.IO;
+using LibreLancer.Data.IO;
+using LibreLancer.Data.Schema.Effects;
+using LibreLancer.Render;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public sealed class BeamBrightnessTests
+{
+    [Fact]
+    public void BrightnessScalesAlphaWithoutChangingRgb()
+    {
+        var result = BeamsBuffer.ApplyBeamBrightness(new Color4(0.2f, 0.4f, 0.8f, 0.75f), 0.4f);
+
+        Assert.Equal(0.2f, result.R);
+        Assert.Equal(0.4f, result.G);
+        Assert.Equal(0.8f, result.B);
+        Assert.Equal(0.3f, result.A, 5);
+    }
+
+    [Theory]
+    [InlineData(-1f, 0f)]
+    [InlineData(2f, 1f)]
+    public void BrightnessIsClampedToTheSupportedRange(float value, float expected)
+    {
+        var result = BeamsBuffer.ApplyBeamBrightness(Color4.White, value);
+
+        Assert.Equal(expected, result.A);
+    }
+
+    [Fact]
+    public void MissingBrightnessKeepsLegacyFullIntensity()
+    {
+        Assert.Equal(1f, new BeamBolt().HeadBrightness);
+        Assert.Equal(1f, new BeamBolt().TrailBrightness);
+        Assert.Equal(1f, new BeamSpear().HeadBrightness);
+        Assert.Equal(1f, new BeamSpear().TrailBrightness);
+    }
+
+    [Fact]
+    public void BeamIniParsesBrightnessForBothBeamKinds()
+    {
+        var root = Path.Combine(Path.GetTempPath(), "beam-brightness-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(root);
+        try
+        {
+            File.WriteAllText(Path.Combine(root, "beams.ini"), """
+                [BeamSpear]
+                nickname = spear
+                head_brightness = 0.25
+                trail_brightness = 0.75
+
+                [BeamBolt]
+                nickname = bolt
+                head_brightness = 0.5
+                trail_brightness = 0.625
+                """);
+
+            var parsed = new EffectsIni();
+            parsed.AddIni("beams.ini", FileSystem.FromPath(root));
+
+            Assert.Equal(0.25f, Assert.Single(parsed.BeamSpears).HeadBrightness);
+            Assert.Equal(0.75f, parsed.BeamSpears[0].TrailBrightness);
+            Assert.Equal(0.5f, Assert.Single(parsed.BeamBolts).HeadBrightness);
+            Assert.Equal(0.625f, parsed.BeamBolts[0].TrailBrightness);
+        }
+        finally
+        {
+            Directory.Delete(root, true);
+        }
+    }
+}
