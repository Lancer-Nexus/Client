+using System;
+using System.Numerics;
+
+namespace LibreLancer.Graphics;
+
+/// <summary>Runs SMAA edge detection, weights, and neighborhood blending as the final post-process pass.</summary>
+internal sealed class SmaaPostProcessPass : IPostProcessPass
+{
+    private readonly RenderContext renderContext;
+    private readonly AntialiasMode mode;
+    private readonly int width;
+    private readonly int height;
+    private readonly RenderTarget2D smaaEdges;
+    private readonly RenderTarget2D smaaBlend;
+
+    public long EstimatedMemoryBytes => 0;
+
+    public SmaaPostProcessPass(RenderContext renderContext, AntialiasMode mode, int width, int height,
+        RenderTarget2D smaaEdges, RenderTarget2D smaaBlend)
+    {
+        this.renderContext = renderContext;
+        this.mode = mode;
+        this.width = width;
+        this.height = height;
+        this.smaaEdges = smaaEdges;
+        this.smaaBlend = smaaBlend;
+    }
+
+    public void Execute(ref PostProcessContext context)
+    {
+        var tgt = context.Target;
+        var offset = context.Offset;
+        var sceneColor = context.Source;
+        var renderContext = context.Graphics;
+        // Save state
+        var t0 = renderContext.Textures[0];
+        var t1 = renderContext.Textures[1];
+        var t2 = renderContext.Textures[2];
+        var s0 = renderContext.Samplers[0];
+        var s1 = renderContext.Samplers[1];
+        var sTgt = renderContext.RenderTarget;
+        var shdr = renderContext.Shader;
+        var srcBlend = renderContext.BlendMode;
+        var stencil = renderContext.Stencil;
+        var stencilEnabled = renderContext.StencilEnabled;
+        bool depth = renderContext.DepthEnabled;
+        bool depthWrite = renderContext.DepthWrite;
+        bool colorWrite = renderContext.ColorWrite;
+        var clearColor = renderContext.ClearColor;
+        bool cull = renderContext.Cull;
+        bool viewportPushed = false;
+        bool scissorPushed = false;
+        bool offsetViewportPushed = false;
+        bool offsetScissorPushed = false;
+        try
+        {
+            renderContext.PushViewport(0, 0, width, height);
+            viewportPushed = true;
+            scissorPushed = renderContext.PushScissor(new(0, 0, width, height), false);
+            // Fetch shaders and set RT size
+            uint level = (uint)(mode - 1);
+            var rtMetrics = new Vector4(1.0f / width, 1.0f / height, width, height);
+            var edgeDetection = renderContext.SMAAEdgeDetection.Get(level);
+            edgeDetection.SetUniformBlock(3, ref rtMetrics);
+            var blendingWeightCalculation = renderContext.SMAABlendingWeightCalculation.Get(level);
+            blendingWeightCalculation.SetUniformBlock(3, ref rtMetrics);
+            var neighborhoodBlending = renderContext.SMAANeighborhoodBlending.Get(level);
+            neighborhoodBlending.SetUniformBlock(3, ref rtMetrics);
+            // SMAA global samplers
+            renderContext.Cull = false;
+            renderContext.Samplers[0] = new(TextureFiltering.Linear, WrapMode.ClampToEdge, WrapMode.ClampToEdge);
+            renderContext.Samplers[1] = new (TextureFiltering.Nearest, WrapMode.ClampToEdge, WrapMode.ClampToEdge);
+            // Edge detection pass
+            context.GpuSubpassMarker?.Invoke(SystemRenderSubpass.SmaaEdgeDetection, true);
+            try
+            {
+                BindSubpassTarget(SystemRenderSubpass.SmaaEdgeDetection, smaaEdges);
+                renderContext.Textures[0] = sceneColor;
+                renderContext.BlendMode = BlendMode.Opaque;
+                renderContext.DepthEnabled = false;
+                renderContext.Shader = edgeDetection;
+                renderContext.StencilEnabled = true;
+                renderContext.Stencil = new(StencilFunction.Always, StencilOperation.Replace, StencilOperation.Replace,
+                    StencilOperation.Replace, 1, 0xFFFFFFFF);
+                renderContext.DepthWrite = true;
+                renderContext.ClearDepth(); // clear depth and stencil
+                renderContext.FullScreenTriangle.Draw(PrimitiveTypes.TriangleList, 1);
+            }
+            finally { context.GpuSubpassMarker?.Invoke(SystemRenderSubpass.SmaaEdgeDetection, false); }
+            // Blending weight pass
+            context.GpuSubpassMarker?.Invoke(SystemRenderSubpass.SmaaBlendWeights, true);
+            try
+            {
+                BindSubpassTarget(SystemRenderSubpass.SmaaBlendWeights, smaaBlend);
+                // The stencil test limits writes to edge pixels. Clear the complete
+                // weight target first so untouched pixels cannot retain old-frame data.
+                renderContext.ColorWrite = true;
+                renderContext.ClearColor = Color4.TransparentBlack;
+                renderContext.ClearColorOnly();
+                renderContext.Textures[0] = smaaEdges.Texture;
+                renderContext.Textures[1] = renderContext.SMAAAreaTex;
+                renderContext.Textures[2] = renderContext.SMAASearchTex;
+                renderContext.Stencil = new(StencilFunction.Equal, StencilOperation.Keep, StencilOperation.Keep,
+                    StencilOperation.Keep, 1, 0xFFFFFFFF);
+                renderContext.Shader = blendingWeightCalculation;
+                renderContext.FullScreenTriangle.Draw(PrimitiveTypes.TriangleList, 1);
+            }
+            finally { context.GpuSubpassMarker?.Invoke(SystemRenderSubpass.SmaaBlendWeights, false); }
+            //Neighborhood blending pass
+            context.GpuSubpassMarker?.Invoke(SystemRenderSubpass.SmaaNeighborhoodBlend, true);
+            try
+            {
+                renderContext.StencilEnabled = false;
+                BindSubpassTarget(SystemRenderSubpass.SmaaNeighborhoodBlend, tgt);
+                renderContext.Textures[0] = sceneColor;
+                renderContext.Textures[1] = smaaBlend.Texture;
+                renderContext.Shader = neighborhoodBlending;
+                if (offset != Point.Zero)
+                {
+                    renderContext.PushViewport(offset.X, offset.Y, width, height);
+                    offsetViewportPushed = true;
+                    offsetScissorPushed = renderContext.PushScissor(new(offset.X, offset.Y, width, height), false);
+                }
+                renderContext.FullScreenTriangle.Draw(PrimitiveTypes.TriangleList, 1);
+                if (offset != Point.Zero)
+                {
+                    offsetScissorPushed = false;
+                    renderContext.PopScissor();
+                    offsetViewportPushed = false;
+                    renderContext.PopViewport();
+                }
+            }
+            finally { context.GpuSubpassMarker?.Invoke(SystemRenderSubpass.SmaaNeighborhoodBlend, false); }
+        }
+        finally
+        {
+            if (offsetScissorPushed) renderContext.PopScissor();
+            if (offsetViewportPushed) renderContext.PopViewport();
+            renderContext.Textures[0] = t0;
+            renderContext.Textures[1] = t1;
+            renderContext.Textures[2] = t2;
+            renderContext.Samplers[0] = s0;
+            renderContext.Samplers[1] = s1;
+            renderContext.BlendMode = srcBlend;
+            renderContext.RenderTarget = sTgt;
+            renderContext.Shader = shdr;
+            renderContext.DepthEnabled = depth;
+            renderContext.DepthWrite = depthWrite;
+            renderContext.ColorWrite = colorWrite;
+            renderContext.ClearColor = clearColor;
+            renderContext.Cull = cull;
+            renderContext.Stencil = stencil;
+            renderContext.StencilEnabled = stencilEnabled;
+            if (scissorPushed) renderContext.PopScissor();
+            if (viewportPushed) renderContext.PopViewport();
+        }
+    }
+
+    private void BindSubpassTarget(SystemRenderSubpass pass, RenderTarget? target)
+    {
+        var descriptor = SystemRenderPasses.GetSubpass(pass);
+        var expectedTarget = descriptor.Target switch
+        {
+            SystemRenderTargetRole.SmaaEdges => smaaEdges,
+            SystemRenderTargetRole.SmaaBlendWeights => smaaBlend,
+            SystemRenderTargetRole.Presentation => target,
+            _ => null
+        };
+        if (!ReferenceEquals(target, expectedTarget))
+            throw new InvalidOperationException(
+                $"SMAA subpass '{descriptor.Name}' was bound to an unexpected target.");
+        if (descriptor.Target is SystemRenderTargetRole.SmaaEdges or
+            SystemRenderTargetRole.SmaaBlendWeights && target is not RenderTarget2D)
+            throw new InvalidOperationException(
+                $"SMAA subpass '{descriptor.Name}' requires a 2D render target.");
+        if (descriptor.Stencil.HasValue &&
+            (target is not RenderTarget2D target2D || target2D.DepthBuffer?.HasStencil != true))
+            throw new InvalidOperationException(
+                $"SMAA subpass '{descriptor.Name}' requires its declared depth/stencil attachment.");
+        renderContext.RenderTarget = target;
+    }
+
+    public void Dispose() { }
+}
