+using System;
+using LibreLancer.Graphics;
+using LibreLancer.Graphics.Backends.OpenGL;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public class DepthFunctionBackendTests
+{
+    [Fact]
+    public void Less_MapsToOpenGlLess()
+    {
+        Assert.Equal(GL.GL_LESS, DepthFunction.Less.ToGL());
+    }
+
+    [Fact]
+    public void LessEqual_MapsToOpenGlLessEqual()
+    {
+        Assert.Equal(GL.GL_LEQUAL, DepthFunction.LessEqual.ToGL());
+    }
+
+    [Fact]
+    public void InvalidDepthFunction_IsRejected()
+    {
+        Assert.Throws<ArgumentOutOfRangeException>(() => ((DepthFunction)99).ToGL());
+    }
+}
