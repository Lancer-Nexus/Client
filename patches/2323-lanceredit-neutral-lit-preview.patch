From: Lancer Nexus
Subject: [PATCH] Use neutral ambient in LancerEdit lit model preview

diff --git a/src/Editor/LancerEdit/Model/ModelViewer.cs b/src/Editor/LancerEdit/Model/ModelViewer.cs
--- a/src/Editor/LancerEdit/Model/ModelViewer.cs
+++ b/src/Editor/LancerEdit/Model/ModelViewer.cs
@@ -75,7 +75,7 @@
         const int M_NORMALS = 3;
         const int M_NONE = 4;
 
-        Vector3 ambientColor = new(0.0f, 0.0f, 0.0f);
+        Vector3 ambientColor = new(0.25f, 0.25f, 0.25f);
 
         static readonly Color4[] initialCmpColors = new Color4[] {
             Color4.White,
diff --git a/src/Editor/LancerEdit/Model/ModelViewer.Viewport.cs b/src/Editor/LancerEdit/Model/ModelViewer.Viewport.cs
--- a/src/Editor/LancerEdit/Model/ModelViewer.Viewport.cs
+++ b/src/Editor/LancerEdit/Model/ModelViewer.Viewport.cs
@@ -58,7 +58,9 @@
             normalsDebugMaterial = new Material(new NormalDebugMaterial(res));
             lighting = Lighting.Create();
             lighting.Enabled = true;
-            lighting.Ambient = Color3f.Black;
+            // Keep the Lit preview inspectable even when the model surface faces
+            // away from the preview's fixed directional lights.
