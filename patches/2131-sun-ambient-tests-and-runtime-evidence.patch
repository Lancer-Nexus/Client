+
+    private static DynamicLight CreateSunAmbientLight(Color3f color,
+        LightKind kind = LightKind.Directional, Vector3 position = default,
+        Vector3? attenuation = null, float range = 100) => new()
+    {
+        Light = new RenderLight
+        {
+            Kind = kind,
+            Position = position,
+            Range = range,
+            Attenuation = attenuation ?? Vector3.One,
+            Color = color
+        }
+    };
