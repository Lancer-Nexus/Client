diff --git a/src/LibreLancer/GameStates/RoomMusicPlaylist.cs b/src/LibreLancer/GameStates/RoomMusicPlaylist.cs
new file mode 100644
--- /dev/null
+++ b/src/LibreLancer/GameStates/RoomMusicPlaylist.cs
@@ -0,0 +1,25 @@
+using System;
+using System.Collections.Generic;
+
+namespace LibreLancer;
+
+internal sealed class RoomMusicPlaylist(IReadOnlyList<string> tracks, Random random)
+{
+    private int previousIndex = -1;
+
+    public int NextIndex()
+    {
+        if (tracks.Count == 0)
+            return -1;
+        if (tracks.Count == 1)
+            return previousIndex = 0;
+
+        if (previousIndex < 0)
+            return previousIndex = random.Next(tracks.Count);
+
+        var next = random.Next(tracks.Count - 1);
+        if (next >= previousIndex)
+            next++;
+        return previousIndex = next;
+    }
+}
diff --git a/src/LibreLancer.Tests/RoomMusicPlaylistTests.cs b/src/LibreLancer.Tests/RoomMusicPlaylistTests.cs
new file mode 100644
--- /dev/null
+++ b/src/LibreLancer.Tests/RoomMusicPlaylistTests.cs
@@ -0,0 +1,63 @@
+using System;
+using System.IO;
+using System.Linq;
+using System.Text;
+using LibreLancer.Data.Ini;
+using LibreLancer.Data.Schema.Universe.Rooms;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public class RoomMusicPlaylistTests
+{
+    [Fact]
+    public void RoomSoundParsesMultipleTracksAndOneshot()
+    {
+        using var input = new MemoryStream(Encoding.UTF8.GetBytes("""
+            [Room_Sound]
+            music = music_bar_generic04, music_bar_generic05, music_bar_generic06, oneshot
+            """));
+        var section = Assert.Single(IniFile.ParseFile("room.ini", input, true, false));
+
+        Assert.True(RoomSound.TryParse(section, out var sound));
+        Assert.Equal("music_bar_generic04", sound!.Music);
+        Assert.Equal(new[] { "music_bar_generic04", "music_bar_generic05", "music_bar_generic06" }, sound.MusicTracks);
+        Assert.True(sound.MusicOneShot);
+    }
+
+    [Fact]
+    public void RoomSoundPreservesSingleTrackAndOneshotSyntax()
+    {
+        using var input = new MemoryStream(Encoding.UTF8.GetBytes("""
+            [Room_Sound]
+            music = music_newlondon, oneshot
+            """));
+        var section = Assert.Single(IniFile.ParseFile("room.ini", input, true, false));
+
+        Assert.True(RoomSound.TryParse(section, out var sound));
+        Assert.Equal("music_newlondon", sound!.Music);
+        Assert.Equal(new[] { "music_newlondon" }, sound.MusicTracks);
+        Assert.True(sound.MusicOneShot);
+    }
+
+    [Fact]
+    public void PlaylistNeverRepeatsThePreviousTrackUntilOnlyOneTrackExists()
+    {
+        var playlist = new RoomMusicPlaylist(new[] { "first", "second", "third" }, new Random(1234));
+        var selected = Enumerable.Range(0, 100).Select(_ => playlist.NextIndex()).ToArray();
+
+        Assert.All(selected, index => Assert.InRange(index, 0, 2));
+        for (var i = 1; i < selected.Length; i++)
+            Assert.NotEqual(selected[i - 1], selected[i]);
+    }
+
+    [Fact]
+    public void PlaylistWithZeroOrOneTrackHasStableSelection()
+    {
+        Assert.Equal(-1, new RoomMusicPlaylist(Array.Empty<string>(), new Random(1)).NextIndex());
+
+        var playlist = new RoomMusicPlaylist(new[] { "only" }, new Random(1));
+        Assert.Equal(0, playlist.NextIndex());
+        Assert.Equal(0, playlist.NextIndex());
+    }
+}
