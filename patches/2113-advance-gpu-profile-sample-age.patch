+using LibreLancer.Render;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public class GpuPassProfileTests
+{
+    [Fact]
+    public void SampleAgeAdvancesWithRenderedFrameSequence()
+    {
+        GpuPassProfile.Clear();
+        try
+        {
+            GpuPassProfile.SetSample(0, 2.5, 10, 10);
+            Assert.Equal(0, GpuPassProfile.GetSample(0)!.Value.AgeFrames);
+
+            GpuPassProfile.UpdateAges(11);
+            Assert.Equal(1, GpuPassProfile.GetSample(0)!.Value.AgeFrames);
+
+            GpuPassProfile.UpdateAges(14);
+            Assert.Equal(4, GpuPassProfile.GetSample(0)!.Value.AgeFrames);
+        }
+        finally
+        {
+            GpuPassProfile.Clear();
+        }
+    }
+}
