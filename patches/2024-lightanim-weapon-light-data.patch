diff --git a/src/LibreLancer.Data/Schema/LightAnimIni.cs b/src/LibreLancer.Data/Schema/LightAnimIni.cs
new file mode 100644
--- /dev/null
+++ b/src/LibreLancer.Data/Schema/LightAnimIni.cs
@@ -0,0 +1,98 @@
+// MIT License - Copyright (c) Callum McGing
+// This file is subject to the terms and conditions defined in
+// LICENSE, which is part of this source code package
+
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Numerics;
+using LibreLancer.Data.Ini;
+using LibreLancer.Data.IO;
+
+namespace LibreLancer.Data.Schema;
+
+public readonly record struct LightAnimFrame(float Time, Vector3 Color, float Intensity);
+
+public sealed class LightAnim
+{
+    public string Name { get; }
+    public IReadOnlyList<LightAnimFrame> Frames { get; }
+    public float Duration => Frames.Count == 0 ? 0 : Frames[^1].Time;
+
+    public LightAnim(string name, IEnumerable<LightAnimFrame> frames)
+    {
+        Name = name;
+        Frames = frames.OrderBy(f => f.Time).ToArray();
+    }
+
+    public LightAnimFrame Sample(float time)
+    {
+        if (Frames.Count == 0)
+            return default;
+        if (Frames.Count == 1 || time <= Frames[0].Time)
+            return Frames[0];
+        if (time >= Frames[^1].Time)
+            return Frames[^1];
+
+        for (var i = 1; i < Frames.Count; i++)
+        {
+            var right = Frames[i];
+            if (time > right.Time)
+                continue;
+            var left = Frames[i - 1];
+            var span = right.Time - left.Time;
+            if (span <= 0)
+                return right;
+            var amount = Math.Clamp((time - left.Time) / span, 0, 1);
+            return new LightAnimFrame(
+                time,
+                Vector3.Lerp(left.Color, right.Color, amount),
+                left.Intensity + ((right.Intensity - left.Intensity) * amount));
+        }
+
+        return Frames[^1];
+    }
+}
+
+public sealed class LightAnimIni
+{
+    private readonly Dictionary<string, LightAnim> animations = new(StringComparer.OrdinalIgnoreCase);
+
+    public LightAnim? Find(string? name) =>
+        name != null && animations.TryGetValue(name, out var animation) ? animation : null;
+
+    public void Load(string path, FileSystem vfs, IniStringPool? stringPool = null)
+    {
+        foreach (var section in IniFile.ParseFile(path, vfs, false, stringPool))
+        {
+            if (!section.Name.Equals("LightAnim", StringComparison.OrdinalIgnoreCase))
+                continue;
+
+            string? name = null;
+            List<LightAnimFrame> frames = [];
+            foreach (var entry in section)
+            {
+                if (entry.Name.Equals("name", StringComparison.OrdinalIgnoreCase) && entry.Count == 1)
+                {
+                    name = entry[0].ToString();
+                }
+                else if (entry.Name.Equals("frame", StringComparison.OrdinalIgnoreCase) && entry.Count == 5)
+                {
+                    var time = entry[0].ToSingle();
+                    var intensity = entry[4].ToSingle();
+                    if (!float.IsFinite(time) || !float.IsFinite(intensity) || time < 0 || intensity < 0)
+                        continue;
+
+                    var color = new Vector3(
+                        Math.Clamp(entry[1].ToInt32(), 0, 255) / 255f,
+                        Math.Clamp(entry[2].ToInt32(), 0, 255) / 255f,
+                        Math.Clamp(entry[3].ToInt32(), 0, 255) / 255f);
+                    frames.Add(new LightAnimFrame(time, color, intensity));
+                }
+            }
+
+            if (!string.IsNullOrWhiteSpace(name) && frames.Count > 0)
+                animations.TryAdd(name, new LightAnim(name, frames));
+        }
+    }
+}

