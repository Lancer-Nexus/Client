+
+        var eventHub = new FlHookCompatServerEventHub("li-01", durableJournalPath: journalPath);
+        eventHub.Publish(FlHookCompatServerEventKind.PlayerConnected, "account-01");
+        var coordinator = Task.Run(async () =>
