+                    ServerCertificate = coordinatorCertificate,
+                    RemoteCertificateValidationCallback = (_, certificate, _, _) =>
+                        certificate is X509Certificate2 peer && ChainsTo(peer, authority) && HasDnsSan(peer, "agent-01")
