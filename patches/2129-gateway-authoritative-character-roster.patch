+        public Task<long> EnsureGatewayCharacterCacheAsync(Guid playerGuid, string characterName,
+            Action<Character> fillCharacter) =>
+            Run(async () =>
+            {
+                await using var ctx = CreateDbContext();
+                var existingId = await ctx.Characters
+                    .Where(character => character.Account.AccountIdentifier == playerGuid &&
+                                        character.Name == characterName)
+                    .Select(character => (long?)character.Id)
+                    .FirstOrDefaultAsync();
+                if (existingId.HasValue) return existingId.Value;
+                var account = await ctx.Accounts.FirstAsync(value => value.AccountIdentifier == playerGuid);
+                var character = new Character
+                {
+                    Account = account,
+                    UpdateDate = DateTime.UtcNow,
+                    CreationDate = DateTime.UtcNow
+                };
+                fillCharacter(character);
+                ctx.Characters.Add(character);
+                await ctx.SaveChangesAsync();
+                return character.Id;
+            });
