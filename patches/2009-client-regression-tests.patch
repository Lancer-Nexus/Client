+using System.Numerics;
+using System.Reflection;
+using System.Runtime.CompilerServices;
+using LibreLancer;
+using LibreLancer.Data;
+using LibreLancer.Data.GameData.World;
+using LibreLancer.Server;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public sealed class GatewayCharacterPreviewTests
+{
+    [Fact]
+    public void InSpaceCharacterWithUnknownShipAndNoBaseRemainsSelectable()
+    {
+        var itemDb = (GameItemDb)RuntimeHelpers.GetUninitializedObject(typeof(GameItemDb));
+        typeof(GameItemDb).GetField("Bases")!.SetValue(itemDb, new GameItemCollection<Base>());
+        var data = (GameDataManager)RuntimeHelpers.GetUninitializedObject(typeof(GameDataManager));
+        typeof(GameDataManager).GetField("Items")!.SetValue(data, itemDb);
+        var character = new NetCharacter();
+        using (var transaction = character.BeginTransaction())
+            transaction.UpdatePosition("missing_base", "li03", Vector3.Zero, Quaternion.Identity);
+
+        typeof(NetCharacter).GetField("gData", BindingFlags.Instance | BindingFlags.NonPublic)!
+            .SetValue(character, data);
+        typeof(NetCharacter).GetField("charId", BindingFlags.Instance | BindingFlags.NonPublic)!
+            .SetValue(character, 42L);
+
+        var selectable = character.ToSelectable();
+
+        Assert.Equal(42L, selectable.Id);
+        Assert.Equal(string.Empty, selectable.Ship);
+        Assert.Equal(string.Empty, selectable.Name);
+        Assert.Equal("li03", selectable.Location);
+    }
+}
