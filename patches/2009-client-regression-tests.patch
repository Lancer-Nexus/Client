+
+    private sealed class Handler(bool mismatchCorrelation = false, bool rejectIdentity = false,
+        bool rejectDeletion = false, bool noPreview = false,
+        MarketTradeCommitStatusV1 marketCommitStatus = MarketTradeCommitStatusV1.Committed) : HttpMessageHandler
+    {
+        public List<string> Paths { get; } = [];
+        public List<string?> Authorizations { get; } = [];
+        public CharacterLeaseAcquireRequestV1? AcquireRequest { get; private set; }
+        public CharacterLeaseRenewRequestV1? RenewRequest { get; private set; }
+        public CharacterLeaseReleaseRequestV1? ReleaseRequest { get; private set; }
+        public CharacterSaveSnapshotReadRequestV1? SnapshotReadRequest { get; private set; }
+        public CharacterSaveSnapshotWriteRequestV1? SnapshotWriteRequest { get; private set; }
+        public CharacterRosterRequestV1? RosterRequest { get; private set; }
+        public CharacterBootstrapRequestV1? BootstrapRequest { get; private set; }
+        public CharacterSnapshotPreviewRequestV1? PreviewRequest { get; private set; }
+        public CharacterDeletionRequestV1? DeleteRequest { get; private set; }
+        public MarketTradeQuoteReadRequestV1? QuoteRequest { get; private set; }
+        public MarketTradeCommitRequestV1? CommitRequest { get; private set; }
+
+        protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request,
+            CancellationToken cancellationToken)
+        {
+            Paths.Add(request.RequestUri!.AbsolutePath);
+            Authorizations.Add(request.Headers.Authorization?.ToString());
+            if (request.RequestUri.AbsolutePath.EndsWith("market-trades/quote", StringComparison.Ordinal))
+            {
+                QuoteRequest = await request.Content!.ReadFromJsonAsync<MarketTradeQuoteReadRequestV1>(
+                    cancellationToken: cancellationToken);
+                var quoteRequest = QuoteRequest!.ToMarketQuoteRequest(7);
+                return new HttpResponseMessage(HttpStatusCode.OK)
+                {
+                    Content = JsonContent.Create(new MarketTradeQuoteReadResponseV1
+                    {
+                        CorrelationId = QuoteRequest.CorrelationId, CharacterId = QuoteRequest.CharacterId,
+                        LeaseVersion = QuoteRequest.LeaseVersion, ExpectedReputationRevision = 7,
+                        Quote = new MarketQuoteResponseV1
+                        {
+                            CorrelationId = quoteRequest.CorrelationId, CharacterId = quoteRequest.CharacterId,
+                            SystemId = quoteRequest.SystemId, MarketId = quoteRequest.MarketId, GoodId = quoteRequest.GoodId,
+                            Side = quoteRequest.Side, Quantity = quoteRequest.Quantity, Status = MarketQuoteStatusV1.Quoted,
+                            MarketRevision = 4, ReputationRevision = 7, MarketFactionId = "li_n_grp",
+                            AppliedReputation = 0, ReputationFactorPartsPerMillion = 1_000_000,
+                            QuoteUnitPrice = 10, TotalPrice = 20, ExpiresUtc = DateTimeOffset.UtcNow.AddSeconds(10),
+                            PricingPolicyVersion = 1
+                        }
+                    })
+                };
+            }
+            if (request.RequestUri.AbsolutePath.EndsWith("market-trades/commit", StringComparison.Ordinal))
+            {
+                CommitRequest = await request.Content!.ReadFromJsonAsync<MarketTradeCommitRequestV1>(
+                    cancellationToken: cancellationToken);
+                return new HttpResponseMessage(marketCommitStatus == MarketTradeCommitStatusV1.Pending
+                    ? HttpStatusCode.Accepted : HttpStatusCode.OK)
+                {
+                    Content = JsonContent.Create(new MarketTradeCommitResponseV1
+                    {
+                        CorrelationId = CommitRequest!.CorrelationId, TradeId = CommitRequest.TradeId,
+                        Status = marketCommitStatus,
+                        SnapshotRevision = marketCommitStatus is MarketTradeCommitStatusV1.Committed or MarketTradeCommitStatusV1.Duplicate
+                            ? CommitRequest.Snapshot.Revision : null
+                    })
+                };
+            }
+            if (request.RequestUri.AbsolutePath.EndsWith("characters/list", StringComparison.Ordinal))
+            {
+                RosterRequest = await request.Content!.ReadFromJsonAsync<CharacterRosterRequestV1>(
+                    cancellationToken: cancellationToken);
+                return new HttpResponseMessage(HttpStatusCode.OK)
+                {
+                    Content = JsonContent.Create(new CharacterRosterResultV1
+                    {
+                        CorrelationId = RosterRequest!.CorrelationId, Accepted = true, ReasonCode = "listed",
+                        Characters = [new CharacterRosterEntryV1 { CharacterId = 918, DisplayName = "Pilot One" }]
+                    })
+                };
+            }
+
+            if (request.RequestUri.AbsolutePath.EndsWith("characters/bootstrap", StringComparison.Ordinal))
+            {
+                BootstrapRequest = await request.Content!.ReadFromJsonAsync<CharacterBootstrapRequestV1>(
+                    cancellationToken: cancellationToken);
+                return new HttpResponseMessage(HttpStatusCode.OK)
+                {
+                    Content = JsonContent.Create(new CharacterBootstrapResultV1
+                    {
+                        CorrelationId = BootstrapRequest!.CorrelationId, Accepted = true, ReasonCode = "stored"
+                    })
+                };
+            }
+
+            if (request.RequestUri.AbsolutePath.EndsWith("snapshot/preview", StringComparison.Ordinal))
+            {
+                PreviewRequest = await request.Content!.ReadFromJsonAsync<CharacterSnapshotPreviewRequestV1>(
+                    cancellationToken: cancellationToken);
+                if (noPreview) return new HttpResponseMessage(HttpStatusCode.NotFound);
+                return new HttpResponseMessage(HttpStatusCode.OK)
+                {
+                    Content = JsonContent.Create(new CharacterSaveSnapshotV1
+                    {
+                        CorrelationId = PreviewRequest!.CorrelationId, CharacterId = PreviewRequest.CharacterId,
+                        LeaseVersion = 1, Revision = 1, Payload = [5, 6, 7]
+                    })
+                };
+            }
+
+            if (request.RequestUri.AbsolutePath.EndsWith("characters/delete", StringComparison.Ordinal))
+            {
+                DeleteRequest = await request.Content!.ReadFromJsonAsync<CharacterDeletionRequestV1>(
+                    cancellationToken: cancellationToken);
+                return new HttpResponseMessage(rejectDeletion ? HttpStatusCode.Conflict : HttpStatusCode.OK)
+                {
+                    Content = JsonContent.Create(new CharacterDeletionResultV1
+                    {
+                        CorrelationId = DeleteRequest!.CorrelationId, Accepted = !rejectDeletion,
+                        ReasonCode = rejectDeletion ? "character_in_use" : "deleted"
+                    })
+                };
+            }
+
+            if (request.RequestUri.AbsolutePath.EndsWith("resolve-identity", StringComparison.Ordinal))
+            {
+                var body = await request.Content!.ReadFromJsonAsync<CharacterIdentityResolveRequestV1>(
+                    cancellationToken: cancellationToken);
+                return new HttpResponseMessage(HttpStatusCode.OK)
+                {
+                    Content = JsonContent.Create(new CharacterIdentityResolveResultV1
+                    {
+                        CorrelationId = mismatchCorrelation ? Guid.NewGuid() : body!.CorrelationId,
+                        Accepted = !rejectIdentity,
+                        ReasonCode = rejectIdentity ? "character_name_conflict" : "resolved",
+                        CharacterId = rejectIdentity ? null : 918,
+                        LeaseTicket = rejectIdentity ? null : "lj1.signed"
+                    })
+                };
+            }
+
+            if (request.RequestUri.AbsolutePath.EndsWith("renew-character-lease", StringComparison.Ordinal))
+            {
+                RenewRequest = await request.Content!.ReadFromJsonAsync<CharacterLeaseRenewRequestV1>(
+                    cancellationToken: cancellationToken);
+                return new HttpResponseMessage(HttpStatusCode.OK)
+                {
+                    Content = JsonContent.Create(new CharacterLeaseRenewResultV1
+                    {
+                        CorrelationId = RenewRequest!.CorrelationId, Accepted = true, ReasonCode = "renewed",
+                        LeaseVersion = RenewRequest.LeaseVersion, ValidUntilUtc = DateTimeOffset.UtcNow.AddMinutes(15)
+                    })
+                };
+            }
+
+            if (request.RequestUri.AbsolutePath.EndsWith("release-character-lease", StringComparison.Ordinal))
+            {
+                ReleaseRequest = await request.Content!.ReadFromJsonAsync<CharacterLeaseReleaseRequestV1>(
+                    cancellationToken: cancellationToken);
+                return new HttpResponseMessage(HttpStatusCode.OK)
+                {
+                    Content = JsonContent.Create(new CharacterLeaseReleaseResultV1
+                    {
+                        CorrelationId = ReleaseRequest!.CorrelationId, Released = true, ReasonCode = "released",
+                        LeaseVersion = ReleaseRequest.LeaseVersion
+                    })
+                };
+            }
+
+            if (request.RequestUri.AbsolutePath.EndsWith("snapshot/read", StringComparison.Ordinal))
+            {
+                SnapshotReadRequest = await request.Content!.ReadFromJsonAsync<CharacterSaveSnapshotReadRequestV1>(
+                    cancellationToken: cancellationToken);
+                return new HttpResponseMessage(HttpStatusCode.OK)
+                {
+                    Content = JsonContent.Create(new CharacterSaveSnapshotV1
+                    {
+                        CorrelationId = SnapshotReadRequest!.CorrelationId, CharacterId = SnapshotReadRequest.CharacterId,
+                        LeaseVersion = SnapshotReadRequest.LeaseVersion, Revision = 7, Payload = [9, 8, 7]
+                    })
+                };
+            }
+
+            if (request.RequestUri.AbsolutePath.EndsWith("snapshot/write", StringComparison.Ordinal))
+            {
+                SnapshotWriteRequest = await request.Content!.ReadFromJsonAsync<CharacterSaveSnapshotWriteRequestV1>(
+                    cancellationToken: cancellationToken);
+                return new HttpResponseMessage(HttpStatusCode.OK)
+                {
+                    Content = JsonContent.Create(new CharacterSaveSnapshotWriteResultV1
+                    {
+                        CorrelationId = SnapshotWriteRequest!.CorrelationId, Accepted = true,
+                        ReasonCode = "stored", Revision = SnapshotWriteRequest.Revision
+                    })
+                };
+            }
+
+            AcquireRequest = await request.Content!.ReadFromJsonAsync<CharacterLeaseAcquireRequestV1>(
+                cancellationToken: cancellationToken);
+            return new HttpResponseMessage(HttpStatusCode.OK)
+            {
+                Content = JsonContent.Create(new CharacterLeaseAcquireResultV1
+                {
+                    CorrelationId = AcquireRequest!.CorrelationId, Accepted = true, ReasonCode = "acquired",
+                    LeaseVersion = 1, ValidUntilUtc = DateTimeOffset.UtcNow.AddMinutes(15)
+                })
+            };
+        }
+    }
+}
