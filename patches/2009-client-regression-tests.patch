@@ -0,0 +1,51 @@
+using LibreLancer.World;
+using LibreLancer.World.Components;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public class AutopilotFormationLeaderRestoreTests
+{
+    [Fact]
+    public void CaptureCancelsFormationBehaviorAfterFollowerBecomesLeader()
+    {
+        var (leader, follower, formation) = CreateFormation();
+        var autopilot = new AutopilotComponent(leader);
+        leader.AddComponent(autopilot);
+        autopilot.StartFormation();
+
+        var snapshot = autopilot.CaptureTransferState();
+
+        Assert.Equal(AutopilotBehaviors.None, snapshot.Behavior);
+        Assert.Equal(AutopilotBehaviors.None, autopilot.CurrentBehavior);
+        Assert.Same(formation, leader.Formation);
+        Assert.Same(formation, follower.Formation);
+    }
+
+    [Fact]
+    public void RestoreCancelsStaleFormationBehaviorForFormationLeader()
+    {
+        var (leader, follower, _) = CreateFormation();
+        var followerAutopilot = new AutopilotComponent(follower);
+        follower.AddComponent(followerAutopilot);
+        followerAutopilot.StartFormation();
+        var snapshot = followerAutopilot.CaptureTransferState();
+        Assert.Equal(AutopilotBehaviors.Formation, snapshot.Behavior);
+
+        var leaderAutopilot = new AutopilotComponent(leader);
+        leader.AddComponent(leaderAutopilot);
+        leaderAutopilot.RestoreTransferState(snapshot);
+
+        Assert.Equal(AutopilotBehaviors.None, leaderAutopilot.CurrentBehavior);
+    }
+
+    private static (GameObject Leader, GameObject Follower, ShipFormation Formation) CreateFormation()
+    {
+        var leader = new GameObject();
+        var follower = new GameObject();
+        var formation = new ShipFormation(leader, follower);
+        leader.Formation = formation;
+        follower.Formation = formation;
+        return (leader, follower, formation);
+    }
+}
