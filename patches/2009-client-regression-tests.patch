+using System.IO;
+using LibreLancer.Net;
+using LibreLancer.Server;
+using LibreLancer.Data.IO;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public sealed class GameListenerShutdownTests
+{
+    [Fact]
+    public void ListenerStoppedBeforeStartDoesNotOpenSocketLater()
+    {
+        var game = new GameServer(new FileSystem(new EmptyFileSystem()));
+        var listener = new GameListener(game);
+
+        listener.Stop();
+        listener.Start();
+        listener.Stop();
+
+        Assert.Null(listener.Server);
+    }
+
+    [Fact]
+    public void GracefulShutdownStateIsVisibleToListenerAdmission()
+    {
+        var game = new GameServer(new FileSystem(new EmptyFileSystem()));
+
+        game.BeginGracefulShutdown();
+
+        Assert.True(game.IsStopping);
+    }
+
+    private sealed class EmptyFileSystem : BaseFileSystemProvider
+    {
+        public EmptyFileSystem() => Refresh();
+
+        public override void Refresh()
+        {
+            Root = new VfsDirectory();
+            var exe = new VfsDirectory { Name = "EXE", Parent = Root };
+            Root.Items["EXE"] = exe;
+            exe.Items.Add("freelancer.ini", new EmptyFile { Name = "freelancer.ini" });
+        }
+
+        private sealed class EmptyFile : VfsFile
+        {
+            public override Stream OpenRead() => new MemoryStream();
+        }
+    }
+}
diff --git a/src/LibreLancer.Tests/GatewayCharacterLeaseClientTests.cs b/src/LibreLancer.Tests/GatewayCharacterLeaseClientTests.cs
