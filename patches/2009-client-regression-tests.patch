+using LibreLancer.World.Components;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public sealed class AutopilotObstacleAvoidanceTests
+{
+    [Fact]
+    public void PlanIsReusedOnlyWithinTheShortRefreshWindow()
+    {
+        Assert.True(AutopilotObstacleAvoidance.ShouldReusePlan(
+            hasPlan: true,
+            targetChanged: false,
+            targetDistanceSquared: 0,
+            elapsed: AutopilotObstacleAvoidance.RecheckInterval / 2));
+
+        Assert.False(AutopilotObstacleAvoidance.ShouldReusePlan(
+            hasPlan: true,
+            targetChanged: false,
+            targetDistanceSquared: 0,
+            elapsed: AutopilotObstacleAvoidance.RecheckInterval));
+    }
+
+    [Fact]
+    public void TargetChangesInvalidateCachedPlanImmediately()
+    {
+        Assert.False(AutopilotObstacleAvoidance.ShouldReusePlan(
+            hasPlan: true,
+            targetChanged: true,
+            targetDistanceSquared: 0,
+            elapsed: 0));
+
+        Assert.False(AutopilotObstacleAvoidance.ShouldReusePlan(
+            hasPlan: true,
+            targetChanged: false,
+            targetDistanceSquared: AutopilotObstacleAvoidance.TargetPointRecheckDistanceSquared + 1,
+            elapsed: 0));
+    }
+
+    [Fact]
+    public void MissingPlanCannotBeReused()
+    {
+        Assert.False(AutopilotObstacleAvoidance.ShouldReusePlan(
+            hasPlan: false,
+            targetChanged: false,
+            targetDistanceSquared: 0,
+            elapsed: 0));
+    }
+}
