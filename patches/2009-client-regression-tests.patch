@@ -0,0 +1,33 @@
+using System;
+using System.Collections.Generic;
+using LibreLancer.Net;
+using LibreLancer.Net.Protocol;
+using LibreLancer.Server;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public sealed class AdminChatInterceptionTests
+{
+    [Theory]
+    [InlineData(ChatCategory.System)]
+    [InlineData(ChatCategory.Local)]
+    public void FragmentedAdminCommandNeverUsesOrdinaryChatOrLocalConsole(ChatCategory category)
+    {
+        var sender = new Capture();
+        // No game world: accidentally entering ordinary chat/local command dispatch fails this test.
+        var player = new Player(sender, null!, Guid.NewGuid());
+        var message = new BinaryChatMessage { Segments = [
+            new() { Contents = "  /ad", Bold = true }, new() { Contents = "min kick secret-target" }] };
+        ((IServerPlayer)player).ChatMessage(category, message);
+        Assert.Single(sender.Packets); // Only the caller receives private usage feedback.
+    }
+
+    private sealed class Capture : IPacketClient
+    {
+        public List<IPacket> Packets = [];
+        public int MaxSequencedSize => 1024;
+        public void SendPacket(IPacket packet, PacketDeliveryMethod method) => Packets.Add(packet);
+        public void Disconnect(DisconnectReason reason) => throw new NotSupportedException();
+    }
+}
