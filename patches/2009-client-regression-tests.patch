+using LibreLancer.Utf.Ale;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public class AlchemySParamRangeTests
+{
+    [Fact]
+    public void CurveAnimationClampsBelowFirstSParam()
+    {
+        var animation = new AlchemyCurveAnimation
+        {
+            Items =
+            [
+                new AlchemyCurve { SParam = 0.25f, Value = 10 },
+                new AlchemyCurve { SParam = 0.75f, Value = 30 }
+            ]
+        };
+
+        Assert.Equal(10, animation.GetValue(0.1f, 0));
+    }
+
+    [Fact]
+    public void FloatAnimationClampsBelowFirstSParam()
+    {
+        var animation = new AlchemyFloatAnimation
+        {
+            Items =
+            [
+                new AlchemyFloats { SParam = 0.25f, Keyframes = [new(0, 10)] },
+                new AlchemyFloats { SParam = 0.75f, Keyframes = [new(0, 30)] }
+            ]
+        };
+
+        Assert.Equal(10, animation.GetValue(0.1f, 0));
+    }
+
+    [Fact]
+    public void ColorAnimationClampsBelowFirstSParam()
+    {
+        var first = new Color3f(0.1f, 0.2f, 0.3f);
+        var last = new Color3f(0.7f, 0.8f, 0.9f);
+        var animation = new AlchemyColorAnimation
+        {
+            Items =
+            [
+                new AlchemyColors { SParam = 0.25f, Keyframes = [new(0, first)] },
+                new AlchemyColors { SParam = 0.75f, Keyframes = [new(0, last)] }
+            ]
+        };
+
+        Assert.Equal(first, animation.GetValue(0.1f, 0));
+    }
+}
diff --git a/src/LibreLancer.Tests/AudioDecoderLoopTests.cs b/src/LibreLancer.Tests/AudioDecoderLoopTests.cs
new file mode 100644
index 0000000..0964063
--- /dev/null
+++ b/src/LibreLancer.Tests/AudioDecoderLoopTests.cs
@@ -0,0 +1,130 @@
+using System;
+using System.IO;
+using LibreLancer.Media;
+using Nexus.Assets;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public class AudioDecoderLoopTests
+{
+    [Theory]
+    [InlineData("AudioTestAssets/vorbis-bell.ogg", "vorbis", "ogg")]
+    [InlineData("TestAssets/Audio/synthetic-flac.flac", "flac", "flac")]
+    [InlineData("TestAssets/Audio/synthetic-ogg-flac.ogg", "flac", "ogg")]
+    public void DecoderCanReplayFromStartAfterTrackEnd(string relativePath, string expectedCodec,
+        string expectedContainer)
+    {
+        var path = Path.Combine(AppContext.BaseDirectory, relativePath.Replace('/', Path.DirectorySeparatorChar));
+        using var decoder = new AudioDecoder(File.OpenRead(path));
+        Assert.True(decoder.GetString(AudioProperty.Codec, out var codec));
+        Assert.Equal(expectedCodec, codec);
+        Assert.True(decoder.GetString(AudioProperty.Container, out var container));
+        Assert.Equal(expectedContainer, container);
+
+        var firstPlay = ReadToEnd(decoder);
+        Assert.NotEmpty(firstPlay);
+
+        decoder.Seek(0, SeekOrigin.Begin);
+        var secondPlay = ReadToEnd(decoder);
+        Assert.Equal(firstPlay, secondPlay);
+    }
+
+    [Fact]
+    public void VorbisReopenFailureReturnsEofWithoutCrashing()
+    {
+        var path = Path.Combine(AppContext.BaseDirectory, "AudioTestAssets", "vorbis-bell.ogg");
+        using var source = new BlockRewindStream(File.OpenRead(path));
+        using var decoder = new AudioDecoder(source);
+        Assert.NotEmpty(ReadToEnd(decoder));
+
+        source.BlockRewinds = true;
+        decoder.Seek(0, SeekOrigin.Begin);
+        Assert.Equal(0, decoder.Read(new byte[8192], 0, 8192));
+        decoder.Seek(0, SeekOrigin.Begin);
+        Assert.Equal(0, decoder.Read(new byte[8192], 0, 8192));
+    }
+
+    [Theory]
+    [InlineData("AudioTestAssets/vorbis-bell.ogg")]
+    [InlineData("TestAssets/Audio/synthetic-flac.flac")]
+    [InlineData("TestAssets/Audio/synthetic-ogg-flac.ogg")]
+    public void DecoderCanReplayAudioFromChunkedNapEntry(string relativePath)
+    {
+        var fixture = Path.Combine(AppContext.BaseDirectory,
+            relativePath.Replace('/', Path.DirectorySeparatorChar));
+        var temporaryRoot = Path.Combine(Path.GetTempPath(), "lancer-audio-nap-" + Guid.NewGuid().ToString("N"));
+        var sourceDirectory = Path.Combine(temporaryRoot, "source");
+        var entryPath = "AUDIO/MUSIC/test-audio.bin";
+        try
+        {
+            Directory.CreateDirectory(Path.Combine(sourceDirectory, "AUDIO", "MUSIC"));
+            var packagedAudio = Path.Combine(sourceDirectory, entryPath.Replace('/', Path.DirectorySeparatorChar));
+            File.Copy(fixture, packagedAudio);
+            var packagePath = Path.Combine(temporaryRoot, "audio.nap");
+            NapWriter.PackDirectory(sourceDirectory, packagePath, new NapPackOptions { ChunkSize = 1024 });
+            var archive = NapArchive.Open(packagePath, chunkCacheBytes: 2048);
+            Assert.True(archive.TryGetEntry(entryPath, out var entry));
+            Assert.True(entry!.Chunks.Count > 1);
+
+            using var stream = archive.OpenFile(entryPath);
+            Assert.True(stream.CanSeek);
+            using var decoder = new AudioDecoder(stream);
+            var firstPlay = ReadToEnd(decoder);
+            Assert.NotEmpty(firstPlay);
+
+            decoder.Seek(0, SeekOrigin.Begin);
+            Assert.Equal(firstPlay, ReadToEnd(decoder));
+        }
+        finally
+        {
+            if (Directory.Exists(temporaryRoot))
+                Directory.Delete(temporaryRoot, recursive: true);
+        }
+    }
+
+    private static byte[] ReadToEnd(AudioDecoder decoder)
+    {
+        var buffer = new byte[8192];
+        using var pcm = new MemoryStream();
+        while (true)
+        {
+            var read = decoder.Read(buffer, 0, buffer.Length);
+            if (read == 0)
+                return pcm.ToArray();
+            pcm.Write(buffer, 0, read);
+        }
+    }
+
+    private sealed class BlockRewindStream(Stream inner) : Stream
+    {
+        public bool BlockRewinds { get; set; }
+
+        public override bool CanRead => inner.CanRead;
+        public override bool CanSeek => inner.CanSeek;
+        public override bool CanWrite => false;
+        public override long Length => inner.Length;
+        public override long Position { get => inner.Position; set => inner.Position = value; }
+
+        public override int Read(byte[] buffer, int offset, int count) => inner.Read(buffer, offset, count);
+        public override int Read(Span<byte> buffer) => inner.Read(buffer);
+
+        public override long Seek(long offset, SeekOrigin origin)
+        {
+            if (BlockRewinds && origin == SeekOrigin.Begin && offset == 0)
+                return inner.Position;
+            return inner.Seek(offset, origin);
+        }
+
+        public override void Flush() => inner.Flush();
+        public override void SetLength(long value) => throw new NotSupportedException();
+        public override void Write(byte[] buffer, int offset, int count) => throw new NotSupportedException();
+
+        protected override void Dispose(bool disposing)
+        {
+            if (disposing)
+                inner.Dispose();
+            base.Dispose(disposing);
+        }
+    }
+}
