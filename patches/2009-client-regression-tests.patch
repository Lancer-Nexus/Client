+using System;
+using System.Threading.Tasks;
+using LibreLancer.Server;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public sealed class FixedTimestepLoopTests
+{
+    [Fact]
+    public async Task StopFromAnotherThreadEndsTheGameLoop()
+    {
+        var firstStep = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        var loop = new FixedTimestepLoop((_, _, _, _) => firstStep.TrySetResult());
+        var worker = Task.Run(loop.Start);
+
+        try
+        {
+            await firstStep.Task.WaitAsync(TimeSpan.FromSeconds(2));
+            loop.Stop();
+            await worker.WaitAsync(TimeSpan.FromSeconds(1));
+        }
+        finally
+        {
+            loop.Stop();
+        }
+    }
+}
