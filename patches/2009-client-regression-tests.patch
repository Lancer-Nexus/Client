+using LibreLancer.Data.Schema.Save;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public class SignedSaveItemHashTests
+{
+    [Fact]
+    public void SignedNumericEquipmentAndCargoHashesPreserveTheirBits()
+    {
+        const int signedHash = -1128247292;
+        var save = SaveGame.FromString(
+            "signed-item-hash",
+            "[Player]\nequip = -1128247292, internal, 1\ncargo = -1128247292, 2\n");
+
+        var equipment = Assert.Single(save.Player!.Equip);
+        var cargo = Assert.Single(save.Player.Cargo);
+
+        Assert.Equal(unchecked((uint)signedHash), (uint)equipment.Item);
+        Assert.Equal(unchecked((uint)signedHash), (uint)cargo.Item);
+        Assert.Equal(2, cargo.Count);
+    }
+}
