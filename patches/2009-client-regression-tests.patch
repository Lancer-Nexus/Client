+using LibreLancer.Net.Protocol;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public sealed class CharacterSelectInfoTests
+{
+    [Fact]
+    public void MissingGatewayPreviewValuesRenderAsEmptyCells()
+    {
+        var info = new CharacterSelectInfo();
