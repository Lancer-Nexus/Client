+using System.Linq;
+using LibreLancer.Utf;
+using LibreLancer.Utf.Mat;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public class TxmTextureLookupTests
+{
+    [Fact]
+    public void ExactKeyTakesPriorityOverCaseInsensitiveDuplicate()
+    {
+        var txm = CreateLibrary("Ships/Hull.dds", "ships/hull.dds");
+        var expected = txm.Textures["Ships/Hull.dds"];
+
+        Assert.Same(expected, txm.FindTexture("Ships/Hull.dds"));
+    }
+
+    [Fact]
+    public void CaseInsensitiveFullPathResolvesUniqueEntry()
+    {
+        var txm = CreateLibrary("Ships/Hull.dds");
+
+        Assert.Same(txm.Textures["Ships/Hull.dds"], txm.FindTexture("ships/hull.DDS"));
+    }
+
+    [Fact]
+    public void BasenameResolvesOnlyWhenUnique()
+    {
+        var txm = CreateLibrary("Ships\\Hull.dds", "Stations/Port.dds");
+
+        Assert.Same(txm.Textures["Ships\\Hull.dds"], txm.FindTexture("hull.tga"));
+        Assert.Null(txm.FindTexture("unknown.tga"));
+    }
+
+    [Fact]
+    public void AmbiguousBasenameIsRejected()
+    {
+        var txm = CreateLibrary("Ships/Hull.dds", "Stations/Hull.dds");
+
+        Assert.Null(txm.FindTexture("hull.tga"));
+    }
+
+    [Theory]
+    [InlineData(null)]
+    [InlineData("")]
+    [InlineData("  ")]
+    public void EmptyTextureNameDoesNotResolve(string? textureName)
+    {
+        var txm = CreateLibrary("Ships/Hull.dds");
+
+        Assert.Null(txm.FindTexture(textureName));
+    }
+
+    private static TxmFile CreateLibrary(params string[] names)
+    {
+        var textures = names.Select(name => (Node)new IntermediateNode(name,
+            [new LeafNode("mips", [0x44, 0x44, 0x53])]));
+        return new TxmFile(new IntermediateNode("texture library", textures.ToList()));
+    }
+}
