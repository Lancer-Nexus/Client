+        public TextureData? FindTexture(string? textureName)
+        {
+            if (string.IsNullOrWhiteSpace(textureName))
+                return null;
+            if (Textures.TryGetValue(textureName, out var exact))
+                return exact;
+
+            TextureData? caseInsensitiveMatch = null;
+            foreach (var texture in Textures)
+            {
+                if (!string.Equals(texture.Key, textureName, StringComparison.OrdinalIgnoreCase))
+                    continue;
+                if (caseInsensitiveMatch != null && !ReferenceEquals(caseInsensitiveMatch, texture.Value))
+                    return null;
+                caseInsensitiveMatch = texture.Value;
+            }
+            if (caseInsensitiveMatch != null)
+                return caseInsensitiveMatch;
+
+            var basename = GetBasename(textureName);
+            TextureData? basenameMatch = null;
+            foreach (var texture in Textures)
+            {
+                if (!string.Equals(GetBasename(texture.Key), basename,
+                        StringComparison.OrdinalIgnoreCase))
+                    continue;
+                if (basenameMatch != null && !ReferenceEquals(basenameMatch, texture.Value))
+                    return null;
+                basenameMatch = texture.Value;
+            }
+            return basenameMatch;
+        }
+
+        private static string GetBasename(string name)
+        {
+            var separator = Math.Max(name.LastIndexOf('/'), name.LastIndexOf('\\'));
+            var filename = name[(separator + 1)..];
+            var extension = filename.LastIndexOf('.');
+            return extension > 0 ? filename[..extension] : filename;
         }
 
