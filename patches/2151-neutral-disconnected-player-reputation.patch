+++ b/src/LibreLancer.Tests/DisconnectedPlayerReputationTests.cs
@@ -0,0 +1,25 @@
+using System;
+using LibreLancer.Data.GameData;
+using LibreLancer.Net;
+using LibreLancer.Server;
+using LibreLancer.Server.Components;
+using LibreLancer.World;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public class DisconnectedPlayerReputationTests
+{
+    [Fact]
+    public void PlayerWithoutCharacterHasNeutralReputation()
+    {
+        var faction = new Faction { Properties = null };
+        var observer = new GameObject();
+        observer.AddComponent(new SRepComponent(observer) { Faction = faction });
+
+        var playerObject = new GameObject();
+        playerObject.AddComponent(new SPlayerComponent(new Player(null!, null!, Guid.Empty), playerObject));
+
+        Assert.Equal(RepAttitude.Neutral, observer.GetComponent<SRepComponent>()!.GetRep(playerObject));
+    }
+}
