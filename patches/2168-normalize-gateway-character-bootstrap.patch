+    [Fact]
+    public void GatewayBootstrapSaveResolvesAndWritesEquipmentNicknames()
+    {
+        var gameData = ConstructMockData();
+        var convex = new ConvexShapeCollection(x => throw new InvalidOperationException("Tried to open sur"));
+        var server = new GameServer(gameData, convex);
+        var itemHash = FLHash.CreateID("gun01");
+        var sourceSave = SaveGame.FromString("bootstrap", $"[Player]\nname = Pilot\nequip = {itemHash}, internal, 1\ncargo = {itemHash}, 2\n");
+
+        var character = NetCharacter.OpenSaveGame(server, sourceSave);
+        var gatewaySave = SaveWriter.CreateSave(character, null, 0, DateTime.UtcNow, gameData,
+            null, null, null);
+        using var payload = new MemoryStream();
+        IniWriter.WriteIni(payload, gatewaySave.ToIni());
+        var restoredSave = SaveGame.FromString("gateway-bootstrap", System.Text.Encoding.UTF8.GetString(payload.ToArray()));
+
+        Assert.Equal("gun01", restoredSave.Player!.Equip.Single().Item.String);
+        Assert.Equal("gun01", restoredSave.Player.Cargo.Single().Item.String);
+    }
 }
