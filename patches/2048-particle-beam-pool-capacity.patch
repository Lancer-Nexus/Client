--- a/src/LibreLancer.Tests/ParticlePoolCapacityTests.cs
+++ b/src/LibreLancer.Tests/ParticlePoolCapacityTests.cs
@@ -0,0 +1,32 @@
+using LibreLancer.Fx;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public sealed class ParticlePoolCapacityTests
+{
+    [Fact]
+    public void ReserveAcceptsLastAvailableIndex()
+    {
+        var next = 2;
+
+        Assert.True(ParticleEffectPool.TryReserveParticle(ref next, 3, out var index));
+
+        Assert.Equal(2, index);
+        Assert.Equal(3, next);
+    }
+
+    [Theory]
+    [InlineData(3, 3)]
+    [InlineData(4, 3)]
+    [InlineData(-1, 3)]
+    public void ReserveRejectsIndicesOutsideCapacity(int nextParticle, int capacity)
+    {
+        var next = nextParticle;
+
+        Assert.False(ParticleEffectPool.TryReserveParticle(ref next, capacity, out var index));
+
+        Assert.Equal(-1, index);
+        Assert.Equal(nextParticle, next);
+    }
+}
