+    public unsafe void ReadBackbuffer(Span<Bgra8> pixels, int width, int height)
+    {
+        var required = checked(width * height);
+        if (width <= 0 || height <= 0 || pixels.Length < required)
+            throw new ArgumentException("Invalid backbuffer readback dimensions or destination length");
+
+        GL.GetIntegerv(GL.GL_READ_FRAMEBUFFER_BINDING, out var previousReadFramebuffer);
+        GL.GetIntegerv(GL.GL_PIXEL_PACK_BUFFER_BINDING, out var previousPackBuffer);
+        GL.GetIntegerv(GL.GL_PACK_ALIGNMENT, out var previousPackAlignment);
+        var previousDefaultReadBuffer = GL.GL_BACK;
+        try
+        {
+            // ReadPixels treats the pointer as an offset when a pack buffer is bound.
+            GL.BindBuffer(GL.GL_PIXEL_PACK_BUFFER, 0);
+            GL.PixelStorei(GL.GL_PACK_ALIGNMENT, 1);
+            GL.BindFramebuffer(GL.GL_READ_FRAMEBUFFER, 0);
+            GL.GetIntegerv(GL.GL_READ_BUFFER, out previousDefaultReadBuffer);
+            GL.ReadBuffer(GL.GL_BACK);
+            fixed (Bgra8* ptr = pixels)
+                GL.ReadPixels(0, 0, width, height, GL.GL_BGRA, GL.GL_UNSIGNED_BYTE, (IntPtr)ptr);
+        }
+        finally
+        {
+            GL.PixelStorei(GL.GL_PACK_ALIGNMENT, previousPackAlignment);
+            GL.BindBuffer(GL.GL_PIXEL_PACK_BUFFER, (uint)previousPackBuffer);
+            // Read buffer selection is framebuffer state. Restore the default target's
+            // selection before restoring the previously bound read framebuffer.
+            GL.BindFramebuffer(GL.GL_READ_FRAMEBUFFER, 0);
+            GL.ReadBuffer(previousDefaultReadBuffer);
+            GL.BindFramebuffer(GL.GL_READ_FRAMEBUFFER, (uint)previousReadFramebuffer);
+        }
+    }
