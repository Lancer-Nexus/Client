+using System;
+using LibreLancer.Graphics.Backends.Null;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public class BackbufferReadbackTests
+{
+    [Fact]
+    public void NullBackend_ClearsOnlyRequestedPixelRegion()
+    {
+        var backend = new NullRenderContext();
+        var pixels = new[] { new Bgra8(1, 2, 3, 4), new Bgra8(5, 6, 7, 8) };
+
+        backend.ReadBackbuffer(pixels, 1, 1);
+
+        Assert.Equal(default, pixels[0]);
+        Assert.Equal(new Bgra8(5, 6, 7, 8), pixels[1]);
+    }
+
+    [Theory]
+    [InlineData(0, 1, 1)]
+    [InlineData(1, 0, 1)]
+    [InlineData(2, 1, 1)]
+    public void NullBackend_RejectsInvalidReadbackRequest(int width, int height, int bufferLength)
+    {
+        var backend = new NullRenderContext();
+        var pixels = new Bgra8[bufferLength];
+
+        Assert.Throws<ArgumentException>(() => backend.ReadBackbuffer(pixels, width, height));
+    }
+}
