diff --git a/src/LibreLancer/Render/GateTunnelRenderer.cs b/src/LibreLancer/Render/GateTunnelRenderer.cs
new file mode 100644
--- /dev/null
+++ b/src/LibreLancer/Render/GateTunnelRenderer.cs
@@ -0,0 +1,286 @@
+// MIT License - Copyright (c) Callum McGing
+// This file is subject to the terms and conditions defined in
+// LICENSE, which is part of this source code package
+
+using System;
+using System.Collections.Generic;
+using System.Numerics;
+using LibreLancer.Data.Schema.Effects;
+using LibreLancer.Graphics;
+using LibreLancer.Graphics.Vertices;
+using LibreLancer.Resources;
+using LibreLancer.Shaders;
+using LibreLancer.Utf.Mat;
+
+namespace LibreLancer.Render;
+
+/// <summary>Draws the layered, camera-centered tunnel used during a jump-gate transition.</summary>
+public sealed unsafe class GateTunnelRenderer : ObjectRenderer, IDisposable
+{
+    private const int MaxTSteps = 256;
+    private const int MaxSSteps = 64;
+    private const int MaxLayers = 8;
+    private readonly GateTunnel profile;
+    private readonly double duration;
+    private readonly double fadeIn;
+    private readonly double fadeOut;
+    private readonly float totalTimeToMaxSpeed;
+    private readonly int tSteps;
+    private readonly int sSteps;
+    private readonly Vector2[] controlPoints;
+    private readonly List<(GateTunnelLayer Layer, Texture2D Texture, TunnelMaterial Material)> layers = [];
+    private readonly List<(TunnelMaterial Material, int Start, int Count)> drawRanges = [];
+    private readonly Vector3[] ringA;
+    private readonly Vector3[] ringB;
+    private readonly VertexBuffer vertices;
+    private double elapsed;
+    private bool disposed;
+
+    public bool Finished => elapsed >= duration;
+
+    public GateTunnelRenderer(RenderContext context, ResourceManager resources, GateTunnel profile,
+        double duration, double fadeIn, double fadeOut)
+    {
+        this.profile = profile;
+        this.duration = Math.Max(0.1, Finite(duration, 0.1));
+        this.fadeIn = Math.Clamp(Finite(fadeIn, 0.25), 0, this.duration);
+        this.fadeOut = Math.Clamp(Finite(fadeOut, 0.25), 0, this.duration);
+        totalTimeToMaxSpeed = Math.Max(0.01f, Finite(profile.TimeToMaxSpeed, 1));
+        tSteps = Math.Clamp(profile.TSteps, 8, MaxTSteps);
+        sSteps = Math.Clamp(profile.SSteps, 6, MaxSSteps);
+        controlPoints = BuildControlPoints(profile, Math.Clamp(profile.SplineControlPoints, 2, 32));
+        ringA = new Vector3[sSteps + 1];
+        ringB = new Vector3[sSteps + 1];
+
+        foreach (var layer in profile.Layers)
+        {
+            if (layers.Count == MaxLayers)
+                break;
+            if (string.IsNullOrWhiteSpace(layer.Texture) ||
+                resources.FindTexture(layer.Texture) is not Texture2D texture)
+                continue;
+            layers.Add((layer, texture, new TunnelMaterial(texture, BlendMode.Additive,
+                profile.WriteDepthBuffer != 0)));
+        }
+
+        vertices = new VertexBuffer(context, typeof(VertexPositionColorTexture),
+            tSteps * sSteps * Math.Max(1, layers.Count) * 6, true);
+        LitAmbient = false;
+        LitDynamic = false;
+        NoFog = true;
+        InheritCull = false;
+    }
+
+    public override void Update(double time, Transform3D transform)
+    {
+        if (double.IsFinite(time) && time > 0)
+            elapsed = Math.Min(duration, elapsed + time);
+    }
+
+    public override bool PrepareRender(ICamera camera, NebulaRenderer? nr, SystemRenderer sys, bool forceCull)
+    {
+        if (disposed || Finished || layers.Count == 0)
+            return false;
+        sys.AddObject(this);
+        return true;
+    }
+
+    public override void Draw(ICamera camera, CommandBuffer commands, SystemLighting lights, NebulaRenderer nr)
+    {
+        if (disposed || Finished || layers.Count == 0 || !Matrix4x4.Invert(camera.View, out var cameraWorld))
+            return;
+
+        var right = Vector3.TransformNormal(Vector3.UnitX, cameraWorld);
+        var up = Vector3.TransformNormal(Vector3.UnitY, cameraWorld);
+        var forward = Vector3.TransformNormal(-Vector3.UnitZ, cameraWorld);
+        right = SafeNormal(right, Vector3.UnitX);
+        up = SafeNormal(up, Vector3.UnitY);
+        forward = SafeNormal(forward, -Vector3.UnitZ);
+        var cameraPosition = camera.Position;
+        var distance = Math.Max(100, Finite(profile.ZRange, 20000));
+        var flow = MathHelper.Clamp(elapsed / totalTimeToMaxSpeed, 0, 1);
+        var speed = Lerp(Finite(profile.MinSpeed, 0), Finite(profile.MaxSpeed, 0.08f), (float)flow);
+        var rotation = MathF.PI / 180f * Lerp(Finite(profile.MinRotation, 0), Finite(profile.MaxRotation, 0),
+            (float)MathHelper.Clamp(elapsed / duration, 0, 1));
+        var alpha = Envelope();
+        var pointer = (VertexPositionColorTexture*)vertices.BeginStreaming();
+        var vertexCount = 0;
+        drawRanges.Clear();
+        try
+        {
+            foreach (var (layer, _, material) in layers)
+            {
+                var start = vertexCount;
+                var radiusFactor = Math.Max(0, Finite(layer.RadiusFactor, 1));
+                var ringCurrent = ringA;
+                var ringNext = ringB;
+                FillRing(ringCurrent, 0, cameraPosition, right, up, forward, distance, radiusFactor, rotation);
+                for (var ti = 0; ti < tSteps; ti++)
+                {
+                    var t0 = ti / (float)tSteps;
+                    var t1 = (ti + 1) / (float)tSteps;
+                    FillRing(ringNext, t1, cameraPosition, right, up, forward, distance, radiusFactor, rotation);
+                    var fade0 = EndFade(t0);
+                    var fade1 = EndFade(t1);
+                    for (var si = 0; si < sSteps; si++)
+                    {
+                        var s0 = si / (float)sSteps;
+                        var s1 = (si + 1) / (float)sSteps;
+                        var uv00 = new Vector2(layer.UOffset + s0 + (float)(elapsed * speed * layer.DU),
+                            layer.VOffset + t0 * layer.VScale + (float)(elapsed * speed * layer.DV));
+                        var uv10 = new Vector2(layer.UOffset + s1 + (float)(elapsed * speed * layer.DU), uv00.Y);
+                        var uv01 = new Vector2(uv00.X, layer.VOffset + t1 * layer.VScale + (float)(elapsed * speed * layer.DV));
+                        var uv11 = new Vector2(uv10.X, uv01.Y);
+                        var c0 = TunnelColor(layer, t0, alpha * fade0);
+                        var c1 = TunnelColor(layer, t1, alpha * fade1);
+                        var p00 = ringCurrent[si];
+                        var p10 = ringCurrent[si + 1];
+                        var p01 = ringNext[si];
+                        var p11 = ringNext[si + 1];
+                        pointer[vertexCount++] = new VertexPositionColorTexture(p00, c0, uv00);
+                        pointer[vertexCount++] = new VertexPositionColorTexture(p10, c0, uv10);
+                        pointer[vertexCount++] = new VertexPositionColorTexture(p11, c1, uv11);
+                        pointer[vertexCount++] = new VertexPositionColorTexture(p00, c0, uv00);
+                        pointer[vertexCount++] = new VertexPositionColorTexture(p11, c1, uv11);
+                        pointer[vertexCount++] = new VertexPositionColorTexture(p01, c1, uv01);
+                    }
+                    (ringCurrent, ringNext) = (ringNext, ringCurrent);
+                }
+                drawRanges.Add((material, start, vertexCount - start));
+            }
+        }
+        finally
+        {
+            vertices.EndStreaming(vertexCount);
+        }
+
+        var depth = cameraPosition + forward * (float)(distance * 0.5);
+        var z = RenderHelpers.GetZ(cameraPosition, depth);
+        foreach (var range in drawRanges)
+        {
+            if (range.Count == 0)
+                continue;
+            commands.AddCommand(range.Material, null, commands.WorldBuffer.Identity, Lighting.Empty,
+                vertices, 1, PrimitiveTypes.TriangleList, -1, range.Start, range.Count / 3,
+                SortLayers.OBJECT, z);
+        }
+    }
+
+    private void FillRing(Vector3[] points, float t, Vector3 camera, Vector3 right, Vector3 up, Vector3 forward,
+        double depth, float radiusFactor, float rotation)
+    {
+        var curve = SampleCenterline(t);
+        var center = camera + forward * (float)(3 + depth * t) + right * curve.X + up * curve.Y;
+        var radius = Lerp(Finite(profile.MinRadius, 50), Finite(profile.MaxRadius, 100), t);
+        radius *= Math.Max(0, Lerp(1, Finite(profile.FarRadiusFactor, 1), t)) * radiusFactor;
+        for (var i = 0; i <= sSteps; i++)
+        {
+            var angle = MathF.Tau * i / sSteps + rotation * t + (float)elapsed * 0.12f;
+            points[i] = center + right * (MathF.Cos(angle) * radius) + up * (MathF.Sin(angle) * radius);
+        }
+    }
+
+    private static Vector2[] BuildControlPoints(GateTunnel profile, int count)
+    {
+        uint hash = 2166136261;
+        foreach (var character in profile.Nickname)
+            hash = (hash ^ char.ToUpperInvariant(character)) * 16777619;
+        var random = new Random(unchecked((int)hash));
+        var xRange = Math.Abs(Finite(profile.XRange, 0)) * 0.5f;
+        var yRange = Math.Abs(Finite(profile.YRange, 0)) * 0.5f;
+        var points = new Vector2[count];
+        for (var i = 0; i < count; i++)
+            points[i] = new Vector2(((float)random.NextDouble() * 2 - 1) * xRange,
+                ((float)random.NextDouble() * 2 - 1) * yRange);
+        points[0] = Vector2.Zero;
+        points[^1] = Vector2.Zero;
+        return points;
+    }
+
+    private Vector2 SampleCenterline(float t)
+    {
+        var scaled = MathHelper.Clamp(t, 0, 1) * (controlPoints.Length - 1);
+        var segment = Math.Min((int)scaled, controlPoints.Length - 2);
+        var amount = scaled - segment;
+        var p0 = controlPoints[Math.Max(0, segment - 1)];
+        var p1 = controlPoints[segment];
+        var p2 = controlPoints[segment + 1];
+        var p3 = controlPoints[Math.Min(controlPoints.Length - 1, segment + 2)];
+        var t2 = amount * amount;
+        var t3 = t2 * amount;
+        return 0.5f * ((2 * p1) + (-p0 + p2) * amount +
+                       (2 * p0 - 5 * p1 + 4 * p2 - p3) * t2 +
+                       (-p0 + 3 * p1 - 3 * p2 + p3) * t3);
+    }
+
+    private float EndFade(float t)
+    {
+        var fade = Math.Clamp(MathF.Abs(Finite(profile.FadeDistance, 0.1f)), 0, 0.5f);
+        if (fade <= 0)
+            return 1;
+        return Math.Min(MathHelper.Clamp(t / fade, 0, 1), MathHelper.Clamp((1 - t) / fade, 0, 1));
+    }
+
+    private Color4 TunnelColor(GateTunnelLayer layer, float t, float fade)
+    {
+        var profileColor = Vector3.Lerp(profile.MinRgb, profile.MaxRgb, t) / 255f;
+        var layerColor = layer.Color / 255f;
+        var alpha = Lerp(Finite(profile.NearAlpha, 1) * Finite(layer.NearAlphaFactor, 1),
+            Finite(profile.FarAlpha, 1) * Finite(layer.FarAlphaFactor, 1), t) * fade;
+        return new Color4(profileColor.X * layerColor.X, profileColor.Y * layerColor.Y,
+            profileColor.Z * layerColor.Z, MathHelper.Clamp(alpha, 0, 1));
+    }
+
+    private float Envelope()
+    {
+        var inAlpha = fadeIn <= 0 ? 1 : (float)MathHelper.Clamp(elapsed / fadeIn, 0, 1);
+        var outAlpha = fadeOut <= 0 ? 1 : (float)MathHelper.Clamp((duration - elapsed) / fadeOut, 0, 1);
+        return Math.Min(inAlpha, outAlpha);
+    }
+
+    private static float Finite(float value, float fallback) => float.IsFinite(value) ? value : fallback;
+    private static double Finite(double value, double fallback) => double.IsFinite(value) ? value : fallback;
+    private static float Lerp(float a, float b, float t) => a + (b - a) * t;
+    private static Vector3 SafeNormal(Vector3 value, Vector3 fallback) =>
+        value.LengthSquared() > 0.0001f ? Vector3.Normalize(value) : fallback;
+
+    public void Dispose()
+    {
+        if (disposed)
+            return;
+        disposed = true;
+        vertices.Dispose();
+        layers.Clear();
+    }
+
+    private sealed class TunnelMaterial : RenderMaterial
+    {
+        private readonly Texture2D texture;
+        private readonly ushort blend;
+        private readonly bool writeDepth;
+        private bool previousDepthWrite;
+
+        public TunnelMaterial(Texture2D texture, ushort blend, bool writeDepth) : base(null)
+        {
+            this.texture = texture;
+            this.blend = blend;
+            this.writeDepth = writeDepth;
+            DoubleSided = true;
+        }
+
+        public override void Use(RenderContext rstate, IVertexType vertextype, ref Lighting lights, int userData)
+        {
+            previousDepthWrite = rstate.DepthWrite;
+            rstate.DepthWrite = writeDepth;
+            rstate.Textures[0] = texture;
+            rstate.Samplers[0] = new SamplerState(rstate.PreferredFilterLevel, WrapMode.Repeat, WrapMode.Repeat);
+            rstate.BlendMode = blend;
+            rstate.Shader = AllShaders.Sprite.Get(0);
+        }
+
+        public override void AfterDraw(RenderContext rstate) => rstate.DepthWrite = previousDepthWrite;
+
+        public override bool IsTransparent => true;
+        public override bool DisableCull => true;
+    }
+}

