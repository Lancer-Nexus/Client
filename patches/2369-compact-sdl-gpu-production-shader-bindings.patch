diff --git a/src/LLShaderCompiler/SpirvBindingCompactor.cs b/src/LLShaderCompiler/SpirvBindingCompactor.cs
new file mode 100644
index 0000000..adde5e0
--- /dev/null
+++ b/src/LLShaderCompiler/SpirvBindingCompactor.cs
@@ -0,0 +1,94 @@
+using System.Buffers.Binary;
+
+namespace LLShaderCompiler;
+
+public readonly record struct SpirvBindingRemap(uint DescriptorSet, uint OriginalBinding, uint SdlBinding);
+
+internal static class SpirvBindingCompactor
+{
+    private const uint SpirvMagic = 0x07230203;
+    private const ushort OpDecorate = 71;
+    private const ushort OpGroupDecorate = 74;
+    private const ushort DecorationBinding = 33;
+    private const ushort DecorationDescriptorSet = 34;
+
+    public static (byte[] Code, SpirvBindingRemap[] Bindings) Compact(byte[] code, string file,
+        ShaderStage stage)
+    {
+        if (code.Length < 20 || (code.Length & 3) != 0)
+            throw BindingError(file, stage, "Invalid SPIR-V module length");
+
+        var words = new uint[code.Length / 4];
+        for (var i = 0; i < words.Length; i++)
+            words[i] = BinaryPrimitives.ReadUInt32LittleEndian(code.AsSpan(i * 4, 4));
+        if (words[0] != SpirvMagic)
+            throw BindingError(file, stage, "Invalid SPIR-V module signature");
+
+        var bindings = new Dictionary<uint, uint>();
+        var descriptorSets = new Dictionary<uint, uint>();
+        var instructionOffsets = new List<(int Offset, int Count)>();
+        for (var offset = 5; offset < words.Length;)
+        {
+            var header = words[offset];
+            var wordCount = checked((int)(header >> 16));
+            var opcode = (ushort)header;
+            if (wordCount == 0 || wordCount > words.Length - offset)
+                throw BindingError(file, stage, "Malformed SPIR-V instruction length");
+            instructionOffsets.Add((offset, wordCount));
+
+            if (opcode == OpDecorate && wordCount >= 4)
+            {
+                var target = words[offset + 1];
+                var decoration = (ushort)words[offset + 2];
+                if (decoration == DecorationBinding)
+                    bindings[target] = words[offset + 3];
+                else if (decoration == DecorationDescriptorSet)
+                    descriptorSets[target] = words[offset + 3];
+            }
+            offset += wordCount;
+        }
+
+        foreach (var (offset, wordCount) in instructionOffsets)
+        {
+            if ((ushort)words[offset] != OpGroupDecorate || wordCount < 3)
+                continue;
+            var groupId = words[offset + 1];
+            if (bindings.ContainsKey(groupId) || descriptorSets.ContainsKey(groupId))
+                throw BindingError(file, stage,
+                    "SDL_GPU binding compaction does not support SPIR-V decoration groups");
+        }
+
+        var resources = bindings
+            .Where(x => descriptorSets.ContainsKey(x.Key))
+            .Select(x => (Id: x.Key, Set: descriptorSets[x.Key], Binding: x.Value))
+            .ToArray();
+        var remaps = resources
+            .GroupBy(x => x.Set)
+            .SelectMany(group => group.Select(x => x.Binding).Distinct().Order()
+                .Select((binding, slot) => new SpirvBindingRemap(group.Key, binding, checked((uint)slot))))
+            .OrderBy(x => x.DescriptorSet)
+            .ThenBy(x => x.OriginalBinding)
+            .ToArray();
+
+        var compactSlots = remaps.ToDictionary(x => (x.DescriptorSet, x.OriginalBinding), x => x.SdlBinding);
+        var compactById = resources.ToDictionary(x => x.Id,
+            x => compactSlots[(x.Set, x.Binding)]);
+        foreach (var (offset, wordCount) in instructionOffsets)
+        {
+            if ((ushort)words[offset] != OpDecorate || wordCount < 4 ||
+                (ushort)words[offset + 2] != DecorationBinding)
+                continue;
+            if (compactById.TryGetValue(words[offset + 1], out var compactBinding))
+                words[offset + 3] = compactBinding;
+        }
+
+        var compactCode = new byte[code.Length];
+        for (var i = 0; i < words.Length; i++)
+            BinaryPrimitives.WriteUInt32LittleEndian(compactCode.AsSpan(i * 4, 4), words[i]);
+        return (compactCode, remaps);
+    }
+
+    private static ShaderCompilerException BindingError(string file, ShaderStage stage, string message) =>
+        new(ShaderError.SdlGpuBindingError, file, 0, 0,
+            $"Cannot compact {stage.ToString().ToLowerInvariant()} SPIR-V bindings for SDL_GPU: {message}");
+}
