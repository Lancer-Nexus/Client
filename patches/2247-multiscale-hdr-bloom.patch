diff --git a/src/LibreLancer.Tests/BloomPyramidPassTests.cs b/src/LibreLancer.Tests/BloomPyramidPassTests.cs
new file mode 100644
index 0000000..8da5338
--- /dev/null
+++ b/src/LibreLancer.Tests/BloomPyramidPassTests.cs
@@ -0,0 +1,36 @@
+using LibreLancer.Graphics;
+using Xunit;
+
+public class BloomPyramidPassTests
+{
+    [Theory]
+    [InlineData(SystemRenderSubpass.BloomMediumHorizontalBlur,
+        SystemRenderResource.BloomExtractColor, SystemRenderResource.BloomMediumHorizontalColor)]
+    [InlineData(SystemRenderSubpass.BloomMediumVerticalBlur,
+        SystemRenderResource.BloomMediumHorizontalColor, SystemRenderResource.BloomMediumBlurredColor)]
+    [InlineData(SystemRenderSubpass.BloomWideHorizontalBlur,
+        SystemRenderResource.BloomExtractColor, SystemRenderResource.BloomWideHorizontalColor)]
+    [InlineData(SystemRenderSubpass.BloomWideVerticalBlur,
+        SystemRenderResource.BloomWideHorizontalColor, SystemRenderResource.BloomWideBlurredColor)]
+    public void PyramidBlurPassesReadAndWriteTheirDeclaredLevel(
+        SystemRenderSubpass pass, SystemRenderResource source, SystemRenderResource destination)
+    {
+        var descriptor = SystemRenderPasses.GetSubpass(pass);
+
+        Assert.True(descriptor.SourceColor.HasValue);
+        Assert.True(descriptor.Color.HasValue);
+        Assert.Equal(source, descriptor.SourceColor.Value.Resource);
+        Assert.Equal(destination, descriptor.Color.Value.Resource);
+        Assert.Equal(destination, descriptor.Writes);
+    }
+
+    [Fact]
+    public void ToneMapReadsAllBloomLevels()
+    {
+        var reads = SystemRenderPasses.GetSubpass(SystemRenderSubpass.ToneMap).Reads;
+
+        Assert.True((reads & SystemRenderResource.BloomBlurredColor) != 0);
+        Assert.True((reads & SystemRenderResource.BloomMediumBlurredColor) != 0);
+        Assert.True((reads & SystemRenderResource.BloomWideBlurredColor) != 0);
+    }
+}
