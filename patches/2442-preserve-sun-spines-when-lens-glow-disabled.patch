 using System;
 using LibreLancer.Graphics;
+using LibreLancer.Render;
 using Xunit;
+
+public class SunRendererVertexLayoutTests
+{
+    [Fact]
+    public void ReservesLensGlowVerticesForSpinesWhenGlowDrawIsDisabled()
+    {
+        var layout = SunRenderer.GetVertexLayout(firstIndex: 12, hasCenter: true, hasLensGlow: true);
+
+        Assert.Equal(12, layout.Center);
+        Assert.Equal(18, layout.Glow);
+        Assert.Equal(24, layout.LensGlow);
+        Assert.Equal(30, layout.Spines);
+    }
+
+    [Fact]
+    public void OmitsAbsentCenterAndLensGlowQuads()
+    {
+        var layout = SunRenderer.GetVertexLayout(firstIndex: 12, hasCenter: false, hasLensGlow: false);
+
+        Assert.Equal(-1, layout.Center);
+        Assert.Equal(12, layout.Glow);
+        Assert.Equal(-1, layout.LensGlow);
+        Assert.Equal(18, layout.Spines);
+    }
+}
 
 public class SystemRenderPassGraphTests
