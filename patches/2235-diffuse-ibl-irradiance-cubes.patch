+    /// <summary>Resolves an optional preconvolved diffuse irradiance cube from Surface metadata.</summary>
+    public TextureCube? ResolveEnvironmentIrradiance(string? nickname)
+    {
+        if (string.IsNullOrWhiteSpace(nickname) ||
+            !SurfaceMaps.TryResolveCubeMap(nickname, out var catalogEntry) ||
+            string.IsNullOrWhiteSpace(catalogEntry?.IrradianceFile)) return null;
+
+        var normalized = catalogEntry.IrradianceFile.Replace('\\', '/');
+        var assetNickname = Path.GetFileNameWithoutExtension(normalized);
+        if (FindTexture(assetNickname) is TextureCube existing) return existing;
+        var unavailableKey = nickname + "|" + assetNickname;
+        if (!unavailableSurfaceIrradianceMaps.Add(unavailableKey)) return null;
+        try
+        {
+            LoadResourceFile(catalogEntry.IrradianceFile);
+        }
+        catch (Exception error) when (error is IOException or InvalidDataException or NotSupportedException or ArgumentException or FileException)
+        {
+            FLLog.Warning("Surface", $"Unable to load irradiance CubeMap {assetNickname} from {catalogEntry.IrradianceFile}: {error.Message}");
+            return null;
+        }
+
+        if (FindTexture(assetNickname) is TextureCube loaded) return loaded;
+        FLLog.Warning("Surface", $"Irradiance CubeMap {assetNickname} from {catalogEntry.IrradianceFile} did not resolve to a TextureCube");
+        return null;
+    }
+
