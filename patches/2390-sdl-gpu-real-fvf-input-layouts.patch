+using LibreLancer.Graphics;
+using LibreLancer.Graphics.Vertices;
+
+namespace LibreLancer.Graphics.Backends.SDL3Gpu;
+
+/// <summary>Representative real vertex layouts used by the production pipeline audit.</summary>
+internal static class SDL3GpuAuditVertexLayouts
+{
+    public static SDL3GpuVertexInputLayout FvfWithTangentAndDiffuse =>
+        SDL3GpuVertexInputLayout.From(new VertexDeclaration(60,
+            new VertexElement(VertexSlots.Position, 3, VertexElementType.Float, false, 0),
+            new VertexElement(VertexSlots.Normal, 3, VertexElementType.Float, false, 12),
+            new VertexElement(VertexSlots.Color, 4, VertexElementType.UnsignedByte, true, 24),
+            new VertexElement(VertexSlots.Texture1, 2, VertexElementType.Float, false, 28),
+            new VertexElement(VertexSlots.Texture2, 2, VertexElementType.Float, false, 36),
+            new VertexElement(VertexSlots.Texture3, 2, VertexElementType.Float, false, 44),
+            new VertexElement(VertexSlots.Texture4, 2, VertexElementType.Float, false, 52)));
+
+    public static SDL3GpuVertexInputLayout DfmSkinnedWithTangent =>
+        SDL3GpuVertexInputLayout.From(new VertexDeclaration(76,
+            new VertexElement(VertexSlots.Position, 3, VertexElementType.Float, false, 0),
+            new VertexElement(VertexSlots.Normal, 3, VertexElementType.Float, false, 12),
+            new VertexElement(VertexSlots.Texture1, 2, VertexElementType.Float, false, 24),
+            new VertexElement(VertexSlots.Texture2, 2, VertexElementType.Float, false, 32),
+            new VertexElement(VertexSlots.BoneWeights, 4, VertexElementType.Float, false, 40),
+            new VertexElement(VertexSlots.BoneIds, 4, VertexElementType.UnsignedByte, false, 56, integer: true),
+            new VertexElement(VertexSlots.Texture3, 2, VertexElementType.Float, false, 60),
+            new VertexElement(VertexSlots.Texture4, 2, VertexElementType.Float, false, 68)));
+}
