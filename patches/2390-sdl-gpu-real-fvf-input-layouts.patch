@@ -0,0 +1,121 @@
+using System;
+using System.Collections.Generic;
+using LibreLancer.Graphics.Vertices;
+using LibreLancer.Platforms;
+
+namespace LibreLancer.Graphics.Backends.SDL3Gpu;
+
+internal readonly record struct SDL3GpuVertexInputLayout(
+    uint Stride,
+    SDL3.SDL_GPUVertexAttribute[] Attributes)
+{
+    public static SDL3GpuVertexInputLayout From(IVertexType vertexType, uint bufferSlot = 0)
+    {
+        ArgumentNullException.ThrowIfNull(vertexType);
+        return From(vertexType.GetVertexDeclaration(), bufferSlot);
+    }
+
+    public static SDL3GpuVertexInputLayout From(VertexDeclaration declaration, uint bufferSlot = 0)
+    {
+        ArgumentNullException.ThrowIfNull(declaration);
+        if (declaration.Stride <= 0)
+            throw new InvalidOperationException("SDL_GPU vertex declarations require a positive stride.");
+
+        var elements = declaration.Elements
+            ?? throw new InvalidOperationException("SDL_GPU vertex declarations require an element list.");
+        var locations = new HashSet<int>();
+        var attributes = new SDL3.SDL_GPUVertexAttribute[elements.Length];
+        for (var i = 0; i < elements.Length; i++)
+        {
+            var element = elements[i];
+            if (element.Slot < 0 || !locations.Add(element.Slot))
+                throw new InvalidOperationException($"SDL_GPU vertex location {element.Slot} is invalid or duplicated.");
+            if (element.Offset < 0)
+                throw new InvalidOperationException($"SDL_GPU vertex location {element.Slot} has a negative offset.");
+
+            var format = GetFormat(element);
+            var elementBytes = checked(element.Elements * BytesPerComponent(element.Type));
+            if (element.Offset > declaration.Stride - elementBytes)
+                throw new InvalidOperationException(
+                    $"SDL_GPU vertex location {element.Slot} exceeds the declared vertex stride.");
+
+            attributes[i] = new SDL3.SDL_GPUVertexAttribute
+            {
+                location = checked((uint)element.Slot),
+                buffer_slot = bufferSlot,
+                format = format,
+                offset = checked((uint)element.Offset)
+            };
+        }
+
+        return new SDL3GpuVertexInputLayout(checked((uint)declaration.Stride), attributes);
+    }
+
+    private static SDL3.SDL_GPUVertexElementFormat GetFormat(VertexElement element)
+    {
+        if (element.Elements is < 1 or > 4)
+            throw new InvalidOperationException($"Unsupported component count {element.Elements}.");
+        if (element.Integer && (element.Normalized || element.Type == VertexElementType.Float))
+            throw new InvalidOperationException("Integer SDL_GPU vertex inputs must be unnormalized integer data.");
+
+        return element.Type switch
+        {
+            VertexElementType.Float when !element.Normalized && !element.Integer => element.Elements switch
+            {
+                1 => SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_FLOAT,
+                2 => SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_FLOAT2,
+                3 => SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3,
+                4 => SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_FLOAT4,
+                _ => throw Unsupported(element)
+            },
+            VertexElementType.UnsignedByte => ByteFormat(element, unsigned: true),
+            VertexElementType.Short => ShortFormat(element, unsigned: false),
+            VertexElementType.UnsignedShort => ShortFormat(element, unsigned: true),
+            _ => throw Unsupported(element)
+        };
+    }
+
+    private static SDL3.SDL_GPUVertexElementFormat ByteFormat(VertexElement element, bool unsigned)
+    {
+        if (element.Elements is not (2 or 4))
+            throw Unsupported(element);
+        return (unsigned, element.Elements, element.Normalized) switch
+        {
+            (true, 2, false) => SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_UBYTE2,
+            (true, 4, false) => SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_UBYTE4,
+            (true, 2, true) => SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_UBYTE2_NORM,
+            (true, 4, true) => SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_UBYTE4_NORM,
+            _ => throw Unsupported(element)
+        };
+    }
+
+    private static SDL3.SDL_GPUVertexElementFormat ShortFormat(VertexElement element, bool unsigned)
+    {
+        if (element.Elements is not (2 or 4))
+            throw Unsupported(element);
+        return (unsigned, element.Elements, element.Normalized) switch
+        {
+            (false, 2, false) => SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_SHORT2,
+            (false, 4, false) => SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_SHORT4,
+            (false, 2, true) => SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_SHORT2_NORM,
+            (false, 4, true) => SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_SHORT4_NORM,
+            (true, 2, false) => SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_USHORT2,
+            (true, 4, false) => SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_USHORT4,
+            (true, 2, true) => SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_USHORT2_NORM,
+            (true, 4, true) => SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_USHORT4_NORM,
+            _ => throw Unsupported(element)
+        };
+    }
+
+    private static int BytesPerComponent(VertexElementType type) => type switch
+    {
+        VertexElementType.Float => sizeof(float),
+        VertexElementType.Short or VertexElementType.UnsignedShort => sizeof(short),
+        VertexElementType.UnsignedByte => sizeof(byte),
+        _ => throw new ArgumentOutOfRangeException(nameof(type))
+    };
+
+    private static InvalidOperationException Unsupported(VertexElement element) =>
+        new($"SDL_GPU does not support vertex element {element.Type}x{element.Elements} " +
+            $"(normalized={element.Normalized}, integer={element.Integer}).");
+}
