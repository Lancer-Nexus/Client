diff --git a/src/LibreLancer.Tests/SDL3GpuVertexInputLayoutTests.cs b/src/LibreLancer.Tests/SDL3GpuVertexInputLayoutTests.cs
new file mode 100644
--- /dev/null
+++ b/src/LibreLancer.Tests/SDL3GpuVertexInputLayoutTests.cs
@@ -0,0 +1,73 @@
+using System;
+using LibreLancer;
+using LibreLancer.Graphics;
+using LibreLancer.Graphics.Backends.SDL3Gpu;
+using LibreLancer.Graphics.Vertices;
+using LibreLancer.Platforms;
+using LibreLancer.Utf.Dfm;
+using LibreLancer.Utf.Vms;
+using Xunit;
+
+public class SDL3GpuVertexInputLayoutTests
+{
+    [Fact]
+    public void MapsRetailFvfSlotsFormatsAndOffsets()
+    {
+        var vertexType = new FVFVertex(D3DFVF.XYZ | D3DFVF.NORMAL | D3DFVF.DIFFUSE | D3DFVF.TEX4);
+
+        var layout = SDL3GpuVertexInputLayout.From(vertexType);
+        var auditLayout = SDL3GpuAuditVertexLayouts.FvfWithTangentAndDiffuse;
+
+        Assert.Equal(60u, layout.Stride);
+        Assert.Equal(layout.Stride, auditLayout.Stride);
+        Assert.Equal(layout.Attributes, auditLayout.Attributes);
+        Assert.Collection(layout.Attributes,
+            attribute => AssertAttribute(attribute, VertexSlots.Position, SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3, 0),
+            attribute => AssertAttribute(attribute, VertexSlots.Normal, SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3, 12),
+            attribute => AssertAttribute(attribute, VertexSlots.Color, SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_UBYTE4_NORM, 24),
+            attribute => AssertAttribute(attribute, VertexSlots.Texture1, SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_FLOAT2, 28),
+            attribute => AssertAttribute(attribute, VertexSlots.Texture2, SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_FLOAT2, 36),
+            attribute => AssertAttribute(attribute, VertexSlots.Texture3, SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_FLOAT2, 44),
+            attribute => AssertAttribute(attribute, VertexSlots.Texture4, SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_FLOAT2, 52));
+    }
+
+    [Fact]
+    public void MapsDfmSkinningIdsAsUnsignedIntegerAttributes()
+    {
+        var layout = SDL3GpuVertexInputLayout.From(new DfmTangentVertex());
+        var auditLayout = SDL3GpuAuditVertexLayouts.DfmSkinnedWithTangent;
+
+        Assert.Equal(76u, layout.Stride);
+        Assert.Equal(layout.Stride, auditLayout.Stride);
+        Assert.Equal(layout.Attributes, auditLayout.Attributes);
+        var boneIds = Assert.Single(layout.Attributes, x => x.location == VertexSlots.BoneIds);
+        Assert.Equal(SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_UBYTE4, boneIds.format);
+        Assert.Equal(56u, boneIds.offset);
+        var boneWeights = Assert.Single(layout.Attributes, x => x.location == VertexSlots.BoneWeights);
+        Assert.Equal(SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_FLOAT4, boneWeights.format);
+        Assert.Equal(40u, boneWeights.offset);
+    }
+
+    [Fact]
+    public void RejectsVertexElementsThatExceedStride()
+    {
+        var vertexType = new TestVertexType(new VertexDeclaration(4,
+            new VertexElement(VertexSlots.Position, 2, VertexElementType.Float, false, 0)));
+
+        Assert.Throws<InvalidOperationException>(() => SDL3GpuVertexInputLayout.From(vertexType));
+    }
+
+    private static void AssertAttribute(SDL3.SDL_GPUVertexAttribute attribute, int location,
+        SDL3.SDL_GPUVertexElementFormat format, uint offset)
+    {
+        Assert.Equal((uint)location, attribute.location);
+        Assert.Equal(0u, attribute.buffer_slot);
+        Assert.Equal(format, attribute.format);
+        Assert.Equal(offset, attribute.offset);
+    }
+
+    private sealed class TestVertexType(VertexDeclaration declaration) : IVertexType
+    {
+        public VertexDeclaration GetVertexDeclaration() => declaration;
+    }
+}
