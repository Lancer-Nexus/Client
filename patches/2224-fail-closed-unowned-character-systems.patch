@@ -0,0 +1,31 @@
+using LibreLancer.Server;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public sealed class ClusterCharacterSystemOwnershipTests
+{
+    [Fact]
+    public void StandaloneCharacterLoadingDoesNotRequireClusterOwnership()
+    {
+        Assert.True(Player.CanLoadCharacterSystem(false, null, _ => false));
+    }
+
+    [Fact]
+    public void ClusterCharacterLoadingRequiresAnOwnedSystem()
+    {
+        Assert.True(Player.CanLoadCharacterSystem(true, "li01",
+            system => system.Equals("li01", System.StringComparison.OrdinalIgnoreCase)));
+        Assert.False(Player.CanLoadCharacterSystem(true, "li03",
+            system => system.Equals("li01", System.StringComparison.OrdinalIgnoreCase)));
+    }
+
+    [Theory]
+    [InlineData(null)]
+    [InlineData("")]
+    [InlineData("   ")]
+    public void ClusterCharacterLoadingRejectsMissingSystem(string? savedSystem)
+    {
+        Assert.False(Player.CanLoadCharacterSystem(true, savedSystem, _ => true));
+    }
+}
