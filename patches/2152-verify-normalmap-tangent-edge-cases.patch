diff --git a/src/LibreLancer.Tests/WorldMatrixBufferTests.cs b/src/LibreLancer.Tests/WorldMatrixBufferTests.cs
--- a/src/LibreLancer.Tests/WorldMatrixBufferTests.cs
+++ b/src/LibreLancer.Tests/WorldMatrixBufferTests.cs
@@ -1,3 +1,4 @@
+using System;
 using System.Numerics;
 using LibreLancer.Render;
 using Xunit;
@@ -23,4 +24,28 @@
         var world = Matrix4x4.CreateScale(0, 2, 3);
         Assert.Equal(1.0f, WorldMatrixBuffer.CreateNormalMatrix(world).M44);
     }
+
+    [Theory]
+    [InlineData(2f, 3f, 0.5f, 1f)]
+    [InlineData(-2f, 3f, 0.5f, -1f)]
+    public void NormalAndTangentStayOrthogonalAfterNonUniformWorldTransform(
+        float scaleX, float scaleY, float scaleZ, float expectedHandedness)
+    {
+        var world = Matrix4x4.CreateScale(scaleX, scaleY, scaleZ) *
+                    Matrix4x4.CreateRotationY(0.37f) *
+                    Matrix4x4.CreateTranslation(4, 5, 6);
+        var normalMatrix = WorldMatrixBuffer.CreateNormalMatrix(world);
+        var normal = Vector3.Normalize(new Vector3(1, 1, 1));
+        var tangent = Vector3.Normalize(Vector3.Cross(normal, Vector3.UnitZ));
+
+        var transformedNormal = Vector3.Normalize(Vector3.TransformNormal(normal, normalMatrix));
+        var transformedTangent = Vector3.Normalize(Vector3.TransformNormal(tangent, world));
+
+        Assert.True(float.IsFinite(transformedNormal.X) && float.IsFinite(transformedNormal.Y) &&
+                    float.IsFinite(transformedNormal.Z));
+        Assert.True(float.IsFinite(transformedTangent.X) && float.IsFinite(transformedTangent.Y) &&
+                    float.IsFinite(transformedTangent.Z));
+        Assert.True(MathF.Abs(Vector3.Dot(transformedNormal, transformedTangent)) < 1e-5f);
+        Assert.Equal(expectedHandedness, normalMatrix.M44);
+    }
 }
