+        private static void SiftUp(int[] heap, float[] priorities, int index)
+        {
+            while (index > 0)
+            {
+                var parent = (index - 1) / 2;
+                if (priorities[heap[parent]] <= priorities[heap[index]])
+                    break;
+                (heap[parent], heap[index]) = (heap[index], heap[parent]);
+                index = parent;
+            }
+        }
