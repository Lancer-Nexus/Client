+        private static void SiftDown(int[] heap, float[] priorities, int count, int index)
+        {
+            while (true)
+            {
+                var left = (index * 2) + 1;
+                if (left >= count)
+                    return;
+                var right = left + 1;
+                var smallest = right < count && priorities[heap[right]] < priorities[heap[left]]
+                    ? right
+                    : left;
+                if (priorities[heap[index]] <= priorities[heap[smallest]])
+                    return;
+                (heap[index], heap[smallest]) = (heap[smallest], heap[index]);
+                index = smallest;
+            }
+        }
