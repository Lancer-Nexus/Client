+    private static unsafe (IntPtr Texture, IntPtr TransferBuffer) CreateDdsTexture(IntPtr device,
+        byte[] ddsData)
+    {
+        using var stream = new MemoryStream(ddsData, writable: false);
+        var mips = LibreLancer.ImageLib.DDS.ImageFromStream(stream);
+        if (mips is not { Length: > 0 })
+            throw new InvalidDataException("SDL_GPU diffuse upload requires a 2D DDS mip chain.");
+        var format = mips[0].Format switch
+        {
+            SurfaceFormat.Dxt1 => SDL3.SDL_GPUTextureFormat.SDL_GPU_TEXTUREFORMAT_BC1_RGBA_UNORM,
+            SurfaceFormat.Dxt3 => SDL3.SDL_GPUTextureFormat.SDL_GPU_TEXTUREFORMAT_BC2_RGBA_UNORM,
+            SurfaceFormat.Dxt5 => SDL3.SDL_GPUTextureFormat.SDL_GPU_TEXTUREFORMAT_BC3_RGBA_UNORM,
+            SurfaceFormat.Rgtc1 => SDL3.SDL_GPUTextureFormat.SDL_GPU_TEXTUREFORMAT_BC4_R_UNORM,
+            SurfaceFormat.Rgtc2 => SDL3.SDL_GPUTextureFormat.SDL_GPU_TEXTUREFORMAT_BC5_RG_UNORM,
+            _ => throw new InvalidDataException($"SDL_GPU diffuse DDS format {mips[0].Format} is not supported by the compressed upload path.")
+        };
+        for (var i = 0; i < mips.Length; i++)
+        {
+            var expectedWidth = Math.Max(1, mips[0].Width >> i);
+            var expectedHeight = Math.Max(1, mips[0].Height >> i);
+            if (mips[i].Format != mips[0].Format || mips[i].Width != expectedWidth ||
+                mips[i].Height != expectedHeight || mips[i].Data.Length == 0)
+                throw new InvalidDataException($"DDS mip {i} has invalid dimensions or no data.");
+        }
+        if (!SDL3.SDL_GPUTextureSupportsFormat(device, format,
+                SDL3.SDL_GPUTextureType.SDL_GPU_TEXTURETYPE_2D,
+                SDL3.SDL_GPUTextureUsageFlags.SDL_GPU_TEXTUREUSAGE_SAMPLER))
+            throw new InvalidOperationException($"The selected SDL_GPU driver does not support sampleable {mips[0].Format} diffuse textures.");
+
+        var totalBytes = mips.Sum(x => checked((long)x.Data.Length));
+        if (totalBytes > uint.MaxValue)
+            throw new InvalidDataException("DDS mip chain is too large for an SDL_GPU transfer buffer.");
+        var texture = SDL3.SDL_CreateGPUTexture(device, new SDL3.SDL_GPUTextureCreateInfo
+        {
+            type = SDL3.SDL_GPUTextureType.SDL_GPU_TEXTURETYPE_2D,
+            format = format,
+            usage = SDL3.SDL_GPUTextureUsageFlags.SDL_GPU_TEXTUREUSAGE_SAMPLER,
+            width = (uint)mips[0].Width,
+            height = (uint)mips[0].Height,
+            layer_count_or_depth = 1,
+            num_levels = (uint)mips.Length,
+            sample_count = SDL3.SDL_GPUSampleCount.SDL_GPU_SAMPLECOUNT_1
+        });
+        if (texture == IntPtr.Zero)
+            throw Failure("Creating the real SDL_GPU diffuse texture failed");
+
+        var transfer = SDL3.SDL_CreateGPUTransferBuffer(device, new SDL3.SDL_GPUTransferBufferCreateInfo
+        {
+            usage = SDL3.SDL_GPUTransferBufferUsage.SDL_GPU_TRANSFERBUFFERUSAGE_UPLOAD,
+            size = (uint)totalBytes
+        });
+        if (transfer == IntPtr.Zero)
+        {
+            SDL3.SDL_ReleaseGPUTexture(device, texture);
+            throw Failure("Creating the real SDL_GPU diffuse upload buffer failed");
+        }
+
+        var mapped = SDL3.SDL_MapGPUTransferBuffer(device, transfer, false);
+        if (mapped == IntPtr.Zero)
+        {
+            SDL3.SDL_ReleaseGPUTexture(device, texture);
+            SDL3.SDL_ReleaseGPUTransferBuffer(device, transfer);
+            throw Failure("Mapping the real SDL_GPU diffuse upload buffer failed");
+        }
+        uint[] mipOffsets = new uint[mips.Length];
+        uint offset = 0;
+        for (var i = 0; i < mips.Length; i++)
+        {
+            mipOffsets[i] = offset;
+            Marshal.Copy(mips[i].Data, 0, IntPtr.Add(mapped, checked((int)offset)), mips[i].Data.Length);
+            offset = checked(offset + (uint)mips[i].Data.Length);
+        }
+        SDL3.SDL_UnmapGPUTransferBuffer(device, transfer);
+
+        var commandBuffer = SDL3.SDL_AcquireGPUCommandBuffer(device);
+        if (commandBuffer == IntPtr.Zero)
+        {
+            SDL3.SDL_ReleaseGPUTexture(device, texture);
+            SDL3.SDL_ReleaseGPUTransferBuffer(device, transfer);
+            throw Failure("Acquiring an SDL_GPU command buffer for diffuse upload failed");
+        }
+        var copyPass = SDL3.SDL_BeginGPUCopyPass(commandBuffer);
+        if (copyPass == IntPtr.Zero)
+        {
+            SDL3.SDL_CancelGPUCommandBuffer(commandBuffer);
+            SDL3.SDL_ReleaseGPUTexture(device, texture);
+            SDL3.SDL_ReleaseGPUTransferBuffer(device, transfer);
+            throw Failure("Beginning the SDL_GPU diffuse upload pass failed");
+        }
+        for (var i = 0; i < mips.Length; i++)
+        {
+            var mip = mips[i];
+            var source = new SDL3.SDL_GPUTextureTransferInfo
+            {
+                transfer_buffer = transfer,
+                offset = mipOffsets[i],
+                pixels_per_row = 0,
+                rows_per_layer = 0
+            };
+            var destination = new SDL3.SDL_GPUTextureRegion
+            {
+                texture = texture,
+                mip_level = (uint)i,
+                layer = 0,
+                x = 0,
+                y = 0,
+                z = 0,
+                w = (uint)mip.Width,
+                h = (uint)mip.Height,
+                d = 1
+            };
+            SDL3.SDL_UploadToGPUTexture(copyPass, source, destination, false);
+        }
+        SDL3.SDL_EndGPUCopyPass(copyPass);
+        if (!SDL3.SDL_SubmitGPUCommandBuffer(commandBuffer))
+        {
+            SDL3.SDL_ReleaseGPUTexture(device, texture);
+            SDL3.SDL_ReleaseGPUTransferBuffer(device, transfer);
+            throw Failure("Submitting the real SDL_GPU diffuse upload failed");
+        }
+        return (texture, transfer);
+    }
