+        private static void RestoreNpcCheckpointBatch(ServerWorld world, IReadOnlyList<NpcCheckpointRecoveryV1> recoveries)
+        {
+            var checkpoints = recoveries.Select(recovery => recovery.Snapshot).ToArray();
+            var npcs = checkpoints.SelectMany(checkpoint => checkpoint.Npcs).ToArray();
+            if (npcs.Length == 0 || npcs.Select(npc => npc.NpcId).Distinct().Count() != npcs.Length)
+                throw new InvalidDataException("NPC checkpoint recovery contains no members or duplicate stable IDs.");
+            foreach (var checkpoint in checkpoints)
+                NpcCheckpointContractValidator.Validate(checkpoint);
+            var snapshot = new NpcTransferSnapshot
+            {
+                TransferId = checkpoints[0].RequestId,
+                NpcIds = npcs.Select(npc => npc.NpcId).ToArray(),
+                Npcs = npcs,
+                TargetSystemId = checkpoints[0].SystemId,
+                Formations = checkpoints.SelectMany(checkpoint => checkpoint.Formations).ToArray()
+            };
+            world.NPCs.RestoreCheckpointBatch(snapshot,
+                expectedSystemId: world.System.Nickname.ToLowerInvariant());
+            foreach (var checkpoint in checkpoints)
+            {
+                var memberIds = checkpoint.Npcs.Select(npc => npc.NpcId).ToHashSet();
+                var members = world.GameWorld.Objects.Where(obj =>
+                        obj.TryGetComponent<Components.SNPCComponent>(out var npc) && memberIds.Contains(npc.NpcId))
+                    .ToArray();
+                if (members.Length != memberIds.Count)
+                    throw new InvalidDataException("NPC checkpoint recovery did not activate its complete member set.");
+                world.Population.AdoptRecoveredCheckpointGroup(members);
+                FLLog.Info("NPC Checkpoint", $"Restored checkpoint {checkpoint.RequestId:D} in {world.System.Nickname} ({members.Length} ships).");
+            }
+        }
