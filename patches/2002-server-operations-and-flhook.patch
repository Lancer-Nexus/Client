+        private bool IsEmptyNpcTransfer(Guid transferId)
+        {
+            var snapshotPath = GetNpcSourceSnapshotPath(transferId);
+            var markerPath = GetNpcNoNpcMarkerPath(transferId);
+            var disposition = NpcTransferJournalContract.Resolve(File.Exists(snapshotPath), File.Exists(markerPath));
+            if (disposition == NpcTransferJournalDisposition.Conflict)
+                throw new InvalidDataException("NPC transfer has both an empty marker and a source snapshot.");
+            if (disposition != NpcTransferJournalDisposition.Empty)
+                return false;
+            if (!NpcTransferJournalContract.IsEmptyMarker(File.ReadAllBytes(markerPath)))
+                throw new InvalidDataException("NPC transfer empty marker is invalid.");
+            return true;
+        }
