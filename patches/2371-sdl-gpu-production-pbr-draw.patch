+    private static unsafe (IntPtr Vertex, IntPtr Fragment) CreateProductionPbrShaders(IntPtr device)
+    {
+        const uint pbrViewVectorFeature = 1 << 9;
+        var gameAssembly = Assembly.Load("LibreLancer");
+        using var stream = gameAssembly.GetManifestResourceStream("PBR.bin")
+                           ?? throw new FileNotFoundException("Missing embedded production PBR shader bundle.");
+        var bundle = BytecodesBundle.FromStream(stream);
+        var index = Enumerable.Range(0, bundle.ShaderCount)
+            .FirstOrDefault(i => bundle.GetFeatures(i) == pbrViewVectorFeature, -1);
+        if (index < 0)
+            throw new InvalidDataException("The production PBR bundle has no PBR_VIEW_VECTOR variant.");
+
+        var shaderBytes = bundle.GetShader(index);
+        var program = ShaderBytecodes.GetSPIRV(shaderBytes);
+        var offset = 0;
+        var vertex = ReadStage(program, ref offset, true);
+        var fragment = ReadStage(program, ref offset, true);
+        if (offset != program.Length)
+            throw new InvalidDataException("Unexpected trailing production PBR SPIR-V data.");
+        ValidateBindingRemaps(vertex, [0, 1]);
+        ValidateBindingRemaps(fragment, [2, 3]);
+        if (vertex.UniformBuffers > 4 || fragment.UniformBuffers > 4 || fragment.Samplers != 2)
+            throw new InvalidDataException("Production PBR shader resources exceed the SDL_GPU probe contract.");
+
+        var vertexHandle = CreateSpirvShader(device, vertex, SDL3.SDL_GPUShaderStage.SDL_GPU_SHADERSTAGE_VERTEX);
+        try
+        {
+            var fragmentHandle = CreateSpirvShader(device, fragment, SDL3.SDL_GPUShaderStage.SDL_GPU_SHADERSTAGE_FRAGMENT);
+            Console.WriteLine($"Loaded production PBR variant {pbrViewVectorFeature}: vertex UBOs={vertex.UniformBuffers}, " +
+                              $"fragment UBOs={fragment.UniformBuffers}, fragment samplers={fragment.Samplers}.");
+            return (vertexHandle, fragmentHandle);
+        }
+        catch
+        {
+            SDL3.SDL_ReleaseGPUShader(device, vertexHandle);
+            throw;
+        }
+    }
