--- a/src/LibreLancer.Tests/SurfaceMapProfileTests.cs
+++ b/src/LibreLancer.Tests/SurfaceMapProfileTests.cs
@@ -82,6 +82,24 @@
     [Theory]
     [InlineData(true)]
     [InlineData(false)]
+    public void SunAmbientToggleSurvivesCopyApplyAndReload(bool enabled)
+    {
+        var settings = new GameSettings { RenderSunAmbient = enabled };
+        var copy = settings.MakeCopy();
+        Assert.Equal(enabled, copy.RenderSunAmbient);
+        var applied = new GameSettings { RenderSunAmbient = !enabled };
+        applied.Apply(copy);
+        Assert.Equal(enabled, applied.RenderSunAmbient);
+        using var writer = new StringWriter();
+        applied.Write(writer);
+        using var stream = new MemoryStream(Encoding.UTF8.GetBytes(writer.ToString()));
+        Assert.True(GameSettings.TryParse(Assert.Single(IniFile.ParseFile("settings.ini", stream)), out var loaded));
+        Assert.Equal(enabled, loaded!.RenderSunAmbient);
+    }
+
