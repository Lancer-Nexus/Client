+    private static unsafe (IntPtr Texture, IntPtr TransferBuffer) CreatePbrDiffuseTexture(IntPtr device)
+    {
+        const uint width = 4;
+        const uint height = 4;
+        const uint bytesPerPixel = 4;
+        const byte red = 204;
+        const byte green = 153;
+        const byte blue = 0;
+        const byte alpha = 255;
+        var format = SDL3.SDL_GPUTextureFormat.SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM;
+        var usage = SDL3.SDL_GPUTextureUsageFlags.SDL_GPU_TEXTUREUSAGE_SAMPLER;
+        if (!SDL3.SDL_GPUTextureSupportsFormat(device, format,
+                SDL3.SDL_GPUTextureType.SDL_GPU_TEXTURETYPE_2D, usage))
+            throw new InvalidOperationException("The selected SDL_GPU driver does not support sampleable RGBA8 textures.");
+
+        var texture = SDL3.SDL_CreateGPUTexture(device, new SDL3.SDL_GPUTextureCreateInfo
+        {
+            type = SDL3.SDL_GPUTextureType.SDL_GPU_TEXTURETYPE_2D,
+            format = format,
+            usage = usage,
+            width = width,
+            height = height,
+            layer_count_or_depth = 1,
+            num_levels = 1,
+            sample_count = SDL3.SDL_GPUSampleCount.SDL_GPU_SAMPLECOUNT_1
+        });
+        if (texture == IntPtr.Zero)
+            throw Failure("Creating the SDL_GPU PBR diffuse fixture failed");
+
+        const uint byteSize = width * height * bytesPerPixel;
+        var transfer = SDL3.SDL_CreateGPUTransferBuffer(device, new SDL3.SDL_GPUTransferBufferCreateInfo
+        {
+            usage = SDL3.SDL_GPUTransferBufferUsage.SDL_GPU_TRANSFERBUFFERUSAGE_UPLOAD,
+            size = byteSize
+        });
+        if (transfer == IntPtr.Zero)
+        {
+            SDL3.SDL_ReleaseGPUTexture(device, texture);
+            throw Failure("Creating the SDL_GPU PBR diffuse upload buffer failed");
+        }
+        var mapped = SDL3.SDL_MapGPUTransferBuffer(device, transfer, false);
+        if (mapped == IntPtr.Zero)
+        {
+            SDL3.SDL_ReleaseGPUTexture(device, texture);
+            SDL3.SDL_ReleaseGPUTransferBuffer(device, transfer);
+            throw Failure("Mapping the SDL_GPU PBR diffuse upload buffer failed");
+        }
+        for (uint pixel = 0; pixel < width * height; pixel++)
+        {
+            var offset = checked((int)(pixel * bytesPerPixel));
+            Marshal.WriteByte(mapped, offset, red);
+            Marshal.WriteByte(mapped, offset + 1, green);
+            Marshal.WriteByte(mapped, offset + 2, blue);
+            Marshal.WriteByte(mapped, offset + 3, alpha);
+        }
+        SDL3.SDL_UnmapGPUTransferBuffer(device, transfer);
+
+        var commandBuffer = SDL3.SDL_AcquireGPUCommandBuffer(device);
+        if (commandBuffer == IntPtr.Zero)
+        {
+            SDL3.SDL_ReleaseGPUTexture(device, texture);
+            SDL3.SDL_ReleaseGPUTransferBuffer(device, transfer);
+            throw Failure("Acquiring a command buffer for the PBR diffuse fixture upload failed");
+        }
+        var copyPass = SDL3.SDL_BeginGPUCopyPass(commandBuffer);
+        if (copyPass == IntPtr.Zero)
+        {
+            SDL3.SDL_CancelGPUCommandBuffer(commandBuffer);
+            SDL3.SDL_ReleaseGPUTexture(device, texture);
+            SDL3.SDL_ReleaseGPUTransferBuffer(device, transfer);
+            throw Failure("Beginning the PBR diffuse fixture upload pass failed");
+        }
+        var source = new SDL3.SDL_GPUTextureTransferInfo
+        {
+            transfer_buffer = transfer,
+            offset = 0,
+            pixels_per_row = width,
+            rows_per_layer = height
+        };
+        var destination = new SDL3.SDL_GPUTextureRegion
+        {
+            texture = texture,
+            mip_level = 0,
+            layer = 0,
+            x = 0,
+            y = 0,
+            z = 0,
+            w = width,
+            h = height,
+            d = 1
+        };
+        SDL3.SDL_UploadToGPUTexture(copyPass, source, destination, false);
+        SDL3.SDL_EndGPUCopyPass(copyPass);
+        if (!SDL3.SDL_SubmitGPUCommandBuffer(commandBuffer))
+        {
+            SDL3.SDL_ReleaseGPUTexture(device, texture);
+            SDL3.SDL_ReleaseGPUTransferBuffer(device, transfer);
+            throw Failure("Submitting the PBR diffuse fixture upload failed");
+        }
+        return (texture, transfer);
+    }
