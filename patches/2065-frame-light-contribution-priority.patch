+    [Fact]
+    public void FrameLightBudgetKeepsHigherAttenuatedContributionInsteadOfOnlyNearestLights()
+    {
+        var lighting = new SystemLighting();
+        lighting.BeginFrame(Vector3.Zero);
+
+        for (var i = 1; i <= SystemLighting.MaxFrameLights; i++)
+            Assert.True(lighting.AddFrameLight(CreateLight(i, attenuation: Vector3.One, range: 100)));
+
+        Assert.True(lighting.AddFrameLight(CreateLight(9, intensity: 2, attenuation: Vector3.One, range: 100)));
+
+        Assert.Equal(SystemLighting.MaxFrameLights, lighting.FrameLights.Count);
+        Assert.Contains(lighting.FrameLights, x => x.Light.Position.X == 9 && x.Light.Color.R == 2);
+        Assert.DoesNotContain(lighting.FrameLights, x => x.Light.Position.X == SystemLighting.MaxFrameLights);
