@@ -0,0 +1,87 @@
+using System;
+using LancerNexus.Protocol;
+using LibreLancer.Net.Protocol;
+using LiteNetLib.Utils;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public sealed class NetMarketQuoteV1Tests
+{
+    [Fact]
+    public void QuoteRoundTripsOverGamePacketEncoding()
+    {
+        var quote = MakeQuote();
+        var writer = new PacketWriter();
+        quote.Put(writer);
+
+        var roundTrip = NetMarketQuoteV1.Read(new PacketReader(new NetDataReader(writer.GetCopy())));
+
+        Assert.Equal(quote.SchemaVersion, roundTrip.SchemaVersion);
+        Assert.Equal(quote.SystemId, roundTrip.SystemId);
+        Assert.Equal(quote.MarketId, roundTrip.MarketId);
+        Assert.Equal(quote.GoodId, roundTrip.GoodId);
+        Assert.Equal(quote.Side, roundTrip.Side);
+        Assert.Equal(quote.Quantity, roundTrip.Quantity);
+        Assert.Equal(quote.MarketRevision, roundTrip.MarketRevision);
+        Assert.Equal(quote.ReputationRevision, roundTrip.ReputationRevision);
+        Assert.Equal(quote.QuoteUnitPrice, roundTrip.QuoteUnitPrice);
+        Assert.Equal(quote.TotalPrice, roundTrip.TotalPrice);
+        Assert.Equal(quote.ExpiresUtcTicks, roundTrip.ExpiresUtcTicks);
+        Assert.Equal(quote.PricingPolicyVersion, roundTrip.PricingPolicyVersion);
+    }
+
+    [Fact]
+    public void QuoteMustMatchGoodSideQuantityMarketAndLivePriceRevisions()
+    {
+        var expected = MakeQuote();
+        var actual = MakeCoordinatorQuote();
+
+        Assert.True(expected.IsFor("commodity_food", 3, sell: false));
+        Assert.True(expected.MatchesQuote(actual, expected.ReputationRevision));
+        Assert.False(expected.IsFor("commodity_food", 2, sell: false));
+        Assert.False(expected.IsFor("commodity_food", 3, sell: true));
+        Assert.False(expected.MatchesQuote(actual with { MarketRevision = actual.MarketRevision + 1 },
+            expected.ReputationRevision));
+        Assert.False(expected.MatchesQuote(actual with { TotalPrice = actual.TotalPrice + 1 },
+            expected.ReputationRevision));
+        Assert.False(expected.MatchesQuote(actual, expected.ReputationRevision + 1));
+        Assert.False(expected.MatchesQuote(actual with { MarketId = "other_base" }, expected.ReputationRevision));
+    }
+
+    private static NetMarketQuoteV1 MakeQuote() => new()
+    {
+        SystemId = "li01",
+        MarketId = "li01_01_base",
+        GoodId = "commodity_food",
+        Side = (byte)MarketTradeSideV1.Buy,
+        Quantity = 3,
+        MarketRevision = 42,
+        ReputationRevision = 7,
+        QuoteUnitPrice = 18,
+        TotalPrice = 54,
+        ExpiresUtcTicks = DateTime.UtcNow.AddSeconds(30).Ticks,
+        PricingPolicyVersion = 1
+    };
+
+    private static MarketQuoteResponseV1 MakeCoordinatorQuote() => new()
+    {
+        CorrelationId = Guid.NewGuid(),
+        CharacterId = 8,
+        SystemId = "li01",
+        MarketId = "li01_01_base",
+        GoodId = "commodity_food",
+        Side = MarketTradeSideV1.Buy,
+        Quantity = 3,
+        Status = MarketQuoteStatusV1.Quoted,
+        MarketRevision = 42,
+        ReputationRevision = 7,
+        MarketFactionId = "li_n_grp",
+        AppliedReputation = 0,
+        ReputationFactorPartsPerMillion = 1_000_000,
+        QuoteUnitPrice = 18,
+        TotalPrice = 54,
+        ExpiresUtc = DateTimeOffset.UtcNow.AddSeconds(30),
+        PricingPolicyVersion = 1
+    };
+}

