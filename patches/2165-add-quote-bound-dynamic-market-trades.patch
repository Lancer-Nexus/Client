new file mode 100644
index 000000000..72226248c
--- /dev/null
+++ b/src/LibreLancer/Server/MarketTradeSaveProjection.cs
@@ -0,0 +1,79 @@
+using System;
+using LibreLancer.Data;
+using LibreLancer.Data.Schema.Save;
+
+namespace LibreLancer.Server;
+
+internal static class MarketTradeSaveProjection
+{
+    public static bool TryPurchase(SaveGame save, string goodId, int quantity, string? hardpoint,
+        string? bundledAmmoGoodId, int bundledAmmoQuantity, long totalPrice)
+    {
+        var player = save.Player;
+        if (player is null || string.IsNullOrWhiteSpace(goodId) || quantity <= 0 || totalPrice < 0 ||
+            player.Money < totalPrice)
+            return false;
+        if (!string.IsNullOrWhiteSpace(hardpoint) && quantity != 1)
+            return false;
+        if (bundledAmmoQuantity < 0 ||
+            (bundledAmmoQuantity > 0 && string.IsNullOrWhiteSpace(bundledAmmoGoodId)))
+            return false;
+
+        player.Money -= totalPrice;
+        if (!string.IsNullOrWhiteSpace(hardpoint))
+        {
+            player.Equip.Add(new PlayerEquipment
+            {
+                Item = new HashValue(goodId),
+                Hardpoint = hardpoint.Equals("internal", StringComparison.OrdinalIgnoreCase) ? "" : hardpoint
+            });
+        }
+        else
+        {
+            player.Cargo.Add(new PlayerCargo { Item = new HashValue(goodId), Count = quantity });
+        }
+        if (bundledAmmoQuantity > 0)
+            player.Cargo.Add(new PlayerCargo
+            {
+                Item = new HashValue(bundledAmmoGoodId!), Count = bundledAmmoQuantity
+            });
+        return true;
+    }
+
+    public static bool TrySell(SaveGame save, string goodId, string? hardpoint, bool isMissionCargo,
+        int quantity, long totalPrice)
+    {
+        var player = save.Player;
+        if (player is null || string.IsNullOrWhiteSpace(goodId) || quantity <= 0 || totalPrice < 0 ||
+            player.Money > long.MaxValue - totalPrice)
+            return false;
+
+        var itemHash = new HashValue(goodId);
+        if (!string.IsNullOrWhiteSpace(hardpoint))
+        {
+            if (quantity != 1)
+                return false;
+            var expectedHardpoint = hardpoint.Equals("internal", StringComparison.OrdinalIgnoreCase)
+                ? "" : hardpoint;
+            var index = player.Equip.FindIndex(x => x.Item == itemHash &&
+                string.Equals(x.Hardpoint ?? "", expectedHardpoint, StringComparison.OrdinalIgnoreCase));
+            if (index < 0)
+                return false;
+            player.Equip.RemoveAt(index);
+        }
+        else
+        {
+            var index = player.Cargo.FindIndex(x => x.Item == itemHash &&
+                x.IsMissionCargo == isMissionCargo && x.Count >= quantity);
+            if (index < 0)
+                return false;
+            var cargo = player.Cargo[index];
+            cargo.Count -= quantity;
+            if (cargo.Count == 0)
+                player.Cargo.RemoveAt(index);
+        }
+
+        player.Money += totalPrice;
+        return true;
+    }
+}

