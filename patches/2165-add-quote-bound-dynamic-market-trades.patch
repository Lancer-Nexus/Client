@@ -0,0 +1,55 @@
+using LibreLancer.Data.Schema.Save;
+using LibreLancer.Server;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public sealed class MarketTradeSaveProjectionTests
+{
+    [Fact]
+    public void ProjectsMountedPurchaseAndBundledAmmoIntoSnapshotOnly()
+    {
+        var save = new SaveGame { Player = new SavePlayer { Money = 500 } };
+
+        var accepted = MarketTradeSaveProjection.TryPurchase(save, "li_gun", 1, "HpWeapon01",
+            "li_gun_ammo", 30, 125);
+
+        Assert.True(accepted);
+        Assert.Equal(375, save.Player!.Money);
+        var equipped = Assert.Single(save.Player.Equip);
+        Assert.Equal(new LibreLancer.Data.HashValue("li_gun"), equipped.Item);
+        Assert.Equal("HpWeapon01", equipped.Hardpoint);
+        var ammo = Assert.Single(save.Player.Cargo);
+        Assert.Equal(new LibreLancer.Data.HashValue("li_gun_ammo"), ammo.Item);
+        Assert.Equal(30, ammo.Count);
+    }
+
+    [Fact]
+    public void ProjectsMissionCargoSaleAndRejectsMissingOrWrongCargo()
+    {
+        var save = new SaveGame { Player = new SavePlayer { Money = 20 } };
+        save.Player.Cargo.Add(new PlayerCargo
+        {
+            Item = new LibreLancer.Data.HashValue("commodity_food"), Count = 8, IsMissionCargo = true
+        });
+
+        Assert.False(MarketTradeSaveProjection.TrySell(save, "commodity_food", null, false, 3, 15));
+        Assert.Equal(20, save.Player.Money);
+        Assert.Equal(8, Assert.Single(save.Player.Cargo).Count);
+
+        Assert.True(MarketTradeSaveProjection.TrySell(save, "commodity_food", null, true, 3, 15));
+        Assert.Equal(35, save.Player.Money);
+        Assert.Equal(5, Assert.Single(save.Player.Cargo).Count);
+    }
+
+    [Fact]
+    public void RefusesPurchaseWhenSnapshotCannotAffordQuotedTotal()
+    {
+        var save = new SaveGame { Player = new SavePlayer { Money = 99 } };
+
+        Assert.False(MarketTradeSaveProjection.TryPurchase(save, "commodity_food", 1, null, null, 0, 100));
+        Assert.Equal(99, save.Player!.Money);
+        Assert.Empty(save.Player.Cargo);
+        Assert.Empty(save.Player.Equip);
+    }
+}
