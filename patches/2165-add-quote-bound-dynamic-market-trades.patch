diff --git a/src/LibreLancer/Net/Protocol/NetMarketQuoteV1.cs b/src/LibreLancer/Net/Protocol/NetMarketQuoteV1.cs
new file mode 100644
index 000000000..49bfd37cd
--- /dev/null
+++ b/src/LibreLancer/Net/Protocol/NetMarketQuoteV1.cs
@@ -0,0 +1,76 @@
+using LancerNexus.Protocol;
+using System;
+
+namespace LibreLancer.Net.Protocol;
+
+/// <summary>
+/// Minimal game-wire quote preview. It carries no authority; the server re-quotes and
+/// matches every field before accepting a Gateway market commit.
+/// </summary>
+public sealed class NetMarketQuoteV1
+{
+    public int SchemaVersion { get; set; } = 1;
+    public string SystemId { get; set; } = "";
+    public string MarketId { get; set; } = "";
+    public string GoodId { get; set; } = "";
+    public byte Side { get; set; }
+    public int Quantity { get; set; }
+    public long MarketRevision { get; set; }
+    public long ReputationRevision { get; set; }
+    public long QuoteUnitPrice { get; set; }
+    public long TotalPrice { get; set; }
+    public long ExpiresUtcTicks { get; set; }
+    public int PricingPolicyVersion { get; set; }
+
+    public bool IsValid() => SchemaVersion == 1 && !string.IsNullOrWhiteSpace(SystemId) &&
+        !string.IsNullOrWhiteSpace(MarketId) && !string.IsNullOrWhiteSpace(GoodId) &&
+        Side is 1 or 2 && Quantity > 0 && MarketRevision > 0 && ReputationRevision > 0 &&
+        QuoteUnitPrice >= 0 && TotalPrice >= 0 && ExpiresUtcTicks > DateTime.UtcNow.Ticks &&
+        PricingPolicyVersion == 1;
+
+    public bool IsFor(string goodId, int quantity, bool sell) => IsValid() &&
+        string.Equals(GoodId, goodId, StringComparison.OrdinalIgnoreCase) && Quantity == quantity &&
+        Side == (sell ? (byte)MarketTradeSideV1.Sell : (byte)MarketTradeSideV1.Buy);
+
+    public bool MatchesQuote(MarketQuoteResponseV1 quote, long expectedReputationRevision) => IsValid() &&
+        quote.Status == MarketQuoteStatusV1.Quoted && quote.ExpiresUtc > DateTimeOffset.UtcNow &&
+        string.Equals(quote.SystemId, SystemId, StringComparison.OrdinalIgnoreCase) &&
+        string.Equals(quote.MarketId, MarketId, StringComparison.OrdinalIgnoreCase) &&
+        string.Equals(quote.GoodId, GoodId, StringComparison.OrdinalIgnoreCase) &&
+        (byte)quote.Side == Side && quote.Quantity == Quantity &&
+        quote.MarketRevision == MarketRevision && quote.ReputationRevision == ReputationRevision &&
+        expectedReputationRevision == ReputationRevision && quote.QuoteUnitPrice == QuoteUnitPrice &&
+        quote.TotalPrice == TotalPrice && quote.PricingPolicyVersion == PricingPolicyVersion;
+
+    public void Put(PacketWriter writer)
+    {
+        writer.PutVariableInt32(SchemaVersion);
+        writer.Put(SystemId);
+        writer.Put(MarketId);
+        writer.Put(GoodId);
+        writer.Put(Side);
+        writer.PutVariableInt32(Quantity);
+        writer.PutVariableInt64(MarketRevision);
+        writer.PutVariableInt64(ReputationRevision);
+        writer.PutVariableInt64(QuoteUnitPrice);
+        writer.PutVariableInt64(TotalPrice);
+        writer.PutVariableInt64(ExpiresUtcTicks);
+        writer.PutVariableInt32(PricingPolicyVersion);
+    }
+
+    public static NetMarketQuoteV1 Read(PacketReader reader) => new()
+    {
+        SchemaVersion = reader.GetVariableInt32(),
+        SystemId = reader.GetString() ?? "",
+        MarketId = reader.GetString() ?? "",
+        GoodId = reader.GetString() ?? "",
+        Side = reader.GetByte(),
+        Quantity = reader.GetVariableInt32(),
+        MarketRevision = reader.GetVariableInt64(),
+        ReputationRevision = reader.GetVariableInt64(),
+        QuoteUnitPrice = reader.GetVariableInt64(),
+        TotalPrice = reader.GetVariableInt64(),
+        ExpiresUtcTicks = reader.GetVariableInt64(),
+        PricingPolicyVersion = reader.GetVariableInt32()
+    };
+}

