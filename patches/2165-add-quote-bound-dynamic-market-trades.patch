+            SystemId = systemId, MarketId = BaseData.Nickname.ToLowerInvariant(),
+            GoodId = item.ToLowerInvariant(), Side = LancerNexus.Protocol.MarketTradeSideV1.Buy,
+            Quantity = quantity
+        };
+
+        return Player.CommitGatewayMarketTradeAsync(quoteRequest, (save, quote, _) =>
+        {
+            committedPrice = quote.TotalPrice;
+            if (!MatchesExpectedQuote(quote, _, expectedQuote))
+                return new LancerNexus.Protocol.MarketTradeQuoteReservationRequestV1();
+            if (!MarketTradeSaveProjection.TryPurchase(save, equipment.Nickname, count, hardpoint,
