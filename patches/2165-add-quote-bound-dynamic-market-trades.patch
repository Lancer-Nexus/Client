+                return new LancerNexus.Protocol.MarketTradeQuoteReservationRequestV1();
+            return CreateMarketReservation(quoteRequest, quote, tradeId);
+        }, () =>
+        {
+            if (!ReferenceEquals(Player.Character, character))
+                throw new InvalidOperationException("Player character changed while market trade was pending.");
+            using var transaction = character.BeginTransaction();
+            if (!string.IsNullOrWhiteSpace(hardpoint))
+                transaction.AddCargo(equipment, hardpoint, 1);
+            else
+                transaction.AddCargo(equipment, null, count);
+            if (bundledAmmo is not null && bundledAmmoCount > 0)
+                transaction.AddCargo(bundledAmmo, null, bundledAmmoCount);
+            transaction.UpdateCredits(character.Credits - committedPrice);
+        });
+    }
+
+    private Task<bool> SellGoodWithDynamicMarketAsync(NetCargo slot, int count, NetMarketQuoteV1 expectedQuote)
+    {
