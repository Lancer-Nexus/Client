From: Lancer Nexus
Subject: [PATCH] Handle in-space Gateway character previews safely

diff --git a/patches/series b/patches/series
--- a/patches/series
+++ b/patches/series
@@ -164,0 +165 @@ client 2162-publish-fixed-timestep-loop-stop.patch
+client 2163-handle-in-space-gateway-character-previews.patch
diff --git a/src/LibreLancer/Server/NetCharacter.cs b/src/LibreLancer/Server/NetCharacter.cs
--- a/src/LibreLancer/Server/NetCharacter.cs
+++ b/src/LibreLancer/Server/NetCharacter.cs
@@ -624,10 +624,10 @@
             {
                 Id = charId,
                 Rank = (int)Rank,
-                Ship = Ship!.Nickname,
-                Name = Name!,
+                Ship = Ship?.Nickname ?? string.Empty,
+                Name = Name ?? string.Empty,
                 Funds = Credits,
