+++ b/src/LibreLancer.Base/Graphics/Backends/SDL3/SDL3GpuShaderProgram.cs
@@ -0,0 +1,165 @@
+using System;
+using System.Buffers.Binary;
+using System.IO;
+using System.Linq;
+using System.Text;
+using LibreLancer.Graphics;
+
+namespace LibreLancer.Graphics.Backends.SDL3Gpu;
+
+internal readonly record struct SDL3GpuBindingRemap(uint DescriptorSet, uint OriginalBinding, uint SdlBinding);
+
+internal readonly record struct SDL3GpuCompiledStage(uint Samplers, uint StorageTextures, uint StorageBuffers,
+    uint UniformBuffers, SDL3GpuBindingRemap[] BindingRemaps, string Entrypoint, byte[] Code);
+
+internal readonly record struct SDL3GpuShaderProgram(SDL3GpuCompiledStage Vertex, SDL3GpuCompiledStage Fragment);
+
+/// <summary>
+/// Reads the SDL_GPU SPIR-V payload and its logical-to-compact descriptor map from a compiled shader.
+/// This is shared by the SDL_GPU probe and the renderer backend.
+/// </summary>
+internal static class SDL3GpuShaderProgramReader
+{
+    public static SDL3GpuShaderProgram Parse(ReadOnlySpan<byte> shaderBytes)
+    {
+        var hasBindingMap = ShaderBytecodes.GetVersion(shaderBytes) >= 2;
+        var program = ShaderBytecodes.GetSPIRV(shaderBytes);
+        var offset = 0;
+        var vertex = ReadStage(program, ref offset, hasBindingMap);
+        var fragment = ReadStage(program, ref offset, hasBindingMap);
+        if (offset != program.Length)
+            throw new InvalidDataException("Unexpected trailing data in SDL_GPU shader program.");
+
+        if (hasBindingMap)
+        {
+            ValidateBindingRemaps(vertex);
+            ValidateBindingRemaps(fragment);
+        }
+
+        return new SDL3GpuShaderProgram(vertex, fragment);
+    }
+
+    private static SDL3GpuCompiledStage ReadStage(ReadOnlySpan<byte> program, ref int offset, bool hasBindingMap)
+    {
+        var samplers = ReadVarUInt32(program, ref offset);
+        var storageTextures = ReadVarUInt32(program, ref offset);
+        var storageBuffers = ReadVarUInt32(program, ref offset);
+        var uniformBuffers = ReadVarUInt32(program, ref offset);
+        var bindingCount = hasBindingMap ? checked((int)ReadVarUInt32(program, ref offset)) : 0;
+        if (bindingCount > 128)
+            throw new InvalidDataException("SDL_GPU shader has an unreasonable binding map size.");
+
+        var bindingRemaps = new SDL3GpuBindingRemap[bindingCount];
+        for (var i = 0; i < bindingRemaps.Length; i++)
+        {
+            bindingRemaps[i] = new SDL3GpuBindingRemap(
+                ReadVarUInt32(program, ref offset),
+                ReadVarUInt32(program, ref offset),
+                ReadVarUInt32(program, ref offset));
+        }
+
+        var entrypointLength = checked((int)ReadVarUInt32(program, ref offset));
+        EnsureAvailable(program, offset, entrypointLength);
+        var entrypoint = Encoding.UTF8.GetString(program.Slice(offset, entrypointLength));
+        offset += entrypointLength;
+
+        var codeLength = checked((int)ReadVarUInt32(program, ref offset));
+        EnsureAvailable(program, offset, codeLength);
+        var code = program.Slice(offset, codeLength).ToArray();
+        offset += codeLength;
+
+        return new SDL3GpuCompiledStage(samplers, storageTextures, storageBuffers, uniformBuffers,
+            bindingRemaps, entrypoint, code);
+    }
+
+    private static void ValidateBindingRemaps(SDL3GpuCompiledStage stage)
+    {
+        if (stage.Code.Length < 20 || (stage.Code.Length & 3) != 0 ||
+            BinaryPrimitives.ReadUInt32LittleEndian(stage.Code) != 0x07230203)
+            throw new InvalidDataException("SDL_GPU shader contains invalid SPIR-V.");
+
+        var descriptorSets = new System.Collections.Generic.Dictionary<uint, uint>();
+        var bindings = new System.Collections.Generic.Dictionary<uint, uint>();
+        var words = new uint[stage.Code.Length / 4];
+        for (var i = 0; i < words.Length; i++)
+            words[i] = BinaryPrimitives.ReadUInt32LittleEndian(stage.Code.AsSpan(i * 4, 4));
+
+        for (var offset = 5; offset < words.Length;)
+        {
+            var wordCount = checked((int)(words[offset] >> 16));
+            if (wordCount == 0 || wordCount > words.Length - offset)
+                throw new InvalidDataException("SDL_GPU shader contains a malformed SPIR-V instruction.");
+
+            if ((ushort)words[offset] == 71 && wordCount >= 4)
+            {
+                var target = words[offset + 1];
+                var decoration = (ushort)words[offset + 2];
+                if (decoration == 33)
+                    bindings[target] = words[offset + 3];
+                else if (decoration == 34)
+                    descriptorSets[target] = words[offset + 3];
+            }
+            offset += wordCount;
+        }
+
+        var actualBindings = new System.Collections.Generic.HashSet<(uint Set, uint SdlBinding)>();
+        foreach (var binding in bindings)
+        {
+            if (descriptorSets.TryGetValue(binding.Key, out var set))
+                actualBindings.Add((set, binding.Value));
+        }
+
+        if (actualBindings.Count != stage.BindingRemaps.Length)
+            throw new InvalidDataException("SDL_GPU shader binding map does not cover every SPIR-V descriptor.");
+
+        var remappedBindings = new System.Collections.Generic.HashSet<(uint Set, uint Original)>();
+        foreach (var group in stage.BindingRemaps.GroupBy(x => x.DescriptorSet))
+        {
+            var ordered = group.OrderBy(x => x.SdlBinding).ToArray();
+            for (var i = 0; i < ordered.Length; i++)
+            {
+                var remap = ordered[i];
+                if (remap.SdlBinding != (uint)i)
+                    throw new InvalidDataException($"SDL_GPU descriptor set {group.Key} is not compact.");
+                if (!actualBindings.Contains((remap.DescriptorSet, remap.SdlBinding)))
+                    throw new InvalidDataException("SDL_GPU shader binding map refers to a missing compact SPIR-V binding.");
+                if (!remappedBindings.Add((remap.DescriptorSet, remap.OriginalBinding)))
+                    throw new InvalidDataException("SDL_GPU shader binding map contains a duplicate original binding.");
+            }
+        }
+    }
+
+    private static uint ReadVarUInt32(ReadOnlySpan<byte> data, ref int offset)
+    {
+        EnsureAvailable(data, offset, 1);
+        var b = data[offset++];
+        uint value = (uint)(b & 0x7F);
+        var extraCount = 0;
+        while ((b & 0x80) != 0 && extraCount < 4)
+        {
+            EnsureAvailable(data, offset, 1);
+            b = data[offset++];
+            var shift = 7 * (++extraCount);
+            var mask = extraCount == 4 ? 0x0F : 0x7F;
+            value |= (uint)(b & mask) << shift;
+        }
+
+        value += extraCount switch
+        {
+            1 => 128u,
+            2 => 16512u,
+            3 => 2113663u,
+            4 => 270549119u,
+            _ => 0u
+        };
+        if ((b & 0x80) != 0)
+            throw new InvalidDataException("Invalid variable-length integer in SDL_GPU shader program.");
+        return value;
+    }
+
+    private static void EnsureAvailable(ReadOnlySpan<byte> data, int offset, int count)
+    {
+        if (offset < 0 || count < 0 || offset > data.Length - count)
+            throw new InvalidDataException("Truncated SDL_GPU shader program.");
+    }
+}
