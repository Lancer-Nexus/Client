+using System;
+using System.Collections.Generic;
+using LibreLancer.Render;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public class RendererCleanupTests
+{
+    [Fact]
+    public void DisposeAllContinuesAfterFailureAndReportsIt()
+    {
+        var disposed = new List<string>();
+
+        var error = Assert.Throws<AggregateException>(() => RendererCleanup.DisposeAll(
+            new TestResource("first", disposed),
+            new TestResource("failing", disposed, fail: true),
+            null,
+            new TestResource("last", disposed)));
+
+        Assert.Contains("renderer dispose failure", error.ToString());
+        Assert.Equal(new[] { "first", "failing", "last" }, disposed);
+    }
+
+    private sealed class TestResource(string name, List<string> disposed, bool fail = false) : IDisposable
+    {
+        public void Dispose()
+        {
+            disposed.Add(name);
+            if (fail)
+                throw new InvalidOperationException("renderer dispose failure");
+        }
+    }
+}
