@@ -0,0 +1,24 @@
+using LibreLancer.Server;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public sealed class NpcTransferJournalDispositionTests
+{
+    [Fact]
+    public void ResolvesSnapshotAndExplicitEmptyHandoff()
+    {
+        Assert.Equal(NpcTransferJournalDisposition.Missing, NpcTransferJournalContract.Resolve(false, false));
+        Assert.Equal(NpcTransferJournalDisposition.Snapshot, NpcTransferJournalContract.Resolve(true, false));
+        Assert.Equal(NpcTransferJournalDisposition.Empty, NpcTransferJournalContract.Resolve(false, true));
+        Assert.Equal(NpcTransferJournalDisposition.Conflict, NpcTransferJournalContract.Resolve(true, true));
+    }
+
+    [Fact]
+    public void EmptyHandoffMarkerMustMatchTheVersionedContract()
+    {
+        Assert.True(NpcTransferJournalContract.IsEmptyMarker(NpcTransferJournalContract.EmptyMarkerBytes));
+        Assert.False(NpcTransferJournalContract.IsEmptyMarker([]));
+        Assert.False(NpcTransferJournalContract.IsEmptyMarker("other"u8));
+    }
+}
