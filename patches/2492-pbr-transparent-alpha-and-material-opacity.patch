@@ -0,0 +1,55 @@
+using LibreLancer.Render.Materials;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public sealed class BasicMaterialTransparencyTests
+{
+    [Fact]
+    public void FractionalMaterialOpacityUsesTransparentPass()
+    {
+        var material = new BasicMaterial("DcDt", null!)
+        {
+            OcEnabled = true,
+            Oc = 0.5f
+        };
+
+        Assert.True(material.IsTransparent);
+    }
+
+    [Fact]
+    public void OpaqueMaterialOpacityDoesNotUseTransparentPass()
+    {
+        var material = new BasicMaterial("DcDt", null!)
+        {
+            OcEnabled = true,
+            Oc = 1.0f
+        };
+
+        Assert.False(material.IsTransparent);
+    }
+
+    [Fact]
+    public void MaterialOpacityMultiplierUsesTransparentPass()
+    {
+        var material = new BasicMaterial("DcDt", null!)
+        {
+            OcEnabled = true,
+            Oc = 1.0f,
+            OpacityMultiplier = 0.5f
+        };
+
+        Assert.True(material.IsTransparent);
+    }
+
+    [Fact]
+    public void OpacityFieldWithoutOpacityFlagRemainsOpaque()
+    {
+        var material = new BasicMaterial("DcDt", null!)
+        {
+            Oc = 0.5f
+        };
+
+        Assert.False(material.IsTransparent);
+    }
+}
