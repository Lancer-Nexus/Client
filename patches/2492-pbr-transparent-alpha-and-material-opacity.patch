+using LibreLancer.Render;
+using LibreLancer.Render.Materials;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public sealed class DetailMapOpacityPassTests
+{
+    private static RenderMaterial[] CreateDetailMapMaterials(float opacity) =>
+    [
+        new DetailMapMaterial(null!, "diffuse", "detail") { OpacityMultiplier = opacity },
+        new Masked2DetailMapMaterial(null!, "diffuse", "detail0", "detail1")
+            { OpacityMultiplier = opacity },
+        new DetailMap2Dm1Msk2PassMaterial(null!, "diffuse", "detail")
+            { OpacityMultiplier = opacity },
+        new IllumDetailMapMaterial(null!, "diffuse", "detail0", "detail1")
+            { OpacityMultiplier = opacity }
+    ];
+
+    [Fact]
+    public void FractionalOpacityUsesTransparentPassForEveryDetailMapMaterial()
+    {
+        foreach (var material in CreateDetailMapMaterials(0.5f))
+            Assert.True(material.IsTransparent, material.GetType().Name);
+    }
+
+    [Fact]
+    public void FullOpacityKeepsEveryDetailMapMaterialInOpaquePass()
+    {
+        foreach (var material in CreateDetailMapMaterials(1.0f))
+            Assert.False(material.IsTransparent, material.GetType().Name);
+    }
+}
