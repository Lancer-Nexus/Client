+using System;
+using LibreLancer;
+using LibreLancer.Graphics;
+using LibreLancer.Platforms;
+
+namespace lancer;
+
+/// <summary>Runtime probe for the OpenGL Texture2D.GetData mip and region contract.</summary>
+internal static class GLTextureReadbackSmoke
+{
+    public static int Run()
+    {
+        try
+        {
+            var game = new ReadbackGame();
+            game.Run();
+            return game.ExitCode;
+        }
+        catch (Exception e)
+        {
+            Console.Error.WriteLine($"OpenGL texture readback smoke failed: {e}");
+            return 1;
+        }
+    }
+
+    private sealed class ReadbackGame() : Game(64, 64, false, GameConfiguration.SDL())
+    {
+        public int ExitCode { get; private set; } = 1;
+
+        protected override void Load()
+        {
+            try
+            {
+                using var texture = new Texture2D(RenderContext, 4, 4, true, SurfaceFormat.Bgra8);
+                Bgra8[] source =
+                [
+                    new(10, 20, 30, 255), new(40, 50, 60, 255),
+                    new(70, 80, 90, 255), new(100, 110, 120, 255)
+                ];
+                var baseLevel = new Bgra8[16];
+                texture.GetData(0, null, baseLevel, 0, baseLevel.Length);
+                texture.SetData(1, null, source, 0, source.Length);
+
+                var sentinel = new Bgra8(3, 5, 7, 11);
+                var full = new Bgra8[6];
+                Array.Fill(full, sentinel);
+                texture.GetData(1, null, full, 1, 4);
+                if (full[0] != sentinel || full[5] != sentinel)
+                    throw new InvalidOperationException("Full-mip readback overwrote data outside the requested destination range.");
+                for (var i = 0; i < source.Length; i++)
+                    if (full[i + 1] != source[i])
+                        throw new InvalidOperationException($"Mip pixel {i} was {full[i + 1]}, expected {source[i]}.");
+
+                var region = new Bgra8[4];
+                Array.Fill(region, sentinel);
+                texture.GetData(1, new Rectangle(1, 0, 1, 2), region, 1, 2);
+                if (region[0] != sentinel || region[3] != sentinel ||
+                    region[1] != source[1] || region[2] != source[3])
+                    throw new InvalidOperationException("Mip-region readback returned incorrect pixels or modified the destination outside start/count.");
+
+                ExpectArgumentFailure(() => texture.GetData(3, null, new Bgra8[1], 0, 1), "mip level");
+                ExpectArgumentFailure(() => texture.GetData(1, new Rectangle(2, 0, 1, 1), new Bgra8[1], 0, 1), "region bounds");
+                ExpectArgumentFailure(() => texture.GetData(1, null, new Bgra8[1], 0, 1), "destination length");
+
+                Console.WriteLine("OpenGL Texture2D.GetData passed mip-level, region, offset/count, bounds, and pixel checks.");
+                ExitCode = 0;
+            }
+            catch (Exception e)
+            {
+                Console.Error.WriteLine($"OpenGL texture readback smoke failed: {e}");
+                ExitCode = 1;
+            }
+        }
+
+        protected override void Update(double elapsed) => Exit();
+
+        private static void ExpectArgumentFailure(Action action, string check)
+        {
+            try
+            {
+                action();
+            }
+            catch (ArgumentException)
+            {
+                return;
+            }
+            throw new InvalidOperationException($"Texture readback did not reject invalid {check}.");
+        }
+    }
+}
