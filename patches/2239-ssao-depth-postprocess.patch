+using System;
+using System.Numerics;
+
+namespace LibreLancer.Graphics;
+
+/// <summary>Conservative, optional depth-based screen-space occlusion for opaque geometry.</summary>
+internal sealed class ScreenSpaceAmbientOcclusionPass : IPostProcessPass
+{
+    private readonly RenderContext graphics;
+    private readonly Texture2D depth;
+    private readonly SurfaceFormat format;
+    private readonly bool hasFollowingPass;
+    private RenderTarget2D? intermediate;
+    private int width;
+    private int height;
+    public long EstimatedMemoryBytes => intermediate?.EstimatedMemoryBytes ?? 0;
+
+    public ScreenSpaceAmbientOcclusionPass(RenderContext graphics, Texture2D depth, SurfaceFormat format,
+        bool hasFollowingPass)
+    {
+        this.graphics = graphics;
+        this.depth = depth;
+        this.format = format;
+        this.hasFollowingPass = hasFollowingPass;
+    }
+
+    public void Execute(ref PostProcessContext context)
+    {
+        if (context.SceneDepth == null)
+            return;
+        if (width != context.Width || height != context.Height || intermediate?.Texture.Format != format)
+        {
+            intermediate?.Dispose();
+            intermediate = new RenderTarget2D(graphics, context.Width, context.Height, null, false, format);
+            width = context.Width;
+            height = context.Height;
+        }
+        var target = hasFollowingPass ? intermediate : context.Target;
+
+        var oldTarget = graphics.RenderTarget;
+        var oldTexture0 = graphics.Textures[0];
+        var oldTexture1 = graphics.Textures[1];
+        var oldSampler0 = graphics.Samplers[0];
+        var oldSampler1 = graphics.Samplers[1];
+        var oldShader = graphics.Shader;
+        var oldBlend = graphics.BlendMode;
+        var oldDepth = graphics.DepthEnabled;
+        var oldDepthWrite = graphics.DepthWrite;
+        var oldColorWrite = graphics.ColorWrite;
+        var oldCull = graphics.Cull;
+        var viewport = false;
+        var scissor = false;
+        try
+        {
+            graphics.RenderTarget = target;
+            graphics.PushViewport(context.Offset.X, context.Offset.Y, context.Width, context.Height);
+            viewport = true;
+            scissor = graphics.PushScissor(new Rectangle(context.Offset.X, context.Offset.Y, context.Width, context.Height), false);
+            graphics.DepthEnabled = false;
+            graphics.DepthWrite = false;
+            graphics.ColorWrite = true;
+            graphics.Cull = false;
+            graphics.BlendMode = BlendMode.Opaque;
+            graphics.Textures[0] = context.Source;
+            graphics.Textures[1] = depth;
+            graphics.Samplers[0] = new SamplerState(TextureFiltering.Linear, WrapMode.ClampToEdge, WrapMode.ClampToEdge);
+            graphics.Samplers[1] = new SamplerState(TextureFiltering.Nearest, WrapMode.ClampToEdge, WrapMode.ClampToEdge);
+            var parameters = new Vector4(1f / context.Width, 1f / context.Height, 0.0015f, 0.045f);
+            graphics.SsaoShader.SetUniformBlock(3, ref parameters);
+            graphics.Shader = graphics.SsaoShader;
+            context.GpuSubpassMarker?.Invoke(SystemRenderSubpass.ScreenSpaceAmbientOcclusion, true);
+            try { graphics.FullScreenTriangle.Draw(PrimitiveTypes.TriangleList, 1); }
+            finally { context.GpuSubpassMarker?.Invoke(SystemRenderSubpass.ScreenSpaceAmbientOcclusion, false); }
+            if (hasFollowingPass)
+                context.Source = intermediate.Texture;
+        }
+        finally
+        {
+            graphics.Textures[0] = oldTexture0;
+            graphics.Textures[1] = oldTexture1;
+            graphics.Samplers[0] = oldSampler0;
+            graphics.Samplers[1] = oldSampler1;
+            graphics.Shader = oldShader;
+            graphics.BlendMode = oldBlend;
+            graphics.DepthEnabled = oldDepth;
+            graphics.DepthWrite = oldDepthWrite;
+            graphics.ColorWrite = oldColorWrite;
+            graphics.Cull = oldCull;
+            if (scissor) graphics.PopScissor();
+            if (viewport) graphics.PopViewport();
+            graphics.RenderTarget = oldTarget;
+        }
+    }
+
+    public void Dispose() => intermediate?.Dispose();
+}
