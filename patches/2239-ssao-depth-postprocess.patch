@@ -0,0 +1,31 @@
+Texture2D<float4> SceneTexture : register(t0, TEXTURE_SPACE);
+Texture2D<float> DepthTexture : register(t1, TEXTURE_SPACE);
+SamplerState SceneSampler : register(s0, TEXTURE_SPACE);
+SamplerState DepthSampler : register(s1, TEXTURE_SPACE);
+cbuffer Parameters : register(b3, UNIFORM_SPACE) { float4 AoParameters; }
+
+float SampleOcclusion(float2 uv, float centerDepth)
+{
+    float sampleDepth = DepthTexture.Sample(DepthSampler, uv).r;
+    return step(0.00001, centerDepth) * step(sampleDepth + AoParameters.z, centerDepth) *
+        saturate((centerDepth - sampleDepth - AoParameters.z) / max(AoParameters.w, 0.0001));
+}
+
+float4 main(float4 position : SV_Position, float2 uv : TEXCOORD0) : SV_Target0
+{
+    float centerDepth = DepthTexture.Sample(DepthSampler, uv).r;
+    if (centerDepth >= 0.99999)
+        return SceneTexture.Sample(SceneSampler, uv);
+    float2 pixel = AoParameters.xy * 2.0;
+    float occlusion = 0.0;
+    occlusion += SampleOcclusion(uv + pixel * float2(-1, -1), centerDepth);
+    occlusion += SampleOcclusion(uv + pixel * float2( 0, -1), centerDepth);
+    occlusion += SampleOcclusion(uv + pixel * float2( 1, -1), centerDepth);
+    occlusion += SampleOcclusion(uv + pixel * float2(-1,  0), centerDepth);
+    occlusion += SampleOcclusion(uv + pixel * float2( 1,  0), centerDepth);
+    occlusion += SampleOcclusion(uv + pixel * float2(-1,  1), centerDepth);
+    occlusion += SampleOcclusion(uv + pixel * float2( 0,  1), centerDepth);
+    occlusion += SampleOcclusion(uv + pixel * float2( 1,  1), centerDepth);
+    float factor = 1.0 - saturate(occlusion * 0.045);
+    return float4(SceneTexture.Sample(SceneSampler, uv).rgb * factor, 1.0);
+}
