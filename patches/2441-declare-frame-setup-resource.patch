+    [Fact]
+    public void FrameStateResourceSchedulesForwardRendererPasses()
+    {
+        var graph = new SystemRenderPassGraph();
+        var executionOrder = new System.Collections.Generic.List<string>();
+
+        graph.AddPass(SystemRenderPass.FrameClear, () => executionOrder.Add("clear"));
+        graph.AddResourceAction("Frame setup", () => executionOrder.Add("setup"),
+            reads: SystemRenderResource.None,
+            writes: SystemRenderResource.FrameState,
+            optionalReads: SystemRenderResource.None,
+            optionalWrites: SystemRenderResource.None,
+            priority: 1,
+            after: SystemRenderPassGraph.Name(SystemRenderPass.FrameClear));
+        graph.AddPass(SystemRenderPass.SsaoDepthPrepass, () => executionOrder.Add("sampleable depth"),
+            SystemRenderResource.FrameState);
+        graph.AddPass(SystemRenderPass.DepthPrepass, () => executionOrder.Add("depth"),
+            SystemRenderResource.FrameState);
+        graph.AddPass(SystemRenderPass.ShadowMap, () => executionOrder.Add("shadow"),
+            SystemRenderResource.FrameState);
+        graph.AddPass(SystemRenderPass.Opaque, () => executionOrder.Add("opaque"),
+            SystemRenderResource.FrameState);
+        graph.AddPass(SystemRenderPass.StarsAndNebula, () => executionOrder.Add("stars"),
+            SystemRenderResource.FrameState);
+        graph.AddResourceAction("Opaque hook", () => executionOrder.Add("opaque hook"),
+            reads: SystemRenderResource.FrameState | SystemRenderResource.SceneColor |
+                   SystemRenderResource.SceneDepth,
+            writes: SystemRenderResource.SceneColor | SystemRenderResource.SceneDepth,
+            optionalReads: SystemRenderResource.SceneDepth,
+            optionalWrites: SystemRenderResource.SceneDepth,
+            priority: 11);
+        graph.AddPass(SystemRenderPass.Transparent, () => executionOrder.Add("transparent"),
+            SystemRenderResource.FrameState);
+        graph.AddResourceAction("Physics hook", () => executionOrder.Add("physics"),
+            reads: SystemRenderResource.FrameState | SystemRenderResource.SceneColor |
+                   SystemRenderResource.SceneDepth,
+            writes: SystemRenderResource.SceneColor,
+            optionalReads: SystemRenderResource.SceneDepth,
+            optionalWrites: SystemRenderResource.None,
+            priority: 13);
+        graph.AddResourceAction("Debug overlay", () => executionOrder.Add("debug"),
+            reads: SystemRenderResource.FrameState | SystemRenderResource.SceneColor |
+                   SystemRenderResource.SceneDepth,
+            writes: SystemRenderResource.SceneColor,
+            optionalReads: SystemRenderResource.SceneDepth,
+            optionalWrites: SystemRenderResource.None,
+            priority: 14);
+        graph.AddResourceAction("AA resolve", () => executionOrder.Add("resolve"),
+            reads: SystemRenderResource.FrameState | SystemRenderResource.SceneColor,
+            writes: SystemRenderResource.PresentationColor,
