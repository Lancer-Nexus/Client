diff --git a/src/LibreLancer/Shaders/Particle.frag.hlsl b/src/LibreLancer/Shaders/Particle.frag.hlsl
new file mode 100644
index 0000000..0476573
--- /dev/null
+++ b/src/LibreLancer/Shaders/Particle.frag.hlsl
@@ -0,0 +1,43 @@
+#include "includes/Camera.hlsl"
+#include "includes/OutputColor.hlsl"
+
+Texture2D<float4> Texture : register(t0, TEXTURE_SPACE);
+Texture2D<float> SceneDepth : register(t1, TEXTURE_SPACE);
+SamplerState Sampler : register(s0, TEXTURE_SPACE);
+SamplerState DepthSampler : register(s1, TEXTURE_SPACE);
+
+cbuffer SoftParticleParameters : register(b4, UNIFORM_SPACE)
+{
+    float Softness;
+    float InvWidth;
+    float InvHeight;
+    float _padding;
+};
+
+struct PSInput
+{
+    float2 texCoord : TEXCOORD0;
+    float4 color : TEXCOORD1;
+    float viewDepth : TEXCOORD2;
+    float4 position : SV_Position;
+};
+
+float4 main(PSInput input) : SV_Target0
+{
+    float4 texel = Texture.Sample(Sampler, input.texCoord);
+    float alpha = texel.a * input.color.a;
+    if (Softness > 0.0)
+    {
+        float2 uv = input.position.xy * float2(InvWidth, InvHeight);
+        float sceneDepth = SceneDepth.Sample(DepthSampler, uv);
+        if (sceneDepth < 0.999999)
+        {
+            float ndcDepth = sceneDepth * 2.0 - 1.0;
+            float sceneViewDepth = abs(Projection[3][2] /
+                max(abs(ndcDepth + Projection[2][2]), 1e-6));
+            alpha *= saturate((sceneViewDepth - input.viewDepth) / Softness);
+        }
+    }
+    return ToLinearSceneOutput(float4(
+        LinearizeLegacyInput(texel.rgb) * LinearizeLegacyInput(input.color.rgb), alpha));
+}
