From: Lancer Nexus
Subject: [PATCH] Handle SDL window-close events before another draw

diff --git a/src/LibreLancer.Base/Platforms/SDL3Game.cs b/src/LibreLancer.Base/Platforms/SDL3Game.cs
--- a/src/LibreLancer.Base/Platforms/SDL3Game.cs
+++ b/src/LibreLancer.Base/Platforms/SDL3Game.cs
@@ -535,8 +535,9 @@
                 switch ((SDL3.SDL_EventType)e.type)
                 {
                     case SDL3.SDL_EventType.SDL_EVENT_QUIT:
-                    {
-                        if (loop.OnWillClose())
+                    case SDL3.SDL_EventType.SDL_EVENT_WINDOW_CLOSE_REQUESTED:
+                    {
+                        if (running && loop.OnWillClose())
                             running = false;
                         break;
                     }

diff --git a/src/LibreLancer.Base/Platforms/SDL2Game.cs b/src/LibreLancer.Base/Platforms/SDL2Game.cs
--- a/src/LibreLancer.Base/Platforms/SDL2Game.cs
+++ b/src/LibreLancer.Base/Platforms/SDL2Game.cs
@@ -501,7 +501,7 @@
                 {
                     case SDL2.SDL_EventType.SDL_QUIT:
                     {
-                        if(loop.OnWillClose())
+                        if(running && loop.OnWillClose())
                             running = false;
                         break;
                     }
@@ -577,6 +577,11 @@
                         if (e.window.windowEvent == SDL2.SDL_WindowEventID.SDL_WINDOWEVENT_RESIZED)
                         {
                             loop.SignalResize();
+                        }
+                        else if (e.window.windowEvent == SDL2.SDL_WindowEventID.SDL_WINDOWEVENT_CLOSE)
+                        {
+                            if (running && loop.OnWillClose())
+                                running = false;
                         }
                         break;
                     case SDL2.SDL_EventType.SDL_DROPFILE:

diff --git a/patches/series b/patches/series
--- a/patches/series
+++ b/patches/series
@@ -324,3 +324,4 @@
 client 2322-fix-glowmap-emission-test-fixture.patch
 client 2323-lanceredit-neutral-lit-preview.patch
 client 2324-diagnose-gl-render-state-index.patch
+client 2325-handle-sdl-window-close.patch
