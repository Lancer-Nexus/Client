+    public async Task<MarketTradeQuoteReadResponseV1> ReadMarketTradeQuoteAsync(
+        MarketTradeQuoteReadRequestV1 request, CancellationToken cancellationToken = default)
+    {
+        ArgumentNullException.ThrowIfNull(request);
+        if (!request.IsValid())
+            throw new ArgumentException("Market trade quote request is invalid.", nameof(request));
+        using var message = new HttpRequestMessage(HttpMethod.Post,
+            new Uri(gateway, "api/v1/game/characters/market-trades/quote"));
+        message.Headers.Authorization = new AuthenticationHeaderValue("Bearer", instanceKey);
+        message.Headers.CacheControl = new CacheControlHeaderValue { NoStore = true };
+        message.Content = JsonContent.Create(request);
+        using var response = await http.SendAsync(message, cancellationToken).ConfigureAwait(false);
+        if (response.StatusCode is not (System.Net.HttpStatusCode.OK or System.Net.HttpStatusCode.Conflict or
+            System.Net.HttpStatusCode.NotFound or System.Net.HttpStatusCode.BadRequest))
+            throw new HttpRequestException($"Gateway market quote failed with HTTP {(int)response.StatusCode}.");
+        var result = await response.Content.ReadFromJsonAsync<MarketTradeQuoteReadResponseV1>(
+            cancellationToken: cancellationToken).ConfigureAwait(false);
+        if (result is null || !result.IsValidFor(request))
+            throw new InvalidDataException("Gateway market quote response is invalid.");
+        return result;
+    }
+
+    public async Task<MarketTradeCommitResponseV1> CommitMarketTradeAsync(
+        MarketTradeCommitRequestV1 request, CancellationToken cancellationToken = default)
+    {
+        ArgumentNullException.ThrowIfNull(request);
+        if (!request.IsValid())
+            throw new ArgumentException("Market trade commit request is invalid.", nameof(request));
+        using var message = new HttpRequestMessage(HttpMethod.Post,
+            new Uri(gateway, "api/v1/game/characters/market-trades/commit"));
+        message.Headers.Authorization = new AuthenticationHeaderValue("Bearer", instanceKey);
+        message.Headers.CacheControl = new CacheControlHeaderValue { NoStore = true };
+        message.Content = JsonContent.Create(request);
+        using var response = await http.SendAsync(message, cancellationToken).ConfigureAwait(false);
+        if (response.StatusCode is not (System.Net.HttpStatusCode.OK or System.Net.HttpStatusCode.Accepted or
+            System.Net.HttpStatusCode.Conflict or System.Net.HttpStatusCode.NotFound))
+            throw new HttpRequestException($"Gateway market trade commit failed with HTTP {(int)response.StatusCode}.");
+        var result = await response.Content.ReadFromJsonAsync<MarketTradeCommitResponseV1>(
+            cancellationToken: cancellationToken).ConfigureAwait(false);
