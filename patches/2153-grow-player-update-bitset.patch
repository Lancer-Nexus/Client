+using System;
+using LibreLancer.Net;
+using LibreLancer.Server;
+using LibreLancer.Server.Components;
+using LibreLancer.World;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public sealed class SPlayerComponentLargeWorldTests
+{
+    [Fact]
+    public void GetUpdatesHandlesMoreObjectsThanInitialBitArrayCapacity()
+    {
+        var parent = new GameObject();
+        var player = new SPlayerComponent(new Player(null!, null!, Guid.Empty), parent);
+        var objects = new GameObject[513];
+        var updates = new FetchedDelta[objects.Length];
+        for (var i = 0; i < objects.Length; i++)
+            objects[i] = i == 0 ? parent : new GameObject();
+
+        var exception = Record.Exception(() => player.GetUpdates(objects, updates));
+
+        Assert.Null(exception);
+    }
+}
