From: Lancer Nexus
Subject: [PATCH] Stop drawing after SDL destroys the main window

diff --git a/src/LibreLancer.Base/Platforms/SDL3Game.cs b/src/LibreLancer.Base/Platforms/SDL3Game.cs
--- a/src/LibreLancer.Base/Platforms/SDL3Game.cs
+++ b/src/LibreLancer.Base/Platforms/SDL3Game.cs
@@ -535,9 +535,15 @@
                 switch ((SDL3.SDL_EventType)e.type)
                 {
                     case SDL3.SDL_EventType.SDL_EVENT_QUIT:
+                    {
+                        if (running && loop.OnWillClose())
+                            running = false;
+                        break;
+                    }
                     case SDL3.SDL_EventType.SDL_EVENT_WINDOW_CLOSE_REQUESTED:
-                    {
-                        if (running && loop.OnWillClose())
+                    case SDL3.SDL_EventType.SDL_EVENT_WINDOW_DESTROYED:
+                    {
+                        if (e.window.windowID == SDL3.SDL_GetWindowID(sdlWin) && running && loop.OnWillClose())
                             running = false;
                         break;
                     }
diff --git a/patches/series b/patches/series
--- a/patches/series
+++ b/patches/series
@@ -325,3 +325,4 @@
 client 2323-lanceredit-neutral-lit-preview.patch
 client 2324-diagnose-gl-render-state-index.patch
 client 2325-handle-sdl-window-close.patch
+client 2326-stop-on-sdl-window-destroyed.patch
