@@ -0,0 +1,14 @@
+namespace LibreLancer.Graphics;
+
+/// <summary>A non-blocking GPU elapsed-time query. Results may arrive several frames later.</summary>
+public interface IGpuTimerQuery : System.IDisposable
+{
+    /// <summary>Starts timing the current GPU command range, or returns false if all query slots are pending.</summary>
+    bool Begin(long frameNumber);
+
+    /// <summary>Ends the active range. Does nothing if Begin returned false.</summary>
+    void End();
+
+    /// <summary>Returns the newest completed sample without waiting for the GPU.</summary>
+    bool TryGetResult(out ulong nanoseconds, out long frameNumber);
+}
