diff --git a/src/LibreLancer.Base/Graphics/Backends/OpenGL/GLGpuTimerQuery.cs b/src/LibreLancer.Base/Graphics/Backends/OpenGL/GLGpuTimerQuery.cs
new file mode 100644
--- /dev/null
+++ b/src/LibreLancer.Base/Graphics/Backends/OpenGL/GLGpuTimerQuery.cs
@@ -0,0 +1,96 @@
+using System;
+using LibreLancer.Graphics;
+
+namespace LibreLancer.Graphics.Backends.OpenGL;
+
+internal sealed class GLGpuTimerQuery : IGpuTimerQuery
+{
+    private const int QueryCount = 4;
+    private readonly uint[] queries = new uint[QueryCount];
+    private readonly bool[] pending = new bool[QueryCount];
+    private readonly long[] submittedFrames = new long[QueryCount];
+    private int nextIndex;
+    private int activeIndex = -1;
+    private long latestFrame = long.MinValue;
+    private ulong latestNanoseconds;
+    private bool disposed;
+
+    public GLGpuTimerQuery()
+    {
+        GL.GenQueries(queries.Length, queries);
+    }
+
+    public bool Begin(long frameNumber)
+    {
+        ObjectDisposedException.ThrowIf(disposed, this);
+        if (activeIndex >= 0)
+            throw new InvalidOperationException("GPU timer query is already active");
+
+        PollPending();
+        for (var offset = 0; offset < QueryCount; offset++)
+        {
+            var index = (nextIndex + offset) % QueryCount;
+            if (pending[index])
+                continue;
+
+            activeIndex = index;
+            submittedFrames[index] = frameNumber;
+            GL.BeginQuery(GL.GL_TIME_ELAPSED, queries[index]);
+            return true;
+        }
+
+        return false;
+    }
+
+    public void End()
+    {
+        ObjectDisposedException.ThrowIf(disposed, this);
+        if (activeIndex < 0)
+            return;
+
+        GL.EndQuery(GL.GL_TIME_ELAPSED);
+        pending[activeIndex] = true;
+        nextIndex = (activeIndex + 1) % QueryCount;
+        activeIndex = -1;
+    }
+
+    public bool TryGetResult(out ulong nanoseconds, out long frameNumber)
+    {
+        ObjectDisposedException.ThrowIf(disposed, this);
+        PollPending();
+        nanoseconds = latestNanoseconds;
+        frameNumber = latestFrame;
+        return latestFrame != long.MinValue;
+    }
+
+    private void PollPending()
+    {
+        for (var i = 0; i < QueryCount; i++)
+        {
+            if (!pending[i])
+                continue;
+
+            GL.GetQueryObjectiv(queries[i], GL.GL_QUERY_RESULT_AVAILABLE, out var available);
+            if (available == 0)
+                continue;
+
+            GL.GetQueryObjectui64v(queries[i], GL.GL_QUERY_RESULT, out var elapsedNanoseconds);
+            pending[i] = false;
+            if (submittedFrames[i] >= latestFrame)
+            {
+                latestFrame = submittedFrames[i];
+                latestNanoseconds = elapsedNanoseconds;
+            }
+        }
+    }
+
+    public void Dispose()
+    {
+        if (disposed)
+            return;
+        if (activeIndex >= 0)
+            End();
+        GL.DeleteQueries(queries.Length, queries);
+        disposed = true;
+    }
+}
