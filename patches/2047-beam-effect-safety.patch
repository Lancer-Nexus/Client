@@ -0,0 +1,32 @@
+using System;
+using System.Numerics;
+using LibreLancer.Render;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public sealed class BeamBasisTests
+{
+    [Theory]
+    [InlineData(0f, 1f, 0f)]
+    [InlineData(0f, -1f, 0f)]
+    [InlineData(0.0001f, 1f, 0.0001f)]
+    [InlineData(0f, 0f, 0f)]
+    public void BeamBasisRemainsFiniteAndOrthonormal(float x, float y, float z)
+    {
+        BeamsBuffer.GetBeamBasis(new Vector3(x, y, z), out var direction, out var right, out var up);
+
+        Assert.True(IsFinite(direction));
+        Assert.True(IsFinite(right));
+        Assert.True(IsFinite(up));
+        Assert.InRange(MathF.Abs(direction.Length() - 1f), 0f, 1e-5f);
+        Assert.InRange(MathF.Abs(right.Length() - 1f), 0f, 1e-5f);
+        Assert.InRange(MathF.Abs(up.Length() - 1f), 0f, 1e-5f);
+        Assert.InRange(MathF.Abs(Vector3.Dot(direction, right)), 0f, 1e-5f);
+        Assert.InRange(MathF.Abs(Vector3.Dot(direction, up)), 0f, 1e-5f);
+        Assert.InRange(MathF.Abs(Vector3.Dot(right, up)), 0f, 1e-5f);
+    }
+
+    private static bool IsFinite(Vector3 value) =>
+        float.IsFinite(value.X) && float.IsFinite(value.Y) && float.IsFinite(value.Z);
+}
