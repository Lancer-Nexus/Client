+        internal static void GetBeamBasis(Vector3 direction, out Vector3 normalized,
+            out Vector3 right, out Vector3 up)
+        {
+            var lengthSquared = direction.LengthSquared();
+            normalized = lengthSquared > 1e-12f && float.IsFinite(lengthSquared)
+                ? direction / MathF.Sqrt(lengthSquared)
+                : Vector3.UnitZ;
+
+            // Choose an axis that is not parallel to the beam. The fixed Y axis
+            // collapses the cross section for beams traveling along +/-Y.
+            var reference = MathF.Abs(normalized.Y) < 0.99f ? Vector3.UnitY : Vector3.UnitX;
+            right = Vector3.Cross(normalized, reference);
+            right = Vector3.Normalize(right);
+            up = Vector3.Normalize(Vector3.Cross(right, normalized));
         }
 
