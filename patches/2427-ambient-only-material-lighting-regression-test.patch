+using System;
+using LibreLancer;
+using LibreLancer.Graphics;
+using LibreLancer.Render;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public class RenderLightingTests
+{
+    private sealed class HeadlessGame : Game
+    {
+        public HeadlessGame() : base(64, 64, false, GameConfiguration.HeadlessTest()) { }
+    }
+
+    [Fact]
+    public void SetLightsAcceptsAmbientOnlyLightingWithoutSourceOwner()
+    {
+        var context = new HeadlessGame().RenderContext;
+        try
+        {
+            using var shader = new Shader(context, ReadOnlySpan<byte>.Empty);
+            var lighting = Lighting.Create();
+            lighting.Ambient = new Color3f(0.2f, 0.3f, 0.4f);
+
+            Assert.Null(lighting.Lights.SourceLighting);
+            RenderMaterial.SetLights(shader, ref lighting, 1);
+        }
+        finally
+        {
+            context.DisposeShaders();
+        }
+    }
+}
