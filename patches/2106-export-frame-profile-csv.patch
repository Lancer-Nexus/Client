         private static int PercentileIndex(int count, double percentile) =>
             (int)Math.Ceiling((count - 1) * percentile);
+
+        private string ExportFrameProfile()
+        {
+            var directory = Path.Combine(
+                Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),
+                "LancerNexus",
+                "profiles");
+            Directory.CreateDirectory(directory);
+            var timestamp = DateTimeOffset.UtcNow.ToString("yyyyMMdd-HHmmss-fff", CultureInfo.InvariantCulture);
+            var filename = $"frame-profile-{timestamp}.csv";
+            var path = Path.Combine(directory, filename);
+            var csv = new StringBuilder();
+            csv.AppendLine("frame,renderer,width,height,update_draw_ms,frame_interval_ms,fps");
+            var start = (performanceSampleIndex - performanceSamplesRecorded + PerformanceSampleCount) % PerformanceSampleCount;
+            for (var i = 0; i < performanceSamplesRecorded; i++)
+            {
+                var index = (start + i) % PerformanceSampleCount;
+                var workMs = frameWorkSamples[index] * 1000;
+                var intervalMs = frameIntervalSamples[index] * 1000;
+                var fps = frameIntervalSamples[index] > 0 ? 1 / frameIntervalSamples[index] : 0;
+                csv.Append(i.ToString(CultureInfo.InvariantCulture)).Append(',')
+                    .Append(game.Renderer ?? "unknown").Append(',')
+                    .Append(game.Width.ToString(CultureInfo.InvariantCulture)).Append(',')
+                    .Append(game.Height.ToString(CultureInfo.InvariantCulture)).Append(',')
+                    .Append(workMs.ToString("F4", CultureInfo.InvariantCulture)).Append(',')
+                    .Append(intervalMs.ToString("F4", CultureInfo.InvariantCulture)).Append(',')
+                    .AppendLine(fps.ToString("F2", CultureInfo.InvariantCulture));
+            }
+            File.WriteAllText(path, csv.ToString(), new UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
+            return $"Saved {performanceSamplesRecorded} frames: {path}";
+        }
     }
