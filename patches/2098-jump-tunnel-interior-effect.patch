+        public void StartJumpTunnel(string targetSystem)
+        {
+            if (jumpTunnelStarted || player == null || world == null || !Game.Config.Settings.RenderJumpGateEffects)
+                return;
+            jumpTunnelStarted = true;
+
+            var sourceGate = world.Objects
+                .Where(x => x.SystemObject?.Dock is { Kind: DockKinds.Jump, Target: not null } dock &&
+                            dock.Target.Equals(targetSystem, StringComparison.OrdinalIgnoreCase) &&
+                            x.SystemObject.JumpEffectData?.JumpTunnelEffect != null)
+                .OrderBy(x => Vector3.DistanceSquared(x.Transform.Position, player.Transform.Position))
+                .FirstOrDefault();
+            var jumpEffect = sourceGate?.SystemObject?.JumpEffectData;
+            var tunnelEffectName = jumpEffect?.JumpTunnelEffect;
+            if (tunnelEffectName == null)
+            {
+                FLLog.Debug("Jump", $"No configured jump tunnel interior effect for destination {targetSystem}");
+                return;
+            }
+
+            var effect = Game.GameData.Items.Effects.Get(tunnelEffectName);
+            if (effect == null)
+            {
+                FLLog.Warning("Jump", $"Jump tunnel effect '{tunnelEffectName}' was not found");
+                return;
+            }
+
+            var attached = AttachShipEffect(effect, loopSound: true);
+            if (attached.Renderer != null)
+                transientShipEffects.Add(attached.Renderer);
+            jumpTunnelSound = attached.Sound;
+            jumpTunnelSoundRemaining = Math.Max(0.1,
+                jumpEffect!.JumpOutTime + jumpEffect.JumpOutTunnelTime);
         }
 
