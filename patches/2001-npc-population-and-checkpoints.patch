+using System;
+using System.Text;
+
+namespace LibreLancer.Server;
+
+internal enum NpcTransferJournalDisposition
+{
+    Missing,
+    Snapshot,
+    Empty,
+    Conflict
+}
+
+internal static class NpcTransferJournalContract
+{
+    private const string EmptyMarker = "LANCER-NEXUS-NPC-TRANSFER-V1:NO-NPCS";
+
+    public static NpcTransferJournalDisposition Resolve(bool hasSnapshot, bool hasEmptyMarker) =>
+        (hasSnapshot, hasEmptyMarker) switch
+        {
+            (false, false) => NpcTransferJournalDisposition.Missing,
+            (true, false) => NpcTransferJournalDisposition.Snapshot,
+            (false, true) => NpcTransferJournalDisposition.Empty,
+            _ => NpcTransferJournalDisposition.Conflict
+        };
+
+    public static byte[] EmptyMarkerBytes => Encoding.ASCII.GetBytes(EmptyMarker);
+
+    public static bool IsEmptyMarker(ReadOnlySpan<byte> content) =>
+        content.SequenceEqual(Encoding.ASCII.GetBytes(EmptyMarker));
+}
diff --git a/src/LibreLancer/Server/NpcTransferQuicPeer.cs b/src/LibreLancer/Server/NpcTransferQuicPeer.cs
new file mode 100644
index 0000000..9a4af9e
--- /dev/null
+++ b/src/LibreLancer/Server/NpcTransferQuicPeer.cs
@@ -0,0 +1,478 @@
+using System;
+using System.Buffers.Binary;
+using System.Collections.Concurrent;
+using System.IO;
+using System.Linq;
+using System.Net;
+using System.Net.Http;
+using System.Net.Http.Headers;
+using System.Net.Http.Json;
+using System.Net.Quic;
+using System.Net.Security;
+using System.Runtime.Versioning;
+using System.Security.Authentication;
+using System.Security.Cryptography;
+using System.Security.Cryptography.X509Certificates;
+using System.Text;
+using System.Threading;
+using System.Threading.Tasks;
+using LancerNexus.Protocol;
+using MessagePack;
+using ProtocolViolationException = LancerNexus.Protocol.ProtocolViolationException;
+
+namespace LibreLancer.Server;
+
+/// <summary>Private mTLS QUIC endpoint for one-shot NPC runtime snapshot handoffs.</summary>
+/// <remarks>
+/// The callback must durably stage the validated snapshot and remain inert until the Coordinator reports
+/// Committed. A positive acknowledgement means staged, not simulated; duplicate transfer IDs must be idempotent.
+/// </remarks>
+[SupportedOSPlatform("linux")]
+public sealed class NpcTransferQuicReceiver : IAsyncDisposable
+{
+    private const long ProtocolErrorCode = 0x200;
+    private const long CloseErrorCode = 0x201;
+    private const int MaximumFrameLength = NpcPeerSnapshotTransferValidator.MaximumSnapshotBytes + 4096;
+    private static readonly SslApplicationProtocol Alpn = new("lancer-nexus-npc-transfer/1");
+    private static readonly MessagePackSerializerOptions UntrustedMessagePack =
+        MessagePackSerializerOptions.Standard.WithSecurity(MessagePackSecurity.UntrustedData);
+
+    private readonly string instanceId;
+    private readonly X509Certificate2 serverCertificate;
+    private readonly X509Certificate2 clientCa;
+    private readonly Uri coordinatorBaseUri;
+    private readonly string coordinatorApiKey;
+    private readonly HttpClient coordinatorHttp = new(new HttpClientHandler { AllowAutoRedirect = false })
+    {
+        Timeout = TimeSpan.FromSeconds(10)
+    };
+    private readonly Func<NpcPeerSnapshotTransfer, CancellationToken, ValueTask<NpcPeerSnapshotTransferAck>> acceptSnapshot;
+    private readonly SemaphoreSlim connectionLimit = new(8, 8);
+    private readonly ConcurrentDictionary<long, Task> activeHandlers = new();
+    private QuicListener? listener;
+    private CancellationTokenSource? shutdown;
+    private Task? acceptLoop;
+    private long handlerId;
+    private bool disposed;
+
+    public NpcTransferQuicReceiver(
+        string instanceId,
+        X509Certificate2 serverCertificate,
+        X509Certificate2 clientCa,
+        Uri coordinatorBaseUri,
+        string coordinatorApiKey,
+        Func<NpcPeerSnapshotTransfer, CancellationToken, ValueTask<NpcPeerSnapshotTransferAck>> acceptSnapshot)
+    {
+        if (string.IsNullOrWhiteSpace(instanceId) || instanceId.Length > 96)
+            throw new ArgumentException("A valid target instance ID is required.", nameof(instanceId));
+        ArgumentNullException.ThrowIfNull(serverCertificate);
+        ArgumentNullException.ThrowIfNull(clientCa);
+        ArgumentNullException.ThrowIfNull(coordinatorBaseUri);
+        if ((coordinatorBaseUri.Scheme != Uri.UriSchemeHttps &&
+             !(coordinatorBaseUri.Scheme == Uri.UriSchemeHttp && coordinatorBaseUri.IsLoopback)) ||
+            !string.IsNullOrEmpty(coordinatorBaseUri.UserInfo) || !string.IsNullOrEmpty(coordinatorBaseUri.Query) ||
+            !string.IsNullOrEmpty(coordinatorBaseUri.Fragment) || string.IsNullOrWhiteSpace(coordinatorApiKey) ||
+            Encoding.UTF8.GetByteCount(coordinatorApiKey) < 32)
+            throw new ArgumentException("A private Coordinator URL and 32-byte internal API key are required.", nameof(coordinatorBaseUri));
+        ArgumentNullException.ThrowIfNull(acceptSnapshot);
+        if (!serverCertificate.HasPrivateKey || !CertificateIdentity.HasDnsIdentity(serverCertificate, instanceId) ||
+            !CertificateIdentity.HasRequiredEku(serverCertificate, client: false) ||
+            DateTime.UtcNow < serverCertificate.NotBefore.ToUniversalTime() ||
+            DateTime.UtcNow > serverCertificate.NotAfter.ToUniversalTime())
+            throw new ArgumentException("The server certificate must be current, include Server Authentication and have a matching instance DNS SAN.", nameof(serverCertificate));
+        if (!clientCa.Extensions.OfType<X509BasicConstraintsExtension>().Any(extension => extension.CertificateAuthority))
+            throw new ArgumentException("The client trust certificate must be a CA certificate.", nameof(clientCa));
+        this.instanceId = instanceId;
+        this.serverCertificate = serverCertificate;
+        this.clientCa = clientCa;
+        this.coordinatorBaseUri = coordinatorBaseUri;
+        this.coordinatorApiKey = coordinatorApiKey;
+        this.acceptSnapshot = acceptSnapshot;
+    }
+
+    public async Task StartAsync(IPEndPoint listenEndPoint, CancellationToken cancellationToken = default)
+    {
+        ObjectDisposedException.ThrowIf(disposed, this);
+        if (listener is not null)
+            throw new InvalidOperationException("The NPC transfer receiver has already started.");
+        if (!QuicListener.IsSupported)
+            throw new PlatformNotSupportedException("NPC transfer QUIC requires a supported MsQuic runtime.");
+
+        shutdown = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
+        var serverAuthentication = new SslServerAuthenticationOptions
+        {
+            ApplicationProtocols = [Alpn],
+            ServerCertificate = serverCertificate,
+            EnabledSslProtocols = SslProtocols.Tls13,
+            ClientCertificateRequired = true,
+            CertificateRevocationCheckMode = X509RevocationMode.NoCheck,
+            RemoteCertificateValidationCallback = (_, certificate, _, errors) =>
+                CertificateIdentity.Validate(certificate, clientCa, client: true, expectedInstanceId: null, errors)
+        };
+        listener = await QuicListener.ListenAsync(new QuicListenerOptions
+        {
+            ListenEndPoint = listenEndPoint,
+            ApplicationProtocols = [Alpn],
+            ConnectionOptionsCallback = (_, _, _) => ValueTask.FromResult(new QuicServerConnectionOptions
+            {
+                DefaultStreamErrorCode = ProtocolErrorCode,
+                DefaultCloseErrorCode = CloseErrorCode,
+                MaxInboundBidirectionalStreams = 1,
+                MaxInboundUnidirectionalStreams = 0,
+                ServerAuthenticationOptions = serverAuthentication
+            })
+        }, shutdown.Token);
+        acceptLoop = AcceptLoopAsync(shutdown.Token);
+    }
+
+    private async Task AcceptLoopAsync(CancellationToken cancellationToken)
+    {
+        while (!cancellationToken.IsCancellationRequested)
+        {
+            await connectionLimit.WaitAsync(cancellationToken);
+            QuicConnection connection;
+            try { connection = await listener!.AcceptConnectionAsync(cancellationToken); }
+            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
+            {
+                connectionLimit.Release();
+                break;
+            }
+            catch (ObjectDisposedException) when (cancellationToken.IsCancellationRequested)
+            {
+                connectionLimit.Release();
+                break;
+            }
+            catch (AuthenticationException exception)
+            {
+                connectionLimit.Release();
+                FLLog.Warning("NPC Transfer", $"Rejected QUIC handshake: {exception.Message}");
+                continue;
+            }
+            catch (QuicException exception)
+            {
+                connectionLimit.Release();
+                FLLog.Warning("NPC Transfer", $"Rejected QUIC connection: {exception.Message}");
+                continue;
+            }
+            catch
+            {
+                connectionLimit.Release();
+                throw;
+            }
+            var id = Interlocked.Increment(ref handlerId);
+            var task = HandleConnectionAsync(connection, cancellationToken);
+            activeHandlers[id] = task;
+            _ = task.ContinueWith(completedTask =>
+            {
+                activeHandlers.TryRemove(id, out _);
+                connectionLimit.Release();
+            }, CancellationToken.None, TaskContinuationOptions.ExecuteSynchronously, TaskScheduler.Default);
+        }
+    }
+
+    private async Task HandleConnectionAsync(QuicConnection connection, CancellationToken cancellationToken)
+    {
+        try
+        {
+            using var requestTimeout = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
+            requestTimeout.CancelAfter(TimeSpan.FromSeconds(60));
+            var requestToken = requestTimeout.Token;
+            await using (connection)
+            {
+                var peerCertificate = connection.RemoteCertificate;
+                var peerInstanceId = CertificateIdentity.GetSingleDnsIdentity(peerCertificate);
+                await using var stream = await connection.AcceptInboundStreamAsync(requestToken);
+                if (stream.Type != QuicStreamType.Bidirectional)
+                    throw new ProtocolViolationException("NPC transfer requires one bidirectional QUIC stream.");
+
+                var request = MessagePackSerializer.Deserialize<NpcPeerSnapshotTransfer>(
+                    await ReadFrameAsync(stream, requestToken), UntrustedMessagePack);
+                NpcPeerSnapshotTransferValidator.Validate(request);
+                ValidateSnapshotPayload(request);
+                if (!string.Equals(request.TargetInstanceId, instanceId, StringComparison.Ordinal) ||
+                    !string.Equals(request.SourceInstanceId, peerInstanceId, StringComparison.OrdinalIgnoreCase))
+                    throw new ProtocolViolationException("NPC transfer source/target does not match the authenticated certificates.");
+
+                NpcPeerSnapshotTransferAck acknowledgement;
+                try
+                {
+                    if (!await IsCoordinatorSnapshotAuthoritativeAsync(request, requestToken))
+                    {
+                        acknowledgement = new NpcPeerSnapshotTransferAck
+                        {
+                            TransferId = request.TransferId,
+                            Accepted = false,
+                            ReasonCode = "coordinator_snapshot_not_authoritative"
+                        };
+                    }
+                    else
+                    {
+                        acknowledgement = await acceptSnapshot(request, requestToken);
+                        if (acknowledgement.Accepted &&
+                            !await MarkCoordinatorTargetAcceptedAsync(request.TransferId, requestToken))
+                        {
+                            acknowledgement = new NpcPeerSnapshotTransferAck
+                            {
+                                TransferId = request.TransferId,
+                                Accepted = false,
+                                ReasonCode = "coordinator_target_accept_failed"
+                            };
+                        }
+                    }
+                }
+                catch (Exception) when (!requestToken.IsCancellationRequested)
+                {
+                    acknowledgement = new NpcPeerSnapshotTransferAck
+                    {
+                        TransferId = request.TransferId,
+                        Accepted = false,
+                        ReasonCode = "snapshot_rejected"
+                    };
+                }
+                if (acknowledgement.TransferId != request.TransferId)
+                    throw new ProtocolViolationException("NPC transfer acknowledgement ID does not match the request.");
+                await WriteFrameAsync(stream, MessagePackSerializer.Serialize(acknowledgement), requestToken);
+                stream.CompleteWrites();
+            }
+        }
+        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
+        catch (Exception exception) { FLLog.Error("NPC Transfer", exception.Message); }
+    }
+
+    public static async Task<NpcPeerSnapshotTransferAck> SendAsync(
+        IPEndPoint targetEndPoint,
+        string targetInstanceId,
+        X509Certificate2 sourceCertificate,
+        X509Certificate2 serverCa,
+        NpcPeerSnapshotTransfer request,
+        CancellationToken cancellationToken = default)
+    {
+        ArgumentNullException.ThrowIfNull(targetEndPoint);
+        ArgumentNullException.ThrowIfNull(sourceCertificate);
+        ArgumentNullException.ThrowIfNull(serverCa);
+        if (!serverCa.Extensions.OfType<X509BasicConstraintsExtension>().Any(extension => extension.CertificateAuthority))
+            throw new ArgumentException("The server trust certificate must be a CA certificate.", nameof(serverCa));
+        NpcPeerSnapshotTransferValidator.Validate(request);
+        ValidateSnapshotPayload(request);
+        if (!sourceCertificate.HasPrivateKey ||
+            !CertificateIdentity.HasDnsIdentity(sourceCertificate, request.SourceInstanceId) ||
+            !string.Equals(request.TargetInstanceId, targetInstanceId, StringComparison.Ordinal))
+            throw new ProtocolViolationException("NPC transfer request does not match the source/target certificate identities.");
+
+        using var sendTimeout = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
+        sendTimeout.CancelAfter(TimeSpan.FromSeconds(60));
+        var sendToken = sendTimeout.Token;
+        await using var connection = await QuicConnection.ConnectAsync(new QuicClientConnectionOptions
+        {
+            RemoteEndPoint = targetEndPoint,
+            DefaultStreamErrorCode = ProtocolErrorCode,
+            DefaultCloseErrorCode = CloseErrorCode,
+            MaxInboundBidirectionalStreams = 1,
+            MaxInboundUnidirectionalStreams = 0,
+            ClientAuthenticationOptions = new SslClientAuthenticationOptions
+            {
+                ApplicationProtocols = [Alpn],
+                TargetHost = targetInstanceId,
+                ClientCertificates = new X509CertificateCollection { sourceCertificate },
+                EnabledSslProtocols = SslProtocols.Tls13,
+                CertificateRevocationCheckMode = X509RevocationMode.NoCheck,
+                RemoteCertificateValidationCallback = (_, certificate, _, errors) =>
+                    CertificateIdentity.Validate(certificate, serverCa, client: false, targetInstanceId, errors)
+            }
+        }, sendToken);
+        await using var stream = await connection.OpenOutboundStreamAsync(QuicStreamType.Bidirectional, sendToken);
+        await WriteFrameAsync(stream, MessagePackSerializer.Serialize(request), sendToken);
+        stream.CompleteWrites();
+        var acknowledgement = MessagePackSerializer.Deserialize<NpcPeerSnapshotTransferAck>(
+            await ReadFrameAsync(stream, sendToken), UntrustedMessagePack);
+        if (acknowledgement.TransferId != request.TransferId)
+            throw new ProtocolViolationException("NPC transfer acknowledgement ID does not match the request.");
+        return acknowledgement;
+    }
+
+    private static async Task<byte[]> ReadFrameAsync(QuicStream stream, CancellationToken cancellationToken)
+    {
+        var header = new byte[sizeof(int)];
+        await stream.ReadExactlyAsync(header, cancellationToken);
+        var length = BinaryPrimitives.ReadInt32BigEndian(header);
+        if (length is <= 0 or > MaximumFrameLength)
+            throw new ProtocolViolationException("NPC transfer frame is empty or exceeds the payload limit.");
+        var payload = new byte[length];
+        await stream.ReadExactlyAsync(payload, cancellationToken);
+        return payload;
+    }
+
+    private static void ValidateSnapshotPayload(NpcPeerSnapshotTransfer request)
+    {
+        var snapshot = MessagePackSerializer.Deserialize<NpcTransferSnapshot>(request.SnapshotMessagePack, UntrustedMessagePack);
+        NpcTransferContractValidator.Validate(snapshot);
+        if (snapshot.TransferId != request.TransferId)
+            throw new ProtocolViolationException("NPC peer envelope and snapshot transfer IDs do not match.");
+    }
+
+    private async Task<bool> IsCoordinatorSnapshotAuthoritativeAsync(
+        NpcPeerSnapshotTransfer request, CancellationToken cancellationToken)
+    {
+        var url = new Uri(coordinatorBaseUri,
+            $"/internal/v1/npc-transfers/{request.TransferId:D}/recovery?instanceId={Uri.EscapeDataString(instanceId)}");
+        using var message = new HttpRequestMessage(HttpMethod.Get, url);
+        message.Headers.Authorization = new AuthenticationHeaderValue("Bearer", coordinatorApiKey);
+        using var response = await coordinatorHttp.SendAsync(message, cancellationToken);
+        if (!response.IsSuccessStatusCode)
+            return false;
+        var recovery = await response.Content.ReadFromJsonAsync<NpcTransferRecoveryResponse>(cancellationToken);
+        if (recovery is null || recovery.TransferId != request.TransferId ||
+            !string.Equals(recovery.SourceInstanceId, request.SourceInstanceId, StringComparison.Ordinal) ||
+            !string.Equals(recovery.TargetInstanceId, request.TargetInstanceId, StringComparison.Ordinal) ||
+            string.IsNullOrWhiteSpace(recovery.SnapshotSha256) || recovery.State is not (NpcTransferState.SourceFrozen or
+                NpcTransferState.TargetAccepted or NpcTransferState.Committed or NpcTransferState.SourceReleased))
+            return false;
+        byte[] authoritativeHash;
+        try { authoritativeHash = Convert.FromHexString(recovery.SnapshotSha256); }
+        catch (FormatException) { return false; }
+        return authoritativeHash.Length == SHA256.HashSizeInBytes &&
+               CryptographicOperations.FixedTimeEquals(authoritativeHash, SHA256.HashData(request.SnapshotMessagePack));
+    }
+
+    private async Task<bool> MarkCoordinatorTargetAcceptedAsync(Guid transferId, CancellationToken cancellationToken)
+    {
+        var recoveryUrl = new Uri(coordinatorBaseUri,
+            $"/internal/v1/npc-transfers/{transferId:D}/recovery?instanceId={Uri.EscapeDataString(instanceId)}");
+        using (var recoveryRequest = new HttpRequestMessage(HttpMethod.Get, recoveryUrl))
+        {
+            recoveryRequest.Headers.Authorization = new AuthenticationHeaderValue("Bearer", coordinatorApiKey);
+            using var recoveryResponse = await coordinatorHttp.SendAsync(recoveryRequest, cancellationToken);
+            if (!recoveryResponse.IsSuccessStatusCode)
+                return false;
+            var recovery = await recoveryResponse.Content.ReadFromJsonAsync<NpcTransferRecoveryResponse>(cancellationToken);
+            if (recovery is null || recovery.TransferId != transferId)
+                return false;
+            if (recovery.State is NpcTransferState.Committed or NpcTransferState.SourceReleased)
+                return true;
+        }
+        var url = new Uri(coordinatorBaseUri, $"/internal/v1/npc-transfers/{transferId:D}/phase");
+        using var message = new HttpRequestMessage(HttpMethod.Post, url)
+        {
+            Content = JsonContent.Create(new NpcTransferPhaseRequest
+            {
+                TransferId = transferId,
+                State = NpcTransferState.TargetAccepted
+            })
+        };
+        message.Headers.Authorization = new AuthenticationHeaderValue("Bearer", coordinatorApiKey);
+        using var response = await coordinatorHttp.SendAsync(message, cancellationToken);
+        if (!response.IsSuccessStatusCode)
+            return false;
+        var result = await response.Content.ReadFromJsonAsync<NpcTransferPhaseResponse>(cancellationToken);
+        return result is { Accepted: true } && result.TransferId == transferId;
+    }
+
+    private static async Task WriteFrameAsync(QuicStream stream, byte[] payload, CancellationToken cancellationToken)
+    {
+        if (payload.Length is <= 0 or > MaximumFrameLength)
+            throw new ProtocolViolationException("NPC transfer frame is empty or exceeds the payload limit.");
+        var header = new byte[sizeof(int)];
+        BinaryPrimitives.WriteInt32BigEndian(header, payload.Length);
+        await stream.WriteAsync(header, cancellationToken);
+        await stream.WriteAsync(payload, cancellationToken);
+    }
+
+    public async ValueTask DisposeAsync()
+    {
+        if (disposed)
+            return;
+        disposed = true;
+        shutdown?.Cancel();
+        if (listener is not null)
+            await listener.DisposeAsync();
+        if (acceptLoop is not null)
+        {
+            try { await acceptLoop; }
+            catch (OperationCanceledException) { }
+            catch (ObjectDisposedException) { }
+            catch (QuicException) { }
+            catch (Exception exception) { FLLog.Error("NPC Transfer", exception.Message); }
+        }
+        var handlers = activeHandlers.Values.ToArray();
+        try { await Task.WhenAll(handlers); }
+        catch (OperationCanceledException) { }
+        catch (QuicException) { }
+        shutdown?.Dispose();
+        coordinatorHttp.Dispose();
+        connectionLimit.Dispose();
+        shutdown = null;
+        listener = null;
+    }
+
+    private sealed record NpcTransferRecoveryResponse(
+        Guid TransferId,
+        string SourceInstanceId,
+        string TargetInstanceId,
+        string TargetSystemId,
+        Guid[] NpcIds,
+        DateTime ExpiresUtc,
+        NpcTransferState State,
+        string? SnapshotSha256,
+        NpcTransferSnapshot? Snapshot);
+
+    private sealed record NpcTransferPhaseResponse(
+        bool Accepted,
+        string ReasonCode,
+        Guid TransferId,
+        NpcTransferState State);
+
+    private static class CertificateIdentity
+    {
+        private const string ServerAuthEku = "1.3.6.1.5.5.7.3.1";
+        private const string ClientAuthEku = "1.3.6.1.5.5.7.3.2";
+
+        public static bool Validate(X509Certificate? certificate, X509Certificate2 trustedRoot, bool client,
+            string? expectedInstanceId, SslPolicyErrors errors)
+        {
+            if (certificate is null || errors.HasFlag(SslPolicyErrors.RemoteCertificateNotAvailable))
+                return false;
+            try
+            {
+                // QUIC owns the certificate instance passed to this callback. Cloning it here
+                // prevents disposing that instance while the TLS handshake still uses it.
+                using var leaf = new X509Certificate2(certificate);
+                var identity = GetSingleDnsIdentity(leaf);
+                if (expectedInstanceId is not null &&
+                    !string.Equals(identity, expectedInstanceId, StringComparison.OrdinalIgnoreCase))
+                    return false;
+                var requiredEku = client ? ClientAuthEku : ServerAuthEku;
+                if (!leaf.Extensions.OfType<X509EnhancedKeyUsageExtension>().Any(extension =>
+                        extension.EnhancedKeyUsages.Cast<Oid>().Any(oid => oid.Value == requiredEku)))
+                    return false;
+                using var chain = new X509Chain();
+                chain.ChainPolicy.TrustMode = X509ChainTrustMode.CustomRootTrust;
+                chain.ChainPolicy.CustomTrustStore.Add(trustedRoot);
+                chain.ChainPolicy.RevocationMode = X509RevocationMode.NoCheck;
+                chain.ChainPolicy.VerificationFlags = X509VerificationFlags.NoFlag;
+                return chain.Build(leaf);
+            }
+            catch (ProtocolViolationException) { return false; }
+            catch (CryptographicException) { return false; }
+            catch (InvalidOperationException) { return false; }
+        }
+
+        public static bool HasDnsIdentity(X509Certificate2 certificate, string expectedInstanceId) =>
+            string.Equals(GetSingleDnsIdentity(certificate), expectedInstanceId, StringComparison.OrdinalIgnoreCase);
+
+        public static bool HasRequiredEku(X509Certificate2 certificate, bool client) =>
+            certificate.Extensions.OfType<X509EnhancedKeyUsageExtension>().Any(extension =>
+                extension.EnhancedKeyUsages.Cast<Oid>().Any(oid => oid.Value == (client ? ClientAuthEku : ServerAuthEku)));
+
+        public static string GetSingleDnsIdentity(X509Certificate? certificate)
+        {
+            if (certificate is null)
+                throw new ProtocolViolationException("mTLS peer certificate is missing.");
+            using var cert = new X509Certificate2(certificate);
+            var extension = cert.Extensions.OfType<X509SubjectAlternativeNameExtension>().SingleOrDefault();
+            var names = extension?.EnumerateDnsNames().ToArray() ?? [];
+            if (names.Length != 1 || string.IsNullOrWhiteSpace(names[0]) || names[0].Contains('*'))
+                throw new ProtocolViolationException("mTLS peer certificate must contain exactly one non-wildcard DNS SAN.");
+            return names[0];
+        }
+    }
+}
