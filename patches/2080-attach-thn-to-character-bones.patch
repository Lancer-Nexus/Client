+        public bool TryGetBoneTransform(string name, Transform3D worldTransform, out Transform3D result)
+        {
+            if (BodySkinning.Bones.TryGetValue(name, out var bodyBone))
+            {
+                result = bodyBone.LocalTransform * worldTransform;
+                return true;
+            }
+
+            if (HeadSkinning != null && HeadConnection != null && HeadSkinning.Bones.TryGetValue(name, out var headBone))
+            {
+                result = headBone.LocalTransform * HeadConnection.Transform * worldTransform;
+                return true;
+            }
+
+            if (LeftHandSkinning != null && LeftHandConnection != null &&
+                LeftHandSkinning.Bones.TryGetValue(name, out var leftHandBone))
+            {
+                result = leftHandBone.LocalTransform * LeftHandConnection.Transform * worldTransform;
+                return true;
+            }
+
+            if (RightHandSkinning != null && RightHandConnection != null &&
+                RightHandSkinning.Bones.TryGetValue(name, out var rightHandBone))
+            {
+                result = rightHandBone.LocalTransform * RightHandConnection.Transform * worldTransform;
+                return true;
+            }
+
+            result = Transform3D.Identity;
+            return false;
+        }
