+    public async Task ReleaseAsync(long characterId, Guid sessionId, string leaseToken, long leaseVersion,
+        CancellationToken cancellationToken = default)
+    {
+        var requestBody = new CharacterLeaseReleaseRequestV1
+        {
+            CorrelationId = Guid.NewGuid(), CharacterId = characterId, SessionId = sessionId,
+            LeaseToken = leaseToken, LeaseVersion = leaseVersion
+        };
+        if (!requestBody.IsValid())
+            throw new ArgumentException("Character lease release request is invalid.");
+        using var message = new HttpRequestMessage(HttpMethod.Post,
+            new Uri(gateway, "api/v1/game/release-character-lease"));
+        message.Headers.Authorization = new AuthenticationHeaderValue("Bearer", instanceKey);
+        message.Content = JsonContent.Create(requestBody);
+        using var response = await http.SendAsync(message, cancellationToken).ConfigureAwait(false);
+        var released = await response.Content.ReadFromJsonAsync<CharacterLeaseReleaseResultV1>(
+            cancellationToken: cancellationToken).ConfigureAwait(false);
+        if (released is null || !released.IsValid() || released.CorrelationId != requestBody.CorrelationId ||
+            released.LeaseVersion != leaseVersion)
+            throw new InvalidDataException("Gateway character lease release response is invalid.");
+        if (!response.IsSuccessStatusCode || !released.Released)
+            throw new InvalidOperationException($"Gateway character lease release rejected: {released.ReasonCode}.");
+    }
+
