+    [Fact]
+    public void PackDirectorySkipsGitKeepPlaceholdersAcrossClassPackages()
+    {
+        using var fixture = new Fixture();
+        var equipment = fixture.PathFor("equipment");
+        var effects = fixture.PathFor("effects");
+        Directory.CreateDirectory(equipment);
+        Directory.CreateDirectory(effects);
+        File.WriteAllBytes(Path.Combine(equipment, ".gitkeep"), []);
+        File.WriteAllBytes(Path.Combine(effects, ".gitkeep"), []);
+        File.WriteAllBytes(Path.Combine(equipment, "ship.cmp"), "asset"u8.ToArray());
+
+        var equipmentPackage = fixture.PathFor("equipment.nap");
+        var effectsPackage = fixture.PathFor("effects.nap");
+        NapWriter.PackDirectory(equipment, equipmentPackage);
+        NapWriter.PackDirectory(effects, effectsPackage);
+
+        var emptyOverrides = new HashSet<string>(StringComparer.Ordinal);
+        var provider = new NexusPackageFileProvider(
+        [
+            new NexusPackageMount("equipment", NapArchive.Open(equipmentPackage), 10, 1, emptyOverrides),
+            new NexusPackageMount("effects", NapArchive.Open(effectsPackage), 10, 2, emptyOverrides)
+        ]);
+
+        Assert.True(provider.FileExists("ship.cmp"));
+        Assert.False(provider.FileExists(".gitkeep"));
+    }
