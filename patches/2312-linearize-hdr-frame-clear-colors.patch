+using LibreLancer.Render;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public class RendererColorSpaceTests
+{
+    [Fact]
+    public void HdrSceneClearColorDecodesSrgbAndPreservesAlpha()
+    {
+        var color = new Color4(0.5f, 0.04045f, 1f, 0.25f);
+
+        var result = RenderHelpers.PrepareSceneClearColor(color, hdrOutput: true);
+
+        Assert.Equal(0.21404114f, result.R, 6);
+        Assert.Equal(0.0031308f, result.G, 6);
+        Assert.Equal(1f, result.B, 6);
+        Assert.Equal(color.A, result.A);
+    }
+
+    [Fact]
+    public void LdrSceneClearColorRemainsUnchanged()
+    {
+        var color = new Color4(0.5f, 0.04045f, 1f, 0.25f);
+
+        var result = RenderHelpers.PrepareSceneClearColor(color, hdrOutput: false);
+
+        Assert.Equal(color, result);
+    }
+}
