diff --git a/src/LibreLancer.Tests/ProjectileSpawnQueueTests.cs b/src/LibreLancer.Tests/ProjectileSpawnQueueTests.cs
new file mode 100644
--- /dev/null
+++ b/src/LibreLancer.Tests/ProjectileSpawnQueueTests.cs
@@ -0,0 +1,34 @@
+using System.Numerics;
+using LibreLancer.Net;
+using LibreLancer.Net.Protocol;
+using LibreLancer.World;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public class ProjectileSpawnQueueTests
+{
+    [Fact]
+    public void BuildSpawnQueueEncodesAtMostOneTargetPerWeaponBit()
+    {
+        var owner = new ObjNetId(17);
+        var sharedTarget = new Vector3(1, 2, 3);
+        var weaponOneTarget = new Vector3(4, 5, 6);
+        var duplicateWeaponTarget = new Vector3(7, 8, 9);
+        var weaponTwoTarget = new Vector3(10, 11, 12);
+
+        var result = ProjectileManager.BuildSpawnQueue(new[]
+        {
+            (owner, 0, sharedTarget),
+            (owner, 1, weaponOneTarget),
+            (owner, 1, duplicateWeaponTarget),
+            (owner, 2, weaponTwoTarget)
+        });
+
+        var spawn = Assert.Single(result);
+        Assert.Equal(0b111UL, spawn.Guns);
+        Assert.Equal(0b110UL, spawn.Unique);
+        Assert.Equal(new[] { weaponOneTarget, weaponTwoTarget }, spawn.OtherTargets);
+        Assert.Equal(System.Numerics.BitOperations.PopCount(spawn.Unique), spawn.OtherTargets.Length);
+    }
+}
