diff --git a/src/LibreLancer.Tests/SystemRenderPassGraphTests.cs b/src/LibreLancer.Tests/SystemRenderPassGraphTests.cs
new file mode 100644
--- /dev/null
+++ b/src/LibreLancer.Tests/SystemRenderPassGraphTests.cs
@@ -0,0 +1,21 @@
+using LibreLancer.Graphics;
+using Xunit;
+
+public class SystemRenderPassGraphTests
+{
+    [Fact]
+    public void ReusesCachedScheduleAfterEquivalentFrameGraphRebuild()
+    {
+        var graph = new SystemRenderPassGraph();
+        var executions = 0;
+
+        graph.AddAction("Frame setup", () => executions++, priority: 0);
+        graph.Execute();
+
+        graph.Reset();
+        graph.AddAction("Frame setup", () => executions++, priority: 0);
+        graph.Execute();
+
+        Assert.Equal(2, executions);
+    }
+}
