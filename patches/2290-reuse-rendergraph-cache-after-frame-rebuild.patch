             ExecuteCompiled(executionOrder, count, topologyVersion);
             return;
         }
-        ExecuteCompiled(executionOrder, nodeCount, topologyVersion);
+        ExecuteCached();
+    }
+
+    private void ExecuteCached()
+    {
+        // HasCachedSchedule already checked that every node still matches this order.
+        // Rebuilt frame graphs advance topologyVersion even when their structure is
+        // unchanged, so the compiled schedule's original version is no longer useful.
+        for (var i = 0; i < nodeCount; i++)
+            nodes[executionOrder[i]].Execute!();
     }
 
