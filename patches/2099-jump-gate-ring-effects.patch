+        private void ScheduleJumpRingEffects(GameObject gate, LibreLancer.Data.Schema.Effects.JumpGateEffect profile)
+        {
+            var effects = profile.GlowRingEffects ?? Array.Empty<string>();
+            var hardpoints = profile.GlowRingHardpoints ?? Array.Empty<string>();
+            if (effects.Length != hardpoints.Length)
+                FLLog.Warning("Jump", $"Jump gate profile '{profile.Nickname}' has {effects.Length} ring effects but {hardpoints.Length} hardpoints");
+            if (profile.GlowCreateTimes != null && profile.GlowCreateTimes.Length != effects.Length)
+                FLLog.Warning("Jump", $"Jump gate profile '{profile.Nickname}' has {profile.GlowCreateTimes.Length} ring times for {effects.Length} effects");
+            var count = Math.Min(effects.Length, hardpoints.Length);
+            for (var i = 0; i < count; i++)
+            {
+                var effect = Game.GameData.Items.Effects.Get(effects[i]);
+                if (effect == null)
+                {
+                    FLLog.Warning("Jump", $"Jump gate ring effect '{effects[i]}' was not found");
+                    continue;
+                }
+
+                var hardpoint = gate.GetHardpoint(hardpoints[i]);
+                if (hardpoint == null)
+                {
+                    FLLog.Warning("Jump", $"Jump gate hardpoint '{hardpoints[i]}' was not found on {gate.Nickname}");
+                    continue;
+                }
+
+                var configuredTime = profile.GlowCreateTimes != null && i < profile.GlowCreateTimes.Length
+                    ? profile.GlowCreateTimes[i]
+                    : 0f;
+                var startTime = float.IsFinite(configuredTime) ? Math.Max(0, configuredTime) : 0;
+                pendingJumpRingEffects.Add(new PendingJumpRingEffect(startTime, gate, effect, hardpoint));
+            }
+
+            pendingJumpRingEffects.Sort((a, b) => a.StartTime.CompareTo(b.StartTime));
+        }
