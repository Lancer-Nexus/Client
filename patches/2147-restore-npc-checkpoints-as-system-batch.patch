+    [Fact]
+    public void UnresolvedAmbientAttackTarget_CanBeDroppedOnlyForNpcAttackDirectives()
+    {
+        var npcTarget = new NpcAiTransferExtensionV1
+        {
+            DirectiveTarget = new NpcTransferObjectReferenceV1("npc", NpcId: Guid.NewGuid())
+        };
+        var characterTarget = npcTarget with
+        {
+            DirectiveTarget = new NpcTransferObjectReferenceV1("character", CharacterId: 1)
+        };
+
+        Assert.True(NPCManager.CanDropUnresolvedAmbientNpcAttackTarget(nameof(AiAttackState), npcTarget,
+            hasMissionRuntime: false));
+        Assert.False(NPCManager.CanDropUnresolvedAmbientNpcAttackTarget(nameof(AiAttackState), npcTarget,
+            hasMissionRuntime: true));
+        Assert.False(NPCManager.CanDropUnresolvedAmbientNpcAttackTarget(nameof(AiDockState), npcTarget,
+            hasMissionRuntime: false));
+        Assert.False(NPCManager.CanDropUnresolvedAmbientNpcAttackTarget(nameof(AiAttackState), characterTarget,
+            hasMissionRuntime: false));
+        Assert.False(NPCManager.CanDropUnresolvedAmbientNpcAttackTarget("none", npcTarget,
+            hasMissionRuntime: false));
+    }
