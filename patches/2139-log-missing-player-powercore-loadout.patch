From: Lancer Nexus
Subject: [PATCH] Log player equipment when powercore setup fails

--- a/src/LibreLancer/GameStates/SpaceGameplay.cs
+++ b/src/LibreLancer/GameStates/SpaceGameplay.cs
@@ -203,4 +203,7 @@
             if (player.CoreEquipment.Power == null)
             {
+                var receivedEquipment = string.Join(", ", session.Items.Select(x =>
+                    $"{x.Equipment?.Nickname ?? \"<unresolved>\"}@{x.Hardpoint ?? \"<none>\"}:{x.Equipment?.GetType().Name ?? \"<unresolved>\"}"));
+                FLLog.Error("Client", $"No powercore component after mounting player equipment. Ship: {session.PlayerShip.Nickname}; received equipment: {receivedEquipment}");
                 throw new Exception("Player launched without a powercore equipped!");
             }
