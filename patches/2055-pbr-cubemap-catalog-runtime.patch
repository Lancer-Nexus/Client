+    /// <summary>Resolves an archetype environment cube, loading catalog assets on demand.</summary>
+    public TextureCube? ResolveEnvironmentCube(string? nickname, out float strength)
+    {
+        strength = 1.0f;
+        if (string.IsNullOrWhiteSpace(nickname)) return null;
+
+        if (!SurfaceMaps.TryResolveCubeMap(nickname, out var catalogEntry) || catalogEntry == null)
+            return FindTexture(nickname) as TextureCube;
+
+        strength = catalogEntry.Strength;
+        if (FindTexture(nickname) is TextureCube existing)
+            return existing;
+        if (!unavailableSurfaceCubeMaps.Add(nickname))
+            return null;
+
+        try
+        {
+            LoadResourceFile(catalogEntry.File);
+        }
+        catch (Exception error) when (error is IOException or InvalidDataException or NotSupportedException or ArgumentException or FileException)
+        {
+            FLLog.Warning("Surface", $"Unable to load CubeMap {nickname} from {catalogEntry.File}: {error.Message}");
+            return null;
+        }
+
+        if (FindTexture(nickname) is TextureCube loaded)
+            return loaded;
+
+        FLLog.Warning("Surface", $"CubeMap {nickname} from {catalogEntry.File} did not resolve to a TextureCube");
+        return null;
     }
 
