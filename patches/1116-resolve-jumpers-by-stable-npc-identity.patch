diff --git a/src/LibreLancer.Tests/NpcPopulationTransferTests.cs b/src/LibreLancer.Tests/NpcPopulationTransferTests.cs
--- a/src/LibreLancer.Tests/NpcPopulationTransferTests.cs
+++ b/src/LibreLancer.Tests/NpcPopulationTransferTests.cs
