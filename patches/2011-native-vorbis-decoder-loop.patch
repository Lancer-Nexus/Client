diff --git a/src/formats/vorbis.c b/src/formats/vorbis.c
index c5d6163..8b75643 100644
--- a/src/formats/vorbis.c
+++ b/src/formats/vorbis.c
@@ -70,6 +70,7 @@ typedef struct {
 size_t ogg_read(void* ptr, size_t size, ld_stream_t stream)
 {
 	ogg_userdata_t *userdata = (ogg_userdata_t*)stream->userData;
+	if (!userdata->vorbis) return 0;
 	size_t sz_bytes = size;
 	if((sz_bytes % 2) != 0) {
 		LOG_S_ERROR(userdata->pcm, "ogg_read: buffer size must be a multiple of sizeof(short)");
@@ -87,7 +88,21 @@ int ogg_seek(ld_stream_t stream, int32_t offset, LDSEEK origin)
 		LOG_S_ERROR(userdata->pcm, "ogg_seek: only can seek to LDSEEK_SET 0");
 		return -1;
 	}
-	stb_vorbis_seek(userdata->vorbis, 0);
+	if (userdata->vorbis) {
+		stb_vorbis_close(userdata->vorbis);
+		userdata->vorbis = NULL;
+	}
+	if (userdata->sbuffer->seek(userdata->sbuffer, 0, LDSEEK_SET) != 0) {
+		LOG_S_ERROR(userdata->pcm, "ogg_seek: failed to rewind stream");
+		return -1;
+	}
+	int err = VORBIS__no_error;
+	userdata->vorbis = stb_vorbis_open_file(userdata->sbuffer, 0, &err, NULL);
+	if (!userdata->vorbis) {
+		LOG_S_ERROR_F(userdata->pcm, "ogg_seek: failed to reopen Vorbis stream: %s",
+			stb_vorbis_strerror(err));
+		return -1;
+	}
 	return 0;
 }

