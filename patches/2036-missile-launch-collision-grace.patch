diff --git a/src/LibreLancer/World/Components/ProjectileLaunchSafety.cs b/src/LibreLancer/World/Components/ProjectileLaunchSafety.cs
new file mode 100644
index 00000000..3271f91a
--- /dev/null
+++ b/src/LibreLancer/World/Components/ProjectileLaunchSafety.cs
@@ -0,0 +1,8 @@
+namespace LibreLancer.World.Components;
+
+public static class ProjectileLaunchSafety
+{
+    public const double CollisionGracePeriod = 1.0;
+
+    public static bool IsCollisionSafe(double elapsed) => elapsed < CollisionGracePeriod;
+}
