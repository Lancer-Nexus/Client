diff --git a/src/LibreLancer/Server/FixedTimestepLoop.cs b/src/LibreLancer/Server/FixedTimestepLoop.cs
index 65e35e584..25fffdae0 100644
--- a/src/LibreLancer/Server/FixedTimestepLoop.cs
+++ b/src/LibreLancer/Server/FixedTimestepLoop.cs
@@ -17,7 +17,7 @@ namespace LibreLancer.Server
         private OnStep onStep;
 
         private Stopwatch timer = null!;
-        private bool running = false;
