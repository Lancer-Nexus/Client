diff --git a/src/LibreLancer.Tests/NomadMaterialTests.cs b/src/LibreLancer.Tests/NomadMaterialTests.cs
new file mode 100644
index 0000000..1f2d457
--- /dev/null
+++ b/src/LibreLancer.Tests/NomadMaterialTests.cs
@@ -0,0 +1,41 @@
+using LibreLancer.Render.Materials;
+using LibreLancer.Utf.Mat;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public class NomadMaterialTests
+{
+    [Fact]
+    public void BtSamplerSuppliesLegacyNomadFacingGradient()
+    {
+        var btFlags = SamplerFlags.ClampToEdgeU | SamplerFlags.SecondUV;
+        var result = NomadMaterial.ResolveGradientSampler(
+            "legacy_bt_gradient", btFlags, "nt_fallback", SamplerFlags.MirrorRepeatV);
+
+        Assert.Equal("legacy_bt_gradient", result.Sampler);
+        Assert.Equal(btFlags, result.Flags);
+    }
+
+    [Fact]
+    public void NtSamplerIsUsedWhenLegacyBtSamplerIsAbsent()
+    {
+        var ntFlags = SamplerFlags.ClampToEdgeV;
+        var result = NomadMaterial.ResolveGradientSampler(
+            null, SamplerFlags.None, "nt_gradient", ntFlags);
+
+        Assert.Equal("nt_gradient", result.Sampler);
+        Assert.Equal(ntFlags, result.Flags);
+    }
+
+    [Fact]
+    public void DefaultGradientIsUsedWhenNeitherSamplerIsSpecified()
+    {
+        var ntFlags = SamplerFlags.MirrorRepeatU;
+        var result = NomadMaterial.ResolveGradientSampler(
+            null, SamplerFlags.None, null, ntFlags);
+
+        Assert.Equal("NomadRGB1_NomadAlpha1", result.Sampler);
+        Assert.Equal(ntFlags, result.Flags);
+    }
+}
