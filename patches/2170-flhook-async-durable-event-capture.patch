+internal sealed class DurableFlHookEventCapture : IAsyncDisposable
+{
+    private const int DefaultCapacity = 4096;
+    private const int DefaultReadyBacklog = 3072;
+    private readonly Channel<CapturedEvent> queue;
+    private readonly FlHookCompatServerEventHub eventHub;
+    private readonly Action<FlHookCompatServerEvent> onRecorded;
+    private readonly Action<Exception> onFailure;
+    private readonly int readyBacklog;
+    private readonly Task worker;
+    private int failed;
+
+    internal DurableFlHookEventCapture(FlHookCompatServerEventHub eventHub,
+        Action<FlHookCompatServerEvent> onRecorded, Action<Exception> onFailure,
+        int capacity = DefaultCapacity, int? readyBacklog = null)
+    {
+        if (capacity < 1) throw new ArgumentOutOfRangeException(nameof(capacity));
+        this.eventHub = eventHub ?? throw new ArgumentNullException(nameof(eventHub));
+        this.onRecorded = onRecorded ?? throw new ArgumentNullException(nameof(onRecorded));
+        this.onFailure = onFailure ?? throw new ArgumentNullException(nameof(onFailure));
+        this.readyBacklog = Math.Clamp(readyBacklog ?? Math.Min(DefaultReadyBacklog, Math.Max(1, capacity * 3 / 4)), 1, capacity);
+        queue = Channel.CreateBounded<CapturedEvent>(new BoundedChannelOptions(capacity)
+        {
+            FullMode = BoundedChannelFullMode.Wait,
+            SingleReader = true,
+            SingleWriter = false,
+            AllowSynchronousContinuations = false
+        });
+        worker = Task.Run(ProcessAsync);
+    }
+
+    internal bool IsReady => worker is { IsCompleted: false } && Volatile.Read(ref failed) == 0 &&
+        queue.Reader.Count < readyBacklog;
+    internal bool IsFailed => Volatile.Read(ref failed) != 0;
+
+    internal void Enqueue(FlHookCompatServerEventKind kind, string playerId, string? systemId, long? characterId)
+    {
+        if (Volatile.Read(ref failed) != 0)
+            throw new IOException("The durable FLHook event capture worker has failed.");
+        if (queue.Writer.TryWrite(new CapturedEvent(kind, playerId, systemId, characterId))) return;
+
+        var overflow = new IOException("The bounded FLHook event capture queue is full; capture has failed closed.");
+        Fail(overflow);
+        throw overflow;
+    }
+
+    private async Task ProcessAsync()
+    {
+        try
+        {
+            await foreach (var item in queue.Reader.ReadAllAsync())
+            {
+                var recorded = eventHub.Record(item.Kind, item.PlayerId, item.SystemId, item.CharacterId);
+                try { onRecorded(recorded); }
+                catch (Exception exception) when (exception is not StackOverflowException and not OutOfMemoryException)
+                { onFailure(exception); }
+            }
+        }
+        catch (Exception exception) when (exception is not StackOverflowException and not OutOfMemoryException)
+        {
+            Fail(exception);
+        }
+    }
+
+    private void Fail(Exception exception)
+    {
+        if (Interlocked.Exchange(ref failed, 1) != 0) return;
+        queue.Writer.TryComplete(exception);
+        try { onFailure(exception); }
+        catch (Exception callbackError) when (callbackError is not StackOverflowException and not OutOfMemoryException) { }
+    }
+
+    public async ValueTask DisposeAsync()
+    {
+        queue.Writer.TryComplete();
+        await worker.ConfigureAwait(false);
+    }
+
+    private sealed record CapturedEvent(FlHookCompatServerEventKind Kind, string PlayerId,
+        string? SystemId, long? CharacterId);
+}
 #endif
diff --git a/src/LibreLancer.Tests/DurableFlHookEventCaptureTests.cs b/src/LibreLancer.Tests/DurableFlHookEventCaptureTests.cs
new file mode 100644
--- /dev/null
+++ b/src/LibreLancer.Tests/DurableFlHookEventCaptureTests.cs
@@ -0,0 +1,77 @@
+#if LANCER_NEXUS_FLHOOKCOMPAT_TESTS
+using System;
+using System.IO;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+using LLServer;
+using LancerNexus.FlhookCompat;
+using LancerNexus.FlhookCompat.Hosting;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public sealed class DurableFlHookEventCaptureTests
+{
+    [Fact]
+    public async Task PersistsInOrderOffProducerThreadAndFailsClosedWhenBoundedQueueIsFull()
+    {
+        var directory = Path.Combine(Path.GetTempPath(), "flhook-capture-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(directory);
+        var eventHub = new FlHookCompatServerEventHub("li-01", durableJournalPath: Path.Combine(directory, "events.jsonl"));
+        using var firstNotificationStarted = new ManualResetEventSlim();
+        using var releaseFirstNotification = new ManualResetEventSlim();
+        await using var capture = new DurableFlHookEventCapture(eventHub, value =>
+        {
+            if (value.Sequence == 1)
+            {
+                firstNotificationStarted.Set();
+                releaseFirstNotification.Wait();
+            }
+        }, _ => { }, capacity: 2, readyBacklog: 1);
+
+        capture.Enqueue(FlHookCompatServerEventKind.PlayerConnected, "account-1", null, null);
+        Assert.True(firstNotificationStarted.Wait(TimeSpan.FromSeconds(5)));
+        capture.Enqueue(FlHookCompatServerEventKind.PlayerDisconnected, "account-1", null, null);
+        capture.Enqueue(FlHookCompatServerEventKind.PlayerConnected, "account-2", null, null);
+        Assert.False(capture.IsReady);
+        Assert.Throws<IOException>(() => capture.Enqueue(
+            FlHookCompatServerEventKind.PlayerDisconnected, "account-2", null, null));
+        Assert.True(capture.IsFailed);
+
+        releaseFirstNotification.Set();
+        await capture.DisposeAsync();
+
+        var replay = eventHub.ReadAfter(0, 10);
+        Assert.Equal(new long[] { 1, 2, 3 }, replay.Events.Select(value => value.Sequence));
+        eventHub.Dispose();
+        Directory.Delete(directory, recursive: true);
+    }
+
+    [Fact]
+    public async Task JournalFailureMakesCaptureUnreadyAndRejectsLaterEvents()
+    {
+        var directory = Path.Combine(Path.GetTempPath(), "flhook-capture-failure-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(directory);
+        using var eventHub = new FlHookCompatServerEventHub("li-01", durableJournalPath: Path.Combine(directory, "events.jsonl"));
+        await using var capture = new DurableFlHookEventCapture(eventHub, _ => { }, _ => { });
+
+        Directory.Delete(directory, recursive: true);
+        capture.Enqueue(FlHookCompatServerEventKind.PlayerConnected, "account-1", null, null);
+        await WaitUntilAsync(() => !capture.IsReady);
+
+        Assert.Throws<IOException>(() => capture.Enqueue(
+            FlHookCompatServerEventKind.PlayerDisconnected, "account-1", null, null));
+    }
+
+    private static async Task WaitUntilAsync(Func<bool> condition)
+    {
+        var timeout = DateTime.UtcNow + TimeSpan.FromSeconds(5);
+        while (!condition())
+        {
+            if (DateTime.UtcNow >= timeout) throw new TimeoutException("Condition did not become true.");
+            await Task.Delay(10);
+        }
+    }
+}
+#endif
