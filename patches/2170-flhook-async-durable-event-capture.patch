new file mode 100644
--- /dev/null
+++ b/src/LibreLancer.Tests/DurableFlHookEventCaptureTests.cs
@@ -0,0 +1,77 @@
+#if LANCER_NEXUS_FLHOOKCOMPAT_TESTS
+using System;
+using System.IO;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+using LLServer;
+using LancerNexus.FlhookCompat;
+using LancerNexus.FlhookCompat.Hosting;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public sealed class DurableFlHookEventCaptureTests
+{
+    [Fact]
+    public async Task PersistsInOrderOffProducerThreadAndFailsClosedWhenBoundedQueueIsFull()
+    {
+        var directory = Path.Combine(Path.GetTempPath(), "flhook-capture-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(directory);
+        var eventHub = new FlHookCompatServerEventHub("li-01", durableJournalPath: Path.Combine(directory, "events.jsonl"));
+        using var firstNotificationStarted = new ManualResetEventSlim();
+        using var releaseFirstNotification = new ManualResetEventSlim();
+        await using var capture = new DurableFlHookEventCapture(eventHub, value =>
+        {
+            if (value.Sequence == 1)
+            {
+                firstNotificationStarted.Set();
+                releaseFirstNotification.Wait();
+            }
+        }, _ => { }, capacity: 2, readyBacklog: 1);
+
+        capture.Enqueue(FlHookCompatServerEventKind.PlayerConnected, "account-1", null, null);
+        Assert.True(firstNotificationStarted.Wait(TimeSpan.FromSeconds(5)));
+        capture.Enqueue(FlHookCompatServerEventKind.PlayerDisconnected, "account-1", null, null);
+        capture.Enqueue(FlHookCompatServerEventKind.PlayerConnected, "account-2", null, null);
+        Assert.False(capture.IsReady);
+        Assert.Throws<IOException>(() => capture.Enqueue(
+            FlHookCompatServerEventKind.PlayerDisconnected, "account-2", null, null));
+        Assert.True(capture.IsFailed);
+
+        releaseFirstNotification.Set();
+        await capture.DisposeAsync();
+
+        var replay = eventHub.ReadAfter(0, 10);
+        Assert.Equal(new long[] { 1, 2, 3 }, replay.Events.Select(value => value.Sequence));
+        eventHub.Dispose();
+        Directory.Delete(directory, recursive: true);
+    }
+
+    [Fact]
+    public async Task JournalFailureMakesCaptureUnreadyAndRejectsLaterEvents()
+    {
+        var directory = Path.Combine(Path.GetTempPath(), "flhook-capture-failure-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(directory);
+        using var eventHub = new FlHookCompatServerEventHub("li-01", durableJournalPath: Path.Combine(directory, "events.jsonl"));
+        await using var capture = new DurableFlHookEventCapture(eventHub, _ => { }, _ => { });
+
+        Directory.Delete(directory, recursive: true);
+        capture.Enqueue(FlHookCompatServerEventKind.PlayerConnected, "account-1", null, null);
+        await WaitUntilAsync(() => !capture.IsReady);
+
+        Assert.Throws<IOException>(() => capture.Enqueue(
+            FlHookCompatServerEventKind.PlayerDisconnected, "account-1", null, null));
+    }
+
+    private static async Task WaitUntilAsync(Func<bool> condition)
+    {
+        var timeout = DateTime.UtcNow + TimeSpan.FromSeconds(5);
+        while (!condition())
+        {
+            if (DateTime.UtcNow >= timeout) throw new TimeoutException("Condition did not become true.");
+            await Task.Delay(10);
+        }
+    }
+}
+#endif
