@@ -0,0 +1,44 @@
+using System;
+using System.Collections.Generic;
+using System.Runtime.ExceptionServices;
+
+namespace LibreLancer.Graphics;
+
+/// <summary>Owns a group of render resources and releases them in reverse construction order.</summary>
+internal sealed class RenderResourceScope : IDisposable
+{
+    private readonly Stack<IDisposable> resources = new();
+    private bool disposed;
+
+    public T Own<T>(T resource) where T : IDisposable
+    {
+        ArgumentNullException.ThrowIfNull(resource);
+        ObjectDisposedException.ThrowIf(disposed, this);
+        resources.Push(resource);
+        return resource;
+    }
+
+    public void Dispose()
+    {
+        if (disposed) return;
+        disposed = true;
+
+        List<Exception>? errors = null;
+        while (resources.TryPop(out var resource))
+        {
+            try
+            {
+                resource.Dispose();
+            }
+            catch (Exception exception)
+            {
+                (errors ??= []).Add(exception);
+            }
+        }
+
+        if (errors is { Count: 1 })
+            ExceptionDispatchInfo.Capture(errors[0]).Throw();
+        if (errors is { Count: > 1 })
+            throw new AggregateException("One or more render resources failed to dispose.", errors);
+    }
+}
