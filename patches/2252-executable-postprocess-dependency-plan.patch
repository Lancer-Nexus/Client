+using System;
+using System.Collections.Generic;
+using LibreLancer.Graphics;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public class PostProcessExecutionPlanTests
+{
+    [Fact]
+    public void CompileRejectsRequiredResourceThatHasNoProducer()
+    {
+        var pass = new TestPass();
+        var stages = new[]
+        {
+            new PostProcessStage("SSAO", pass,
+                PostProcessResource.CurrentColor | PostProcessResource.SceneDepth,
+                PostProcessResource.CurrentColor)
+        };
+
+        var error = Assert.Throws<InvalidOperationException>(() =>
+            PostProcessExecutionPlan.Compile(stages, PostProcessResource.CurrentColor));
+
+        Assert.Contains("SceneDepth", error.Message);
+    }
+
+    [Fact]
+    public void OptionalResourcesMayBeMissingWhenPassHasFallback()
+    {
+        var pass = new TestPass();
+        var stages = new[]
+        {
+            new PostProcessStage("Tone map", pass,
+                PostProcessResource.CurrentColor | PostProcessResource.BloomBase,
+                PostProcessResource.PresentationColor,
+                PostProcessResource.BloomBase)
+        };
+
+        var plan = PostProcessExecutionPlan.Compile(stages, PostProcessResource.CurrentColor);
+        var context = ContextWithColor();
+        plan.Execute(ref context);
+
+        Assert.Equal(1, pass.ExecuteCount);
+        Assert.Equal(0, plan.EstimatedMemoryBytes);
+        plan.Dispose();
+        Assert.Equal(1, pass.DisposeCount);
+    }
+
+    [Fact]
+    public void OptionalResourcesMustAlsoBeDeclaredAsInputs()
+    {
+        var stages = new[]
+        {
+            new PostProcessStage("Tone map", new TestPass(),
+                PostProcessResource.CurrentColor,
+                PostProcessResource.PresentationColor,
+                PostProcessResource.BloomBase)
+        };
+
+        var error = Assert.Throws<ArgumentException>(() =>
+            PostProcessExecutionPlan.Compile(stages, PostProcessResource.CurrentColor));
+
+        Assert.Contains("undeclared inputs", error.Message);
+    }
+
+    [Fact]
+    public void ExecuteKeepsDeclaredStageOrder()
+    {
+        var order = new List<string>();
+        var first = new TestPass(() => order.Add("first"));
+        var second = new TestPass(() => order.Add("second"));
+        var stages = new[]
+        {
+            new PostProcessStage("Bloom", first, PostProcessResource.CurrentColor,
+                PostProcessResource.BloomBase),
+            new PostProcessStage("Tone map", second,
+                PostProcessResource.CurrentColor | PostProcessResource.BloomBase,
+                PostProcessResource.PresentationColor)
+        };
+        var plan = PostProcessExecutionPlan.Compile(stages, PostProcessResource.CurrentColor);
+        var context = ContextWithColor();
+
+        plan.Execute(ref context);
+
+        Assert.Equal(new[] { "first", "second" }, order);
+    }
+
+    [Fact]
+    public void ExecuteOrdersAProducerBeforeAnEarlierDeclaredConsumer()
+    {
+        var order = new List<string>();
+        var consumer = new TestPass(() => order.Add("consumer"));
+        var producer = new TestPass(() => order.Add("producer"));
+        var stages = new[]
+        {
+            new PostProcessStage("Tone map", consumer,
+                PostProcessResource.CurrentColor | PostProcessResource.BloomBase,
+                PostProcessResource.PresentationColor),
+            new PostProcessStage("Bloom", producer, PostProcessResource.CurrentColor,
+                PostProcessResource.BloomBase)
+        };
+        var plan = PostProcessExecutionPlan.Compile(stages, PostProcessResource.CurrentColor);
+        var context = ContextWithColor();
+
+        plan.Execute(ref context);
+
+        Assert.Equal(new[] { "producer", "consumer" }, order);
+    }
+
+    [Fact]
+    public void PassCannotReadResourceThatOnlyItProduces()
+    {
+        var stages = new[]
+        {
+            new PostProcessStage("Invalid in-place pass", new TestPass(),
+                PostProcessResource.PresentationColor,
+                PostProcessResource.PresentationColor)
+        };
+
+        var error = Assert.Throws<InvalidOperationException>(() =>
+            PostProcessExecutionPlan.Compile(stages, PostProcessResource.CurrentColor));
+
+        Assert.Contains("PresentationColor", error.Message);
+    }
+
+    [Fact]
+    public void ExecuteRejectsRuntimeInputMissingFromCompiledPlan()
+    {
+        var pass = new TestPass();
+        var stages = new[]
+        {
+            new PostProcessStage("SSAO", pass, PostProcessResource.SceneDepth,
+                PostProcessResource.CurrentColor)
+        };
+        var plan = PostProcessExecutionPlan.Compile(stages, PostProcessResource.SceneDepth);
+        var context = ContextWithColor();
+
+        var error = Assert.Throws<InvalidOperationException>(() => plan.Execute(ref context));
+
+        Assert.Contains("runtime resources: SceneDepth", error.Message);
+        Assert.Equal(0, pass.ExecuteCount);
+    }
+
+    [Fact]
+    public void OptionalOutputMustBeDeclaredAsAnOutput()
+    {
+        var stages = new[]
+        {
+            new PostProcessStage("Tone map", new TestPass(),
+                PostProcessResource.CurrentColor, PostProcessResource.PresentationColor,
+                OptionalWrites: PostProcessResource.BloomBase)
+        };
+
+        var error = Assert.Throws<ArgumentException>(() =>
+            PostProcessExecutionPlan.Compile(stages, PostProcessResource.CurrentColor));
+
+        Assert.Contains("undeclared outputs", error.Message);
+    }
+
+    [Fact]
+    public void MissingOptionalRuntimeOutputFailsBeforeRequiredConsumer()
+    {
+        var consumer = new TestPass();
+        var stages = new[]
+        {
+            new PostProcessStage("Bloom", new TestPass(), PostProcessResource.CurrentColor,
+                PostProcessResource.BloomBase, OptionalWrites: PostProcessResource.BloomBase),
+            new PostProcessStage("Required consumer", consumer,
+                PostProcessResource.CurrentColor | PostProcessResource.BloomBase,
+                PostProcessResource.PresentationColor)
+        };
+        var plan = PostProcessExecutionPlan.Compile(stages, PostProcessResource.CurrentColor);
+        var context = ContextWithColor();
+
+        var error = Assert.Throws<InvalidOperationException>(() => plan.Execute(ref context));
+
+        Assert.Contains("Required consumer", error.Message);
+        Assert.Contains("BloomBase", error.Message);
+        Assert.Equal(0, consumer.ExecuteCount);
+    }
+
+    [Fact]
+    public void DisposeReleasesPassesInReverseExecutionOrder()
+    {
+        var disposed = new List<string>();
+        var first = new TestPass(dispose: () => disposed.Add("first"));
+        var second = new TestPass(dispose: () => disposed.Add("second"));
+        var stages = new[]
+        {
+            new PostProcessStage("First", first, PostProcessResource.CurrentColor,
+                PostProcessResource.BloomBase),
+            new PostProcessStage("Second", second,
+                PostProcessResource.CurrentColor | PostProcessResource.BloomBase,
+                PostProcessResource.PresentationColor)
+        };
+        var plan = PostProcessExecutionPlan.Compile(stages, PostProcessResource.CurrentColor);
+
+        plan.Dispose();
+
+        Assert.Equal(new[] { "second", "first" }, disposed);
+    }
+
+    private static PostProcessContext ContextWithColor() =>
+        new() { AvailableResources = PostProcessResource.CurrentColor };
+
+    private sealed class TestPass(Action? execute = null, Action? dispose = null) : IPostProcessPass
+    {
+        public int ExecuteCount { get; private set; }
+        public int DisposeCount { get; private set; }
+        public long EstimatedMemoryBytes => 0;
+
+        public void Execute(ref PostProcessContext context)
+        {
+            ExecuteCount++;
+            execute?.Invoke();
+        }
+
+        public void Dispose()
+        {
+            DisposeCount++;
+            dispose?.Invoke();
+        }
+    }
+}
