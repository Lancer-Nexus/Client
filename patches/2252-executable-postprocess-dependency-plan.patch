+using System;
+using System.Collections.Generic;
+using LibreLancer.Graphics;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+public class RenderResourceScopeTests
+{
+    [Fact]
+    public void DisposeReleasesOwnedResourcesInReverseOrderAndOnlyOnce()
+    {
+        var disposed = new List<string>();
+        var scope = new RenderResourceScope();
+        var first = new TestResource("first", disposed);
+        var second = new TestResource("second", disposed);
+
+        Assert.Same(first, scope.Own(first));
+        Assert.Same(second, scope.Own(second));
+        scope.Dispose();
+        scope.Dispose();
+
+        Assert.Equal(new[] { "second", "first" }, disposed);
+        Assert.Throws<ObjectDisposedException>(() => scope.Own(new TestResource("late", disposed)));
+    }
+
+    [Fact]
+    public void DisposeContinuesReleasingResourcesWhenOneResourceThrows()
+    {
+        var disposed = new List<string>();
+        var scope = new RenderResourceScope();
+        scope.Own(new TestResource("first", disposed));
+        scope.Own(new TestResource("throws", disposed, throwOnDispose: true));
+        scope.Own(new TestResource("last", disposed));
+
+        Assert.Throws<InvalidOperationException>(() => scope.Dispose());
+
+        Assert.Equal(new[] { "last", "throws", "first" }, disposed);
+        scope.Dispose();
+        Assert.Equal(3, disposed.Count);
+    }
+
+    private sealed class TestResource(string name, List<string> disposed, bool throwOnDispose = false) : IDisposable
+    {
+        public void Dispose()
+        {
+            disposed.Add(name);
+            if (throwOnDispose)
+                throw new InvalidOperationException("Test disposal failure.");
+        }
+    }
+}
