index 0d06a225c04fb8fdbf38f3826ca2ebe7955906eb..b3d1554bf147543cf1650f1216703ab7bf983ea9 100644
--- a/src/LibreLancer.Base/Platforms/SDL3GpuSmoke.cs
+++ b/src/LibreLancer.Base/Platforms/SDL3GpuSmoke.cs
@@ -23,6 +23,71 @@ public static class SDL3GpuSmoke
     private const string ShaderBundleResource = "SDLGPUSmoke.bin";
     private const string CopyShaderBundleResource = "SDLGPUCopy.bin";
 
+    public static int AuditProductionShaderBundles()
+    {
+        try
+        {
+            var assembly = Assembly.Load("LibreLancer");
+            var shaderCatalog = assembly.GetType("LibreLancer.Shaders.AllShaders", throwOnError: true)!;
+            var bundles = shaderCatalog.GetFields(BindingFlags.Public | BindingFlags.Static)
+                .Where(field => field.FieldType == typeof(ShaderBundle))
+                .OrderBy(field => field.Name, StringComparer.Ordinal)
+                .ToArray();
+            if (bundles.Length == 0)
+                throw new InvalidDataException("The built-in shader catalog contains no shader bundles.");
+
+            var totalVariants = 0;
+            var totalEmptyVariants = 0;
+            var totalMappedVariants = 0;
+            var totalLegacyVariants = 0;
+            foreach (var field in bundles)
+            {
+                var resourceName = field.Name + ".bin";
+                using var stream = assembly.GetManifestResourceStream(resourceName)
+                                   ?? throw new FileNotFoundException($"Missing embedded production shader bundle {resourceName}.");
+                var bundle = BytecodesBundle.FromStream(stream);
+                var variants = 0;
+                var emptyVariants = 0;
+                var mappedVariants = 0;
+                var legacyVariants = 0;
+                for (var index = 0; index < bundle.ShaderCount; index++)
+                {
+                    var shader = bundle.GetShader(index);
+                    if (shader.Length == 5 && shader.SequenceEqual("NULL\0"u8))
+                    {
+                        emptyVariants++;
+                        continue;
+                    }
+
+                    var version = ShaderBytecodes.GetVersion(shader);
+                    _ = SDL3GpuShaderProgramReader.Parse(shader);
+                    variants++;
+                    if (version >= 2)
+                        mappedVariants++;
+                    else
+                        legacyVariants++;
+                }
+
+                totalVariants += variants;
+                totalEmptyVariants += emptyVariants;
+                totalMappedVariants += mappedVariants;
+                totalLegacyVariants += legacyVariants;
+                Console.WriteLine($"{field.Name}: {variants} parsed, {mappedVariants} with SDL_GPU maps, " +
+                                  $"{legacyVariants} legacy, {emptyVariants} empty feature entries.");
+            }
+
+            Console.WriteLine($"SDL_GPU production shader audit passed: {bundles.Length} bundles, " +
+                              $"{totalVariants} parsed variants, {totalMappedVariants} mapped, " +
+                              $"{totalLegacyVariants} legacy, {totalEmptyVariants} empty entries.");
+            return totalVariants == 0 ? 1 : 0;
+        }
+        catch (Exception exception)
+        {
+            Console.Error.WriteLine($"SDL_GPU production shader audit failed: {exception}");
+            return 1;
+        }
+    }
+
