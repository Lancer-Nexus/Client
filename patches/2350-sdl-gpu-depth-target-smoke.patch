+    private static IntPtr CreateDepthTexture(IntPtr device, uint width, uint height)
+    {
+        var format = SDL3.SDL_GPUTextureFormat.SDL_GPU_TEXTUREFORMAT_D32_FLOAT;
+        var usage = SDL3.SDL_GPUTextureUsageFlags.SDL_GPU_TEXTUREUSAGE_DEPTH_STENCIL_TARGET;
+        if (!SDL3.SDL_GPUTextureSupportsFormat(device, format,
+                SDL3.SDL_GPUTextureType.SDL_GPU_TEXTURETYPE_2D, usage))
+            throw new InvalidOperationException("The selected SDL_GPU driver does not support a D32 depth target.");
+        var texture = SDL3.SDL_CreateGPUTexture(device, new SDL3.SDL_GPUTextureCreateInfo
+        {
+            type = SDL3.SDL_GPUTextureType.SDL_GPU_TEXTURETYPE_2D,
+            format = format,
+            usage = usage,
+            width = width,
+            height = height,
+            layer_count_or_depth = 1,
+            num_levels = 1,
+            sample_count = SDL3.SDL_GPUSampleCount.SDL_GPU_SAMPLECOUNT_1
