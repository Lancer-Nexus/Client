+        return Math.Clamp((color * (a * color + b)) / (color * (c * color + d) + e), 0f, 1f);
+    }
+
+    private static byte ToOutputByte(float linear, bool srgbTarget)
+    {
+        var display = srgbTarget
+            ? linear <= 0.0031308f
+                ? linear * 12.92f
+                : 1.055f * MathF.Pow(linear, 1f / 2.4f) - 0.055f
+            : linear;
+        return (byte)Math.Clamp((int)MathF.Round(display * 255f), 0, 255);
+    }
 }
