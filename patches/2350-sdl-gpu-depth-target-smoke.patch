new file mode 100644
--- /dev/null
+++ b/src/LibreLancer.Base/Shaders/SDLGPUCopy.frag.hlsl
@@ -0,0 +1,21 @@
+Texture2D<float4> SceneColor : register(t0, TEXTURE_SPACE);
+SamplerState SceneSampler : register(s0, TEXTURE_SPACE);
+
+float3 AcesFitted(float3 color)
+{
+    const float a = 2.51;
+    const float b = 0.03;
+    const float c = 2.43;
+    const float d = 0.59;
+    const float e = 0.14;
+    return saturate((color * (a * color + b)) / (color * (c * color + d) + e));
+}
+
+float4 main(float2 uv : TEXCOORD0) : SV_Target0
+{
+    float4 source = SceneColor.Sample(SceneSampler, uv);
+    // Values above 1.0 must survive the RGBA16F scene target and texture sample.
+    // Apply the same fitted ACES curve used by the game's Tonemap shader.
+    float3 hdr = max(source.rgb, 0.0);
+    return float4(AcesFitted(hdr), source.a);
+}
