+    }
+
+    private static IntPtr CreateDiffuseSampler(IntPtr device)
+    {
+        var sampler = SDL3.SDL_CreateGPUSampler(device, new SDL3.SDL_GPUSamplerCreateInfo
+        {
+            min_filter = SDL3.SDL_GPUFilter.SDL_GPU_FILTER_NEAREST,
+            mag_filter = SDL3.SDL_GPUFilter.SDL_GPU_FILTER_NEAREST,
+            mipmap_mode = SDL3.SDL_GPUSamplerMipmapMode.SDL_GPU_SAMPLERMIPMAPMODE_NEAREST,
+            address_mode_u = SDL3.SDL_GPUSamplerAddressMode.SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE,
+            address_mode_v = SDL3.SDL_GPUSamplerAddressMode.SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE,
+            address_mode_w = SDL3.SDL_GPUSamplerAddressMode.SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE,
+            max_anisotropy = 1.0f,
+            min_lod = 0.0f,
+            max_lod = 0.0f
+        });
+        if (sampler == IntPtr.Zero)
+            throw Failure("Creating the SDL_GPU normal-map sampler failed");
+        return sampler;
+    }
+
+    private static unsafe IntPtr CreatePipeline(IntPtr device, IntPtr vertexShader, IntPtr fragmentShader,
+        SDL3.SDL_GPUTextureFormat colorFormat)
+    {
+        var vertexBuffer = new SDL3.SDL_GPUVertexBufferDescription
+        {
+            slot = 0,
+            pitch = 5 * sizeof(float),
+            input_rate = SDL3.SDL_GPUVertexInputRate.SDL_GPU_VERTEXINPUTRATE_VERTEX,
+            instance_step_rate = 0
+        };
+        SDL3.SDL_GPUVertexAttribute* attributes = stackalloc SDL3.SDL_GPUVertexAttribute[2];
+        attributes[0] = new SDL3.SDL_GPUVertexAttribute
+        {
+            location = 0,
+            buffer_slot = 0,
+            format = SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_FLOAT2,
+            offset = 0
+        };
+        attributes[1] = new SDL3.SDL_GPUVertexAttribute
+        {
+            location = 1,
+            buffer_slot = 0,
+            format = SDL3.SDL_GPUVertexElementFormat.SDL_GPU_VERTEXELEMENTFORMAT_FLOAT2,
+            offset = 3 * sizeof(float)
+        };
+        var blend = new SDL3.SDL_GPUColorTargetBlendState
+        {
+            color_write_mask = SDL3.SDL_GPUColorComponentFlags.SDL_GPU_COLORCOMPONENT_R |
+                               SDL3.SDL_GPUColorComponentFlags.SDL_GPU_COLORCOMPONENT_G |
+                               SDL3.SDL_GPUColorComponentFlags.SDL_GPU_COLORCOMPONENT_B |
+                               SDL3.SDL_GPUColorComponentFlags.SDL_GPU_COLORCOMPONENT_A,
+            enable_color_write_mask = true
+        };
+        var colorTarget = new SDL3.SDL_GPUColorTargetDescription
+        {
+            format = colorFormat,
+            blend_state = blend
+        };
+        var info = new SDL3.SDL_GPUGraphicsPipelineCreateInfo
+        {
+            vertex_shader = vertexShader,
+            fragment_shader = fragmentShader,
+            vertex_input_state = new SDL3.SDL_GPUVertexInputState
+            {
+                vertex_buffer_descriptions = &vertexBuffer,
+                num_vertex_buffers = 1,
+                vertex_attributes = attributes,
+                num_vertex_attributes = 2
+            },
+            primitive_type = SDL3.SDL_GPUPrimitiveType.SDL_GPU_PRIMITIVETYPE_TRIANGLELIST,
+            rasterizer_state = new SDL3.SDL_GPURasterizerState
+            {
+                fill_mode = SDL3.SDL_GPUFillMode.SDL_GPU_FILLMODE_FILL,
+                cull_mode = SDL3.SDL_GPUCullMode.SDL_GPU_CULLMODE_NONE,
+                front_face = SDL3.SDL_GPUFrontFace.SDL_GPU_FRONTFACE_COUNTER_CLOCKWISE,
+                enable_depth_clip = true
+            },
+            multisample_state = new SDL3.SDL_GPUMultisampleState
+            {
+                sample_count = SDL3.SDL_GPUSampleCount.SDL_GPU_SAMPLECOUNT_1
+            },
+            depth_stencil_state = new SDL3.SDL_GPUDepthStencilState
+            {
+                compare_op = SDL3.SDL_GPUCompareOp.SDL_GPU_COMPAREOP_LESS,
+                enable_depth_test = true,
+                enable_depth_write = true
+            }
+        };
+        info.target_info.color_target_descriptions = &colorTarget;
+        info.target_info.num_color_targets = 1;
+        info.target_info.depth_stencil_format = SDL3.SDL_GPUTextureFormat.SDL_GPU_TEXTUREFORMAT_D32_FLOAT;
+        info.target_info.has_depth_stencil_target = true;
+        return SDL3.SDL_CreateGPUGraphicsPipeline(device, info);
+    }
+
+    private static InvalidOperationException Failure(string message)
+    {
+        var error = SDL3.SDL_GetError();
+        return new InvalidOperationException(string.IsNullOrEmpty(error)
+            ? message
+            : $"{message}: {error}");
+    }
+}
