+Texture2D<float2> NormalTexture : register(t0, TEXTURE_SPACE);
+SamplerState DiffuseSampler : register(s0, TEXTURE_SPACE);
+
+float4 main(float2 uv : TEXCOORD0) : SV_Target0
+{
+    float2 xy = NormalTexture.Sample(DiffuseSampler, uv).rg * 2.0 - 1.0;
+    float3 normal = normalize(float3(xy, sqrt(max(1.0 - dot(xy, xy), 0.0))));
+    return float4(normal * 0.5 + 0.5, 1.0);
+}
