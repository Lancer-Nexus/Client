+/// <summary>Checks resource dependencies between post-process passes in one frame.</summary>
+public sealed class SystemRenderSubpassExecution
+{
+    private SystemRenderResource available;
+    private SystemRenderSubpass? activePass;
+
+    public void Reset(SystemRenderResource externalResources) =>
+        (available, activePass) = (externalResources, null);
+
+    public void Begin(SystemRenderSubpass pass)
+    {
+        if (activePass != null)
+            throw new InvalidOperationException(
+                $"Render subpass '{SystemRenderPasses.GetSubpass(activePass.Value).Name}' is still active.");
+
+        var descriptor = SystemRenderPasses.GetSubpass(pass);
+        var required = descriptor.Reads & ~descriptor.OptionalReads;
+        var missing = required & ~available;
+        if (missing != SystemRenderResource.None)
+            throw new InvalidOperationException(
+                $"Render subpass '{descriptor.Name}' reads unavailable frame resources {missing}.");
+
+        activePass = pass;
+    }
+
+    public void End(SystemRenderSubpass pass)
+    {
+        if (activePass != pass)
+            throw new InvalidOperationException(
+                $"Render subpass '{SystemRenderPasses.GetSubpass(pass).Name}' ended without a matching begin.");
+        available |= SystemRenderPasses.GetSubpass(pass).Writes;
+        activePass = null;
+    }
+
+    public void Abort(SystemRenderSubpass pass)
+    {
+        if (activePass == pass)
+            activePass = null;
+    }
+
+    public void CompleteFrame()
+    {
+        if (activePass != null)
+            throw new InvalidOperationException(
+                $"Render frame ended while subpass '{SystemRenderPasses.GetSubpass(activePass.Value).Name}' was active.");
+    }
+}
 
