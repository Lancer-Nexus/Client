+        internal static float CalculateLightPriority(RenderLight light, Vector3 objectCenter, float objectRadius)
+        {
+            var color = light.Color;
+            var ambient = light.Ambient;
+            var intensity = Math.Max(0, color.R) * 0.2126f +
+                            Math.Max(0, color.G) * 0.7152f +
+                            Math.Max(0, color.B) * 0.0722f +
+                            Math.Max(0, ambient.R) * 0.2126f +
+                            Math.Max(0, ambient.G) * 0.7152f +
+                            Math.Max(0, ambient.B) * 0.0722f;
+            if (!float.IsFinite(intensity) || intensity <= 0)
+                return 0;
+
+            if (light.Kind == LightKind.Directional)
+                return intensity;
+
+            var distance = Math.Max(0, Vector3.Distance(light.Position, objectCenter) - Math.Max(0, objectRadius));
+            var attenuation = light.Attenuation;
+            float factor;
+            if (light.Kind == LightKind.PointAttenCurve)
+            {
+                var normalizedDistance = distance / Math.Max(light.Range, 1);
+                factor = attenuation.X * normalizedDistance * normalizedDistance +
+                         attenuation.Y * normalizedDistance + attenuation.Z;
+            }
+            else
+            {
+                var denominator = attenuation.X + attenuation.Y * distance +
+                                  attenuation.Z * distance * distance;
+                factor = denominator > 0 && float.IsFinite(denominator) ? 1f / denominator : 0;
+            }
+
+            var priority = intensity * Math.Max(0, factor);
+            return float.IsFinite(priority) ? priority : 0;
+        }
